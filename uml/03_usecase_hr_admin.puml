@startuml 03_usecase_hr_admin
skinparam dpi 220
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam packageStyle rectangle
skinparam shadowing true
skinparam roundCorner 10

skinparam titleFontName "Segoe UI"
skinparam titleFontSize 16
skinparam titleFontStyle bold
skinparam titleFontColor #0F172A

skinparam actor {
    BackgroundColor #FEF3C7
    BorderColor #B45309
    FontColor #78350F
    FontSize 12
    FontStyle bold
}

skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #059669
    FontColor #0F172A
    FontSize 12
    ArrowColor #475569
    ArrowThickness 1.2
}

skinparam package {
    BackgroundColor #F8FAFC
    BorderColor #94A3B8
    FontColor #0F172A
    FontStyle bold
}

left to right direction

title **SƠ ĐỒ USE CASE PHÂN RÃ: PHÂN HỆ KẾ TOÁN (HR) & QUẢN TRỊ VIÊN**\n(Accountant / HR & Admin Detailed Use Cases)

actor "Kế Toán / HR\n(Accountant / HR)" as HR
actor "Quản Trị Viên\n(System Admin)" as Admin

rectangle "Phân Hệ Nghiệp Vụ Kế Toán & Quản Trị Hệ Thống" {

    package "1. Quản Trị Hệ Thống & Tổ Chức" #F0FDF4 {
        usecase "UC_AUTH_01: Đăng nhập hệ thống (JWT/RBAC)" as UC_AUTH_01 #FFFFFF
        usecase "UC_AUTH_02: Đổi mật khẩu cá nhân" as UC_AUTH_02 #FFFFFF
        usecase "UC_ADMIN_01: Quản lý tài khoản người dùng" as UC_ADMIN_01 #FFFFFF
        usecase "UC_ADMIN_02: Phân quyền vai trò (Role Management)" as UC_ADMIN_02 #FFFFFF
        usecase "UC_HR_01: Quản lý danh mục Phòng ban" as UC_HR_01 #FFFFFF
    }

    package "2. Hồ Sơ Nhân Sự, Hợp Đồng & Chế Độ" #EFF6FF {
        usecase "UC_HR_02: Quản lý Hồ sơ nhân viên" as UC_HR_02 #FFFFFF
        usecase "UC_HR_03: Quản lý Hợp đồng lao động" as UC_HR_03 #FFFFFF
        usecase "UC_HR_04: Quản lý Phụ cấp & Khoản khấu trừ" as UC_HR_04 #FFFFFF
        usecase "UC_HR_05: Cấu hình tỷ lệ trích nộp (DeductionRate)" as UC_HR_05 #FFFFFF
    }

    package "3. Giám Sát & Phê Duyệt Chấm Công" #FEF3C7 {
        usecase "UC_HR_06: Duyệt đơn phép & Khóa công tháng" as UC_HR_06 #FFFFFF
    }

    package "4. Động Cơ Tính Lương & Quyết Toán (Core Engine)" #FAF5FF {
        usecase "UC_HR_07: Khởi tạo & Tính lương tự động (Batch Run)" as UC_HR_07 #FFFFFF
        usecase "UC_HR_08: Xem & đối soát bảng lương tổng hợp" as UC_HR_08 #FFFFFF
        usecase "UC_HR_09: Chốt kỳ lương (Đã khóa, Read-Only)" as UC_HR_09 #FFFFFF
        usecase "UC_HR_10: Xuất danh sách chuyển khoản ngân hàng" as UC_HR_10 #FFFFFF
    }
}

' Quyền Admin
Admin --> UC_AUTH_01
Admin --> UC_AUTH_02
Admin --> UC_ADMIN_01
Admin --> UC_ADMIN_02
Admin --> UC_HR_01

' Nghiệp vụ HR
HR --> UC_AUTH_01
HR --> UC_AUTH_02
HR --> UC_HR_01
HR --> UC_HR_02
HR --> UC_HR_03
HR --> UC_HR_04
HR --> UC_HR_05
HR --> UC_HR_06
HR --> UC_HR_07
HR --> UC_HR_08
HR --> UC_HR_09
HR --> UC_HR_10

@enduml
