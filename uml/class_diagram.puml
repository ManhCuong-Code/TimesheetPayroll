@startuml class_diagram
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam roundCorner 8
skinparam classAttributeIconSize 0
skinparam linetype ortho

skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #2563EB
    HeaderBackgroundColor #EFF6FF
    ArrowColor #475569
}

enum Role {
    EMPLOYEE
    ACCOUNTANT_HR
    ADMIN
}

enum TimesheetStatus {
    PRESENT
    HALF_DAY
    ABSENT_PERMITTED
    ABSENT_UNPERMITTED
    HOLIDAY
}

enum PeriodStatus {
    DRAFT
    CALCULATED
    LOCKED
}

enum LineType {
    BASE_SALARY
    ALLOWANCE
    OVERTIME
    INSURANCE_DEDUCTION
    TAX_DEDUCTION
    BONUS
    PENALTY
}

class Department {
    - id: Long
    - code: String
    - name: String
    - description: String
    + getEmployees(): List<Employee>
}

class Employee {
    - id: Long
    - employeeCode: String
    - fullName: String
    - email: String
    - phoneNumber: String
    - bankAccount: String
    - bankName: String
    - role: Role
    - isActive: Boolean
    - departmentId: Long
    + getActiveContract(): Contract
    + getTimesheets(month: int, year: int): List<Timesheet>
}

class Contract {
    - id: Long
    - employeeId: Long
    - contractNumber: String
    - baseSalary: Double
    - mealAllowance: Double
    - fuelAllowance: Double
    - startDate: LocalDate
    - endDate: LocalDate
    - isCurrent: Boolean
    + calculateGrossBase(): Double
}

class Timesheet {
    - id: Long
    - employeeId: Long
    - workDate: LocalDate
    - checkInTime: LocalTime
    - checkOutTime: LocalTime
    - workUnits: Double
    - status: TimesheetStatus
    - note: String
    + isValidWorkDay(): Boolean
}

class PayrollPeriod {
    - id: Long
    - periodCode: String
    - month: Integer
    - year: Integer
    - standardWorkDays: Double
    - status: PeriodStatus
    - lockedAt: LocalDateTime
    - lockedBy: String
    + calculateAllPayslips(): void
    + lockPeriod(): void
}

class Payslip {
    - id: Long
    - periodId: Long
    - employeeId: Long
    - actualWorkDays: Double
    - grossIncome: Double
    - totalDeductions: Double
    - netSalary: Double
    - isPaid: Boolean
    + generateLines(): void
    + computeNet(): Double
}

class PayslipLine {
    - id: Long
    - payslipId: Long
    - lineType: LineType
    - title: String
    - amount: Double
    - rate: Double
    - note: String
}

class DeductionRate {
    - id: Long
    - code: String
    - name: String
    - ratePercent: Double
    - isCompulsory: Boolean
    - effectiveDate: LocalDate
    + applyTo(salaryBase: Double): Double
}

' Quan hệ kết hợp & phụ thuộc
Department "1" o-- "0..*" Employee : có nhân sự >
Employee "1" *-- "0..*" Contract : sở hữu >
Employee "1" *-- "0..*" Timesheet : ghi nhận >
Employee "1" <-- "0..*" Payslip : nhận phiếu lương <
PayrollPeriod "1" *-- "0..*" Payslip : chứa >
Payslip "1" *-- "1..*" PayslipLine : chi tiết dòng tính >
PayrollPeriod ..> DeductionRate : áp dụng tỷ lệ >

@enduml
