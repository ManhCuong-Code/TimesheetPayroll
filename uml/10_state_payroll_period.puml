@startuml 10_state_payroll_period
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam roundCorner 8

title **SƠ ĐỒ MÁY TRẠNG THÁI (STATE MACHINE DIAGRAM)**\nVòng đời đối tượng Kỳ Lương (PayrollPeriod Lifecycle) - Kiểm soát tính toàn vẹn dữ liệu

[*] --> DRAFT : Tạo mới kỳ lương (VD: T10/2026)

state DRAFT {
    DRAFT : Thu thập bảng chấm công hàng ngày
    DRAFT : Nhân viên có thể gửi đơn xin nghỉ phép
    DRAFT : Cho phép chỉnh sửa thông tin hợp đồng
}

DRAFT --> CALCULATING : Kế toán bấm "Tính Lương Tự Động"

state CALCULATING {
    CALCULATING : Bắt đầu Database Transaction
    CALCULATING : Tính lương gộp & khấu trừ BHXH/Thuế
    CALCULATING : Khóa tạm thời bảng công (Lock row)
}

CALCULATING --> DRAFT : Phát sinh lỗi hệ thống / Rollback Transaction
CALCULATING --> CALCULATED : Tính toán 100% thành công cho tất cả nhân viên

state CALCULATED {
    CALCULATED : Phiếu lương ở dạng Xem trước (Preview)
    CALCULATED : Kế toán đối soát tổng quỹ lương
    CALCULATED : Được phép tính toán lại nếu sửa ngày công
}

CALCULATED --> CALCULATING : Chạy lại tính lương khi có điều chỉnh
CALCULATED --> LOCKED : Kế toán bấm "Chốt Kỳ Lương (Khóa Sổ)"

state LOCKED {
    LOCKED : Khóa vĩnh viễn (Read-Only)
    LOCKED : Ngăn chặn tuyệt đối mọi hành vi sửa/xóa
    LOCKED : Phiếu lương hiển thị công khai tới nhân viên
    LOCKED : Kích hoạt Trợ lý AI giải đáp thắc mắc
    LOCKED : Xuất file danh sách chuyển khoản cho Ngân hàng
}

LOCKED --> PAID : Kế toán xác nhận ủy nhiệm chi ngân hàng thành công

state PAID {
    PAID : Đã thanh toán tiền qua tài khoản ngân hàng
    PAID : Lưu trữ vào kho dữ liệu lịch sử (Archive)
}

PAID --> [*] : Kết thúc chu kỳ quyết toán

@enduml
