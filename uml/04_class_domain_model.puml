@startuml 04_class_domain_model
skinparam dpi 220
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam roundCorner 8
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam shadowing true

skinparam titleFontName "Segoe UI"
skinparam titleFontSize 16
skinparam titleFontStyle bold
skinparam titleFontColor #0F172A

skinparam class {
    BackgroundColor #FFFFFF
    BorderColor #1E40AF
    HeaderBackgroundColor #1E40AF
    FontColor #0F172A
    ArrowColor #334155
    ArrowThickness 1.2
}

title **SƠ ĐỒ LỚP MIỀN NGHIỆP VỤ (DOMAIN MODEL CLASS DIAGRAM)**\n10 Thực Thể Nghiệp Vụ Cốt Lõi & Các Kiểu Liệt Kê (Enumerations)

enum UserRole #475569 {
    ROLE_EMPLOYEE
    ROLE_HR_ACCOUNTANT
    ROLE_ADMIN
}

enum WorkShiftStatus #475569 {
    PRESENT
    LATE
    EARLY_LEAVE
    HALF_DAY
    ABSENT_WITH_PERMISSION
    ABSENT_UNAUTHORIZED
    HOLIDAY
}

enum LeaveType #475569 {
    ANNUAL_LEAVE
    SICK_LEAVE
    MATERNITY_LEAVE
    UNPAID_LEAVE
}

enum ApprovalStatus #475569 {
    PENDING
    APPROVED
    REJECTED
}

enum PeriodStatus #475569 {
    DRAFT
    CALCULATING
    CALCULATED
    LOCKED
    PAID
}

enum PayslipLineType #475569 {
    BASE_SALARY_PRORATED
    MEAL_ALLOWANCE
    FUEL_ALLOWANCE
    OVERTIME_PAY
    BONUS
    DEDUCTION_BHXH
    DEDUCTION_BHYT
    DEDUCTION_BHTN
    PERSONAL_INCOME_TAX
    PENALTY
}

class Department #EFF6FF {
    - id: Long
    - departmentCode: String
    - departmentName: String
    - managerName: String
    + getActiveEmployees(): List<Employee>
}

class UserAccount #EFF6FF {
    - id: Long
    - username: String
    - passwordHash: String
    - role: UserRole
    - isActive: Boolean
    + changePassword(newPass: String): Boolean
}

class Employee #EFF6FF {
    - id: Long
    - employeeCode: String
    - fullName: String
    - dateOfBirth: LocalDate
    - identityCardNumber: String
    - email: String
    - phoneNumber: String
    - bankAccountNumber: String
    - bankName: String
    - hireDate: LocalDate
    - status: String
    + getActiveContract(): Contract
}

class Contract #EFF6FF {
    - id: Long
    - contractNumber: String
    - contractType: String
    - baseSalary: Double
    - mealAllowance: Double
    - fuelAllowance: Double
    - startDate: LocalDate
    - endDate: LocalDate
    - isActive: Boolean
    + isValidForPeriod(date: LocalDate): Boolean
}

class Timesheet #EFF6FF {
    - id: Long
    - workDate: LocalDate
    - checkInTime: LocalTime
    - checkOutTime: LocalTime
    - actualHoursWorked: Double
    - workShiftStatus: WorkShiftStatus
    - workUnits: Double
    - isLocked: Boolean
    + lockTimesheet(): void
}

class LeaveRequest #EFF6FF {
    - id: Long
    - leaveType: LeaveType
    - startDate: LocalDate
    - endDate: LocalDate
    - totalDays: Double
    - reason: String
    - approvalStatus: ApprovalStatus
    - approvedBy: String
    + isPaidLeave(): Boolean
}

class DeductionRate #FEF3C7 {
    - id: Long
    - rateCode: String
    - employeeRate: Double
    - employerRate: Double
    - effectiveFrom: LocalDate
    - effectiveTo: LocalDate
    - isActive: Boolean
    + calculateEmployeeDeduction(gross: Double): Double
}

class PayrollPeriod #EFF6FF {
    - id: Long
    - periodCode: String
    - periodMonth: Integer
    - periodYear: Integer
    - standardWorkDays: Double
    - status: PeriodStatus
    - totalGrossAmount: Double
    - totalNetAmount: Double
    + canCalculate(): Boolean
    + lock(): void
    + isLocked(): Boolean
}

class Payslip #EFF6FF {
    - id: Long
    - actualWorkDays: Double
    - paidLeaveDays: Double
    - overtimeHours: Double
    - grossSalary: Double
    - totalDeductions: Double
    - netSalary: Double
    + calculateNetSalary(): Double
}

class PayslipLine #EFF6FF {
    - id: Long
    - lineType: PayslipLineType
    - lineDescription: String
    - amount: Double
    - isDeduction: Boolean
}

' Quan hệ phân cấp & liên kết
Department "1" -- "0..*" Employee : có nhân sự >
UserAccount "1" -- "1" Employee : định danh >
Employee "1" -- "0..*" Contract : ký kết >
Employee "1" -- "0..*" Timesheet : ghi nhận >
Employee "1" -- "0..*" LeaveRequest : tạo đơn >
Employee "1" -- "0..*" Payslip : nhận phiếu >

PayrollPeriod "1" -- "0..*" Payslip : chứa >
Payslip "1" *-- "1..*" PayslipLine : cấu thành từ >

' Enums
UserAccount ..> UserRole
Timesheet ..> WorkShiftStatus
LeaveRequest ..> LeaveType
LeaveRequest ..> ApprovalStatus
PayrollPeriod ..> PeriodStatus
PayslipLine ..> PayslipLineType

@enduml
