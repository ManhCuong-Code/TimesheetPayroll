@startuml 10_activity_timesheet_leave
skinparam dpi 220
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam roundCorner 10
skinparam shadowing true

skinparam titleFontName "Segoe UI"
skinparam titleFontSize 16
skinparam titleFontStyle bold
skinparam titleFontColor #0F172A

skinparam activity {
    BackgroundColor #EFF6FF
    BorderColor #2563EB
    FontColor #1E293B
    FontSize 12
    DiamondBackgroundColor #FEF3C7
    DiamondBorderColor #D97706
    DiamondFontColor #78350F
    StartColor #10B981
    EndColor #EF4444
    ArrowColor #2563EB
    ArrowThickness 1.2
}

title **SƠ ĐỒ HOẠT ĐỘNG 01: QUY TRÌNH CHẤM CÔNG & NGHỈ PHÉP (SWIMLANE)**\nPhân làn trách nhiệm giữa Nhân viên, Kế toán HR và Hệ thống

|#EFF6FF|Nhân Viên (Employee)|
|#FEF3C7|Kế Toán / HR (Accountant)|
|#F0FDF4|Hệ Thống Máy Chủ (System)|

|Nhân Viên (Employee)|
start
:Chấm công (Check-in/Check-out) hàng ngày;

|Hệ Thống Máy Chủ (System)|
:Ghi nhận thời gian thực vào bảng Timesheets;
:Tính số giờ làm việc thực tế & đối chiếu ca chuẩn;

|Nhân Viên (Employee)|
if (Có phát sinh đi trễ / xin nghỉ phép?) then (Có)
    :Tạo đơn xin nghỉ phép (LeaveRequest);
    |Kế Toán / HR (Accountant)|
    :Kiểm tra lý do và định mức phép còn lại;
    if (Đơn hợp lệ?) then (Đồng ý)
        :Phê duyệt đơn nghỉ phép;
        |Hệ Thống Máy Chủ (System)|
        :Cập nhật trạng thái công phép (có lương / không lương);
    else (Từ chối)
        |Kế Toán / HR (Accountant)|
        :Từ chối đơn & ghi rõ phản hồi;
        |Hệ Thống Máy Chủ (System)|
        :Ghi nhận công vắng không phép (vắng trừ lương);
    endif
else (Không)
    |Hệ Thống Máy Chủ (System)|
    :Ghi nhận công chuẩn (1.0 công / ngày);
endif

|Kế Toán / HR (Accountant)|
:Cuối tháng: Kiểm tra và khóa bảng chấm công (Timesheet.is_locked = true);
stop

@enduml
