@startuml 06_sequence_login
skinparam dpi 220
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam roundCorner 8
skinparam shadowing true
skinparam BoxPadding 10
autonumber

skinparam titleFontName "Segoe UI"
skinparam titleFontSize 16
skinparam titleFontStyle bold
skinparam titleFontColor #0F172A

title **SƠ ĐỒ TUẦN TỰ 01: XÁC THỰC ĐĂNG NHẬP & PHÂN QUYỀN (JWT AUTHENTICATION & RBAC)**\n(Kiến trúc Spring Security + JWT Token + PostgreSQL)

box "Client Tier" #EFF6FF
    actor "Người Dùng\n(NV / Kế Toán)" as User #EEF2FF
    boundary "Giao Diện Đăng Nhập\n(Login Web UI)" as UI #FFFFFF
end box

box "Backend API Tier (Spring Boot 3.2)" #FAF5FF
    control "AuthController" as AuthCtrl #FFFFFF
    control "AuthService" as AuthSvc #FFFFFF
    control "PasswordEncoder" as Crypt #FFFFFF
    control "JwtTokenProvider" as Jwt #FFFFFF
end box

box "Data Access & Persistence Tier" #F0FDF4
    entity "UserRepository" as UserRepo #FFFFFF
    database "PostgreSQL Database\n(user_accounts)" as DB #FFFFFF
end box

User -> UI: Nhập Username & Password -> Bấm "Đăng Nhập"
UI -> AuthCtrl: POST /api/auth/login {username, password}
activate AuthCtrl

AuthCtrl -> AuthSvc: authenticate(loginRequest)
activate AuthSvc

AuthSvc -> UserRepo: findByUsername(username)
activate UserRepo
UserRepo -> DB: SELECT * FROM user_accounts WHERE username = ?
DB --> UserRepo: Trả về bản ghi UserAccount (kèm Hash & Role)
UserRepo --> AuthSvc: UserAccount entity
deactivate UserRepo

alt Tài khoản không tồn tại hoặc bị khóa
    AuthSvc --> AuthCtrl: Ném BadCredentialsException
    AuthCtrl --> UI: 401 Unauthorized ("Tài khoản hoặc mật khẩu không chính xác")
    UI --> User: Cảnh báo đăng nhập thất bại
else Tài khoản hợp lệ
    AuthSvc -> Crypt: matches(rawPassword, passwordHash)
    activate Crypt
    Crypt --> AuthSvc: Mật khẩu chính xác (true)
    deactivate Crypt

    AuthSvc -> Jwt: generateToken(user.getId(), user.getRole())
    activate Jwt
    Jwt --> AuthSvc: Chuỗi JWT AccessToken (kèm Claim: Role, Exp: 24h)
    deactivate Jwt

    AuthSvc --> AuthCtrl: LoginResponseDTO (token, role, fullName, empId)
    AuthCtrl --> UI: 200 OK + JWT Token & User Profile
    
    UI -> UI: Lưu Token vào LocalStorage / Secure Cookie
    alt Role == 'ROLE_EMPLOYEE'
        UI --> User: Điều hướng tới Trang cá nhân (Bảng công & Phiếu lương)
    else Role == 'ROLE_HR_ACCOUNTANT' hoặc 'ROLE_ADMIN'
        UI --> User: Điều hướng tới Dashboard Quản trị & Bảng tính lương
    end
end

deactivate AuthSvc
deactivate AuthCtrl

@enduml
