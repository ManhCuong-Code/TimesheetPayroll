@startuml 09_activity_swimlane
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam roundCorner 8

title **SƠ ĐỒ HOẠT ĐỘNG PHÂN LÀN TRÁCH NHIỆM (SWIMLANE ACTIVITY DIAGRAM)**\nQuy trình toàn diện từ Chấm công hàng ngày đến Quyết toán lương cuối tháng

|#E0F2FE|Nhân Viên (Employee)|
|#FEF3C7|Kế Toán / HR (Accountant)|
|#F0FDF4|Hệ Thống Máy Chủ (System)|

|Nhân Viên (Employee)|
start
:Chấm công (Check-in/Check-out) hàng ngày;

|Hệ Thống Máy Chủ (System)|
:Ghi nhận thời gian thực vào bảng Timesheet;
:Tính số giờ làm việc & đối chiếu ca làm việc;

|Nhân Viên (Employee)|
if (Có phát sinh đi trễ / xin nghỉ phép?) then (Có)
    :Tạo đơn xin nghỉ phép trên hệ thống;
    |Kế Toán / HR (Accountant)|
    :Kiểm tra đơn nghỉ phép;
    if (Hợp lệ?) then (Đồng ý)
        :Duyệt đơn nghỉ phép;
        |Hệ Thống Máy Chủ (System)|
        :Cập nhật trạng thái công phép (có lương/không lương);
    else (Từ chối)
        |Kế Toán / HR (Accountant)|
        :Từ chối đơn & ghi rõ lý do;
        |Hệ Thống Máy Chủ (System)|
        :Ghi nhận công vắng không phép;
    endif
else (Không)
    |Hệ Thống Máy Chủ (System)|
    :Ghi nhận công đủ chuẩn (1.0 công);
endif

|Kế Toán / HR (Accountant)|
:Cuối tháng: Kiểm tra và chốt bảng chấm công toàn công ty;
:Bấm nút "Tính Lương Tự Động" (Batch Calculate);

|Hệ Thống Máy Chủ (System)|
:Khởi tạo Transaction tài chính;
:Đọc dữ liệu tổng ngày công từ Timesheet;
:Đọc thông tin lương cơ bản & phụ cấp từ Hợp đồng;
:Áp dụng bảng tỷ lệ khấu trừ (BHXH 8%, BHYT 1.5%, BHTN 1%);
:Tính lương thực lĩnh = (Lương CB * Ngày làm / Chuẩn) + Phụ cấp - Khấu trừ;
:Ghi vào bảng Payslip & PayslipLine;

if (Toàn bộ 50 nhân viên tính hợp lệ?) then (Thành công)
    :Commit Transaction & Cập nhật trạng thái CALCULATED;
    |Kế Toán / HR (Accountant)|
    :Xem trước bảng tổng hợp lương;
    if (Số liệu khớp thực tế?) then (Đồng ý)
        :Bấm nút "Chốt Kỳ Lương & Xuất File Ngân Hàng";
        |Hệ Thống Máy Chủ (System)|
        :Khóa sổ kỳ lương (Status = LOCKED);
        :Chuyển bảng công & phiếu lương sang chế độ Chỉ đọc;
        :Sinh file Excel lệnh chuyển khoản ngân hàng;
        :Gửi thông báo phát hành phiếu lương đến nhân viên;
        |Nhân Viên (Employee)|
        fork
            :Mở ứng dụng xem phiếu lương cá nhân (bảo mật);
        fork again
            :Trò chuyện với AI nếu có thắc mắc về các khoản trừ;
        end fork
    else (Cần sửa dữ liệu)
        |Kế Toán / HR (Accountant)|
        :Điều chỉnh lại dữ liệu công hoặc phụ cấp;
        |Hệ Thống Máy Chủ (System)|
        :Chạy lại chức năng tính lương;
    endif
else (Lỗi hệ thống)
    |Hệ Thống Máy Chủ (System)|
    :Rollback Transaction hủy bỏ toàn bộ;
    |Kế Toán / HR (Accountant)|
    :Nhận cảnh báo lỗi chi tiết để xử lý;
endif

stop
@enduml
