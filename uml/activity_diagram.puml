@startuml activity_diagram
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam roundCorner 8

start

:Nhân viên điểm danh / chấm công mỗi ngày;
:Hệ thống tự động ghi nhận vào Timesheet;

if (Có phát sinh xin nghỉ phép / đi trễ?) then (Có)
    :Nhân viên gửi đơn xin phép;
    :Quản lý / HR duyệt trạng thái công phép;
else (Không)
    :Ghi nhận công chuẩn;
endif

:Cuối tháng: Kế toán rà soát & duyệt chốt bảng công;

:Kế toán bấm nút "Tính Lương Tự Động";

partition "Hệ Thống Tính Toán Tự Động" {
    :Kiểm tra ngày công chuẩn trong tháng;
    :Lấy mức lương cơ bản & phụ cấp từ Hợp đồng;
    :Tính tiền công thực tế = (Lương CB * Ngày làm / Chuẩn);
    :Cộng các khoản phụ cấp (ăn trưa, gửi xe);
    :Tính trừ BHXH (8%), BHYT (1.5%), BHTN (1%);
    :Tính tạm nộp thuế TNCN (nếu vượt ngưỡng);
    :Xác định Lương thực lĩnh (Net Salary);
    :Tạo Phiếu lương & Dòng chi tiết (PayslipLine);
}

if (Số liệu tính toán chính xác & hợp lệ?) then (Đạt)
    :Kế toán bấm "Chốt Kỳ Lương";
    :Hệ thống khóa sổ vĩnh viễn (Read-only);
    :Xuất file danh sách chuyển khoản gửi Ngân hàng;
    :Phát hành Phiếu lương cá nhân cho từng nhân viên;
    fork
        :Nhân viên nhận & mở xem phiếu lương bảo mật;
    fork again
        :Nhân viên có thể hỏi Trợ lý AI về các khoản trừ;
    end fork
else (Có sai sót dữ liệu)
    :Kế toán chỉnh sửa lại bảng công hoặc hợp đồng;
    :Chạy lại chức năng tính lương;
endif

stop
@enduml
