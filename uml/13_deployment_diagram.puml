@startuml 13_deployment_diagram
skinparam dpi 220
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam roundCorner 8
skinparam shadowing true

skinparam titleFontName "Segoe UI"
skinparam titleFontSize 16
skinparam titleFontStyle bold
skinparam titleFontColor #0F172A

skinparam node {
    BackgroundColor #FFFFFF
    BorderColor #2563EB
    FontColor #0F172A
    FontSize 12
    ArrowColor #2563EB
    ArrowThickness 1.2
}

title **SƠ ĐỒ TRIỂN KHAI HỆ THỐNG (DEPLOYMENT DIAGRAM)**\nKiến trúc phần cứng, hạ tầng mạng & công nghệ .NET 10 Blazor + SQL Server

node "Thiết Bị Người Dùng (Client Tier)" #EFF6FF {
    node "PC / Laptop (Kế toán & Quản trị)" as PC #FFFFFF {
        artifact "Web Browser (Chrome/Edge)\n[Blazor Interactive Server UI]" as PC_Browser #F8FAFC
    }
    node "Smartphone (Nhân viên di động)" as Mobile #FFFFFF {
        artifact "Mobile Browser (Safari/Chrome)\n[Responsive Web 390px - Chấm công & Lương]" as Mobile_Browser #F8FAFC
    }
}

cloud "Mạng Internet / Mạng Nội Bộ (LAN / HTTPS)" as Net #F1F5F9

node "Máy Chủ Ứng Dụng (Application Server)" as AppServer #F8FAFC {
    node "Kestrel Web Server (.NET 10 Core)" as Kestrel #ECFDF5 {
        artifact "TimesheetPayroll.Web.dll\n[Blazor Server + SignalR WebSocket]\n- TopNavbar & Responsive Layout\n- AuthorizeRouteView (Chặn URL 403)\n- Floating AI Assistant Component" as WebApp #FFFFFF
    }

    node "Clean Architecture Service Container" as DotNetCore #FAF5FF {
        artifact "TimesheetPayroll.UseCases.dll\n- CalculatePayrollBatchUseCase\n- LockPayrollPeriodUseCase\n- ExportPayrollExcelUseCase\n- AskSalaryAiUseCase" as UseCases #FFFFFF

        artifact "TimesheetPayroll.CoreBusiness.dll\n- SalaryFormulaEngine (TT111/Luật BHXH)\n- PayrollCalculationService\n- LlmClient & Grounded Engine" as CoreBus #FFFFFF

        artifact "TimesheetPayroll.DataStore.SQL.Dapper.dll\n- Dapper Micro-ORM (Parameterized SQL)\n- ADO.NET SqlTransaction (ACID Safety)\n- BCrypt.Net Password Hashing" as DapperPlugin #FFFFFF
    }
}

node "Máy Chủ Cơ Sở Dữ Liệu (Database Server)" as DBServer #F0FDF4 {
    database "Microsoft SQL Server 2022 / Express\n(BangChamCongDB)" as RDBMS #FFFFFF {
        artifact "11 Bảng CSDL Chuẩn 3NF\n- departments, employees, user_accounts\n- contracts, payroll_periods, deduction_rates\n- work_shifts, timesheets, leave_requests\n- payslips, payslip_lines" as Schema #F8FAFC
    }
}

cloud "Dịch Vụ AI Đám Mây (Google Cloud / AI Studio)" as CloudAI #FDF2F8 {
    node "Google AI Studio API Gateway" as AICloudNode #FFFFFF {
        artifact "Gemini 2.0 Flash / Pro API\n[Large Language Model Engine]" as LLM_API #F8FAFC
    }
}

' Kết nối mạng
PC_Browser --> Net : HTTPS / WSS SignalR (Port 443 / 5001)
Mobile_Browser --> Net : HTTPS / WSS SignalR (Port 443 / 5001)

Net --> Kestrel : HTTPS / WSS (Port 443 / 5001)
Kestrel --> WebApp : Render UI & Xử lý sự kiện Interactive Server
WebApp --> UseCases : Gọi Ca sử dụng qua Interface DI
UseCases --> CoreBus : Thực thi Luật nghiệp vụ & Tính toán
UseCases --> DapperPlugin : Truy xuất dữ liệu qua Interface IRepositories

DapperPlugin --> RDBMS : TCP/IP TDS Protocol (Port 1433)
CoreBus --> LLM_API : HTTPS TLS 1.3 REST API (Port 443)

@enduml
