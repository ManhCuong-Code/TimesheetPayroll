@startuml 13_deployment_diagram
skinparam dpi 220
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam roundCorner 8
skinparam shadowing true

skinparam titleFontName "Segoe UI"
skinparam titleFontSize 16
skinparam titleFontStyle bold
skinparam titleFontColor #0F172A

skinparam node {
    BackgroundColor #FFFFFF
    BorderColor #2563EB
    FontColor #0F172A
    FontSize 12
    ArrowColor #2563EB
    ArrowThickness 1.2
}

title **SƠ ĐỒ TRIỂN KHAI HỆ THỐNG (DEPLOYMENT DIAGRAM)**\nKiến trúc phần cứng, hạ tầng mạng & các thành phần công nghệ thống nhất

node "Thiết Bị Người Dùng (Client Devices)" #EFF6FF {
    node "PC / Laptop (Kế toán & Quản trị)" as PC #FFFFFF {
        artifact "Web Browser (Chrome/Edge)\n[React SPA Web Application]" as PC_Browser #F8FAFC
    }
    node "Smartphone (Nhân viên)" as Mobile #FFFFFF {
        artifact "Mobile Browser / PWA\n[Giao diện chấm công & Tra cứu lương]" as Mobile_Browser #F8FAFC
    }
}

cloud "Mạng Internet / Mạng Nội Bộ (LAN/VPN)" as Net #F1F5F9

node "Máy Chủ Ứng Dụng (Application Server - Ubuntu Linux 22.04 LTS)" as AppServer #F8FAFC {
    node "Nginx Web Server & Reverse Proxy" as Nginx #ECFDF5 {
        artifact "Static Web Bundle\n(HTML5, CSS3, JavaScript SPA)" as StaticFiles #FFFFFF
    }

    node "Java Runtime Environment (OpenJDK 17/21)" as JRE #FAF5FF {
        artifact "payroll-service.jar\n[Java Spring Boot 3.2 Framework]\n- Spring Security & JWT Auth\n- Spring Data JPA\n- Batch Payroll Calculation Engine" as CoreAPI #FFFFFF
    }

    node "Python Runtime (Python 3.11)" as PyEnv #FEF3C7 {
        artifact "ai_assistant_service.py\n[Python FastAPI Framework]\n- Prompt Grounding Engine\n- Salary Comparison Logic" as AIAgent #FFFFFF
    }
}

node "Máy Chủ Cơ Sở Dữ Liệu (Database Server)" as DBServer #F0FDF4 {
    database "PostgreSQL 16 Database Server" as RDBMS #FFFFFF {
        artifact "payroll_db\n- 10 bảng nghiệp vụ cốt lõi\n- ACID Transaction Engine\n- B-Tree Indexes & Foreign Keys" as Schema #F8FAFC
    }
}

cloud "Dịch Vụ AI Đám Mây (Google Cloud)" as CloudAI #FDF2F8 {
    node "Google Cloud Vertex AI / AI Studio" as AICloudNode #FFFFFF {
        artifact "Gemini 1.5 Pro API\n[Large Language Model Engine]" as LLM_API #F8FAFC
    }
}

' Kết nối mạng
PC_Browser --> Net : HTTPS (Port 443)
Mobile_Browser --> Net : HTTPS (Port 443)

Net --> Nginx : HTTPS Request (Port 443)
Nginx --> StaticFiles : Phục vụ giao diện người dùng
Nginx --> CoreAPI : Reverse Proxy /api/* (Port 8080)

CoreAPI --> RDBMS : JDBC Connection Pool HikariCP (Port 5432)
CoreAPI --> AIAgent : HTTP POST /v1/ai/* (Port 8000)
AIAgent --> LLM_API : HTTPS TLS 1.3 (Port 443)

@enduml
