@startuml 11_deployment_diagram
!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam roundCorner 8
skinparam node {
    BackgroundColor #F8FAFC
    BorderColor #2563EB
}

title **SƠ ĐỒ TRIỂN KHAI HỆ THỐNG (DEPLOYMENT DIAGRAM)**\nKiến trúc phần cứng, hạ tầng mạng & các thành phần thực thi

node "Thiết Bị Người Dùng (Client Devices)" {
    node "PC / Laptop (Kế toán & Quản trị)" as PC {
        artifact "Web Browser (Chrome/Edge)\n[React / Vue / HTML5-CSS3-JS]" as PC_Browser
    }
    node "Smartphone (Nhân viên)" as Mobile {
        artifact "Mobile Browser / PWA\n[Giao diện chấm công & Tra cứu lương]" as Mobile_Browser
    }
}

cloud "Mạng Internet / Mạng Nội Bộ (LAN/VPN)" as Net

node "Máy Chủ Ứng Dụng (Application Server - Ubuntu Linux)" as AppServer {
    node "Nginx Reverse Proxy & Web Server" as Nginx {
        artifact "Static Web Files\n(HTML, CSS, JS, Assets)" as StaticFiles
    }

    node "Backend Runtime (Java Spring Boot / Node.js)" as Backend {
        artifact "Payroll-Core-API.jar\n(REST API, JWT Security, Batch Engine)" as CoreAPI
    }

    node "AI Microservice (Python Runtime)" as AIService {
        artifact "ai_agent_service.py\n(LangChain / Prompt Engine)" as AIAgent
    }
}

node "Máy Chủ Cơ Sở Dữ Liệu (Database Server)" as DBServer {
    database "PostgreSQL / MySQL 8.0" as RDBMS {
        artifact "payroll_db\n(8 bảng cốt lõi, ACID Transactions, Foreign Keys)" as Schema
    }
}

cloud "Dịch Vụ AI Đám Mây (Cloud AI Provider)" as CloudAI {
    node "Google Cloud / OpenAI" as AICloudNode {
        artifact "Gemini 1.5 Pro / GPT-4o Mini API" as LLM_API
    }
}

' Kết nối mạng
PC_Browser --> Net : HTTPS (Port 443)
Mobile_Browser --> Net : HTTPS (Port 443)

Net --> Nginx : Reverse Proxy (Port 443)
Nginx --> StaticFiles : Phục vụ giao diện
Nginx --> CoreAPI : Proxy /api/* (Port 8080)

CoreAPI --> RDBMS : JDBC Connection Pool (Port 5432 / 3306)
CoreAPI --> AIAgent : HTTP POST /v1/ai (Port 5000)
AIAgent --> LLM_API : HTTPS REST API (Port 443)

@enduml
