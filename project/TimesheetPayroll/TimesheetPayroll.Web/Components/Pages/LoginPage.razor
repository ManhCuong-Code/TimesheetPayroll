@page "/login"
@using System.ComponentModel.DataAnnotations
@inject ILoginUseCase LoginUseCase
@inject IUserSessionService UserSession
@inject NavigationManager NavManager

<PageTitle>Đăng Nhập - HỆ THỐNG QUẢN LÝ NHÂN SỰ – CHẤM CÔNG – TÍNH LƯƠNG</PageTitle>

<div class="container py-4">
    <!-- ENTERPRISE IDENTITY HEADER -->
    <div class="row justify-content-center mb-4">
        <div class="col-lg-10">
            <div class="card border-0 shadow-sm text-white p-4 rounded-4 hero-corporate">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="badge bg-primary px-3 py-1 fw-bold">
                                <i class="fa-solid fa-shield-halved me-1"></i>CỔNG XÁC THỰC DOANH NGHIỆP
                            </span>
                            <span class="badge bg-white bg-opacity-10 text-white px-2 py-1">
                                <i class="fa-solid fa-lock me-1"></i>Mã hóa BCrypt & SSL
                            </span>
                        </div>
                        <h2 class="h3 fw-bold mb-1 tracking-tight">HỆ THỐNG QUẢN TRỊ NHÂN SỰ & TIỀN LƯƠNG TẬP TRUNG</h2>
                        <p class="mb-0 text-white-50 small">
                            Đăng nhập an toàn để điểm danh chấm công hàng ngày, theo dõi ngày phép và tra cứu phiếu lương bảo mật.
                        </p>
                    </div>
                    <div class="col-md-4 text-md-end mt-3 mt-md-0">
                        <span class="badge bg-success bg-opacity-25 text-white border border-success border-opacity-50 px-3 py-2 fw-semibold">
                            <i class="fa-solid fa-server me-1"></i>Hệ thống: Trực tuyến 24/7
                        </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- KHUNG ĐĂNG NHẬP & PHÂN QUYỀN DEMO -->
    <div class="row justify-content-center g-4">
        <!-- FORM ĐĂNG NHẬP CHÍNH -->
        <div class="col-lg-5 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-4 bg-white">
                <div class="text-center mb-4">
                    <div class="bg-primary-subtle text-primary rounded-circle d-inline-flex p-3 mb-2" style="width: 58px; height: 58px; align-items:center; justify-content:center;">
                        <i class="fa-solid fa-user-shield fa-2x"></i>
                    </div>
                    <h4 class="fw-bold text-dark mb-1">Đăng Nhập Tài Khoản</h4>
                    <p class="text-muted small mb-0">Nhập tên người dùng và mật khẩu được cấp</p>
                </div>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger alert-dismissible fade show small py-2" role="alert">
                        <i class="fa-solid fa-triangle-exclamation me-1"></i> @errorMessage
                        <button type="button" class="btn-close btn-sm" @onclick="() => errorMessage = string.Empty"></button>
                    </div>
                }

                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <div class="alert alert-success alert-dismissible fade show small py-2" role="alert">
                        <i class="fa-solid fa-circle-check me-1"></i> @successMessage
                    </div>
                }

                <EditForm Model="@loginModel" OnValidSubmit="HandleLoginAsync">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label small fw-semibold text-secondary">Tên đăng nhập (Username) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-user text-muted"></i></span>
                            <InputText class="form-control border-start-0" placeholder="vd: nhanvien.a, ketoan.thao..." @bind-Value="loginModel.Username" />
                        </div>
                        <ValidationMessage For="@(() => loginModel.Username)" class="text-danger small mt-1" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-semibold text-secondary">Mật khẩu (Password) <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="fa-solid fa-key text-muted"></i></span>
                            <InputText type="@(showPassword ? "text" : "password")" class="form-control border-start-0 border-end-0" placeholder="••••••••" @bind-Value="loginModel.Password" />
                            <button type="button" class="btn btn-light border border-start-0" @onclick="() => showPassword = !showPassword">
                                <i class="fa-solid @(showPassword ? "fa-eye-slash" : "fa-eye") text-muted"></i>
                            </button>
                        </div>
                        <ValidationMessage For="@(() => loginModel.Password)" class="text-danger small mt-1" />
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 shadow-sm mb-3" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span>Đang xác thực thông tin...</span>
                        }
                        else
                        {
                            <i class="fa-solid fa-right-to-bracket me-2"></i>
                            <span>Đăng Nhập Hệ Thống</span>
                        }
                    </button>

                    <div class="text-center">
                        <span class="text-muted small">
                            <i class="fa-solid fa-circle-info me-1"></i>Mật khẩu mặc định hệ thống nội bộ: <code>123456</code>
                        </span>
                    </div>
                </EditForm>
            </div>
        </div>

        <!-- PHÂN HỆ CHUYỂN ĐỔI VAI TRÒ (RBAC DEMO) -->
        <div class="col-lg-5 col-md-6">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-4 bg-white">
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-success-subtle text-success rounded-circle p-2 me-2 d-inline-flex align-items-center justify-content-center" style="width:36px; height:36px;">
                        <i class="fa-solid fa-users-gear"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0 text-dark">Chuyển Đổi Nhanh Theo Vai Trò</h5>
                        <small class="text-muted">Chọn nhân sự để kiểm tra luồng nghiệp vụ tương ứng</small>
                    </div>
                </div>

                <div class="d-flex flex-column gap-2">
                    <!-- TÀI KHOẢN NHÂN VIÊN A -->
                    <button class="btn btn-white text-start p-3 border rounded-3 shadow-sm card-hover d-flex align-items-center justify-content-between"
                            @onclick='() => QuickLoginAsync("nhanvien.a", "123456")' disabled="@isLoading">
                        <div class="d-flex align-items-center">
                            <div class="bg-primary-subtle text-primary rounded-circle p-2 me-3 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                                <i class="fa-solid fa-user"></i>
                            </div>
                            <div>
                                <div class="fw-bold text-dark">Nguyễn Văn A</div>
                                <div class="small text-muted"><code>nhanvien.a</code> • Kỹ sư phần mềm (IT)</div>
                            </div>
                        </div>
                        <span class="badge bg-primary-subtle text-primary border border-primary border-opacity-25">Nhân Viên</span>
                    </button>

                    <!-- TÀI KHOẢN QUẢN LÝ NAM -->
                    <button class="btn btn-white text-start p-3 border rounded-3 shadow-sm card-hover d-flex align-items-center justify-content-between"
                            @onclick='() => QuickLoginAsync("quanly.nam", "123456")' disabled="@isLoading">
                        <div class="d-flex align-items-center">
                            <div class="bg-info-subtle text-info rounded-circle p-2 me-3 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                                <i class="fa-solid fa-user-tie"></i>
                            </div>
                            <div>
                                <div class="fw-bold text-dark">Phạm Hoàng Nam</div>
                                <div class="small text-muted"><code>quanly.nam</code> • Trưởng phòng Kinh Doanh</div>
                            </div>
                        </div>
                        <span class="badge bg-info-subtle text-info border border-info border-opacity-25">Quản Lý Bộ Phận</span>
                    </button>

                    <!-- TÀI KHOẢN KẾ TOÁN THẢO -->
                    <button class="btn btn-white text-start p-3 border rounded-3 shadow-sm card-hover d-flex align-items-center justify-content-between"
                            @onclick='() => QuickLoginAsync("ketoan.thao", "123456")' disabled="@isLoading">
                        <div class="d-flex align-items-center">
                            <div class="bg-warning-subtle text-warning rounded-circle p-2 me-3 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                                <i class="fa-solid fa-calculator"></i>
                            </div>
                            <div>
                                <div class="fw-bold text-dark">Lê Thị Thu Thảo</div>
                                <div class="small text-muted"><code>ketoan.thao</code> • Trưởng phòng Kế toán & HR</div>
                            </div>
                        </div>
                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning border-opacity-25">Kế Toán Trưởng</span>
                    </button>

                    <!-- TÀI KHOẢN QUẢN TRỊ TRỌNG -->
                    <button class="btn btn-white text-start p-3 border rounded-3 shadow-sm card-hover d-flex align-items-center justify-content-between"
                            @onclick='() => QuickLoginAsync("admin.trong", "123456")' disabled="@isLoading">
                        <div class="d-flex align-items-center">
                            <div class="bg-danger-subtle text-danger rounded-circle p-2 me-3 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                                <i class="fa-solid fa-shield-halved"></i>
                            </div>
                            <div>
                                <div class="fw-bold text-dark">Trần Đình Trọng</div>
                                <div class="small text-muted"><code>admin.trong</code> • Giám đốc CNTT (IT)</div>
                            </div>
                        </div>
                        <span class="badge bg-danger-subtle text-danger border border-danger border-opacity-25">Quản Trị Viên</span>
                    </button>

                    <!-- TÀI KHOẢN NHÂN VIÊN TUẤN -->
                    <button class="btn btn-white text-start p-3 border rounded-3 shadow-sm card-hover d-flex align-items-center justify-content-between"
                            @onclick='() => QuickLoginAsync("nhanvien.tuan", "123456")' disabled="@isLoading">
                        <div class="d-flex align-items-center">
                            <div class="bg-info-subtle text-info rounded-circle p-2 me-3 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                                <i class="fa-solid fa-user-tag"></i>
                            </div>
                            <div>
                                <div class="fw-bold text-dark">Hoàng Minh Tuấn</div>
                                <div class="small text-muted"><code>nhanvien.tuan</code> • Chuyên viên Kinh doanh</div>
                            </div>
                        </div>
                        <span class="badge bg-secondary-subtle text-secondary border border-secondary border-opacity-25">Nhân Viên</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    public class LoginViewModel
    {
        [Required(ErrorMessage = "Vui lòng nhập tên đăng nhập.")]
        [StringLength(50, MinimumLength = 3, ErrorMessage = "Tên đăng nhập phải từ 3 đến 50 ký tự.")]
        public string Username { get; set; } = "nhanvien.a";

        [Required(ErrorMessage = "Vui lòng nhập mật khẩu.")]
        [MinLength(4, ErrorMessage = "Mật khẩu tối thiểu 4 ký tự.")]
        public string Password { get; set; } = "123456";
    }

    private LoginViewModel loginModel = new();
    private bool showPassword = false;
    private bool isLoading = false;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;

    private async Task QuickLoginAsync(string u, string p)
    {
        loginModel.Username = u;
        loginModel.Password = p;
        await HandleLoginAsync();
    }

    private async Task HandleLoginAsync()
    {
        errorMessage = string.Empty;
        successMessage = string.Empty;
        isLoading = true;

        try
        {
            var user = await LoginUseCase.ExecuteAsync(loginModel.Username, loginModel.Password);
            if (user == null)
            {
                errorMessage = "Tên đăng nhập hoặc mật khẩu không chính xác, hoặc tài khoản đã bị vô hiệu hóa!";
                return;
            }

            await UserSession.SignInAsync(user);
            successMessage = $"Đăng nhập thành công! Xin chào {user.FullName ?? user.Username}.";

            // BẮT BUỘC: Sau mỗi lần đăng nhập thành công, luôn chuyển về Trang Chủ (/) cho tất cả vai trò
            NavManager.NavigateTo("/");
        }
        catch (Exception ex)
        {
            errorMessage = $"Lỗi kết nối cơ sở dữ liệu: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
