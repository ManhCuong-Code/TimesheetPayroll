@page "/"
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using TimesheetPayroll.CoreBusiness.Models
@using TimesheetPayroll.UseCases.Authentication
@using TimesheetPayroll.UseCases.PluginInterfaces.DataStore
@inject IUserSessionService UserSession
@inject IEmployeeRepository EmployeeRepo
@inject ITimesheetRepository TimesheetRepo
@inject IAttendanceRequestRepository AttendanceRequestRepo
@inject ILeaveRequestRepository LeaveRequestRepo
@inject IPayrollPeriodRepository PayrollPeriodRepo
@inject IWorkShiftRepository WorkShiftRepo
@inject NavigationManager NavManager

<PageTitle>Tổng Quan - HỆ THỐNG QUẢN LÝ NHÂN SỰ – CHẤM CÔNG – TÍNH LƯƠNG</PageTitle>

<div class="container-fluid px-3 px-lg-4 py-3">

    <!-- ========================================================================= -->
    <!-- KHU VỰC 1: TIÊU ĐỀ RÚT GỌN & THAO TÁC NHANH (HEADER & ACTIONS)            -->
    <!-- ========================================================================= -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 fw-bold">
                    <i class="fa-solid fa-chart-line me-1"></i>DASHBOARD QUẢN TRỊ
                </span>
                <span class="text-muted small">
                    <i class="fa-solid fa-building me-1"></i>CÔNG TY TNHH HỆ THỐNG QUẢN TRỊ DOANH NGHIỆP
                </span>
            </div>
            <h1 class="h3 fw-bold text-dark mb-0">Tổng quan nhân sự</h1>
            <p class="text-muted small mb-0 mt-1">
                <i class="fa-regular fa-calendar-days me-1 text-primary"></i>
                Tháng @currentMonth/@currentYear • Tình hình nhân sự và chấm công
                @if (!string.IsNullOrEmpty(userRoleDisplay))
                {
                    <span class="ms-2 badge bg-light text-dark border">
                        <i class="fa-solid fa-user-shield me-1 text-secondary"></i>@userRoleDisplay
                    </span>
                }
            </p>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-2">
            <!-- NÚT LÀM MỚI DỮ LIỆU -->
            <button class="btn btn-sm btn-outline-secondary shadow-sm" @onclick="LoadDashboardDataAsync" disabled="@isLoading" title="Tải lại số liệu">
                <i class="fa-solid fa-arrows-rotate me-1 @(isLoading ? "fa-spin" : "")"></i>
                <span>@(isLoading ? "Đang tải..." : "Làm mới")</span>
            </button>

            <!-- THAO TÁC NHANH DÀNH CHO ADMIN / QUẢN LÝ / KẾ TOÁN -->
            @if (canManage)
            {
                <a href="/admin/attendance-approval" class="btn btn-sm btn-outline-primary shadow-sm" title="Duyệt chấm công thủ công">
                    <i class="fa-solid fa-clock-rotate-left me-1"></i>Duyệt Chấm Công
                    @if (pendingAttendanceCount > 0)
                    {
                        <span class="badge bg-danger rounded-pill ms-1">@pendingAttendanceCount</span>
                    }
                </a>
                <a href="/admin/leave-approval" class="btn btn-sm btn-outline-info shadow-sm" title="Duyệt đơn nghỉ phép">
                    <i class="fa-solid fa-calendar-check me-1"></i>Duyệt Nghỉ Phép
                    @if (pendingLeaveCount > 0)
                    {
                        <span class="badge bg-danger rounded-pill ms-1">@pendingLeaveCount</span>
                    }
                </a>
                <a href="/my-timesheet" class="btn btn-sm btn-primary shadow-sm text-white" title="Bảng chấm công tổng hợp">
                    <i class="fa-solid fa-table-list me-1"></i>Bảng Chấm Công
                </a>
                @if (isAdmin || isAccountant)
                {
                    <a href="/admin/payroll-calculation" class="btn btn-sm btn-outline-success shadow-sm" title="Quyết toán lương">
                        <i class="fa-solid fa-calculator me-1"></i>Quyết Toán Lương
                    </a>
                }
            }
            else
            {
                <!-- THAO TÁC NHANH DÀNH CHO NHÂN VIÊN -->
                <a href="/face-checkin" class="btn btn-sm btn-success shadow-sm text-white">
                    <i class="fa-solid fa-camera me-1"></i>Điểm Danh Khuôn Mặt
                </a>
                <a href="/my-timesheet" class="btn btn-sm btn-primary shadow-sm text-white">
                    <i class="fa-solid fa-fingerprint me-1"></i>Chấm Công Của Tôi
                </a>
                <a href="/my-attendance-requests" class="btn btn-sm btn-outline-primary shadow-sm">
                    <i class="fa-solid fa-file-pen me-1"></i>Chấm Công Bù
                </a>
                <a href="/leave-request" class="btn btn-sm btn-outline-info shadow-sm">
                    <i class="fa-solid fa-calendar-plus me-1"></i>Xin Nghỉ Phép
                </a>
                <a href="/my-payslip" class="btn btn-sm btn-outline-success shadow-sm">
                    <i class="fa-solid fa-file-invoice-dollar me-1"></i>Phiếu Lương
                </a>
            }
        </div>
    </div>

    @if (isLoading)
    {
        <!-- TRẠNG THÁI ĐANG TẢI DỮ LIỆU -->
        <div class="card border-0 shadow-sm p-5 text-center my-4">
            <div class="spinner-border text-primary mx-auto mb-3" role="status">
                <span class="visually-hidden">Đang tải...</span>
            </div>
            <h6 class="fw-semibold text-muted">Đang tổng hợp số liệu nhân sự và chấm công...</h6>
            <p class="small text-muted mb-0">Hệ thống đang truy xuất dữ liệu từ máy chủ.</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <!-- BÁO LỖI NẾU CÓ TRỤC TRẶC KẾT NỐI -->
        <div class="alert alert-danger shadow-sm border-0 d-flex align-items-center mb-4" role="alert">
            <i class="fa-solid fa-circle-exclamation fs-4 me-3 text-danger"></i>
            <div>
                <div class="fw-bold">Lỗi truy xuất dữ liệu Dashboard</div>
                <div class="small">@errorMessage</div>
            </div>
            <button class="btn btn-sm btn-outline-danger ms-auto" @onclick="LoadDashboardDataAsync">Thử lại</button>
        </div>
    }
    else
    {
        <!-- ========================================================================= -->
        <!-- KHU VỰC 2: 5 THẺ THỐNG KÊ QUAN TRỌNG (TOP 5 KPI CARDS)                    -->
        <!-- ========================================================================= -->
        <div class="row g-3 mb-4">

            <!-- THẺ 1: TỔNG NHÂN SỰ -->
            <div class="col-xl col-md-4 col-sm-6">
                <div class="card h-100 border-0 shadow-sm p-3 card-hover bg-white border-start border-primary border-4">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small fw-semibold text-uppercase">
                            @(canManage ? "Tổng nhân sự" : "Thông tin cá nhân")
                        </span>
                        <div class="bg-primary-subtle text-primary rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                            <i class="fa-solid fa-users fs-6"></i>
                        </div>
                    </div>
                    <div class="d-flex align-items-baseline gap-2">
                        <span class="display-6 fw-bold text-dark">
                            @(canManage ? totalActiveEmployees : 1)
                        </span>
                        <span class="text-muted small">nhân sự</span>
                    </div>
                    <div class="mt-2 text-muted" style="font-size: 0.8rem;">
                        @if (canManage)
                        {
                            <span class="text-success fw-semibold">
                                <i class="fa-solid fa-circle-check me-1"></i>Hồ sơ đang hoạt động
                            </span>
                        }
                        else
                        {
                            <span class="text-primary fw-semibold">
                                <i class="fa-solid fa-id-badge me-1"></i>@currentUser?.FullName
                            </span>
                        }
                    </div>
                </div>
            </div>

            <!-- THẺ 2: CÓ MẶT HÔM NAY -->
            <div class="col-xl col-md-4 col-sm-6">
                <div class="card h-100 border-0 shadow-sm p-3 card-hover bg-white border-start border-success border-4">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small fw-semibold text-uppercase">
                            @(canManage ? "Có mặt hôm nay" : "Điểm danh hôm nay")
                        </span>
                        <div class="bg-success-subtle text-success rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                            <i class="fa-solid fa-user-check fs-6"></i>
                        </div>
                    </div>
                    <div class="d-flex align-items-baseline gap-2">
                        @if (canManage)
                        {
                            <span class="display-6 fw-bold text-success">@presentTodayCount</span>
                            <span class="text-muted small">/@totalActiveEmployees</span>
                        }
                        else
                        {
                            <span class="h4 fw-bold @(isMyPresentToday ? "text-success" : "text-secondary") mb-0">
                                @(isMyPresentToday ? "Đã chấm công" : "Chưa chấm công")
                            </span>
                        }
                    </div>
                    <div class="mt-2 text-muted" style="font-size: 0.8rem;">
                        @if (canManage)
                        {
                            <span>Tỷ lệ đi làm: <strong>@attendanceRateToday%</strong></span>
                        }
                        else
                        {
                            <span>@(isMyPresentToday ? $"Vào: {myTodayCheckIn?.ToString(@"hh\:mm") ?? "--:--"}" : "Nhấn nút để điểm danh vào ca")</span>
                        }
                    </div>
                </div>
            </div>

            <!-- THẺ 3: ĐI TRỄ TRONG THÁNG (LƯỢT ĐI TRỄ) - CÓ THỂ BẤM XEM CHI TIẾT -->
            <div class="col-xl col-md-4 col-sm-6">
                <div class="card h-100 border-0 shadow-sm p-3 card-hover bg-white border-start border-warning border-4 cursor-pointer"
                     @onclick="OpenLateDetailsModal"
                     title="Nhấn để xem danh sách chi tiết các lượt đi trễ"
                     style="cursor: pointer;">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small fw-semibold text-uppercase">
                            @(canManage ? "Đi trễ trong tháng" : "Lượt đi trễ của tôi")
                        </span>
                        <div class="bg-warning-subtle text-warning rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                            <i class="fa-solid fa-clock-rotate-left fs-6"></i>
                        </div>
                    </div>
                    <div class="d-flex align-items-baseline gap-2">
                        <span class="display-6 fw-bold text-warning">
                            @(canManage ? totalLateInstances : myLateInstances)
                        </span>
                        <span class="text-muted small fw-bold">lượt đi trễ</span>
                    </div>
                    <div class="mt-2 d-flex align-items-center justify-content-between" style="font-size: 0.8rem;">
                        <span class="text-muted">
                            <i class="fa-regular fa-calendar me-1"></i>Từ 01/@currentMonth đến nay
                        </span>
                        <span class="badge bg-warning-subtle text-dark border border-warning">
                            Xem chi tiết <i class="fa-solid fa-arrow-right ms-1"></i>
                        </span>
                    </div>
                </div>
            </div>

            <!-- THẺ 4: VẮNG MẶT HÔM NAY -->
            <div class="col-xl col-md-6 col-sm-6">
                <div class="card h-100 border-0 shadow-sm p-3 card-hover bg-white border-start border-danger border-4">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small fw-semibold text-uppercase">
                            @(canManage ? "Vắng mặt hôm nay" : "Nghỉ phép tháng này")
                        </span>
                        <div class="bg-danger-subtle text-danger rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                            <i class="fa-solid fa-user-xmark fs-6"></i>
                        </div>
                    </div>
                    <div class="d-flex align-items-baseline gap-2">
                        <span class="display-6 fw-bold text-danger">
                            @(canManage ? absentTodayCount : myLeaveDaysCount)
                        </span>
                        <span class="text-muted small">@(canManage ? "nhân sự" : "ngày")</span>
                    </div>
                    <div class="mt-2 text-muted" style="font-size: 0.8rem;">
                        @if (canManage)
                        {
                            <span>Bao gồm nghỉ phép đã duyệt & chưa vào ca</span>
                        }
                        else
                        {
                            <span>Theo đơn nghỉ phép đã được phê duyệt</span>
                        }
                    </div>
                </div>
            </div>

            <!-- THẺ 5: ĐƠN CHỜ DUYỆT -->
            <div class="col-xl col-md-6 col-sm-12">
                <div class="card h-100 border-0 shadow-sm p-3 card-hover bg-white border-start border-info border-4 cursor-pointer"
                     @onclick="NavigateToPendingRequests"
                     title="Nhấn để mở danh sách xử lý"
                     style="cursor: pointer;">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small fw-semibold text-uppercase">
                            @(canManage ? "Đơn chờ duyệt" : "Đơn chờ xử lý của tôi")
                        </span>
                        <div class="bg-info-subtle text-info rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                            <i class="fa-solid fa-clipboard-check fs-6"></i>
                        </div>
                    </div>
                    <div class="d-flex align-items-baseline gap-2">
                        <span class="display-6 fw-bold text-info">
                            @(canManage ? totalPendingCount : myTotalPendingCount)
                        </span>
                        <span class="text-muted small">yêu cầu</span>
                    </div>
                    <div class="mt-2 d-flex align-items-center justify-content-between" style="font-size: 0.8rem;">
                        <span class="text-muted">
                            Chấm công: @(canManage ? pendingAttendanceCount : myPendingAttendanceCount) • Nghỉ: @(canManage ? pendingLeaveCount : myPendingLeaveCount)
                        </span>
                        <span class="badge bg-info-subtle text-dark border border-info">
                            Xử lý <i class="fa-solid fa-arrow-right ms-1"></i>
                        </span>
                    </div>
                </div>
            </div>

        </div>

        <!-- ========================================================================= -->
        <!-- KHU VỰC 3: THÔNG BÁO QUAN TRỌNG (IMPORTANT NOTIFICATIONS AREA)            -->
        <!-- ========================================================================= -->
        <div class="card border-0 shadow-sm bg-white mb-4">
            <div class="card-header bg-white border-bottom py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="bg-danger text-white rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 30px; height: 30px;">
                        <i class="fa-solid fa-bell fs-6"></i>
                    </span>
                    <h5 class="h6 fw-bold mb-0 text-dark text-uppercase tracking-wider">Thông báo quan trọng</h5>
                    @if (importantAlerts.Count > 0)
                    {
                        <span class="badge bg-danger rounded-pill">@importantAlerts.Count</span>
                    }
                </div>

                @if (canManage)
                {
                    <div class="d-flex align-items-center gap-2">
                        <label class="text-muted small mb-0">Ngưỡng cảnh báo đi trễ:</label>
                        <select class="form-select form-select-sm" style="width: 120px;" @bind="lateThreshold" @bind:after="RecalculateAlerts">
                            <option value="2">≥ 2 lượt</option>
                            <option value="3">≥ 3 lượt</option>
                            <option value="4">≥ 4 lượt</option>
                            <option value="5">≥ 5 lượt</option>
                        </select>
                    </div>
                }
            </div>

            <div class="card-body p-0">
                @if (importantAlerts.Count == 0)
                {
                    <div class="p-4 text-center text-muted">
                        <i class="fa-solid fa-circle-check text-success fs-3 mb-2 d-block"></i>
                        <span class="fw-semibold">Không có thông báo khẩn cấp hoặc yêu cầu tồn đọng nào cần xử lý.</span>
                        <div class="small">Tất cả dữ liệu chấm công và phê duyệt đang ở trạng thái bình thường.</div>
                    </div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var alert in importantAlerts)
                        {
                            <div class="list-group-item p-3 border-bottom d-flex flex-wrap align-items-center justify-content-between gap-3 @GetAlertRowClass(alert.Severity)">
                                <div class="d-flex align-items-start gap-3" style="max-width: 85%;">
                                    <div class="rounded-circle p-2 d-flex align-items-center justify-content-center mt-1 @GetAlertIconBg(alert.Severity)" style="width: 38px; height: 38px; flex-shrink: 0;">
                                        <i class="@alert.Icon fs-6"></i>
                                    </div>
                                    <div>
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <span class="fw-bold text-dark">@alert.Title</span>
                                            <span class="badge @GetAlertBadgeClass(alert.Severity) px-2 py-0.5" style="font-size: 0.7rem;">
                                                @GetSeverityLabel(alert.Severity)
                                            </span>
                                            <span class="text-muted" style="font-size: 0.75rem;">
                                                <i class="fa-regular fa-clock me-1"></i>@alert.TimeStamp.ToString("HH:mm - dd/MM")
                                            </span>
                                        </div>
                                        <p class="text-secondary small mb-0" style="line-height: 1.5;">@alert.Description</p>
                                    </div>
                                </div>

                                <div class="ms-auto">
                                    @if (!string.IsNullOrEmpty(alert.ActionUrl))
                                    {
                                        <a href="@alert.ActionUrl" class="btn btn-sm btn-outline-primary fw-semibold shadow-sm">
                                            @alert.ActionText <i class="fa-solid fa-arrow-right ms-1"></i>
                                        </a>
                                    }
                                    else if (alert.CustomAction != null)
                                    {
                                        <button class="btn btn-sm btn-outline-warning text-dark fw-semibold shadow-sm" @onclick="alert.CustomAction">
                                            @alert.ActionText <i class="fa-solid fa-magnifying-glass ms-1"></i>
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- ========================================================================= -->
        <!-- KHU VỰC 4: BIỂU ĐỒ MINI & HOẠT ĐỘNG CHẤM CÔNG GẦN ĐÂY                    -->
        <!-- ========================================================================= -->
        <div class="row g-4">

            <!-- CỘT TRÁI: BIỂU ĐỒ MINI & TỶ LỆ CHUYÊN CẦN -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm bg-white p-3 h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold mb-0 text-dark">
                            <i class="fa-solid fa-chart-pie text-primary me-2"></i>Tỷ Lệ Chuyên Cần Tháng @currentMonth
                        </h6>
                        <span class="badge bg-light text-muted border">Kỳ @currentMonth/@currentYear</span>
                    </div>

                    <div class="p-3 bg-light rounded-3 mb-3">
                        <div class="d-flex justify-content-between text-muted small mb-1">
                            <span>Tỷ lệ đi làm đúng giờ</span>
                            <span class="fw-bold text-success">@onTimeRate%</span>
                        </div>
                        <div class="progress" style="height: 10px;">
                            <div class="progress-bar bg-success" role="progressbar" style="width: @onTimeRate%;" aria-valuenow="@onTimeRate" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>

                        <div class="d-flex justify-content-between text-muted small mt-3 mb-1">
                            <span>Tỷ lệ đi trễ / về sớm</span>
                            <span class="fw-bold text-warning">@lateRate%</span>
                        </div>
                        <div class="progress" style="height: 10px;">
                            <div class="progress-bar bg-warning" role="progressbar" style="width: @lateRate%;" aria-valuenow="@lateRate" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>

                        <div class="d-flex justify-content-between text-muted small mt-3 mb-1">
                            <span>Tỷ lệ nghỉ phép có duyệt</span>
                            <span class="fw-bold text-info">@leaveRate%</span>
                        </div>
                        <div class="progress" style="height: 10px;">
                            <div class="progress-bar bg-info" role="progressbar" style="width: @leaveRate%;" aria-valuenow="@leaveRate" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>

                    <div class="row g-2 text-center" style="font-size: 0.85rem;">
                        <div class="col-4">
                            <div class="p-2 border rounded-2 bg-white">
                                <div class="text-muted small">Đúng giờ</div>
                                <div class="fw-bold text-success fs-5">@presentCountMonth</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-2 border rounded-2 bg-white">
                                <div class="text-muted small">Đi trễ</div>
                                <div class="fw-bold text-warning fs-5">@totalLateInstances</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="p-2 border rounded-2 bg-white">
                                <div class="text-muted small">Nghỉ phép</div>
                                <div class="fw-bold text-info fs-5">@leaveCountMonth</div>
                            </div>
                        </div>
                    </div>

                    @if (canManage)
                    {
                        <div class="mt-3 text-center">
                            <a href="/my-timesheet" class="btn btn-sm btn-outline-primary w-100 fw-semibold">
                                <i class="fa-solid fa-calendar-days me-1"></i>Mở Bảng Chấm Công Tổng Hợp
                            </a>
                        </div>
                    }
                </div>
            </div>

            <!-- CỘT PHẢI: HOẠT ĐỘNG CHẤM CÔNG MỚI NHẤT -->
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm bg-white p-3 h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold mb-0 text-dark">
                            <i class="fa-solid fa-list-check text-success me-2"></i>Hoạt Động Điểm Danh Gần Đây
                        </h6>
                        <span class="badge bg-light text-muted border">Bản ghi mới nhất</span>
                    </div>

                    @if (recentTimesheets.Count == 0)
                    {
                        <div class="p-4 text-center text-muted">
                            Chưa có dữ liệu điểm danh nào được ghi nhận gần đây.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle table-sm mb-0">
                                <thead class="table-light text-muted small">
                                    <tr>
                                        <th>Nhân viên</th>
                                        <th>Ngày</th>
                                        <th>Ca làm việc</th>
                                        <th>Giờ vào/ra</th>
                                        <th>Trạng thái</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var ts in recentTimesheets)
                                    {
                                        <tr>
                                            <td>
                                                <div class="fw-semibold text-dark" style="font-size: 0.85rem;">@ts.EmployeeName</div>
                                                <div class="text-muted" style="font-size: 0.75rem;">@ts.EmployeeCode</div>
                                            </td>
                                            <td style="font-size: 0.85rem;">@ts.WorkDate.ToString("dd/MM/yyyy")</td>
                                            <td class="text-truncate" style="font-size: 0.85rem; max-width: 140px;" title="@ts.ShiftName">
                                                @(string.IsNullOrEmpty(ts.ShiftName) ? "Ca tiêu chuẩn" : ts.ShiftName)
                                            </td>
                                            <td style="font-size: 0.85rem;">
                                                <span class="text-success fw-semibold">@(ts.CheckInTime?.ToString(@"hh\:mm") ?? "--:--")</span>
                                                <span class="text-muted mx-1">-</span>
                                                <span class="text-primary fw-semibold">@(ts.CheckOutTime?.ToString(@"hh\:mm") ?? "--:--")</span>
                                            </td>
                                            <td>
                                                <span class="badge @GetStatusBadge(ts.WorkShiftStatus)" style="font-size: 0.75rem;">
                                                    @GetStatusText(ts.WorkShiftStatus)
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

        </div>
    }

</div>

<!-- ========================================================================= -->
<!-- MODAL: DANH SÁCH CHI TIẾT CÁC LƯỢT ĐI TRỄ TRONG THÁNG                      -->
<!-- ========================================================================= -->
@if (showLateDetailsModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0, 0, 0, 0.5); z-index: 1055;" aria-modal="true" role="dialog">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 shadow-lg rounded-3">
                <div class="modal-header bg-warning text-dark py-3">
                    <h5 class="modal-title fw-bold">
                        <i class="fa-solid fa-clock-rotate-left me-2"></i>
                        Danh Sách Chi Tiết Các Lượt Đi Trễ Tháng @currentMonth/@currentYear
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseLateDetailsModal" aria-label="Close"></button>
                </div>

                <div class="modal-body p-3 p-lg-4">
                    <!-- BỘ LỌC TÌM KIẾM TRONG MODAL -->
                    <div class="row g-2 mb-3 align-items-center">
                        <div class="col-md-6">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-white"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                                <input type="text" class="form-control" placeholder="Tìm theo tên nhân viên, mã nhân viên..."
                                       @bind="modalSearchText" @bind:event="oninput" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <select class="form-select form-select-sm" @bind="modalDepartmentFilter">
                                <option value="">-- Tất cả phòng ban --</option>
                                @foreach (var dept in departmentsList)
                                {
                                    <option value="@dept">@dept</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2 text-end">
                            <span class="badge bg-warning text-dark px-3 py-2 fw-semibold">
                                @FilteredLateRecords.Count lượt đi trễ
                            </span>
                        </div>
                    </div>

                    <!-- BẢNG LƯỢT ĐI TRỄ -->
                    @if (FilteredLateRecords.Count == 0)
                    {
                        <div class="p-5 text-center text-muted bg-light rounded-3">
                            <i class="fa-solid fa-check-circle text-success fs-2 mb-2 d-block"></i>
                            Không tìm thấy lượt đi trễ nào phù hợp với bộ lọc.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover table-striped align-middle table-sm border mb-0">
                                <thead class="table-light text-muted small">
                                    <tr>
                                        <th style="width: 50px;">STT</th>
                                        <th>Mã NV</th>
                                        <th>Họ và tên</th>
                                        <th>Phòng ban</th>
                                        <th>Ngày đi trễ</th>
                                        <th>Ca làm việc</th>
                                        <th>Giờ ca bắt đầu</th>
                                        <th>Giờ vào thực tế</th>
                                        <th>Số phút trễ</th>
                                        <th>Ghi chú</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        int stt = 1;
                                    }
                                    @foreach (var item in FilteredLateRecords)
                                    {
                                        <tr>
                                            <td class="text-center text-muted small">@(stt++)</td>
                                            <td class="fw-bold text-primary">@item.EmployeeCode</td>
                                            <td class="fw-semibold">@item.FullName</td>
                                            <td class="small text-muted">@item.DepartmentName</td>
                                            <td class="fw-semibold">@item.WorkDate.ToString("dd/MM/yyyy")</td>
                                            <td class="small">@item.ShiftName</td>
                                            <td class="small">@item.ShiftStartTime.ToString(@"hh\:mm")</td>
                                            <td class="text-danger fw-bold">@item.CheckInTime.ToString(@"hh\:mm")</td>
                                            <td>
                                                <span class="badge bg-danger text-white rounded-pill px-2 py-1">
                                                    +@item.MinutesLate phút
                                                </span>
                                            </td>
                                            <td class="small text-muted" style="max-width: 200px;">
                                                @(string.IsNullOrEmpty(item.Note) ? "Đi muộn theo giờ ca" : item.Note)
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>

                <div class="modal-footer bg-light py-2">
                    <span class="text-muted small me-auto">
                        <i class="fa-solid fa-circle-info me-1 text-primary"></i>
                        Quy định: Thời gian vào ca vượt quá giờ bắt đầu ca + 15 phút ân hạn được xác định là đi trễ.
                    </span>
                    <button type="button" class="btn btn-sm btn-secondary" @onclick="CloseLateDetailsModal">Đóng</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    // Trạng thái chung
    private bool isLoading = true;
    private string? errorMessage = null;
    private int currentMonth = 10;
    private int currentYear = 2026;

    // Ngưỡng cảnh báo đi trễ nhiều lần
    private int lateThreshold = 3;

    // Phân quyền người dùng
    private UserAccount? currentUser;
    private bool isAdmin = false;
    private bool isManager = false;
    private bool isAccountant = false;
    private bool isEmployee = false;
    private bool canManage = false;
    private string userRoleDisplay = "";

    // Dữ liệu thống kê
    private int totalActiveEmployees = 0;
    private int presentTodayCount = 0;
    private int absentTodayCount = 0;
    private int totalLateInstances = 0;
    private int pendingAttendanceCount = 0;
    private int pendingLeaveCount = 0;
    private int totalPendingCount => pendingAttendanceCount + pendingLeaveCount;

    // Tỷ lệ chuyên cần
    private int attendanceRateToday = 0;
    private int onTimeRate = 0;
    private int lateRate = 0;
    private int leaveRate = 0;
    private int presentCountMonth = 0;
    private int leaveCountMonth = 0;

    // Dành riêng cho nhân viên
    private bool isMyPresentToday = false;
    private TimeSpan? myTodayCheckIn = null;
    private int myLateInstances = 0;
    private decimal myLeaveDaysCount = 0;
    private int myPendingAttendanceCount = 0;
    private int myPendingLeaveCount = 0;
    private int myTotalPendingCount => myPendingAttendanceCount + myPendingLeaveCount;

    // Danh sách thực thể
    private List<Employee> scopedEmployees = new();
    private List<Timesheet> scopedMonthTimesheets = new();
    private List<Timesheet> recentTimesheets = new();
    private List<LateDetailItem> lateDetailsList = new();
    private List<DashboardAlert> importantAlerts = new();
    private List<string> departmentsList = new();

    // Modal đi trễ
    private bool showLateDetailsModal = false;
    private string modalSearchText = "";
    private string modalDepartmentFilter = "";

    private List<LateDetailItem> FilteredLateRecords => lateDetailsList
        .Where(item =>
            (string.IsNullOrWhiteSpace(modalSearchText) ||
             item.FullName.Contains(modalSearchText, StringComparison.OrdinalIgnoreCase) ||
             item.EmployeeCode.Contains(modalSearchText, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrWhiteSpace(modalDepartmentFilter) ||
             item.DepartmentName.Equals(modalDepartmentFilter, StringComparison.OrdinalIgnoreCase)))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardDataAsync();
    }

    private async Task LoadDashboardDataAsync()
    {
        isLoading = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            // 1. Xác định phiên làm việc người dùng
            currentUser = UserSession.CurrentUser;
            if (currentUser == null)
            {
                await UserSession.EnsureInitialUserAsync();
                currentUser = UserSession.CurrentUser;
            }

            isAdmin = currentUser?.Role == "ROLE_ADMIN";
            isManager = currentUser?.Role == "ROLE_MANAGER";
            isAccountant = currentUser?.Role == "ROLE_HR_ACCOUNTANT";
            isEmployee = currentUser?.Role == "ROLE_EMPLOYEE";
            canManage = isAdmin || isManager || isAccountant;

            userRoleDisplay = isAdmin ? "Quản Trị Viên (Admin)" :
                              isManager ? "Quản Lý Bộ Phận" :
                              isAccountant ? "Kế Toán Tiền Lương" : "Nhân Viên";

            // 2. Xác định tháng/năm báo cáo (mặc định tháng 10/2026 khớp bộ dữ liệu CSDL)
            currentMonth = 10;
            currentYear = 2026;

            // 3. Tải danh mục ca làm việc
            var allShifts = (await WorkShiftRepo.GetWorkShiftsAsync()).ToList();
            var shiftDict = allShifts.ToDictionary(s => s.Id, s => s);

            // 4. Tải danh sách nhân sự theo phạm vi quyền
            var allEmployees = (await EmployeeRepo.GetEmployeesAsync()).ToList();
            departmentsList = allEmployees
                .Where(e => !string.IsNullOrEmpty(e.DepartmentName))
                .Select(e => e.DepartmentName!)
                .Distinct()
                .OrderBy(d => d)
                .ToList();

            if (isEmployee)
            {
                scopedEmployees = allEmployees.Where(e => e.Id == currentUser?.EmployeeId).ToList();
            }
            else if (isManager)
            {
                scopedEmployees = allEmployees.Where(e => e.DepartmentName == currentUser?.DepartmentName).ToList();
                if (scopedEmployees.Count == 0) scopedEmployees = allEmployees; // Dự phòng
            }
            else
            {
                scopedEmployees = allEmployees;
            }

            totalActiveEmployees = scopedEmployees.Count;
            var scopedEmpIds = scopedEmployees.Select(e => e.Id).ToHashSet();

            // 5. Tải dữ liệu chấm công trong tháng
            var allMonthTimesheets = (await TimesheetRepo.GetAllTimesheetsByMonthAsync(currentMonth, currentYear)).ToList();
            scopedMonthTimesheets = allMonthTimesheets.Where(t => scopedEmpIds.Contains(t.EmployeeId)).ToList();

            // 6. Tính toán các chỉ số thống kê
            // Ngày hiện tại: 21/10/2026
            var targetToday = new DateTime(2026, 10, 21);
            var todayTimesheets = scopedMonthTimesheets.Where(t => t.WorkDate.Date == targetToday.Date).ToList();

            presentTodayCount = todayTimesheets.Count(t =>
                t.WorkShiftStatus == WorkShiftStatus.PRESENT ||
                t.WorkShiftStatus == WorkShiftStatus.LATE ||
                t.WorkShiftStatus == WorkShiftStatus.EARLY_LEAVE ||
                t.WorkShiftStatus == WorkShiftStatus.HALF_DAY ||
                t.CheckInTime.HasValue);

            absentTodayCount = todayTimesheets.Count(t =>
                t.WorkShiftStatus == WorkShiftStatus.ABSENT_WITH_PERMISSION ||
                t.WorkShiftStatus == WorkShiftStatus.ABSENT_UNAUTHORIZED);

            if (totalActiveEmployees > 0 && canManage)
            {
                attendanceRateToday = (int)Math.Round((double)presentTodayCount / totalActiveEmployees * 100);
            }

            // Dành riêng cho nhân viên cá nhân
            if (isEmployee && currentUser != null && currentUser.EmployeeId > 0)
            {
                var myTodayRecord = todayTimesheets.FirstOrDefault(t => t.EmployeeId == currentUser.EmployeeId);
                isMyPresentToday = myTodayRecord != null && (myTodayRecord.CheckInTime.HasValue || myTodayRecord.WorkShiftStatus == WorkShiftStatus.PRESENT || myTodayRecord.WorkShiftStatus == WorkShiftStatus.LATE);
                myTodayCheckIn = myTodayRecord?.CheckInTime;

                var myMonthRecords = scopedMonthTimesheets.Where(t => t.EmployeeId == currentUser.EmployeeId).ToList();
                myLateInstances = myMonthRecords.Count(t => t.WorkShiftStatus == WorkShiftStatus.LATE || t.IsLate);
                myLeaveDaysCount = myMonthRecords.Where(t => t.WorkShiftStatus == WorkShiftStatus.ABSENT_WITH_PERMISSION).Sum(t => 1.0m);
            }

            // 7. Xây dựng danh sách chi tiết các lượt đi trễ
            lateDetailsList.Clear();
            var lateTimesheets = scopedMonthTimesheets.Where(t => t.WorkShiftStatus == WorkShiftStatus.LATE || t.IsLate).ToList();
            totalLateInstances = lateTimesheets.Count;

            var empDict = scopedEmployees.ToDictionary(e => e.Id, e => e);

            foreach (var lt in lateTimesheets.OrderByDescending(t => t.WorkDate).ThenBy(t => t.EmployeeCode))
            {
                empDict.TryGetValue(lt.EmployeeId, out var emp);
                WorkShift? shift = null;
                if (lt.ShiftId.HasValue) shiftDict.TryGetValue(lt.ShiftId.Value, out shift);

                var shiftStartTime = shift?.StartTime ?? new TimeSpan(8, 0, 0);
                var checkIn = lt.CheckInTime ?? shiftStartTime.Add(TimeSpan.FromMinutes(22));
                int minsLate = checkIn > shiftStartTime ? (int)(checkIn - shiftStartTime).TotalMinutes : 15;

                lateDetailsList.Add(new LateDetailItem
                {
                    EmployeeId = lt.EmployeeId,
                    EmployeeCode = lt.EmployeeCode ?? emp?.EmployeeCode ?? "N/A",
                    FullName = lt.EmployeeName ?? emp?.FullName ?? "N/A",
                    DepartmentName = emp?.DepartmentName ?? "Văn phòng",
                    WorkDate = lt.WorkDate,
                    ShiftName = lt.ShiftName ?? shift?.ShiftName ?? "Ca Hành Chính",
                    ShiftStartTime = shiftStartTime,
                    CheckInTime = checkIn,
                    MinutesLate = minsLate,
                    Note = lt.Note ?? ""
                });
            }

            // 8. Tỷ lệ chuyên cần trong tháng
            int totalMonthRecords = scopedMonthTimesheets.Count;
            if (totalMonthRecords > 0)
            {
                presentCountMonth = scopedMonthTimesheets.Count(t => t.WorkShiftStatus == WorkShiftStatus.PRESENT);
                leaveCountMonth = scopedMonthTimesheets.Count(t => t.WorkShiftStatus == WorkShiftStatus.ABSENT_WITH_PERMISSION);

                onTimeRate = (int)Math.Round((double)presentCountMonth / totalMonthRecords * 100);
                lateRate = (int)Math.Round((double)totalLateInstances / totalMonthRecords * 100);
                leaveRate = (int)Math.Round((double)leaveCountMonth / totalMonthRecords * 100);
            }

            // 9. Danh sách hoạt động gần đây
            recentTimesheets = scopedMonthTimesheets
                .OrderByDescending(t => t.WorkDate)
                .ThenByDescending(t => t.CheckInTime)
                .Take(7)
                .ToList();

            // 10. Tải danh sách đơn chờ duyệt
            var allPendingAttendance = (await AttendanceRequestRepo.GetPendingAttendanceRequestsAsync()).ToList();
            var allPendingLeave = (await LeaveRequestRepo.GetPendingLeaveRequestsAsync()).ToList();

            if (isEmployee && currentUser != null && currentUser.EmployeeId > 0)
            {
                var myAttendance = (await AttendanceRequestRepo.GetAttendanceRequestsByEmployeeAsync(currentUser.EmployeeId)).ToList();
                var myLeave = (await LeaveRequestRepo.GetLeaveRequestsByEmployeeAsync(currentUser.EmployeeId)).ToList();
                myPendingAttendanceCount = myAttendance.Count(r => r.ApprovalStatus == "PENDING" || r.IsPending);
                myPendingLeaveCount = myLeave.Count(r => r.ApprovalStatus == ApprovalStatus.PENDING);
            }
            else if (isManager)
            {
                pendingAttendanceCount = allPendingAttendance.Count(r => scopedEmpIds.Contains(r.EmployeeId));
                pendingLeaveCount = allPendingLeave.Count(r => scopedEmpIds.Contains(r.EmployeeId));
            }
            else
            {
                pendingAttendanceCount = allPendingAttendance.Count;
                pendingLeaveCount = allPendingLeave.Count;
            }

            // 11. Xây dựng danh sách thông báo quan trọng
            RecalculateAlerts();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void RecalculateAlerts()
    {
        importantAlerts.Clear();

        // THÔNG BÁO 1: ĐƠN NGHỈ PHÉP CHỜ DUYỆT
        if (canManage && pendingLeaveCount > 0)
        {
            importantAlerts.Add(new DashboardAlert
            {
                Icon = "fa-solid fa-calendar-check text-danger",
                Title = "Đơn nghỉ phép chờ duyệt",
                Description = $"Hiện có {pendingLeaveCount} đơn xin nghỉ phép của nhân viên đang chờ phê duyệt trước kỳ chốt công.",
                Severity = NotificationSeverity.Danger,
                ActionText = "Duyệt ngay",
                ActionUrl = "/admin/leave-approval",
                TimeStamp = DateTime.Now
            });
        }

        // THÔNG BÁO 2: YÊU CẦU CHẤM CÔNG THỦ CÔNG CHỜ DUYỆT
        if (canManage && pendingAttendanceCount > 0)
        {
            importantAlerts.Add(new DashboardAlert
            {
                Icon = "fa-solid fa-clock-rotate-left text-warning",
                Title = "Yêu cầu chấm công thủ công",
                Description = $"Có {pendingAttendanceCount} đề nghị bổ sung giờ vào/ra hoặc điều chỉnh ca làm việc cần xem xét.",
                Severity = NotificationSeverity.Warning,
                ActionText = "Xem xét",
                ActionUrl = "/admin/attendance-approval",
                TimeStamp = DateTime.Now
            });
        }

        // THÔNG BÁO 3: CẢNH BÁO NHÂN VIÊN ĐI TRỄ NHIỀU LẦN (GOM NHÓM THEO NHÂN VIÊN)
        if (canManage)
        {
            var frequentLaters = lateDetailsList
                .GroupBy(x => new { x.EmployeeId, x.EmployeeCode, x.FullName, x.DepartmentName })
                .Select(g => new FrequentLateEmployee
                {
                    EmployeeId = g.Key.EmployeeId,
                    EmployeeCode = g.Key.EmployeeCode,
                    FullName = g.Key.FullName,
                    DepartmentName = g.Key.DepartmentName,
                    LateCount = g.Count(),
                    Instances = g.ToList()
                })
                .Where(x => x.LateCount >= lateThreshold)
                .OrderByDescending(x => x.LateCount)
                .ToList();

            if (frequentLaters.Count > 0)
            {
                string names = string.Join(", ", frequentLaters.Take(3).Select(f => $"{f.FullName} ({f.LateCount} lần)"));
                if (frequentLaters.Count > 3) names += $" và {frequentLaters.Count - 3} nhân sự khác";

                importantAlerts.Add(new DashboardAlert
                {
                    Icon = "fa-solid fa-triangle-exclamation text-danger",
                    Title = $"Cảnh báo: {frequentLaters.Count} nhân viên đi trễ ≥ {lateThreshold} lần",
                    Description = $"Các nhân viên đã vượt ngưỡng đi trễ quy định trong tháng: {names}. Cần nhắc nhở và đối soát ca trực.",
                    Severity = NotificationSeverity.Danger,
                    ActionText = "Xem danh sách",
                    CustomAction = () => OpenLateDetailsModal(),
                    TimeStamp = DateTime.Now
                });
            }
        }
        else if (isEmployee && myLateInstances >= lateThreshold)
        {
            importantAlerts.Add(new DashboardAlert
            {
                Icon = "fa-solid fa-triangle-exclamation text-warning",
                Title = "Lưu ý cá nhân: Bạn có nhiều lượt đi trễ",
                Description = $"Bạn đã ghi nhận {myLateInstances} lượt đi trễ trong tháng {currentMonth}. Vui lòng chú ý thời gian vào ca để đảm bảo đánh giá chuyên cần.",
                Severity = NotificationSeverity.Warning,
                ActionText = "Xem chi tiết",
                CustomAction = () => OpenLateDetailsModal(),
                TimeStamp = DateTime.Now
            });
        }

        // THÔNG BÁO 4: THIẾU DỮ LIỆU CHẤM CÔNG (Check-in nhưng thiếu Check-out)
        var missingCheckoutCount = scopedMonthTimesheets.Count(t => t.CheckInTime.HasValue && !t.CheckOutTime.HasValue && t.WorkDate.Date < new DateTime(2026, 10, 21));
        if (canManage && missingCheckoutCount > 0)
        {
            importantAlerts.Add(new DashboardAlert
            {
                Icon = "fa-solid fa-business-time text-warning",
                Title = "Thiếu dữ liệu Check-Out hết ca",
                Description = $"Phát hiện {missingCheckoutCount} lượt chấm công có giờ vào nhưng thiếu giờ ra ở các ngày trước. Đề nghị nhân viên gửi yêu cầu bổ sung.",
                Severity = NotificationSeverity.Warning,
                ActionText = "Kiểm tra",
                ActionUrl = "/my-timesheet",
                TimeStamp = DateTime.Now
            });
        }

        // THÔNG BÁO 5: KỲ LƯƠNG HIỆN HÀNH (Dành cho Admin & Kế toán)
        if (isAdmin || isAccountant)
        {
            importantAlerts.Add(new DashboardAlert
            {
                Icon = "fa-solid fa-money-check-dollar text-primary",
                Title = $"Kỳ lương Tháng {currentMonth}/{currentYear} đang mở",
                Description = "Dữ liệu chấm công đang được tổng hợp liên tục. Kế toán có thể chạy tính toán thử nghiệm hoặc chốt bảng lương.",
                Severity = NotificationSeverity.Info,
                ActionText = "Bảng lương",
                ActionUrl = "/admin/payroll-calculation",
                TimeStamp = DateTime.Now
            });
        }

        // THÔNG BÁO 6: SINH NHẬT NHÂN VIÊN TRONG THÁNG
        var birthdayEmployees = scopedEmployees.Where(e => e.DateOfBirth.HasValue && e.DateOfBirth.Value.Month == currentMonth).ToList();
        if (birthdayEmployees.Count > 0)
        {
            string birthdayNames = string.Join(", ", birthdayEmployees.Take(4).Select(e => $"{e.FullName} ({e.DateOfBirth!.Value:dd/MM})"));
            importantAlerts.Add(new DashboardAlert
            {
                Icon = "fa-solid fa-cake-candles text-primary",
                Title = $"Sinh nhật trong tháng {currentMonth} ({birthdayEmployees.Count} nhân sự)",
                Description = $"Chúc mừng sinh nhật: {birthdayNames}.",
                Severity = NotificationSeverity.Info,
                ActionText = "Xem danh sách",
                ActionUrl = "/my-timesheet",
                TimeStamp = DateTime.Now
            });
        }

        // THÔNG BÁO 7: DÀNH RIÊNG CHO NHÂN VIÊN THƯỜNG
        if (isEmployee)
        {
            if (myPendingAttendanceCount > 0 || myPendingLeaveCount > 0)
            {
                importantAlerts.Add(new DashboardAlert
                {
                    Icon = "fa-solid fa-clock text-info",
                    Title = "Yêu cầu của bạn đang chờ phê duyệt",
                    Description = $"Bạn có {myPendingAttendanceCount} yêu cầu chấm công bù và {myPendingLeaveCount} đơn nghỉ phép đang được ban quản lý xử lý.",
                    Severity = NotificationSeverity.Info,
                    ActionText = "Theo dõi",
                    ActionUrl = "/my-attendance-requests",
                    TimeStamp = DateTime.Now
                });
            }
        }
    }

    private void OpenLateDetailsModal()
    {
        modalSearchText = "";
        modalDepartmentFilter = "";
        showLateDetailsModal = true;
    }

    private void CloseLateDetailsModal()
    {
        showLateDetailsModal = false;
    }

    private void NavigateToPendingRequests()
    {
        if (canManage)
        {
            if (pendingAttendanceCount > 0)
                NavManager.NavigateTo("/admin/attendance-approval");
            else
                NavManager.NavigateTo("/admin/leave-approval");
        }
        else
        {
            NavManager.NavigateTo("/my-attendance-requests");
        }
    }

    // Helper methods định dạng giao diện
    private string GetAlertRowClass(NotificationSeverity severity) => severity switch
    {
        NotificationSeverity.Danger => "bg-danger-subtle bg-opacity-10",
        NotificationSeverity.Warning => "bg-warning-subtle bg-opacity-10",
        _ => "bg-white"
    };

    private string GetAlertIconBg(NotificationSeverity severity) => severity switch
    {
        NotificationSeverity.Danger => "bg-danger-subtle text-danger",
        NotificationSeverity.Warning => "bg-warning-subtle text-warning",
        _ => "bg-primary-subtle text-primary"
    };

    private string GetAlertBadgeClass(NotificationSeverity severity) => severity switch
    {
        NotificationSeverity.Danger => "bg-danger text-white",
        NotificationSeverity.Warning => "bg-warning text-dark",
        _ => "bg-info-subtle text-info border border-info"
    };

    private string GetSeverityLabel(NotificationSeverity severity) => severity switch
    {
        NotificationSeverity.Danger => "Cần xử lý ngay",
        NotificationSeverity.Warning => "Cần chú ý",
        _ => "Thông tin"
    };

    private string GetStatusBadge(WorkShiftStatus status) => status switch
    {
        WorkShiftStatus.PRESENT => "bg-success-subtle text-success border border-success",
        WorkShiftStatus.LATE => "bg-warning-subtle text-dark border border-warning",
        WorkShiftStatus.EARLY_LEAVE => "bg-warning-subtle text-dark border border-warning",
        WorkShiftStatus.HALF_DAY => "bg-info-subtle text-dark border border-info",
        WorkShiftStatus.ABSENT_WITH_PERMISSION => "bg-primary-subtle text-primary border border-primary",
        _ => "bg-danger-subtle text-danger border border-danger"
    };

    private string GetStatusText(WorkShiftStatus status) => status switch
    {
        WorkShiftStatus.PRESENT => "Đúng giờ",
        WorkShiftStatus.LATE => "Đi muộn",
        WorkShiftStatus.EARLY_LEAVE => "Về sớm",
        WorkShiftStatus.HALF_DAY => "Nửa ngày",
        WorkShiftStatus.ABSENT_WITH_PERMISSION => "Nghỉ phép",
        _ => "Vắng mặt"
    };

