@page "/404"
@page "/not-found"

<PageTitle>404 - Không Tìm Thấy Trang</PageTitle>

<div class="container p-5 text-center">
    <div class="card border-0 shadow-sm mx-auto rounded-4" style="max-width: 600px;">
        <div class="card-body p-5">
            <div class="text-warning mb-3">
                <i class="fa-solid fa-triangle-exclamation fa-4x"></i>
            </div>
            <h3 class="fw-bold text-dark mb-2">Không Tìm Thấy Trang (404)</h3>
            <p class="text-muted mb-4">Đường dẫn bạn yêu cầu không tồn tại hoặc đã được chuyển hướng trong hệ thống.</p>
            <div class="d-flex justify-content-center gap-2">
                <a href="/" class="btn btn-primary px-4">
                    <i class="fa-solid fa-house me-2"></i>Về Trang Chủ
                </a>
                <a href="/login" class="btn btn-outline-secondary px-4">
                    <i class="fa-solid fa-right-to-bracket me-2"></i>Đăng Nhập
                </a>
            </div>
        </div>
    </div>
</div>
