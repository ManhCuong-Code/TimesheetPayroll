@inherits LayoutComponentBase

<div class="page d-flex flex-column min-vh-100 bg-light">
    <TopNavbar />

    <main class="flex-grow-1">
        <article class="content p-3 p-md-4">
            @Body
        </article>
    </main>

    <footer class="bg-white border-top py-3 text-muted small mt-auto">
        <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-primary text-white fw-bold px-2 py-1" style="font-size: 0.7rem;">HRMS</span>
                <span>&copy; 2026 <strong>HỆ THỐNG QUẢN LÝ NHÂN SỰ – CHẤM CÔNG – TÍNH LƯƠNG</strong>. Tất cả quyền được bảo lưu.</span>
            </div>
            <div class="d-flex align-items-center gap-3 text-secondary">
                <span class="d-flex align-items-center text-success"><i class="fa-solid fa-circle me-1" style="font-size: 0.45rem;"></i> Trực tuyến 99.9%</span>
                <span>•</span>
                <span>Bảo mật dữ liệu chuẩn ngân hàng</span>
                <span>•</span>
                <span>Phiên bản 4.2 LTS</span>
            </div>
        </div>
    </footer>

    <!-- TRỢ LÝ AI NỔI TRÊN MÀN HÌNH (HIỆN DIỆN VÀ CHO PHÉP TINH CHỈNH Ở MỌI TRANG) -->
    <FloatingAiAssistant />
</div>

<div id="blazor-error-ui" data-nosnippet>
    Đã xảy ra lỗi không mong muốn.
    <a href="." class="reload">Tải lại</a>
    <span class="dismiss">🗙</span>
</div>
