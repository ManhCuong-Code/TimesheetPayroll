@using TimesheetPayroll.UseCases.Authentication
@using Microsoft.AspNetCore.Components.Routing
@implements IDisposable
@inject IUserSessionService UserSession
@inject NavigationManager NavManager

<header class="hrm-topbar sticky-top">
    <nav class="navbar navbar-expand-lg hrm-topbar-nav" aria-label="Thanh điều hướng chính">
        <div class="container-fluid hrm-topbar-container">
            <!-- KHU VỰC TRÁI TRÊN MOBILE: NÚT MENU HAMBURGER + BRAND HEADER -->
            <div class="d-flex align-items-center hrm-topbar-left">
                <button class="navbar-toggler hrm-topbar-toggler d-lg-none me-2"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarMain"
                        aria-controls="navbarMain"
                        aria-expanded="false"
                        aria-label="Mở menu điều hướng">
                    <i class="fa-solid fa-bars"></i>
                </button>

                <!-- KHU VỰC 1: BRAND HEADER -->
                <a class="navbar-brand hrm-brand" href="/">
                    <div class="hrm-brand-logo" aria-hidden="true">
                        <i class="fa-solid fa-users-gear"></i>
                    </div>
                    <div class="hrm-brand-text">
                        <span class="hrm-brand-title">QUẢN LÝ NHÂN SỰ</span>
                        <span class="hrm-brand-subtitle d-none d-sm-block">HUMAN RESOURCE MANAGEMENT</span>
                    </div>
                </a>
            </div>

            <!-- ĐƯỜNG PHÂN CÁCH TRÊN DESKTOP -->
            <div class="hrm-topbar-divider d-none d-lg-block" aria-hidden="true"></div>

            <!-- KHU VỰC 3: TÀI KHOẢN NGƯỜI DÙNG (BÊN PHẢI TRÊN CẢ DESKTOP & MOBILE) -->
            <div class="hrm-topbar-account order-lg-3 ms-auto ms-lg-0">
                <AuthorizeView>
                    <Authorized>
                        <div class="dropdown">
                            <button class="hrm-account-btn dropdown-toggle"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false"
                                    title="Tài khoản người dùng">
                                <span class="hrm-account-avatar">
                                    @GetAvatarInitial(context.User)
                                </span>
                                <span class="hrm-account-name d-none d-sm-inline-block text-truncate">
                                    @GetDisplayName(context.User)
                                </span>
                                <i class="fa-solid fa-chevron-down hrm-account-caret" aria-hidden="true"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end hrm-dropdown-menu hrm-user-dropdown">
                                <li class="hrm-user-dropdown-header">
                                    <div class="d-flex align-items-center justify-content-between gap-2 mb-1">
                                        <span class="hrm-user-fullname text-truncate">
                                            @(context.User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? context.User.Identity?.Name)
                                        </span>
                                        <span class="badge @GetRoleBadgeClass(context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value) hrm-role-badge">
                                            @GetRoleDisplayName(context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value)
                                        </span>
                                    </div>
                                    <div class="hrm-user-meta">
                                        @(context.User.FindFirst("EmployeeCode")?.Value ?? "EMP") • @(context.User.FindFirst("DepartmentName")?.Value ?? "Phòng Ban")
                                    </div>
                                </li>
                                <li>
                                    <NavLink class="dropdown-item hrm-dropdown-item" href="/change-password">
                                        <i class="fa-solid fa-key hrm-dropdown-icon"></i>
                                        <span>Đổi Mật Khẩu</span>
                                    </NavLink>
                                </li>
                                <li>
                                    <NavLink class="dropdown-item hrm-dropdown-item" href="/login">
                                        <i class="fa-solid fa-user-check hrm-dropdown-icon"></i>
                                        <span>Đổi Tài Khoản</span>
                                    </NavLink>
                                </li>
                                <li><hr class="dropdown-divider hrm-dropdown-divider" /></li>
                                <li>
                                    <button type="button" class="dropdown-item hrm-dropdown-item hrm-logout-item" @onclick="HandleLogout">
                                        <i class="fa-solid fa-right-from-bracket hrm-dropdown-icon"></i>
                                        <span>Đăng Xuất</span>
                                    </button>
                                </li>
                            </ul>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/login" class="hrm-login-btn">
                            <i class="fa-solid fa-right-to-bracket me-2"></i>
                            <span>Đăng Nhập</span>
                        </a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>

            <!-- KHU VỰC 2: MENU ĐIỀU HƯỚNG CHÍNH -->
            <div class="collapse navbar-collapse order-lg-2 hrm-navbar-collapse" id="navbarMain">
                <ul class="navbar-nav hrm-nav-list me-auto mb-0">
                    <!-- TRANG CHỦ -->
                    <li class="nav-item">
                        <NavLink class="nav-link hrm-nav-link" href="/" Match="NavLinkMatch.All">
                            <i class="fa-solid fa-house hrm-nav-icon" aria-hidden="true"></i>
                            <span>Trang Chủ</span>
                        </NavLink>
                    </li>

                    <!-- CHẤM CÔNG -->
                    <AuthorizeView>
                        <Authorized>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle hrm-nav-link @(IsActive("/face-checkin", "/my-timesheet") ? "active" : "")"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">
                                    <i class="fa-solid fa-calendar-check hrm-nav-icon" aria-hidden="true"></i>
                                    <span>Chấm Công</span>
                                    <i class="fa-solid fa-chevron-down hrm-nav-caret" aria-hidden="true"></i>
                                </a>
                                <ul class="dropdown-menu hrm-dropdown-menu">
                                    <li>
                                        <NavLink class="dropdown-item hrm-dropdown-item" href="/face-checkin">
                                            <i class="fa-solid fa-camera hrm-dropdown-icon"></i>
                                            <span>Chấm Công Khuôn Mặt</span>
                                        </NavLink>
                                    </li>
                                    <li>
                                        <NavLink class="dropdown-item hrm-dropdown-item" href="/my-timesheet">
                                            <i class="fa-solid fa-calendar-days hrm-dropdown-icon"></i>
                                            <span>Lịch Chấm Công Của Tôi</span>
                                        </NavLink>
                                    </li>
                                </ul>
                            </li>
                        </Authorized>
                        <NotAuthorized>
                            <li class="nav-item">
                                <NavLink class="nav-link hrm-nav-link" href="/face-checkin">
                                    <i class="fa-solid fa-calendar-check hrm-nav-icon" aria-hidden="true"></i>
                                    <span>Chấm Công</span>
                                </NavLink>
                            </li>
                        </NotAuthorized>
                    </AuthorizeView>

                    <!-- YÊU CẦU & PHIẾU LƯƠNG -->
                    <AuthorizeView>
                        <Authorized>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle hrm-nav-link @(IsActive("/leave-request", "/my-attendance-requests") ? "active" : "")"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">
                                    <i class="fa-solid fa-file-signature hrm-nav-icon" aria-hidden="true"></i>
                                    <span>Yêu Cầu</span>
                                    <i class="fa-solid fa-chevron-down hrm-nav-caret" aria-hidden="true"></i>
                                </a>
                                <ul class="dropdown-menu hrm-dropdown-menu">
                                    <li>
                                        <NavLink class="dropdown-item hrm-dropdown-item" href="/leave-request">
                                            <i class="fa-solid fa-calendar-plus hrm-dropdown-icon"></i>
                                            <span>Đăng Ký Nghỉ Phép</span>
                                        </NavLink>
                                    </li>
                                    <li>
                                        <NavLink class="dropdown-item hrm-dropdown-item" href="/my-attendance-requests">
                                            <i class="fa-solid fa-clock-rotate-left hrm-dropdown-icon"></i>
                                            <span>Yêu Cầu Chấm Công</span>
                                        </NavLink>
                                    </li>
                                </ul>
                            </li>

                            <!-- PHIẾU LƯƠNG -->
                            <li class="nav-item">
                                <NavLink class="nav-link hrm-nav-link" href="/my-payslip">
                                    <i class="fa-solid fa-file-invoice-dollar hrm-nav-icon" aria-hidden="true"></i>
                                    <span>Phiếu Lương</span>
                                </NavLink>
                            </li>
                        </Authorized>
                    </AuthorizeView>

                    <!-- QUẢN LÝ (QUẢN LÝ / KẾ TOÁN / ADMIN) -->
                    <AuthorizeView Roles="ROLE_MANAGER, ROLE_HR_ACCOUNTANT, ROLE_ADMIN">
                        <Authorized>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle hrm-nav-link @(IsActive("/admin/attendance-approval", "/admin/leave-approval", "/admin/shifts", "/admin/payroll-calculation") ? "active" : "")"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">
                                    <i class="fa-solid fa-briefcase hrm-nav-icon" aria-hidden="true"></i>
                                    <span>Quản Lý</span>
                                    <i class="fa-solid fa-chevron-down hrm-nav-caret" aria-hidden="true"></i>
                                </a>
                                <ul class="dropdown-menu hrm-dropdown-menu">
                                    <AuthorizeView Roles="ROLE_MANAGER, ROLE_ADMIN" Context="mgrContext">
                                        <Authorized>
                                            <li>
                                                <NavLink class="dropdown-item hrm-dropdown-item" href="/admin/attendance-approval">
                                                    <i class="fa-solid fa-user-clock hrm-dropdown-icon"></i>
                                                    <span>Duyệt Chấm Công</span>
                                                </NavLink>
                                            </li>
                                        </Authorized>
                                    </AuthorizeView>
                                    <li>
                                        <NavLink class="dropdown-item hrm-dropdown-item" href="/admin/leave-approval">
                                            <i class="fa-solid fa-calendar-check hrm-dropdown-icon"></i>
                                            <span>Duyệt Nghỉ Phép</span>
                                        </NavLink>
                                    </li>
                                    <li><hr class="dropdown-divider hrm-dropdown-divider" /></li>
                                    <li>
                                        <NavLink class="dropdown-item hrm-dropdown-item" href="/admin/shifts">
                                            <i class="fa-solid fa-business-time hrm-dropdown-icon"></i>
                                            <span>Ca Làm Việc</span>
                                        </NavLink>
                                    </li>
                                    <AuthorizeView Roles="ROLE_HR_ACCOUNTANT, ROLE_ADMIN" Context="accContext">
                                        <Authorized>
                                            <li>
                                                <NavLink class="dropdown-item hrm-dropdown-item" href="/admin/payroll-calculation">
                                                    <i class="fa-solid fa-calculator hrm-dropdown-icon"></i>
                                                    <span>Bảng Công / Tính Lương</span>
                                                </NavLink>
                                            </li>
                                        </Authorized>
                                    </AuthorizeView>
                                </ul>
                            </li>
                        </Authorized>
                    </AuthorizeView>

                    <!-- QUẢN TRỊ (CHỈ ROLE_ADMIN) -->
                    <AuthorizeView Roles="ROLE_ADMIN">
                        <Authorized>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle hrm-nav-link @(IsActive("/admin/face-management", "/admin/user-management") ? "active" : "")"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">
                                    <i class="fa-solid fa-shield-halved hrm-nav-icon" aria-hidden="true"></i>
                                    <span>Quản Trị</span>
                                    <i class="fa-solid fa-chevron-down hrm-nav-caret" aria-hidden="true"></i>
                                </a>
                                <ul class="dropdown-menu hrm-dropdown-menu">
                                    <li>
                                        <NavLink class="dropdown-item hrm-dropdown-item" href="/admin/face-management">
                                            <i class="fa-solid fa-camera-rotate hrm-dropdown-icon"></i>
                                            <span>Quản Lý Khuôn Mặt</span>
                                        </NavLink>
                                    </li>
                                    <li>
                                        <NavLink class="dropdown-item hrm-dropdown-item" href="/admin/user-management">
                                            <i class="fa-solid fa-users-gear hrm-dropdown-icon"></i>
                                            <span>Quản Trị Tài Khoản</span>
                                        </NavLink>
                                    </li>
                                </ul>
                            </li>
                        </Authorized>
                    </AuthorizeView>
                </ul>
            </div>
        </div>
    </nav>
</header>

@code {
    protected override void OnInitialized()
    {
        NavManager.LocationChanged += HandleLocationChanged;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NavManager.LocationChanged -= HandleLocationChanged;
    }

    private void HandleLogout()
    {
        UserSession.SignOut();
        NavManager.NavigateTo("/login");
    }

    private bool IsActive(params string[] routes)
    {
        var relative = "/" + NavManager.ToBaseRelativePath(NavManager.Uri).Trim('/');
        foreach (var r in routes)
        {
            var clean = "/" + r.Trim('/');
            if (clean == "/" && relative == "/") return true;
            if (clean != "/" && relative.StartsWith(clean, StringComparison.OrdinalIgnoreCase)) return true;
        }
        return false;
    }

    private string GetAvatarInitial(System.Security.Claims.ClaimsPrincipal user)
    {
        var name = user.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value 
            ?? user.Identity?.Name 
            ?? "U";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length > 0)
        {
            var last = parts[^1];
            if (last.Length > 0) return last[0].ToString().ToUpperInvariant();
        }
        return "U";
    }

    private string GetDisplayName(System.Security.Claims.ClaimsPrincipal user)
    {
        var name = user.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value 
            ?? user.Identity?.Name 
            ?? "Người dùng";
        return name.Trim();
    }

    private string GetRoleBadgeClass(string? role) => role switch
    {
        "ROLE_ADMIN" => "bg-danger text-white",
        "ROLE_MANAGER" => "bg-primary text-white",
        "ROLE_HR_ACCOUNTANT" => "bg-warning text-dark",
        _ => "bg-success text-white"
    };

    private string GetRoleDisplayName(string? role) => role switch
    {
        "ROLE_ADMIN" => "Admin",
        "ROLE_MANAGER" => "Quản lý",
        "ROLE_HR_ACCOUNTANT" => "Kế toán",
        _ => "Nhân viên"
    };
}
