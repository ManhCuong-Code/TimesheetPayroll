@using TimesheetPayroll.CoreBusiness.Models
@using Microsoft.JSInterop
@inject IJSRuntime JSRuntime

@if (Payslip == null)
{
    <div class="alert alert-light border text-center p-4">
        <i class="fa-solid fa-file-invoice text-muted fs-1 mb-2"></i>
        <div class="text-muted">Không tìm thấy thông tin phiếu lương của kỳ này.</div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm overflow-hidden mb-4">
        <div class="card-header bg-primary text-white p-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge bg-white text-primary fw-bold">HỆ THỐNG QUẢN LÝ NHÂN SỰ</span>
                        <span class="badge bg-primary-subtle text-white border border-light">PHIẾU LƯƠNG CÁ NHÂN</span>
                    </div>
                    <h3 class="h4 mb-0 fw-bold">@Payslip.EmployeeName</h3>
                    <div class="small opacity-75">Mã NV: <strong>@Payslip.EmployeeCode</strong> | Phòng ban: @(Payslip.DepartmentName ?? "Văn phòng")</div>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <div class="text-end">
                        <div class="small opacity-75">THỰC LĨNH CHUYỂN KHOẢN (NET)</div>
                        <div class="display-6 fw-bold">@Payslip.NetSalary.ToString("N0") <span class="fs-6">VNĐ</span></div>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-light btn-sm shadow-sm" @onclick="HandlePrintPayslipAsync" title="In phiếu lương cá nhân">
                            <i class="fa-solid fa-print me-1"></i>In Phiếu Lương
                        </button>
                        @if (OnClose.HasDelegate)
                        {
                            <button type="button" class="btn-close btn-close-white" aria-label="Close" @onclick="() => OnClose.InvokeAsync()"></button>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="card-body p-4">
            <!-- TỔNG QUAN 3 CHỈ SỐ -->
            <div class="row g-3 mb-4 text-center">
                <div class="col-md-4">
                    <div class="p-3 bg-light rounded-3 border">
                        <div class="text-muted small">Ngày Công Thực Tế</div>
                        <div class="fs-4 fw-bold text-dark mt-1">@Payslip.ActualWorkDays công</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 bg-light rounded-3 border">
                        <div class="text-muted small">Tổng Thu Nhập Gộp (Gross)</div>
                        <div class="fs-4 fw-bold text-primary mt-1">+@Payslip.GrossSalary.ToString("N0") đ</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 bg-light rounded-3 border">
                        <div class="text-muted small">Tổng Khấu Trừ Bảo Hiểm</div>
                        <div class="fs-4 fw-bold text-danger mt-1">-@Payslip.TotalDeductions.ToString("N0") đ</div>
                    </div>
                </div>
            </div>

            <!-- DANH SÁCH CÁC KHOẢN CỘNG / TRỪ CHI TIẾT -->
            <h6 class="fw-bold mb-3 text-secondary border-bottom pb-2">
                <i class="fa-solid fa-list-ol me-2"></i>Bảng Kê Chi Tiết Từng Khoản Mục
            </h6>
            <div class="list-group list-group-flush mb-4">
                @foreach (var line in Payslip.Lines)
                {
                    <div @key="line.Id" class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                        <div>
                            @if (line.IsDeduction)
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle me-2">Khấu trừ</span>
                            }
                            else
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle me-2">Thu nhập</span>
                            }
                            <span class="text-dark">@line.LineDescription</span>
                        </div>
                        <span class="fw-bold @(line.IsDeduction ? "text-danger" : "text-success")">
                            @(line.IsDeduction ? "-" : "+")@line.Amount.ToString("N0") đ
                        </span>
                    </div>
                }
            </div>

            <!-- THÔNG TIN NGÂN HÀNG -->
            <div class="alert alert-light border d-flex align-items-center mb-0">
                <i class="fa-solid fa-building-columns text-primary fs-4 me-3"></i>
                <div>
                    <div class="small text-muted">Số tài khoản nhận lương:</div>
                    <div class="fw-bold text-dark">@Payslip.BankAccountNumber - @Payslip.BankName</div>
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL XEM TRƯỚC VÀ IN PHIẾU LƯƠNG CHUẨN A4/A5 -->
    @if (showPrintModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.65); z-index: 1060;">
            <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content shadow-lg border-0">
                    <div class="modal-header bg-dark text-white py-3 d-print-none">
                        <h5 class="modal-title h6 fw-bold">
                            <i class="fa-solid fa-print me-2 text-primary"></i>In Phiếu Lương Cá Nhân - @Payslip.EmployeeName
                        </h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="() => showPrintModal = false"></button>
                    </div>
                    <div class="modal-body p-4 bg-white" id="payslipPrintArea">
                        <div class="payslip-print-sheet p-3 border rounded bg-white">
                            <!-- HEADER -->
                            <div class="d-flex justify-content-between align-items-start border-bottom pb-3 mb-3">
                                <div>
                                    <div class="fw-bold text-uppercase fs-6 text-primary">CÔNG TY TNHH HỆ THỐNG QUẢN TRỊ DOANH NGHIỆP</div>
                                    <div class="small text-muted">Hệ Thống Quản Lý Nhân Sự – Chấm Công – Tính Lương</div>
                                    <div class="small text-muted">Bộ phận: Phòng Kế Toán - Tiền Lương</div>
                                </div>
                                <div class="text-end">
                                    <div class="badge bg-light text-dark border fw-bold px-2 py-1 mb-1">MẪU SỐ 02-LĐTL</div>
                                    <div class="small text-muted">Mã phiếu: <strong>PS-@Payslip.PeriodId-@Payslip.EmployeeCode</strong></div>
                                    <div class="small text-muted">Ngày lập: @DateTime.Today.ToString("dd/MM/yyyy")</div>
                                </div>
                            </div>

                            <div class="text-center my-3">
                                <h4 class="fw-bold text-uppercase text-dark mb-1">PHIẾU THANH TOÁN TIỀN LƯƠNG</h4>
                                <div class="fst-italic text-muted small">Kỳ lương: Tháng @(Payslip.PeriodMonth > 0 ? Payslip.PeriodMonth : 10)/@(Payslip.PeriodYear > 0 ? Payslip.PeriodYear : 2026)</div>
                            </div>

                            <!-- THÔNG TIN NHÂN SỰ -->
                            <div class="row g-2 p-2 bg-light rounded border mb-3 small">
                                <div class="col-6"><strong>Họ và tên:</strong> @Payslip.EmployeeName</div>
                                <div class="col-6"><strong>Mã nhân viên:</strong> @Payslip.EmployeeCode</div>
                                <div class="col-6"><strong>Phòng ban / Bộ phận:</strong> @(Payslip.DepartmentName ?? "Khối Vận Hành")</div>
                                <div class="col-6"><strong>Số ngày công thực tế:</strong> @Payslip.ActualWorkDays ngày</div>
                                <div class="col-6"><strong>Số tài khoản:</strong> @Payslip.BankAccountNumber</div>
                                <div class="col-6"><strong>Ngân hàng thụ hưởng:</strong> @Payslip.BankName</div>
                            </div>

                            <!-- CHI TIẾT BẢNG KÊ THU NHẬP & KHẤU TRỪ -->
                            <table class="table table-sm table-bordered align-middle small mb-3">
                                <thead class="table-light text-center">
                                    <tr>
                                        <th style="width: 40px;">STT</th>
                                        <th>Khoản Mục</th>
                                        <th style="width: 140px;" class="text-end">Thu Nhập (+)</th>
                                        <th style="width: 140px;" class="text-end">Khấu Trừ (-)</th>
                                        <th>Ghi Chú</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ int idx = 1; }
                                    @foreach (var line in Payslip.Lines)
                                    {
                                        <tr>
                                            <td class="text-center">@(idx++)</td>
                                            <td>@line.LineDescription</td>
                                            <td class="text-end fw-semibold @(!line.IsDeduction ? "text-success" : "")">
                                                @(!line.IsDeduction ? line.Amount.ToString("N0") + " đ" : "-")
                                            </td>
                                            <td class="text-end fw-semibold @(line.IsDeduction ? "text-danger" : "")">
                                                @(line.IsDeduction ? line.Amount.ToString("N0") + " đ" : "-")
                                            </td>
                                            <td class="text-muted small">@(line.IsDeduction ? "Trích nộp theo luật" : "Hưởng theo hợp đồng")</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-light fw-bold">
                                    <tr>
                                        <td colspan="2" class="text-end">TỔNG CỘNG:</td>
                                        <td class="text-end text-success">+@Payslip.GrossSalary.ToString("N0") đ</td>
                                        <td class="text-end text-danger">-@Payslip.TotalDeductions.ToString("N0") đ</td>
                                        <td></td>
                                    </tr>
                                    <tr class="table-success border-top border-2 border-success">
                                        <td colspan="2" class="text-end fs-6">SỐ TIỀN THỰC LĨNH (NET):</td>
                                        <td colspan="2" class="text-end text-success fs-5 fw-bold">@Payslip.NetSalary.ToString("N0") VNĐ</td>
                                        <td>Chuyển khoản</td>
                                    </tr>
                                </tfoot>
                            </table>

                            <!-- CHỮ KÝ 2 BÊN -->
                            <div class="row text-center mt-4 pt-3 small">
                                <div class="col-6">
                                    <div class="fw-bold mb-1">NGƯỜI NHẬN TIỀN</div>
                                    <div class="text-muted fst-italic mb-4">(Ký và ghi rõ họ tên)</div>
                                    <div class="mt-4 pt-4 fw-semibold">@Payslip.EmployeeName</div>
                                </div>
                                <div class="col-6">
                                    <div class="fw-bold mb-1">NGƯỜI LẬP BIỂU / KẾ TOÁN</div>
                                    <div class="text-muted fst-italic mb-4">(Ký và ghi rõ họ tên)</div>
                                    <div class="mt-4 pt-4 fw-semibold">Phòng Kế Toán Doanh Nghiệp</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light py-2 d-print-none">
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="() => showPrintModal = false">
                            <i class="fa-solid fa-xmark me-1"></i>Đóng
                        </button>
                        <button type="button" class="btn btn-primary btn-sm px-3 shadow-sm" @onclick="TriggerBrowserPrintAsync">
                            <i class="fa-solid fa-print me-1"></i>In Ngay (Print)
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter] public Payslip? Payslip { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private bool showPrintModal = false;

    private void HandlePrintPayslipAsync()
    {
        showPrintModal = true;
    }

    private async Task TriggerBrowserPrintAsync()
    {
        await JSRuntime.InvokeVoidAsync("window.print");
    }
}
