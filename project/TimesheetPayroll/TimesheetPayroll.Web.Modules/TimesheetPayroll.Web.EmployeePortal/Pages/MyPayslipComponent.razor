@page "/my-payslip"
@inject IViewMyPayslipUseCase ViewPayslipUseCase
@using TimesheetPayroll.Web.EmployeePortal.Controls

<div class="container py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h4 mb-1 text-dark fw-bold">
                <i class="fa-solid fa-file-invoice-dollar text-primary me-2"></i>Phiếu Lương Của Tôi
            </h2>
            <p class="text-muted small mb-0">Tra cứu chi tiết thu nhập, tiền công và các khoản trích nộp bảo hiểm cá nhân.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="text-muted small">Kỳ lương:</span>
            <span class="badge bg-primary px-3 py-2 fs-6">Tháng 10/2026</span>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <div class="mt-2 text-muted">Đang tải phiếu lương...</div>
        </div>
    }
    else
    {
        <PayslipDetailCard Payslip="@payslip" />
    }
</div>

@code {
    private const long CurrentEmployeeId = 1; // Giả lập nhân viên EMP001 (Nguyễn Văn A)
    private const long PeriodId = 10;          // Tháng 10/2026
    private Payslip? payslip;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            payslip = await ViewPayslipUseCase.ExecuteAsync(PeriodId, CurrentEmployeeId);
        }
        finally
        {
            isLoading = false;
        }
    }
}
