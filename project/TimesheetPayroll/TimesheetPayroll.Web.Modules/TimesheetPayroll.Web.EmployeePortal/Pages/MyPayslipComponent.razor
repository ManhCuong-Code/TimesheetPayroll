@page "/my-payslip"
@attribute [Authorize]
@inject IViewMyPayslipUseCase ViewPayslipUseCase
@inject IGetEmployeePayslipHistoryUseCase HistoryUseCase
@using TimesheetPayroll.Web.Common.Controls

<PageTitle>Phiếu Lương Của Tôi - HỆ THỐNG QUẢN LÝ NHÂN SỰ – CHẤM CÔNG – TÍNH LƯƠNG</PageTitle>

<div class="container py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h2 class="h4 mb-1 text-dark fw-bold">
                <i class="fa-solid fa-file-invoice-dollar text-primary me-2"></i>Phiếu Lương Của Tôi
            </h2>
            <p class="text-muted small mb-0">Tra cứu chi tiết thu nhập, tiền công và các khoản trích nộp bảo hiểm cá nhân.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            @if (allPayslips.Any())
            {
                <div class="d-flex align-items-center gap-2">
                    <span class="text-muted small">Kỳ lương:</span>
                    <select class="form-select form-select-sm" style="width: auto;" @bind="selectedPeriodId" @bind:after="OnPeriodChangedAsync">
                        @foreach (var p in allPayslips)
                        {
                            <option @key="p.PeriodId" value="@p.PeriodId">@FormatPeriod(p)</option>
                        }
                    </select>
                </div>
            }

            <a href="/ai-salary-assistant" class="btn btn-outline-primary btn-sm rounded-pill px-3 shadow-sm">
                <i class="fa-solid fa-robot me-1 text-primary"></i>Trợ Lý Lương AI
            </a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="fa-solid fa-triangle-exclamation me-2"></i>@errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
        </div>
    }

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <div class="mt-2 text-muted">Đang tải phiếu lương...</div>
        </div>
    }
    else
    {
        <div class="position-relative">
            <PayslipDetailCard Payslip="@payslip" />

            <!-- AI QUICK PROMPT FLOATING BANNER -->
            @if (payslip != null)
            {
                <div class="card border-0 bg-light rounded-3 p-3 mt-3 shadow-sm">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <div class="d-flex align-items-center gap-2">
                            <div class="bg-primary text-white rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                                <i class="fa-solid fa-sparkles"></i>
                            </div>
                            <div>
                                <div class="fw-bold small text-dark">Bạn có thắc mắc về phiếu lương @FormatPeriod(payslip)?</div>
                                <div class="text-muted" style="font-size: 0.75rem;">Trợ lý Lương AI sẵn sàng phân tích chênh lệch so với kỳ trước và giải thích bảo hiểm.</div>
                            </div>
                        </div>
                        <a href="/ai-salary-assistant" class="btn btn-primary btn-sm rounded-pill px-3 fw-semibold">
                            <i class="fa-solid fa-comments me-1"></i>Hỏi AI Ngay
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private long currentEmployeeId = 1;
    private long selectedPeriodId = 10;
    private List<Payslip> allPayslips = new();
    private Payslip? payslip;
    private bool isLoading = true;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        errorMessage = string.Empty;
        try
        {
            if (AuthStateTask != null)
            {
                var authState = await AuthStateTask;
                var empIdClaim = authState.User.FindFirst("EmployeeId")?.Value;
                if (long.TryParse(empIdClaim, out var id) && id > 0)
                {
                    currentEmployeeId = id;
                }
            }

            var history = await HistoryUseCase.ExecuteAsync(currentEmployeeId);
            allPayslips = history.ToList();

            if (allPayslips.Any())
            {
                selectedPeriodId = allPayslips.First().PeriodId;
                payslip = allPayslips.First();
            }
            else
            {
                payslip = await ViewPayslipUseCase.ExecuteAsync(selectedPeriodId, currentEmployeeId);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Không thể tải thông tin phiếu lương: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnPeriodChangedAsync()
    {
        isLoading = true;
        try
        {
            payslip = await ViewPayslipUseCase.ExecuteAsync(selectedPeriodId, currentEmployeeId);
        }
        catch (Exception ex)
        {
            errorMessage = $"Không thể nạp phiếu lương kỳ đã chọn: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private string FormatPeriod(Payslip p)
    {
        if (p.PeriodMonth > 0)
            return $"Tháng {p.PeriodMonth}/{p.PeriodYear}";
        if (!string.IsNullOrEmpty(p.PeriodCode))
            return p.PeriodCode;
        return $"Kỳ #{p.PeriodId}";
    }
}
