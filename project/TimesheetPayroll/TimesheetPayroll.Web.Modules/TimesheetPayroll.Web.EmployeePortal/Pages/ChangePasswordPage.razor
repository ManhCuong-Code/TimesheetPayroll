@page "/change-password"
@inject IChangePasswordUseCase ChangePasswordUseCase
@inject NavigationManager NavManager
@using TimesheetPayroll.UseCases.Authentication
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization

<AuthorizeView>
    <Authorized>
        <div class="container py-4">
            <div class="row justify-content-center">
                <div class="col-lg-6 col-md-8 col-sm-12">
                    <!-- BREADCRUMB & HEADER -->
                    <div class="d-flex align-items-center mb-3 text-muted small">
                        <a href="/" class="text-decoration-none text-muted">
                            <i class="fa-solid fa-house me-1"></i>Trang Chủ
                        </a>
                        <span class="mx-2">/</span>
                        <span class="text-dark fw-semibold">Đổi Mật Khẩu</span>
                    </div>

                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                        <!-- CARD HEADER -->
                        <div class="card-header border-0 py-3 px-4 text-white" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);">
                            <div class="d-flex align-items-center justify-content-between">
                                <div>
                                    <h4 class="h5 mb-1 fw-bold text-white d-flex align-items-center">
                                        <div class="bg-warning text-dark rounded-circle d-inline-flex align-items-center justify-content-center p-2 me-2" style="width:34px; height:34px;">
                                            <i class="fa-solid fa-key" style="font-size: 0.9rem;"></i>
                                        </div>
                                        Đổi Mật Khẩu Cá Nhân
                                    </h4>
                                    <p class="text-white-50 small mb-0">Cập nhật mật khẩu bảo mật tài khoản cho nhân viên</p>
                                </div>
                                <span class="badge bg-warning text-dark px-2 py-1 fw-bold">Bảo Mật RBAC</span>
                            </div>
                        </div>

                        <div class="card-body p-4">
                            <!-- THÔNG TIN TÀI KHOẢN ĐANG ĐĂNG NHẬP -->
                            <div class="p-3 mb-4 rounded-3 bg-light border d-flex align-items-center justify-content-between">
                                <div class="d-flex align-items-center">
                                    <div class="bg-primary text-white rounded-circle p-2 me-3 d-flex align-items-center justify-content-center" style="width:42px; height:42px;">
                                        <i class="fa-solid fa-user-shield fs-5"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark">
                                            @(context.User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? context.User.Identity?.Name)
                                            <span class="badge bg-primary-subtle text-primary ms-1" style="font-size:0.7rem;">
                                                @(context.User.Identity?.Name)
                                            </span>
                                        </div>
                                        <div class="text-muted small">
                                            Mã NV: @(context.User.FindFirst("EmployeeCode")?.Value ?? "EMP") • @(context.User.FindFirst("DepartmentName")?.Value ?? "Phòng Ban")
                                        </div>
                                    </div>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(alertMessage))
                            {
                                <div class="alert alert-@alertType alert-dismissible fade show shadow-sm" role="alert">
                                    <i class="fa-solid @(alertType == "success" ? "fa-circle-check" : "fa-triangle-exclamation") me-2"></i>
                                    @alertMessage
                                    <button type="button" class="btn-close" @onclick="() => alertMessage = string.Empty"></button>
                                </div>
                            }

                            <!-- FORM ĐỔI MẬT KHẨU -->
                            <form @onsubmit="HandleChangePasswordAsync">
                                <!-- 1. MẬT KHẨU CŨ (HIỆN TẠI) -->
                                <div class="mb-3">
                                    <label class="form-label small fw-bold text-dark">
                                        Mật Khẩu Hiện Tại (Mật khẩu cũ) <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-white text-muted">
                                            <i class="fa-solid fa-lock"></i>
                                        </span>
                                        <input type="@(showCurrentPassword ? "text" : "password")" 
                                               class="form-control" 
                                               placeholder="Nhập mật khẩu đang sử dụng..." 
                                               @bind="currentPassword" 
                                               disabled="@isSubmitting" />
                                        <button class="btn btn-outline-secondary" type="button" @onclick="() => showCurrentPassword = !showCurrentPassword" tabindex="-1">
                                            <i class="fa-solid @(showCurrentPassword ? "fa-eye-slash" : "fa-eye")"></i>
                                        </button>
                                    </div>
                                    <div class="form-text" style="font-size: 0.75rem;">
                                        Bắt buộc nhập mật khẩu cũ để xác thực quyền chủ sở hữu tài khoản.
                                    </div>
                                </div>

                                <hr class="my-3 text-secondary opacity-25" />

                                <!-- 2. MẬT KHẨU MỚI (LẦN 1) -->
                                <div class="mb-3">
                                    <label class="form-label small fw-bold text-dark">
                                        Mật Khẩu Mới <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-white text-muted">
                                            <i class="fa-solid fa-key"></i>
                                        </span>
                                        <input type="@(showNewPassword ? "text" : "password")" 
                                               class="form-control" 
                                               placeholder="Nhập mật khẩu mới (tối thiểu 6 ký tự)..." 
                                               @bind="newPassword" 
                                               disabled="@isSubmitting" />
                                        <button class="btn btn-outline-secondary" type="button" @onclick="() => showNewPassword = !showNewPassword" tabindex="-1">
                                            <i class="fa-solid @(showNewPassword ? "fa-eye-slash" : "fa-eye")"></i>
                                        </button>
                                    </div>
                                    <div class="form-text" style="font-size: 0.75rem;">
                                        Mật khẩu mới phải có tối thiểu 6 ký tự và khác mật khẩu hiện tại.
                                    </div>
                                </div>

                                <!-- 3. XÁC NHẬN MẬT KHẨU MỚI (LẦN 2) -->
                                <div class="mb-4">
                                    <label class="form-label small fw-bold text-dark">
                                        Xác Nhận Mật Khẩu Mới (Nhập lại lần 2) <span class="text-danger">*</span>
                                    </label>
                                    <div class="input-group">
                                        <span class="input-group-text bg-white text-muted">
                                            <i class="fa-solid fa-shield-check"></i>
                                        </span>
                                        <input type="@(showConfirmPassword ? "text" : "password")" 
                                               class="form-control @GetConfirmBorderClass()" 
                                               placeholder="Nhập lại mật khẩu mới để xác nhận..." 
                                               @bind="confirmNewPassword" 
                                               @bind:event="oninput" 
                                               disabled="@isSubmitting" />
                                        <button class="btn btn-outline-secondary" type="button" @onclick="() => showConfirmPassword = !showConfirmPassword" tabindex="-1">
                                            <i class="fa-solid @(showConfirmPassword ? "fa-eye-slash" : "fa-eye")"></i>
                                        </button>
                                    </div>
                                    @if (!string.IsNullOrEmpty(newPassword) && !string.IsNullOrEmpty(confirmNewPassword))
                                    {
                                        if (string.Equals(newPassword, confirmNewPassword, StringComparison.Ordinal))
                                        {
                                            <div class="text-success small mt-1">
                                                <i class="fa-solid fa-circle-check me-1"></i>Mật khẩu xác nhận đã trùng khớp!
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="text-danger small mt-1">
                                                <i class="fa-solid fa-circle-xmark me-1"></i>Mật khẩu xác nhận chưa trùng khớp.
                                            </div>
                                        }
                                    }
                                </div>

                                <!-- KHUYẾN NGHỊ BẢO MẬT -->
                                <div class="p-3 mb-4 rounded-3 bg-warning bg-opacity-10 border border-warning border-opacity-25 small">
                                    <div class="fw-bold text-dark mb-1">
                                        <i class="fa-solid fa-shield-halved text-warning me-1"></i>Quy định bảo mật tài khoản:
                                    </div>
                                    <ul class="mb-0 ps-3 text-muted" style="font-size: 0.8rem;">
                                        <li>Mật khẩu mới được tự động băm mã hóa một chiều qua thuật toán <strong>BCrypt</strong>.</li>
                                        <li>Tuyệt đối không tiết lộ thông tin đăng nhập cho người khác.</li>
                                        <li>Sau khi đổi mật khẩu, bạn có thể tiếp tục làm việc bình thường hoặc dùng mật khẩu mới khi đăng nhập lại.</li>
                                    </ul>
                                </div>

                                <!-- NÚT HÀNH ĐỘNG -->
                                <div class="d-flex gap-2 justify-content-end">
                                    <a href="/my-timesheet" class="btn btn-light px-3">
                                        <i class="fa-solid fa-arrow-left me-1"></i>Quay Lại
                                    </a>
                                    <button type="submit" class="btn btn-warning px-4 fw-bold shadow-sm" disabled="@isSubmitting">
                                        @if (isSubmitting)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                            <span>Đang cập nhật...</span>
                                        }
                                        else
                                        {
                                            <i class="fa-solid fa-floppy-disk me-1"></i>
                                            <span>Xác Nhận Đổi Mật Khẩu</span>
                                        }
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="container py-5 text-center">
            <div class="alert alert-warning d-inline-block shadow-sm p-4">
                <i class="fa-solid fa-lock fs-1 text-warning mb-3 d-block"></i>
                <h4 class="fw-bold">Yêu Cầu Đăng Nhập</h4>
                <p class="mb-3 text-muted">Bạn cần đăng nhập vào hệ thống để có thể thực hiện đổi mật khẩu cá nhân.</p>
                <a href="/login" class="btn btn-primary">
                    <i class="fa-solid fa-right-to-bracket me-1"></i>Đến Trang Đăng Nhập
                </a>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private string currentPassword = string.Empty;
    private string newPassword = string.Empty;
    private string confirmNewPassword = string.Empty;

    private bool showCurrentPassword = false;
    private bool showNewPassword = false;
    private bool showConfirmPassword = false;

    private bool isSubmitting = false;
    private string alertMessage = string.Empty;
    private string alertType = "success";

    private string GetConfirmBorderClass()
    {
        if (string.IsNullOrEmpty(newPassword) || string.IsNullOrEmpty(confirmNewPassword))
            return string.Empty;

        return string.Equals(newPassword, confirmNewPassword, StringComparison.Ordinal)
            ? "border-success"
            : "border-danger";
    }

    private async Task HandleChangePasswordAsync()
    {
        alertMessage = string.Empty;

        if (AuthStateTask == null)
        {
            alertMessage = "Không xác định được phiên đăng nhập của người dùng.";
            alertType = "danger";
            return;
        }

        var authState = await AuthStateTask;
        var username = authState.User.Identity?.Name;
        if (string.IsNullOrWhiteSpace(username))
        {
            alertMessage = "Phiên làm việc đã hết hạn. Vui lòng đăng nhập lại.";
            alertType = "danger";
            return;
        }

        isSubmitting = true;
        try
        {
            await ChangePasswordUseCase.ExecuteByUsernameAsync(username, currentPassword, newPassword, confirmNewPassword);

            alertMessage = "ĐỔI MẬT KHẨU THÀNH CÔNG! Mật khẩu mới đã được cập nhật và bảo mật an toàn.";
            alertType = "success";

            // Reset form
            currentPassword = string.Empty;
            newPassword = string.Empty;
            confirmNewPassword = string.Empty;
        }
        catch (Exception ex)
        {
            alertMessage = ex.Message;
            alertType = "danger";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}
