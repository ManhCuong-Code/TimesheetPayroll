@page "/face-checkin"
@implements IAsyncDisposable
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using TimesheetPayroll.CoreBusiness.Models
@using TimesheetPayroll.UseCases.AdminPortal
@using TimesheetPayroll.UseCases.Authentication
@using TimesheetPayroll.UseCases.EmployeePortal
@using TimesheetPayroll.UseCases.PluginInterfaces.DataStore
@inject IFaceCheckInUseCase FaceCheckInUseCase
@inject IEmployeeRepository EmployeeRepo
@inject IUserSessionService UserSession
@inject IJSRuntime JSRuntime
@inject NavigationManager NavManager

<PageTitle>Chấm Công Bằng Khuôn Mặt - HỆ THỐNG QUẢN LÝ NHÂN SỰ – CHẤM CÔNG – TÍNH LƯƠNG</PageTitle>

<div class="container-fluid py-3">
    <!-- TIÊU ĐỀ ĐƠN VỊ & PHÂN HỆ -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 pb-2 border-bottom gap-2">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 fw-bold">
                    <i class="fa-solid fa-building me-1"></i>HỆ THỐNG QUẢN TRỊ DOANH NGHIỆP
                </span>
                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 fw-semibold">
                    <i class="fa-solid fa-wand-magic-sparkles me-1"></i>Tự Động Nhận Diện & Tự Phân Giải Ca
                </span>
            </div>
            <h2 class="h4 mb-0 text-dark fw-bold">
                <i class="fa-solid fa-face-smile text-primary me-2"></i>Chấm Công Bằng Khuôn Mặt
            </h2>
            <p class="text-muted small mb-0 mt-1">
                Đưa khuôn mặt vào khung hình camera. Hệ thống sẽ tự động xác minh danh tính và phân giải ca làm việc theo lịch phân công thực tế.
            </p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="/my-timesheet" class="btn btn-outline-primary shadow-sm">
                <i class="fa-solid fa-calendar-days me-1"></i>Bảng Công Cá Nhân
            </a>
            <AuthorizeView Roles="ROLE_ADMIN, ROLE_HR_ACCOUNTANT">
                <Authorized>
                    <a href="/admin/shifts" class="btn btn-outline-dark shadow-sm">
                        <i class="fa-solid fa-business-time me-1"></i>Quản Lý Phân Ca
                    </a>
                    <a href="/admin/face-management" class="btn btn-danger shadow-sm">
                        <i class="fa-solid fa-user-shield me-1"></i>Hồ Sơ Khuôn Mặt
                    </a>
                </Authorized>
            </AuthorizeView>
        </div>
    </div>

    <!-- KHỐI CHÍNH: CAMERA VÀ KẾT QUẢ TỰ ĐỘNG -->
    <div class="row g-4">
        <!-- CỘT TRÁI: CAMERA VIEWPORT & HUD THÔNG MINH -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-dark text-white">
                <div class="card-header bg-black bg-opacity-40 py-3 px-4 d-flex justify-content-between align-items-center border-secondary border-opacity-25">
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge @(isCameraActive ? "bg-success" : "bg-secondary") rounded-pill px-3 py-1 fw-bold">
                            <i class="fa-solid fa-circle fa-fade me-1"></i>@(isCameraActive ? "CAMERA LIVE" : "CAMERA TẮT")
                        </span>
                        <span class="small text-white-50">Sinh Trắc Học AI • Tự Phân Biệt Vào/Ra</span>
                    </div>
                    <div class="small font-monospace text-info">
                        <i class="fa-regular fa-clock me-1"></i>@currentTime.ToString("HH:mm:ss")
                    </div>
                </div>

                <!-- KHU VỰC VIDEO & OVERLAY CANVAS -->
                <div class="position-relative d-flex justify-content-center align-items-center" style="min-height: 440px; background-color: #0b0f19;">
                    <video id="faceCheckInVideo" autoplay playsinline muted 
                           style="width: 100%; max-height: 480px; object-fit: cover; display: @(isCameraActive ? "block" : "none");"></video>
                    
                    <canvas id="faceCheckInCanvas" 
                            style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; display: @(isCameraActive ? "block" : "none");"></canvas>

                    @if (!isCameraActive)
                    {
                        <div class="text-center p-5">
                            <div class="bg-secondary bg-opacity-25 rounded-circle p-4 d-inline-flex mb-3">
                                <i class="fa-solid fa-camera-retro fs-1 text-secondary"></i>
                            </div>
                            <h5 class="fw-bold text-white mb-2">Camera Chưa Được Kích Hoạt</h5>
                            <p class="text-white-50 small mb-4" style="max-width: 380px;">
                                Vui lòng nhấn nút bên dưới để cấp quyền và mở camera. Đưa khuôn mặt vào giữa khung hình để thực hiện chấm công tự động.
                            </p>
                            <button class="btn btn-primary btn-lg px-4 shadow fw-bold" @onclick="StartCameraAsync" disabled="@isBusy">
                                @if (isBusy)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    <span>Đang kết nối camera...</span>
                                }
                                else
                                {
                                    <i class="fa-solid fa-video me-2"></i>
                                    <span>Bật Camera Chấm Công</span>
                                }
                            </button>
                        </div>
                    }
                </div>

                <!-- HƯỚNG DẪN TRỰC TIẾP & ĐIỀU KHIỂN DƯỚI CAMERA -->
                <div class="card-footer bg-black bg-opacity-50 p-3 border-secondary border-opacity-25">
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                        <div class="d-flex align-items-center gap-2">
                            @if (isCameraActive)
                            {
                                <button class="btn btn-success fw-bold px-3 py-2 shadow-sm d-flex align-items-center" 
                                        @onclick="CaptureAndVerifyAsync" disabled="@isBusy">
                                    @if (isBusy)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2"></span>
                                        <span>Đang phân tích khuôn mặt & ca...</span>
                                    }
                                    else
                                    {
                                        <i class="fa-solid fa-expand fs-5 me-2"></i>
                                        <span>Quét & Điểm Danh Ngay</span>
                                    }
                                </button>
                                <button class="btn btn-outline-danger btn-sm px-3 py-2" @onclick="StopCameraAsync" title="Tắt Camera">
                                    <i class="fa-solid fa-power-off me-1"></i>Tắt
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-primary fw-semibold px-3 py-2 shadow-sm" @onclick="StartCameraAsync" disabled="@isBusy">
                                    <i class="fa-solid fa-video me-2"></i>Mở Camera
                                </button>
                            }
                        </div>
                        <div class="d-flex align-items-center gap-2 text-white-50 small">
                            <span class="badge bg-dark border border-secondary text-info px-2 py-1">
                                <i class="fa-solid fa-eye me-1"></i>Liveness Check
                            </span>
                            <span>Đưa khuôn mặt vào khung hình để chấm công</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- HƯỚNG DẪN QUY TRÌNH TỰ ĐỘNG HÓA -->
            <div class="card border-0 bg-light rounded-4 shadow-sm mt-3 p-3">
                <div class="d-flex align-items-start gap-3">
                    <div class="bg-primary text-white rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                        <i class="fa-solid fa-shield-halved fs-6"></i>
                    </div>
                    <div>
                        <h6 class="mb-1 fw-bold text-dark">Quy trình tự động hóa thông minh</h6>
                        <p class="text-muted small mb-0">
                            Nhân viên không cần chọn ca hoặc chọn Vào/Ra thủ công. Hệ thống tự động xác minh mẫu khuôn mặt 128-D, 
                            đối chiếu lịch phân ca thực tế và trạng thái trong ngày để tự động ghi nhận chính xác theo giao dịch SQL an toàn.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- CỘT PHẢI: KẾT QUẢ NHẬN DIỆN & THÔNG TIN CA TỰ ĐỘNG -->
        <div class="col-lg-5">
            <!-- 1. BẢNG TRẠNG THÁI HIỂN THỊ KẾT QUẢ GẦN NHẤT -->
            @if (lastResult != null)
            {
                <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden border-start border-4 @(lastResult.IsSuccess ? "border-success" : "border-danger")">
                    <div class="card-header @(lastResult.IsSuccess ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger") py-3 px-4 d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-2">
                            <i class="fa-solid @(lastResult.IsSuccess ? "fa-circle-check" : "fa-triangle-exclamation") fs-4"></i>
                            <div>
                                <h6 class="mb-0 fw-bold">@(lastResult.IsSuccess ? "ĐIỂM DANH THÀNH CÔNG" : "CHƯA THỂ GHI NHẬN")</h6>
                                <small class="text-muted">@DateTime.Now.ToString("HH:mm:ss dd/MM/yyyy")</small>
                            </div>
                        </div>
                        @if (lastResult.IsSuccess && !string.IsNullOrEmpty(lastResult.PunchType))
                        {
                            <span class="badge @(lastResult.PunchType == "CHECK_IN" ? "bg-success" : "bg-primary") fs-6 px-3 py-2 shadow-sm">
                                <i class="fa-solid @(lastResult.PunchType == "CHECK_IN" ? "fa-right-to-bracket" : "fa-right-from-bracket") me-1"></i>
                                @(lastResult.PunchType == "CHECK_IN" ? "VÀO CA" : "HẾT CA")
                            </span>
                        }
                    </div>

                    <div class="card-body p-4">
                        <p class="fw-semibold @(lastResult.IsSuccess ? "text-dark" : "text-danger") mb-3">
                            @lastResult.Message
                        </p>

                        @if (lastResult.Employee != null)
                        {
                            <!-- THÔNG TIN NHÂN VIÊN ĐÃ XÁC MINH -->
                            <div class="p-3 rounded-3 bg-light border mb-3">
                                <div class="d-flex align-items-center">
                                    <div class="bg-primary text-white rounded-circle me-3 d-flex align-items-center justify-content-center shadow-sm" style="width: 52px; height: 52px;">
                                        <i class="fa-solid fa-user fs-4"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="fw-bold text-dark fs-6">@lastResult.Employee.FullName</div>
                                        <div class="small text-muted font-monospace">
                                            [@lastResult.Employee.EmployeeCode] • @lastResult.Employee.DepartmentName
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- THÔNG TIN CA LÀM VIỆC TỰ ĐỘNG XÁC ĐỊNH -->
                            @if (!string.IsNullOrEmpty(lastResult.ShiftName))
                            {
                                <div class="border rounded-3 p-3 bg-white shadow-sm mb-3">
                                    <div class="text-muted small text-uppercase fw-bold mb-1">
                                        <i class="fa-solid fa-business-time text-primary me-1"></i>Ca làm việc tự xác định:
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="fw-bold text-primary fs-6">@lastResult.ShiftName</div>
                                        @if (lastResult.IsOvernight)
                                        {
                                            <span class="badge bg-dark text-warning">
                                                <i class="fa-solid fa-moon me-1"></i>Ca qua đêm
                                            </span>
                                        }
                                    </div>
                                    @if (lastResult.ShiftStartTime.HasValue && lastResult.ShiftEndTime.HasValue)
                                    {
                                        <div class="small text-secondary mt-1">
                                            Giờ quy định: <span class="fw-bold font-monospace">@lastResult.ShiftStartTime.Value.ToString(@"hh\:mm") - @lastResult.ShiftEndTime.Value.ToString(@"hh\:mm")</span>
                                            • Ngày bắt đầu ca: <span class="fw-bold">@lastResult.WorkDate.ToString("dd/MM/yyyy")</span>
                                        </div>
                                    }
                                </div>
                            }

                            <!-- THỐNG KÊ CHI TIẾT LƯỢT ĐIỂM DANH -->
                            @if (lastResult.IsSuccess)
                            {
                                <div class="row g-2 text-center small">
                                    <div class="col-4">
                                        <div class="p-2 border rounded bg-white">
                                            <div class="text-muted">Giờ Ghi Nhận</div>
                                            <div class="fw-bold font-monospace text-primary">@lastResult.PunchTime?.ToString(@"hh\:mm\:ss")</div>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="p-2 border rounded bg-white">
                                            <div class="text-muted">Độ Tin Cậy AI</div>
                                            <div class="fw-bold text-success">@lastResult.Confidence?.ToString("0.#")%</div>
                                        </div>
                                    </div>
                                    <div class="col-4">
                                        <div class="p-2 border rounded bg-white">
                                            <div class="text-muted">Ngày Công</div>
                                            <div class="fw-bold text-dark">@lastResult.WorkUnits công</div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            }
            else
            {
                <!-- TRẠNG THÁI CHỜ QUÉT -->
                <div class="card border-0 shadow-sm rounded-4 mb-4 p-4 text-center">
                    <div class="my-4">
                        <div class="bg-primary-subtle text-primary rounded-circle p-4 d-inline-flex mb-3">
                            <i class="fa-solid fa-id-badge fs-1"></i>
                        </div>
                        <h5 class="fw-bold text-dark mb-1">Sẵn Sàng Điểm Danh</h5>
                        <p class="text-muted small mb-0" style="max-width: 320px; margin: 0 auto;">
                            Đưa khuôn mặt vào khung hình camera. Hệ thống tự động xác thực danh tính và phân giải ca làm việc từ lịch phân công.
                        </p>
                    </div>
                    <div class="p-3 bg-light rounded-3 text-start border small">
                        <div class="fw-bold text-secondary mb-2">
                            <i class="fa-solid fa-list-check me-1 text-primary"></i>Quy tắc tự động xác định:
                        </div>
                        <ul class="list-unstyled mb-0 text-muted ps-1">
                            <li class="mb-1"><i class="fa-solid fa-check text-success me-2"></i>Tự động nhận diện danh tính nhân viên.</li>
                            <li class="mb-1"><i class="fa-solid fa-check text-success me-2"></i>Tự chọn ca làm việc theo lịch phân công.</li>
                            <li class="mb-1"><i class="fa-solid fa-check text-success me-2"></i>Tự phân biệt Check-In hoặc Check-Out.</li>
                            <li><i class="fa-solid fa-check text-success me-2"></i>Hỗ trợ ca làm việc xuyên đêm qua 24h.</li>
                        </ul>
                    </div>
                </div>
            }

            <!-- KHỐI MÔ PHỎNG THỬ NGHIỆM (SANDBOX TEST CHO THIẾT BỊ KHÔNG WEBCAM) -->
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <span class="fw-bold small text-dark">
                        <i class="fa-solid fa-flask-vial text-info me-1"></i>Thử Nghiệm Nhận Diện Nhanh (Demo Sandbox)
                    </span>
                    <span class="badge bg-info-subtle text-info border border-info-subtle small">Sandbox Test</span>
                </div>
                <div class="card-body p-3">
                    <p class="text-muted small mb-2">
                        Dành cho kiểm thử chức năng tự động nhận diện và phân giải ca khi thiết bị thử nghiệm không có webcam vật lý:
                    </p>
                    <div class="input-group input-group-sm">
                        <select class="form-select" @bind="demoEmployeeId">
                            @foreach (var emp in allEmployees)
                            {
                                <option value="@emp.Id">[@emp.EmployeeCode] @emp.FullName</option>
                            }
                        </select>
                        <button class="btn btn-primary fw-semibold px-3" @onclick="HandleDemoSimulateAsync" disabled="@isBusy">
                            <i class="fa-solid fa-play me-1"></i>Thử Quét Khuôn Mặt
                        </button>
                    </div>
                    <div class="form-text small text-muted mt-1">
                        Backend tự động lấy vector của nhân viên này, tự truy vấn lịch phân công và đối chiếu ca hiện tại.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private bool isCameraActive = false;
    private bool isBusy = false;
    private DateTime currentTime = DateTime.Now;
    private System.Threading.Timer? clockTimer;

    private List<Employee> allEmployees = new();
    private long demoEmployeeId = 1;
    private FacePunchResult? lastResult;

    protected override async Task OnInitializedAsync()
    {
        clockTimer = new System.Threading.Timer(_ =>
        {
            currentTime = DateTime.Now;
            InvokeAsync(StateHasChanged);
        }, null, 1000, 1000);

        try
        {
            allEmployees = (await EmployeeRepo.GetEmployeesAsync()).ToList();
            if (allEmployees.Any())
            {
                demoEmployeeId = allEmployees.First().Id;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Lỗi tải danh sách nhân sự: {ex.Message}");
        }
    }

    private async Task StartCameraAsync()
    {
        isBusy = true;
        try
        {
            var res = await JSRuntime.InvokeAsync<CameraInitResult>("FaceRecognitionHelper.startCamera", "faceCheckInVideo", "faceCheckInCanvas", null);
            if (res.Success)
            {
                isCameraActive = true;
            }
            else
            {
                lastResult = new FacePunchResult
                {
                    IsSuccess = false,
                    Message = res.Error ?? "Không thể kết nối camera."
                };
            }
        }
        catch (Exception ex)
        {
            lastResult = new FacePunchResult
            {
                IsSuccess = false,
                Message = $"Lỗi khi khởi chạy camera: {ex.Message}"
            };
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task StopCameraAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("FaceRecognitionHelper.stopCamera", "faceCheckInVideo");
        }
        catch { }
        isCameraActive = false;
    }

    private async Task CaptureAndVerifyAsync()
    {
        if (isBusy || !isCameraActive) return;

        isBusy = true;
        try
        {
            var captureRes = await JSRuntime.InvokeAsync<FaceCaptureResult>("FaceRecognitionHelper.captureFaceDescriptor", "faceCheckInVideo");
            if (!captureRes.Success || captureRes.Descriptor == null || captureRes.Descriptor.Length == 0)
            {
                lastResult = new FacePunchResult
                {
                    IsSuccess = false,
                    Message = captureRes.Error ?? "Chưa căn chỉnh được khuôn mặt rõ nét trong khung hình. Vui lòng nhìn thẳng và giữ yên."
                };
                await JSRuntime.InvokeVoidAsync("FaceRecognitionHelper.playChime", "error");
                return;
            }

            var request = new FacePunchRequest
            {
                Descriptor = captureRes.Descriptor,
                LivenessScore = (decimal)captureRes.LivenessScore,
                DeviceInfo = "Trạm Camera Điểm Danh Văn Phòng",
                PerformedBy = UserSession.CurrentUser?.Username ?? "KIOSK"
            };

            lastResult = await FaceCheckInUseCase.ExecuteAsync(request);

            if (lastResult.IsSuccess)
            {
                await JSRuntime.InvokeVoidAsync("FaceRecognitionHelper.playChime", "success");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("FaceRecognitionHelper.playChime", "error");
            }
        }
        catch (Exception ex)
        {
            lastResult = new FacePunchResult
            {
                IsSuccess = false,
                Message = $"Lỗi xử lý xác minh khuôn mặt: {ex.Message}"
            };
            await JSRuntime.InvokeVoidAsync("FaceRecognitionHelper.playChime", "error");
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task HandleDemoSimulateAsync()
    {
        isBusy = true;
        try
        {
            var request = new FacePunchRequest
            {
                // Vector giả lập ngẫu nhiên (sẽ được đối chiếu bằng SimulatedEmployeeId ở sandbox mode)
                Descriptor = new float[128],
                LivenessScore = 0.95m,
                SimulatedEmployeeId = demoEmployeeId,
                DeviceInfo = "Simulated Biometric Terminal",
                PerformedBy = UserSession.CurrentUser?.Username ?? "DEMO_TEST"
            };

            lastResult = await FaceCheckInUseCase.ExecuteAsync(request);

            if (lastResult.IsSuccess)
            {
                await JSRuntime.InvokeVoidAsync("FaceRecognitionHelper.playChime", "success");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("FaceRecognitionHelper.playChime", "error");
            }
        }
        catch (Exception ex)
        {
            lastResult = new FacePunchResult
            {
                IsSuccess = false,
                Message = $"Lỗi thử nghiệm mô phỏng: {ex.Message}"
            };
        }
        finally
        {
            isBusy = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        clockTimer?.Dispose();
        if (isCameraActive)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("FaceRecognitionHelper.stopCamera", "faceCheckInVideo");
            }
            catch { }
        }
    }

    public class CameraInitResult
    {
        public bool Success { get; set; }
        public string? Error { get; set; }
        public int Width { get; set; }
        public int Height { get; set; }
    }

    public class FaceCaptureResult
    {
        public bool Success { get; set; }
        public string? Error { get; set; }
        public float[]? Descriptor { get; set; }
        public double LivenessScore { get; set; } = 0.9;
        public bool QualityOk { get; set; }
    }
}
