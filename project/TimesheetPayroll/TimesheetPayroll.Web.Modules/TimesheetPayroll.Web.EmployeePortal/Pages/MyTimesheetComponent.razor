@page "/my-timesheet"
@attribute [Authorize]
@implements IDisposable
@implements IAsyncDisposable
@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using TimesheetPayroll.CoreBusiness.Models
@using TimesheetPayroll.UseCases.AdminPortal
@using TimesheetPayroll.UseCases.Authentication
@using TimesheetPayroll.UseCases.EmployeePortal
@using TimesheetPayroll.UseCases.PluginInterfaces.DataStore
@inject IViewMyTimesheetUseCase ViewTimesheetUseCase
@inject ICheckInCheckOutUseCase CheckInUseCase
@inject IGetWorkShiftsUseCase GetWorkShiftsUseCase
@inject IEmployeeRepository EmployeeRepo
@inject IViewTimesheetSummaryUseCase ViewTimesheetSummaryUseCase
@inject IExportTimesheetExcelUseCase ExportTimesheetExcelUseCase
@inject IManageTimesheetUseCase ManageTimesheetUseCase
@inject IUserSessionService UserSession
@inject IJSRuntime JSRuntime
@inject NavigationManager NavManager

<PageTitle>Lịch Chấm Công & Điểm Danh - HỆ THỐNG QUẢN LÝ NHÂN SỰ – CHẤM CÔNG – TÍNH LƯƠNG</PageTitle>

<div class="container-fluid py-3">
    <!-- TIÊU ĐỀ TRANG & PHÂN HỆ ĐIỂM DANH -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 pb-2 border-bottom gap-2 d-print-none">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 fw-bold">
                    <i class="fa-solid fa-building me-1"></i>HỆ THỐNG QUẢN TRỊ DOANH NGHIỆP
                </span>
                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">
                    <i class="fa-solid fa-calendar-check me-1"></i>Quản Lý Ca Làm Việc & Chấm Công
                </span>
            </div>
            <h2 class="h4 mb-0 text-dark fw-bold">
                @if (canManage)
                {
                    <i class="fa-solid fa-calendar-days text-primary me-2"></i><span>Quản Lý Lịch Chấm Công Doanh Nghiệp</span>
                }
                else
                {
                    <i class="fa-solid fa-calendar-day text-success me-2"></i><span>Lịch Chấm Công Cá Nhân</span>
                }
            </h2>
            <p class="text-muted small mb-0 mt-1">
                @if (canManage)
                {
                    <span>Chế độ <strong>@(isManager ? "Quản Lý Bộ Phận" : (isAdmin ? "Quản Trị Viên" : "Kế Toán"))</strong>: Theo dõi lịch trực quan, đối soát bảng công và điều chỉnh có lưu vết kiểm toán.</span>
                }
                else
                {
                    <span>Chế độ <strong>Nhân Viên</strong>: Theo dõi ca làm việc, lịch sử điểm danh theo tuần/tháng và trạng thái ngày công.</span>
                }
            </p>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-2">
            <a href="/face-checkin" class="btn btn-outline-info fw-semibold shadow-sm">
                <i class="fa-solid fa-face-smile me-1"></i>Chấm Công Bằng Khuôn Mặt
            </a>
            <button class="btn btn-success fw-semibold shadow-sm" @onclick='() => OpenPhotoPunchModalAsync("CHECK_IN")' disabled="@isPunchSubmitting">
                <i class="fa-solid fa-right-to-bracket me-1"></i>Check-In
            </button>
            <button class="btn btn-warning fw-semibold shadow-sm text-dark" @onclick='() => OpenPhotoPunchModalAsync("CHECK_OUT")' disabled="@isPunchSubmitting">
                <i class="fa-solid fa-right-from-bracket me-1"></i>Check-Out
            </button>
            <button class="btn btn-outline-secondary" @onclick="LoadDataAsync" disabled="@isLoading" title="Tải lại dữ liệu">
                <i class="fa-solid fa-arrows-rotate @(isLoading ? "fa-spin" : "")"></i>
            </button>
        </div>
    </div>

    <!-- THÔNG BÁO HỆ THỐNG -->
    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert alert-@statusType alert-dismissible fade show shadow-sm d-print-none" role="alert">
            <i class="fa-solid @(statusType == "success" ? "fa-circle-check" : "fa-triangle-exclamation") me-2"></i>
            @statusMessage
            <button type="button" class="btn-close" @onclick="() => statusMessage = string.Empty"></button>
        </div>
    }

    <!-- THANH ĐIỀU HƯỚNG VÀ NÚT CHỨC NĂNG BẢNG CHẤM CÔNG TỔNG HỢP & IN BÁO CÁO -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2 d-print-none">
        <ul class="nav nav-pills p-1 bg-white rounded shadow-sm border gap-1">
            <li class="nav-item">
                <button type="button" class="nav-link fw-bold @(currentTab == "calendar" ? "active bg-primary text-white" : "text-dark")" 
                        @onclick='() => currentTab = "calendar"'>
                    <i class="fa-solid fa-calendar-days me-2"></i>Lịch Chấm Công (Tháng / Tuần)
                </button>
            </li>
            @if (canManage)
            {
                <li class="nav-item">
                    <button type="button" class="nav-link fw-bold @(currentTab == "audit" ? "active bg-primary text-white" : "text-dark")" 
                            @onclick='() => currentTab = "audit"'>
                        <i class="fa-solid fa-clock-rotate-left me-2"></i>Lịch Sử Điều Chỉnh (Audit Log)
                        <span class="badge @(currentTab == "audit" ? "bg-light text-dark" : "bg-secondary text-white") ms-2">
                            @auditLogs.Count
                        </span>
                    </button>
                </li>
            }
        </ul>

        @if (canManage)
        {
            <!-- NÚT CHỨC NĂNG BẢNG CHẤM CÔNG TỔNG HỢP & IN BÁO CÁO (CHUẨN THEO ẢNH MẪU ĐỒ ÁN) -->
            <button type="button" 
                    id="btn-summary-report"
                    class="btn text-white fw-bold shadow-sm d-inline-flex align-items-center px-3 py-2" 
                    style="background-color: #0d6efd; border-radius: 8px; border: none; font-size: 0.95rem;" 
                    @onclick="OpenSummaryReportView"
                    title="Mở bảng chấm công tổng hợp toàn bộ nhân sự và in báo cáo">
                <i class="fa-solid fa-table-list me-2 fs-5"></i>
                <span class="me-1">Bảng Chấm Công Tổng Hợp & In Báo Cáo</span>
                <span class="badge bg-white text-dark rounded-pill ms-2 px-3 py-1 fw-bold font-monospace" style="font-size: 0.85rem;">
                    @summaryList.Count nhân sự
                </span>
            </button>
        }
        else
        {
            <!-- DÀNH CHO NHÂN VIÊN: GỬI YÊU CẦU CHẤM CÔNG THỦ CÔNG & ĐƠN NGHỈ PHÉP -->
            <div class="d-flex align-items-center gap-2">
                <a href="/my-attendance-requests" class="btn btn-primary btn-sm fw-semibold shadow-sm">
                    <i class="fa-solid fa-clock-rotate-left me-1"></i>Gửi Yêu Cầu Chấm Công Bù
                </a>
                <a href="/leave-request" class="btn btn-outline-secondary btn-sm fw-semibold shadow-sm">
                    <i class="fa-solid fa-calendar-check me-1"></i>Nộp Đơn Nghỉ Phép
                </a>
            </div>
        }
    </div>

    @if (currentTab == "calendar")
    {
        <!-- ========================================================================= -->
        <!-- MỤC 2.1: THANH ĐIỀU KHIỂN PHÍA TRÊN LỊCH CHẤM CÔNG                        -->
        <!-- ========================================================================= -->
        <div class="card border-0 shadow-sm mb-3 bg-white d-print-none">
            <div class="card-body p-3">
                <div class="row g-2 align-items-center justify-content-between">
                    <!-- KHỐI ĐIỀU HƯỚNG THÁNG/TUẦN -->
                    <div class="col-lg-5 col-md-6 d-flex align-items-center gap-2">
                        <!-- Nút Chuyển đổi Tuần và Tháng -->
                        <div class="btn-group shadow-sm" role="group">
                            <button type="button" class="btn btn-sm @(calendarViewMode == "MONTH" ? "btn-primary" : "btn-outline-primary")" 
                                    @onclick='() => SetViewMode("MONTH")'>
                                <i class="fa-solid fa-calendar-alt me-1"></i>Tháng
                            </button>
                            <button type="button" class="btn btn-sm @(calendarViewMode == "WEEK" ? "btn-primary" : "btn-outline-primary")" 
                                    @onclick='() => SetViewMode("WEEK")'>
                                <i class="fa-solid fa-calendar-week me-1"></i>Tuần
                            </button>
                        </div>

                        <!-- Nút Hôm nay -->
                        <button class="btn btn-sm btn-outline-secondary fw-semibold shadow-sm" @onclick="GoToToday">
                            <i class="fa-solid fa-clock-rotate-left me-1"></i>Hôm nay
                        </button>

                        <!-- Nút Tháng Trước / Tiếp theo -->
                        <div class="btn-group btn-group-sm shadow-sm" role="group">
                            <button type="button" class="btn btn-light border" @onclick="PrevMonth" title="Tháng trước">
                                <i class="fa-solid fa-chevron-left"></i>
                            </button>
                            <button type="button" class="btn btn-light border" @onclick="NextMonth" title="Tháng tiếp theo">
                                <i class="fa-solid fa-chevron-right"></i>
                            </button>
                        </div>

                        <!-- Tiêu đề Tháng/Năm nổi bật -->
                        <div class="fs-5 fw-bold text-primary text-nowrap ms-2">
                            @(calendarViewMode == "MONTH" ? $"Tháng {currentMonth:D2}/{currentYear}" : $"Tuần {GetWeekNumber(selectedDate)} (Tháng {currentMonth:D2}/{currentYear})")
                        </div>
                    </div>

                    <!-- KHỐI BỘ LỌC DỮ LIỆU -->
                    <div class="col-lg-7 col-md-6">
                        <div class="row g-2 justify-content-end align-items-center">
                            <!-- Bộ lọc trạng thái chấm công -->
                            <div class="col-sm-4">
                                <select class="form-select form-select-sm shadow-none" @bind="statusFilter">
                                    <option value="ALL">Tất cả trạng thái</option>
                                    <option value="PRESENT">Đúng giờ / Hoàn thành ca</option>
                                    <option value="LATE_EARLY">Đi muộn / Về sớm</option>
                                    <option value="HALF_DAY">Nửa ca (0.5 công)</option>
                                    <option value="ABSENT_WITH_PERMISSION">Nghỉ có phép</option>
                                    <option value="ABSENT_UNAUTHORIZED">Vắng không phép</option>
                                </select>
                            </div>

                            <!-- Bộ lọc phòng ban nếu là Quản lý/Admin/Kế toán -->
                            @if (canManage)
                            {
                                <div class="col-sm-4">
                                    <select class="form-select form-select-sm shadow-none" @bind="departmentFilter">
                                        <option value="ALL">Tất cả phòng ban</option>
                                        @foreach (var d in allDepartments)
                                        {
                                            <option value="@d">@d</option>
                                        }
                                    </select>
                                </div>
                            }

                            <!-- Ô tìm kiếm nhân viên / Chọn nhân viên -->
                            <div class="col-sm-4">
                                @if (canManage)
                                {
                                    <select class="form-select form-select-sm shadow-none fw-semibold" 
                                            value="@selectedEmployeeId" @onchange="OnEmployeeSelectChangedAsync">
                                        <option value="0">Tất cả nhân viên (Lưới tổng)</option>
                                        @foreach (var emp in allEmployees)
                                        {
                                            <option value="@emp.Id">[@emp.EmployeeCode] @emp.FullName</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <div class="form-control form-control-sm bg-light text-truncate fw-semibold text-primary">
                                        [@selectedEmployee?.EmployeeCode] @selectedEmployee?.FullName
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- DÒNG QUY ƯỚC MÀU SẮC CHUẨN MỤC 2.3 -->
                <div class="d-flex flex-wrap align-items-center gap-3 mt-3 pt-2 border-top small text-muted">
                    <span class="fw-bold text-dark"><i class="fa-solid fa-palette me-1 text-primary"></i>Quy ước màu sắc:</span>
                    <span class="d-inline-flex align-items-center">
                        <span class="badge bg-success-subtle text-success border border-success-subtle me-1 px-2 py-0">● Xanh lá</span> Đầy đủ / Hoàn thành ca
                    </span>
                    <span class="d-inline-flex align-items-center">
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle me-1 px-2 py-0">● Xanh dương</span> Ngày hôm nay / Đang chọn
                    </span>
                    <span class="d-inline-flex align-items-center">
                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle me-1 px-2 py-0">● Vàng/Cam</span> Đi muộn, về sớm, thiếu giờ
                    </span>
                    <span class="d-inline-flex align-items-center">
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle me-1 px-2 py-0">● Đỏ</span> Vắng không phép
                    </span>
                    <span class="d-inline-flex align-items-center">
                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle me-1 px-2 py-0">● Xám</span> Không có lịch / Nghỉ tuần
                    </span>
                </div>
            </div>
        </div>

        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status"></div>
                <div class="text-muted small mt-2">Đang tải dữ liệu lịch chấm công tháng @currentMonth/@currentYear...</div>
            </div>
        }
        else if (calendarViewMode == "MONTH")
        {
            <!-- ========================================================================= -->
            <!-- MỤC 2.2: LƯỚI LỊCH THÁNG (7 CỘT: THỨ HAI ĐẾN CHỦ NHẬT)                     -->
            <!-- ========================================================================= -->
            <div class="calendar-wrapper shadow-sm mb-4">
                <!-- HÀNG TIÊU ĐỀ 7 THỨ TRONG TUẦN -->
                <div class="calendar-header-grid">
                    <div class="calendar-header-cell">Thứ Hai</div>
                    <div class="calendar-header-cell">Thứ Ba</div>
                    <div class="calendar-header-cell">Thứ Tư</div>
                    <div class="calendar-header-cell">Thứ Năm</div>
                    <div class="calendar-header-cell">Thứ Sáu</div>
                    <div class="calendar-header-cell">Thứ Bảy</div>
                    <div class="calendar-header-cell" style="background-color: #1e3a8a;">Chủ Nhật</div>
                </div>

                <!-- LƯỚI CÁC Ô NGÀY TRONG THÁNG -->
                <div class="calendar-body-grid">
                    @foreach (var day in monthCalendarDays)
                    {
                        var isOutside = day.Date.Month != currentMonth;
                        var isToday = day.Date.Date == DateTime.Today;
                        var isSelected = day.Date.Date == selectedDate.Date;
                        var dayTimesheets = GetTimesheetsForDay(day.Date);

                        <div class="calendar-day-cell @(isOutside ? "calendar-day-outside" : "") @(isToday ? "calendar-day-today" : "") @(isSelected ? "calendar-day-selected" : "")"
                             @onclick="() => OnDayCellClicked(day.Date)">
                            <!-- HEADER CỦA Ô NGÀY -->
                            <div class="day-header">
                                <span class="day-number">@day.Day</span>
                                @if (isToday)
                                {
                                    <span class="badge bg-primary text-white" style="font-size: 0.65rem; padding: 2px 4px;">Hôm nay</span>
                                }
                                else if (dayTimesheets.Count > 0)
                                {
                                    <span class="text-muted" style="font-size: 0.7rem;">@dayTimesheets.Count ca</span>
                                }
                            </div>

                            <!-- DANH SÁCH SỰ KIỆN CHẤM CÔNG TRONG NGÀY -->
                            <div class="event-chips-container">
                                @if (dayTimesheets.Count == 0 && !isOutside && (day.DayOfWeek == DayOfWeek.Saturday || day.DayOfWeek == DayOfWeek.Sunday))
                                {
                                    <div class="event-chip event-chip-gray">
                                        <i class="fa-regular fa-calendar-minus me-1"></i>Nghỉ cuối tuần
                                    </div>
                                }
                                else
                                {
                                    @for (int i = 0; i < Math.Min(dayTimesheets.Count, 3); i++)
                                    {
                                        var t = dayTimesheets[i];
                                        var chipClass = GetEventChipClass(t.WorkShiftStatus);
                                        <div class="event-chip @chipClass" @onclick:stopPropagation="true" @onclick="() => OpenDetailModal(t)">
                                            @if (selectedEmployeeId == 0)
                                            {
                                                <div class="text-truncate fw-bold">@t.EmployeeName</div>
                                            }
                                            <div class="d-flex justify-content-between">
                                                <span>@(t.CheckInTime?.ToString(@"hh\:mm") ?? "--:--") - @(t.CheckOutTime?.ToString(@"hh\:mm") ?? "--:--")</span>
                                                <span class="fw-bold">@t.WorkUnits c</span>
                                            </div>
                                        </div>
                                    }

                                    @if (dayTimesheets.Count > 3)
                                    {
                                        <div class="show-more-badge" @onclick:stopPropagation="true" @onclick="() => OnDayCellClicked(day.Date)">
                                            +@(dayTimesheets.Count - 3) xem thêm
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <!-- ========================================================================= -->
            <!-- CHẾ ĐỘ XEM TUẦN (WEEK VIEW)                                               -->
            <!-- ========================================================================= -->
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                <div class="card-header bg-dark text-white py-3 px-4 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0">
                        <i class="fa-solid fa-calendar-week text-primary me-2"></i>Lịch Làm Việc Chi Tiết Theo Tuần (@weekDays.First().ToString("dd/MM") - @weekDays.Last().ToString("dd/MM/yyyy"))
                    </h6>
                    <button class="btn btn-sm btn-outline-light" @onclick='() => SetViewMode("MONTH")'>
                        <i class="fa-solid fa-arrow-left me-1"></i>Trở lại xem Tháng
                    </button>
                </div>
                <div class="row g-0">
                    @foreach (var day in weekDays)
                    {
                        var isToday = day.Date == DateTime.Today;
                        var dayTimesheets = GetTimesheetsForDay(day);
                        <div class="col border-end p-3 @(isToday ? "bg-primary-subtle bg-opacity-25" : "bg-white")" style="min-width: 140px;">
                            <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                                <div>
                                    <div class="fw-bold text-dark">@day.ToString("dddd", new CultureInfo("vi-VN"))</div>
                                    <div class="small text-muted">@day.ToString("dd/MM/yyyy")</div>
                                </div>
                                @if (isToday)
                                {
                                    <span class="badge bg-primary">Hôm nay</span>
                                }
                            </div>

                            <div class="d-flex flex-column gap-2" style="min-height: 280px;">
                                @if (dayTimesheets.Count == 0)
                                {
                                    <div class="text-center py-4 text-muted small">
                                        <i class="fa-regular fa-calendar-xmark text-secondary fs-4 d-block mb-1"></i>
                                        Không có ca
                                    </div>
                                }
                                else
                                {
                                    @foreach (var t in dayTimesheets)
                                    {
                                        var chipClass = GetEventChipClass(t.WorkShiftStatus);
                                        <div class="card border p-2 shadow-sm @chipClass" style="cursor: pointer;" @onclick="() => OpenDetailModal(t)">
                                            <div class="fw-bold text-dark small text-truncate">@(t.EmployeeName ?? "Nhân viên")</div>
                                            <div class="small text-muted">@t.ShiftName</div>
                                            <div class="font-monospace fw-bold small text-primary mt-1">
                                                @(t.CheckInTime?.ToString(@"hh\:mm") ?? "--:--") - @(t.CheckOutTime?.ToString(@"hh\:mm") ?? "--:--")
                                            </div>
                                            <div class="d-flex justify-content-between align-items-center mt-1 pt-1 border-top border-secondary border-opacity-25" style="font-size: 0.72rem;">
                                                <span>@t.ActualHoursWorked giờ</span>
                                                <span class="badge bg-dark bg-opacity-75 text-white">@t.WorkUnits công</span>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
    else if (currentTab == "report")
    {
        <!-- ========================================================================= -->
        <!-- BẢNG CHẤM CÔNG TỔNG HỢP & IN BÁO CÁO                                        -->
        <!-- ========================================================================= -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-white py-3 px-4 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2 d-print-none">
                <div class="d-flex align-items-center">
                    <button class="btn btn-outline-secondary btn-sm me-3" @onclick='() => currentTab = "calendar"' title="Quay lại giao diện lịch">
                        <i class="fa-solid fa-arrow-left me-1"></i>Quay lại Lịch
                    </button>
                    <div>
                        <h5 class="h6 mb-0 fw-bold text-dark">
                            <i class="fa-solid fa-file-invoice text-primary me-2"></i>Bảng Tổng Hợp Chấm Công & Theo Dõi Ngày Công Tháng @currentMonth/@currentYear
                        </h5>
                        <small class="text-muted">Đơn vị: <strong>CÔNG TY TNHH HỆ THỐNG QUẢN TRỊ DOANH NGHIỆP</strong></small>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-primary fw-semibold shadow-sm" @onclick="OpenPrintPreviewModal">
                        <i class="fa-solid fa-print me-1"></i>Xem Trước & In Bảng Công
                    </button>
                    <button class="btn btn-success fw-semibold shadow-sm" @onclick="HandleExportTimesheetExcelAsync">
                        <i class="fa-solid fa-file-excel me-1"></i>Xuất Excel Bảng Công (.xls)
                    </button>
                </div>
            </div>

            <!-- BẢNG DỮ LIỆU ĐỐI SOÁT TỔNG HỢP TRÊN MÀN HÌNH -->
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light small text-uppercase">
                        <tr>
                            <th style="width: 50px;">STT</th>
                            <th style="width: 100px;">Mã NV</th>
                            <th>Họ và Tên</th>
                            <th>Phòng Ban</th>
                            <th class="text-center" style="width: 90px;">Ca Chuẩn</th>
                            <th class="text-center" style="width: 80px;">Ca Gãy</th>
                            <th class="text-center" style="width: 80px;">Nửa Ca</th>
                            <th class="text-center" style="width: 100px;">Muộn/Sớm</th>
                            <th class="text-center" style="width: 90px;">Nghỉ Phép</th>
                            <th class="text-center" style="width: 90px;">K.Phép</th>
                            <th class="text-center" style="width: 100px;">Tổng Giờ</th>
                            <th class="text-center" style="width: 90px;">Tăng Ca</th>
                            <th class="text-center" style="width: 120px; background-color: #f0fdf4;">TỔNG CÔNG</th>
                            <th class="text-center" style="width: 120px;">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!summaryList.Any())
                        {
                            <tr>
                                <td colspan="14" class="text-center py-4 text-muted">
                                    Không có dữ liệu chấm công cho kỳ tháng @currentMonth/@currentYear.
                                </td>
                            </tr>
                        }
                        else
                        {
                            int stt = 1;
                            @foreach (var item in summaryList)
                            {
                                <tr>
                                    <td class="text-center text-muted">@(stt++)</td>
                                    <td class="fw-bold text-primary font-monospace">@item.EmployeeCode</td>
                                    <td>
                                        <div class="fw-semibold text-dark">@item.FullName</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@(item.DepartmentName ?? "Văn phòng")</span>
                                    </td>
                                    <td class="text-center">@item.Standard8hCount</td>
                                    <td class="text-center">@item.SplitShiftCount</td>
                                    <td class="text-center">@item.HalfShiftCount</td>
                                    <td class="text-center @(item.LateOrEarlyCount > 0 ? "text-warning fw-bold" : "text-muted")">
                                        @item.LateOrEarlyCount
                                    </td>
                                    <td class="text-center">@item.PaidLeaveCount</td>
                                    <td class="text-center @(item.AbsentCount > 0 ? "text-danger fw-bold" : "text-muted")">
                                        @item.AbsentCount
                                    </td>
                                    <td class="text-center font-monospace">@item.TotalHours.ToString("0.0") h</td>
                                    <td class="text-center font-monospace">@item.OvertimeHours.ToString("0.0") h</td>
                                    <td class="text-center fw-bold fs-6 text-success bg-success-subtle bg-opacity-25">
                                        @item.TotalWorkUnits.ToString("0.0")
                                    </td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => FilterByEmployee(item.EmployeeId)" title="Xem chi tiết lịch">
                                            <i class="fa-solid fa-calendar me-1"></i>Xem Lịch
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                    <tfoot class="table-light fw-bold">
                        <tr>
                            <td colspan="4" class="text-end">TỔNG CỘNG TOÀN DOANH NGHIỆP:</td>
                            <td class="text-center">@summaryList.Sum(s => s.Standard8hCount)</td>
                            <td class="text-center">@summaryList.Sum(s => s.SplitShiftCount)</td>
                            <td class="text-center">@summaryList.Sum(s => s.HalfShiftCount)</td>
                            <td class="text-center text-warning">@summaryList.Sum(s => s.LateOrEarlyCount)</td>
                            <td class="text-center">@summaryList.Sum(s => s.PaidLeaveCount)</td>
                            <td class="text-center text-danger">@summaryList.Sum(s => s.AbsentCount)</td>
                            <td class="text-center font-monospace">@summaryList.Sum(s => s.TotalHours).ToString("0.0") h</td>
                            <td class="text-center font-monospace">@summaryList.Sum(s => s.OvertimeHours).ToString("0.0") h</td>
                            <td class="text-center text-success fs-6">@summaryList.Sum(s => s.TotalWorkUnits).ToString("0.0") công</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    }
    else if (currentTab == "audit")
    {
        <!-- ========================================================================= -->
        <!-- MỤC 2.4: LỊCH SỬ CHỈNH SỬA & KIỂM TOÁN CHẤM CÔNG (AUDIT TRAIL)              -->
        <!-- ========================================================================= -->
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
            <div class="card-header bg-white py-3 px-4 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark">
                    <i class="fa-solid fa-clock-rotate-left text-primary me-2"></i>Nhật Ký Điều Chỉnh Bảng Chấm Công (Audit Logs)
                </h6>
                <span class="badge bg-secondary-subtle text-secondary px-2 py-1">
                    Kiểm toán minh bạch: Người sửa, thời điểm, dữ liệu cũ & mới
                </span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 small">
                    <thead class="table-light text-uppercase">
                        <tr>
                            <th style="width: 150px;">Thời Điểm</th>
                            <th>Nhân Viên</th>
                            <th>Hành Động</th>
                            <th>Người Thực Hiện</th>
                            <th>Lý Do Điều Chỉnh</th>
                            <th>Dữ Liệu Trước / Sau</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!auditLogs.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">
                                    Chưa có bản ghi điều chỉnh thủ công nào.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var log in auditLogs)
                            {
                                <tr>
                                    <td class="font-monospace text-muted">@log.ModifiedAt.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                    <td class="fw-bold">[@log.EmployeeCode] @log.EmployeeName</td>
                                    <td><span class="badge bg-info-subtle text-info border">@log.Action</span></td>
                                    <td><code>@log.ModifiedBy</code></td>
                                    <td class="text-dark">@log.Reason</td>
                                    <td>
                                        <button class="btn btn-sm btn-link text-primary p-0" @onclick="() => ShowAuditJson(log)">
                                            <i class="fa-solid fa-code me-1"></i>Xem Dữ Liệu JSON
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- ============================================================================= -->
<!-- MODAL XEM CHI TIẾT & ĐIỀU CHỈNH CHẤM CÔNG                                     -->
<!-- ============================================================================= -->
@if (selectedTimesheet != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);" aria-modal="true" role="dialog">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-primary text-white p-3">
                    <div class="d-flex align-items-center">
                        <i class="fa-solid fa-calendar-check fs-4 me-2"></i>
                        <div>
                            <h5 class="modal-title h6 fw-bold mb-0">Chi Tiết Bản Ghi Chấm Công</h5>
                            <small class="opacity-75">Ngày @selectedTimesheet.WorkDate.ToString("dd/MM/yyyy (dddd)", new CultureInfo("vi-VN"))</small>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseDetailModal"></button>
                </div>
                <div class="modal-body p-4">
                    <!-- THÔNG TIN NHÂN VIÊN & CA HIỆN TẠI -->
                    <div class="d-flex align-items-center p-3 rounded bg-light border mb-4">
                        <div class="bg-primary text-white rounded-circle p-3 me-3 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                            <i class="fa-solid fa-user"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="fw-bold text-dark fs-6">@selectedTimesheet.EmployeeName</div>
                            <div class="small text-muted font-monospace">Mã NV: @selectedTimesheet.EmployeeCode • Ca: @(selectedTimesheet.ShiftName ?? "Ca Hành Chính")</div>
                        </div>
                        <span class="badge @GetEventChipClass(selectedTimesheet.WorkShiftStatus) px-3 py-2 fs-6">
                            @selectedTimesheet.WorkShiftStatus
                        </span>
                    </div>

                    <!-- THẺ CHỈ SỐ: GIỜ VÀO, GIỜ RA, SỐ GIỜ LÀM, NGÀY CÔNG -->
                    <div class="row g-3 mb-4 text-center">
                        <div class="col-sm-3">
                            <div class="p-3 border rounded bg-white">
                                <div class="text-muted small fw-semibold">GIỜ VÀO (IN)</div>
                                <div class="fs-4 fw-bold font-monospace text-success mt-1">
                                    @(selectedTimesheet.CheckInTime?.ToString(@"hh\:mm\:ss") ?? "--:--:--")
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-3">
                            <div class="p-3 border rounded bg-white">
                                <div class="text-muted small fw-semibold">GIỜ RA (OUT)</div>
                                <div class="fs-4 fw-bold font-monospace text-warning-emphasis mt-1">
                                    @(selectedTimesheet.CheckOutTime?.ToString(@"hh\:mm\:ss") ?? "--:--:--")
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-3">
                            <div class="p-3 border rounded bg-white">
                                <div class="text-muted small fw-semibold">SỐ GIỜ LÀM</div>
                                <div class="fs-4 fw-bold text-primary mt-1">
                                    @selectedTimesheet.ActualHoursWorked giờ
                                </div>
                            </div>
                        </div>
                        <div class="col-sm-3">
                            <div class="p-3 border rounded bg-white">
                                <div class="text-muted small fw-semibold">NGÀY CÔNG</div>
                                <div class="fs-4 fw-bold text-dark mt-1">
                                    @selectedTimesheet.WorkUnits công
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-light border small text-muted mb-4">
                        <i class="fa-solid fa-comment-dots me-1 text-primary"></i><strong>Ghi chú / Đánh giá:</strong> 
                        @(string.IsNullOrEmpty(selectedTimesheet.Note) ? "Không có ghi chú thêm." : selectedTimesheet.Note)
                    </div>

                    @if (!string.IsNullOrEmpty(selectedTimesheet.PhotoInUrl) || !string.IsNullOrEmpty(selectedTimesheet.PhotoOutUrl))
                    {
                        <div class="card border rounded-3 p-3 mb-4 bg-light shadow-sm">
                            <h6 class="fw-bold mb-3 text-secondary">
                                <i class="fa-solid fa-camera text-primary me-2"></i>Ảnh Xác Minh Chấm Công (Audit Photos)
                            </h6>
                            <div class="row g-3">
                                @if (!string.IsNullOrEmpty(selectedTimesheet.PhotoInUrl))
                                {
                                    <div class="col-sm-6 text-center">
                                        <div class="small text-muted fw-bold mb-1">
                                            <i class="fa-solid fa-right-to-bracket text-success me-1"></i>Ảnh Vào Ca (@(selectedTimesheet.CheckInTime?.ToString(@"hh\:mm") ?? ""))
                                        </div>
                                        <img src="@selectedTimesheet.PhotoInUrl" alt="Ảnh vào ca" class="img-thumbnail rounded shadow-sm" style="max-height: 160px; object-fit: cover;" />
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(selectedTimesheet.PhotoOutUrl))
                                {
                                    <div class="col-sm-6 text-center">
                                        <div class="small text-muted fw-bold mb-1">
                                            <i class="fa-solid fa-right-from-bracket text-warning me-1"></i>Ảnh Ra Ca (@(selectedTimesheet.CheckOutTime?.ToString(@"hh\:mm") ?? ""))
                                        </div>
                                        <img src="@selectedTimesheet.PhotoOutUrl" alt="Ảnh ra ca" class="img-thumbnail rounded shadow-sm" style="max-height: 160px; object-fit: cover;" />
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <!-- KHỐI ĐIỀU CHỈNH BẢN GHI (CHỈ DÀNH CHO ADMIN / QUẢN LÝ / KẾ TOÁN) -->
                    @if (canManage)
                    {
                        <div class="card border-primary border-opacity-25 bg-light p-3 rounded-3">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="fw-bold mb-0 text-primary">
                                    <i class="fa-solid fa-pen-to-square me-2"></i>Điều Chỉnh Bản Ghi (Dành cho Quản Lý / Admin / Kế Toán)
                                </h6>
                                <span class="badge bg-warning text-dark">Lưu vết kiểm toán</span>
                            </div>

                            <div class="row g-3">
                                <div class="col-sm-6">
                                    <label class="form-label small fw-bold text-dark">Giờ Vào (hh:mm):</label>
                                    <input type="time" class="form-control" @bind="modalInTime" />
                                </div>
                                <div class="col-sm-6">
                                    <label class="form-label small fw-bold text-dark">Giờ Ra (hh:mm):</label>
                                    <input type="time" class="form-control" @bind="modalOutTime" />
                                </div>
                                <div class="col-sm-6">
                                    <label class="form-label small fw-bold text-dark">Trạng Thái Ca:</label>
                                    <select class="form-select" @bind="modalStatus">
                                        <option value="PRESENT">Đúng giờ (PRESENT)</option>
                                        <option value="LATE">Đi muộn (LATE)</option>
                                        <option value="EARLY_LEAVE">Về sớm (EARLY_LEAVE)</option>
                                        <option value="HALF_DAY">Nửa ca (HALF_DAY)</option>
                                        <option value="ABSENT_WITH_PERMISSION">Nghỉ có phép (ABSENT_WITH_PERMISSION)</option>
                                        <option value="ABSENT_UNAUTHORIZED">Vắng không phép (ABSENT_UNAUTHORIZED)</option>
                                    </select>
                                </div>
                                <div class="col-sm-6">
                                    <label class="form-label small fw-bold text-dark">Hệ Số Ngày Công:</label>
                                    <input type="number" step="0.25" min="0" max="2.0" class="form-control" @bind="modalWorkUnits" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label small fw-bold text-danger">Lý do điều chỉnh (Bắt buộc theo quy định kiểm toán) *:</label>
                                    <input type="text" class="form-control" placeholder="vd: Nhân viên quên quét mã vân tay/camera khi ra về, có xác nhận của trưởng bộ phận..." 
                                           @bind="modalAdjustReason" />
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer bg-light p-3">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseDetailModal">Đóng</button>
                    @if (canManage)
                    {
                        <button type="button" class="btn btn-primary fw-bold px-4 shadow" @onclick="HandleSaveAdjustmentAsync" disabled="@isSubmittingModal">
                            @if (isSubmittingModal)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                                <span>Đang lưu...</span>
                            }
                            else
                            {
                                <i class="fa-solid fa-floppy-disk me-2"></i>
                                <span>Lưu Thay Đổi & Ghi Log</span>
                            }
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

<!-- ============================================================================= -->
<!-- MODAL CHẤM CÔNG XÁC MINH ẢNH TỰ ĐỘNG (AUTO PHOTO VERIFICATION MODAL)          -->
<!-- ============================================================================= -->
@if (showPhotoPunchModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.75); backdrop-filter: blur(4px); z-index: 1060;" aria-modal="true" role="dialog">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <!-- Header -->
                <div class="modal-header @(punchActionType == "CHECK_IN" ? "bg-success text-white" : "bg-warning text-dark") py-3 px-4">
                    <div class="d-flex align-items-center gap-2">
                        <i class="fa-solid @(punchActionType == "CHECK_IN" ? "fa-right-to-bracket" : "fa-right-from-bracket") fs-5"></i>
                        <h5 class="modal-title fw-bold mb-0">
                            @(punchActionType == "CHECK_IN" ? "Chấm Công Vào Ca (Check-In) • Chụp Ảnh Xác Minh" : "Chấm Công Ra Ca (Check-Out) • Chụp Ảnh Xác Minh")
                        </h5>
                    </div>
                    <button type="button" class="btn-close @(punchActionType == "CHECK_IN" ? "btn-close-white" : "")" @onclick="ClosePhotoPunchModalAsync" disabled="@isPunchSubmitting"></button>
                </div>

                <!-- Body -->
                <div class="modal-body p-4 bg-light">
                    <!-- Thanh trạng thái hệ thống: 5 trạng thái quy định -->
                    <div class="card border mb-3 shadow-sm @(punchStatus == "Chấm công thành công" ? "border-success bg-success-subtle text-success-emphasis" : (punchStatus == "Không thể chấm công" ? "border-danger bg-danger-subtle text-danger-emphasis" : "border-primary bg-white"))">
                        <div class="card-body p-3 d-flex align-items-center justify-content-between">
                            <div class="d-flex align-items-center gap-3">
                                <span class="fs-4">
                                    @if (punchStatus == "Đang khởi tạo camera" || punchStatus == "Đang chụp ảnh" || punchStatus == "Đang gửi dữ liệu")
                                    {
                                        <span class="spinner-border spinner-border-sm text-primary" role="status"></span>
                                    }
                                    else if (punchStatus == "Chấm công thành công")
                                    {
                                        <i class="fa-solid fa-circle-check text-success"></i>
                                    }
                                    else if (punchStatus == "Không thể chấm công")
                                    {
                                        <i class="fa-solid fa-triangle-exclamation text-danger"></i>
                                    }
                                    else
                                    {
                                        <i class="fa-solid fa-camera text-primary"></i>
                                    }
                                </span>
                                <div>
                                    <div class="fw-bold fs-6">Trạng thái: @punchStatus</div>
                                    <div class="small text-muted">@punchStatusSubtitle</div>
                                </div>
                            </div>
                            <span class="badge @(punchStatus == "Chấm công thành công" ? "bg-success" : (punchStatus == "Không thể chấm công" ? "bg-danger" : "bg-primary")) px-3 py-2 fw-semibold">
                                @punchStatus
                            </span>
                        </div>
                    </div>

                    <div class="row g-3">
                        <!-- Khung hình Camera hoặc Preview Ảnh Chụp -->
                        <div class="col-md-7">
                            <div class="position-relative rounded-4 overflow-hidden bg-black shadow d-flex align-items-center justify-content-center" style="min-height: 280px; max-height: 330px;">
                                <video id="punchCaptureVideo" autoplay playsinline muted
                                       style="width: 100%; height: 100%; object-fit: cover; display: @(isPunchCameraActive && string.IsNullOrEmpty(capturedPhotoPreview) ? "block" : "none");"></video>
                                <canvas id="punchCaptureCanvas"
                                        style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; display: @(isPunchCameraActive && string.IsNullOrEmpty(capturedPhotoPreview) ? "block" : "none");"></canvas>

                                @if (!string.IsNullOrEmpty(capturedPhotoPreview))
                                {
                                    <img src="@capturedPhotoPreview" alt="Ảnh xác minh vừa chụp" class="w-100 h-100 object-fit-cover" />
                                    <div class="position-absolute bottom-0 start-0 end-0 bg-dark bg-opacity-75 text-white text-center py-1 small fw-semibold">
                                        <i class="fa-solid fa-circle-check text-success me-1"></i>Ảnh xác minh tự động ghi nhận (@DateTime.Now.ToString("HH:mm:ss"))
                                    </div>
                                }
                                else if (!isPunchCameraActive)
                                {
                                    <div class="text-center p-4 text-white">
                                        <i class="fa-solid fa-video-slash fs-1 text-secondary mb-2"></i>
                                        <div class="fw-bold">Camera đang dừng</div>
                                        <div class="small text-white-50 mt-1">Camera tự động giải phóng khi hoàn tất hoặc đóng hộp thoại.</div>
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Cột phải: Thông tin nhân viên và chỉ dẫn -->
                        <div class="col-md-5 d-flex flex-column justify-content-between">
                            <div class="card border rounded-3 bg-white p-3 h-100 shadow-sm">
                                <h6 class="fw-bold border-bottom pb-2 mb-3 text-secondary">
                                    <i class="fa-solid fa-id-card me-2 text-primary"></i>Thông Tin Chấm Công
                                </h6>
                                <div class="mb-2">
                                    <span class="text-muted small d-block">Nhân viên:</span>
                                    <strong class="text-dark">@(selectedEmployee?.FullName ?? UserSession.CurrentUser?.FullName ?? "Nhân viên")</strong>
                                    <span class="badge bg-secondary-subtle text-secondary ms-1">@(selectedEmployee?.EmployeeCode ?? UserSession.CurrentUser?.Username ?? "EMP")</span>
                                </div>
                                <div class="mb-2">
                                    <span class="text-muted small d-block">Thời điểm chấm công:</span>
                                    <strong class="text-dark font-monospace">@DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")</strong>
                                </div>
                                <div class="mb-2">
                                    <span class="text-muted small d-block">Lượt ghi nhận:</span>
                                    <span class="badge @(punchActionType == "CHECK_IN" ? "bg-success" : "bg-warning text-dark") fw-bold px-2 py-1">
                                        @(punchActionType == "CHECK_IN" ? "VÀO CA (CHECK-IN)" : "RA CA (CHECK-OUT)")
                                    </span>
                                </div>

                                @if (punchStatus == "Chấm công thành công")
                                {
                                    <div class="alert alert-success py-2 px-3 small mt-auto mb-0">
                                        <i class="fa-solid fa-check-circle me-1"></i>
                                        <strong>Ghi nhận thành công!</strong> Ảnh xác minh đã được kiểm toán và lưu an toàn vào cơ sở dữ liệu.
                                    </div>
                                }
                                else if (punchStatus == "Không thể chấm công")
                                {
                                    <div class="alert alert-danger py-2 px-3 small mt-auto mb-0">
                                        <i class="fa-solid fa-circle-exclamation me-1"></i>
                                        <strong>Lưu ý:</strong> @punchErrorMessage
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-info py-2 px-3 small mt-auto mb-0">
                                        <i class="fa-solid fa-face-smile me-1"></i>
                                        Vui lòng nhìn thẳng vào camera. Hệ thống sẽ <strong>tự động chụp</strong> khi khuôn mặt vào giữa khung hình (không cần nhấn nút).
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Footer -->
                <div class="modal-footer bg-white py-2 px-4 d-flex justify-content-between">
                    <button type="button" class="btn btn-outline-secondary" @onclick="ClosePhotoPunchModalAsync" disabled="@isPunchSubmitting">
                        <i class="fa-solid fa-xmark me-1"></i>@(punchStatus == "Chấm công thành công" ? "Đóng" : "Hủy bỏ")
                    </button>

                    @if (punchStatus == "Không thể chấm công")
                    {
                        <button type="button" class="btn btn-primary" @onclick='() => OpenPhotoPunchModalAsync(punchActionType)'>
                            <i class="fa-solid fa-arrows-rotate me-1"></i>Thử Lại
                        </button>
                    }
                    else if (punchStatus == "Chấm công thành công")
                    {
                        <button type="button" class="btn btn-success" @onclick="ClosePhotoPunchModalAsync">
                            <i class="fa-solid fa-check me-1"></i>Xác Nhận & Đóng
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

