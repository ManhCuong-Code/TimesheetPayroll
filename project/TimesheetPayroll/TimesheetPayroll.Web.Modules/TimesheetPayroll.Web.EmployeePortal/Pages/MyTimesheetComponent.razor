@page "/my-timesheet"
@implements IDisposable
@inject IViewMyTimesheetUseCase ViewTimesheetUseCase
@inject ICheckInCheckOutUseCase CheckInUseCase
@inject IGetWorkShiftsUseCase GetWorkShiftsUseCase
@inject IEmployeeRepository EmployeeRepo
@using TimesheetPayroll.UseCases.AdminPortal
@using TimesheetPayroll.UseCases.PluginInterfaces.DataStore
@using TimesheetPayroll.CoreBusiness.Models
@using TimesheetPayroll.Web.Common.Controls

<div class="container-fluid py-3">
    <!-- TIÊU ĐỀ TRANG & THANH ĐIỀU HƯỚNG NHANH -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 pb-2 border-bottom gap-2">
        <div>
            <h2 class="h4 mb-1 text-dark fw-bold">
                <i class="fa-solid fa-calendar-check text-success me-2"></i>Bảng Chấm Công & Điểm Danh Trực Tuyến
            </h2>
            <p class="text-muted small mb-0">
                Ghi nhận Check-In / Check-Out thời gian thực, điểm danh thủ công theo giờ cho từng nhân viên và theo dõi ngày công chi tiết.
            </p>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <button class="btn btn-primary shadow-sm fw-semibold" @onclick="() => OpenManualPunchModal(null)">
                <i class="fa-solid fa-clock-rotate-left me-1"></i>Điểm Danh Thủ Công (Nhập Giờ)
            </button>
            <button class="btn btn-success shadow-sm fw-semibold" @onclick="HandleCheckInAsync" disabled="@isCheckingIn">
                <i class="fa-solid fa-right-to-bracket me-1"></i>Check-In (Vào Ca)
            </button>
            <button class="btn btn-warning shadow-sm fw-semibold text-dark" @onclick="HandleCheckOutAsync" disabled="@isCheckingOut">
                <i class="fa-solid fa-right-from-bracket me-1"></i>Check-Out (Hết Ca)
            </button>
            <button class="btn btn-outline-secondary" @onclick="LoadDataAsync" disabled="@isLoading" title="Tải lại dữ liệu">
                <i class="fa-solid fa-arrows-rotate @(isLoading ? "fa-spin" : "")"></i>
            </button>
        </div>
    </div>

    <!-- THÔNG BÁO HỆ THỐNG -->
    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert alert-@statusType alert-dismissible fade show shadow-sm" role="alert">
            <i class="fa-solid @(statusType == "success" ? "fa-circle-check" : (statusType == "warning" ? "fa-bell" : "fa-triangle-exclamation")) me-2"></i>
            @statusMessage
            <button type="button" class="btn-close" @onclick="() => statusMessage = string.Empty"></button>
        </div>
    }

    <!-- THANH LỌC: CHỌN NHÂN VIÊN & THÁNG NĂM -->
    <div class="card border-0 shadow-sm mb-4 bg-light">
        <div class="card-body p-3">
            <div class="row g-3 align-items-center">
                <!-- Chọn nhân viên -->
                <div class="col-lg-5 col-md-6">
                    <label class="form-label small fw-bold text-dark mb-1">
                        <i class="fa-solid fa-user-tie me-1 text-primary"></i>Chọn Nhân Viên:
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted">
                            <i class="fa-solid fa-users"></i>
                        </span>
                        <select class="form-select border-start-0 shadow-none fw-semibold" 
                                value="@currentEmployeeId" 
                                @onchange="OnEmployeeChangedAsync">
                            @foreach (var emp in allEmployees)
                            {
                                <option value="@emp.Id">
                                    [@emp.EmployeeCode] @emp.FullName - @(emp.DepartmentName ?? "Chưa phân phòng")
                                </option>
                            }
                        </select>
                    </div>
                </div>

                <!-- Chọn Tháng -->
                <div class="col-lg-3 col-md-3 col-sm-6">
                    <label class="form-label small fw-bold text-dark mb-1">
                        <i class="fa-regular fa-calendar-days me-1 text-primary"></i>Tháng Chấm Công:
                    </label>
                    <select class="form-select shadow-none" value="@currentMonth" @onchange="OnMonthChangedAsync">
                        @for (int m = 1; m <= 12; m++)
                        {
                            <option value="@m">Tháng @m</option>
                        }
                    </select>
                </div>

                <!-- Chọn Năm -->
                <div class="col-lg-2 col-md-3 col-sm-6">
                    <label class="form-label small fw-bold text-dark mb-1">
                        <i class="fa-solid fa-calendar me-1 text-primary"></i>Năm:
                    </label>
                    <select class="form-select shadow-none" value="@currentYear" @onchange="OnYearChangedAsync">
                        @for (int y = DateTime.Today.Year - 1; y <= DateTime.Today.Year + 1; y++)
                        {
                            <option value="@y">Năm @y</option>
                        }
                    </select>
                </div>

                <!-- Thông tin nhân sự đang xem -->
                <div class="col-lg-2 col-md-12 text-lg-end text-start">
                    <div class="small text-muted">Đang xem dữ liệu của:</div>
                    <div class="fw-bold text-primary text-truncate">
                        @(selectedEmployee != null ? $"[{selectedEmployee.EmployeeCode}] {selectedEmployee.FullName}" : "Nhân viên")
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- TRẠM ĐIỂM DANH THỜI GIAN THỰC (PUNCH STATION) -->
    <div class="card border-0 shadow-sm mb-4 overflow-hidden" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);">
        <div class="card-body p-4 text-white">
            <div class="row g-4 align-items-center">
                <!-- KHỐI ĐỒNG HỒ ĐIỆN TỬ & THÔNG TIN HÔM NAY -->
                <div class="col-lg-4 border-end border-secondary-subtle pe-lg-4">
                    <div class="d-flex align-items-center mb-2">
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 fw-bold me-2">
                            <i class="fa-solid fa-circle fa-fade me-1 text-danger"></i>LIVE
                        </span>
                        <span class="text-white-50 small text-uppercase fw-semibold letter-spacing-1">Đồng Hồ Hệ Thống</span>
                    </div>

                    <div class="display-5 fw-bold font-monospace text-white tracking-wider my-1" style="letter-spacing: 2px;">
                        @currentTime.ToString("HH:mm:ss")
                    </div>
                    <div class="text-info fw-medium small mb-3">
                        <i class="fa-regular fa-calendar-days me-1"></i>
                        @currentTime.ToString("dddd, dd/MM/yyyy", new System.Globalization.CultureInfo("vi-VN"))
                    </div>

                    <!-- DROPDOWN CHỌN CA LÀM VIỆC -->
                    <div class="mt-3">
                        <label class="form-label small text-white-50 fw-semibold mb-1">
                            <i class="fa-solid fa-business-time me-1 text-warning"></i>Ca Làm Việc:
                        </label>
                        <select class="form-select form-select-sm bg-dark text-white border-secondary shadow-none" 
                                @bind="selectedShiftId" 
                                disabled="@(todayTimesheet?.CheckInTime.HasValue == true && todayTimesheet?.CheckOutTime.HasValue == true)">
                            @foreach (var shift in activeShifts)
                            {
                                <option value="@shift.Id">
                                    @shift.ShiftName - [@shift.StartTime.ToString(@"hh\:mm") đến @shift.EndTime.ToString(@"hh\:mm")]
                                </option>
                            }
                        </select>

                        @if (currentShift != null)
                        {
                            <div class="p-2 mt-2 rounded bg-black bg-opacity-25 border border-white border-opacity-10 small">
                                <div class="d-flex justify-content-between text-white-50">
                                    <span>Mục tiêu ca:</span>
                                    <span class="text-white fw-bold">@currentShift.TargetHours giờ (@currentShift.WorkUnits công)</span>
                                </div>
                                <div class="d-flex justify-content-between text-white-50 mt-1">
                                    <span>Ân hạn đi trễ:</span>
                                    <span class="text-info">@currentShift.GracePeriodMinutes phút</span>
                                </div>
                                @if (currentShift.IsNightShift)
                                {
                                    <div class="mt-1 text-warning small">
                                        <i class="fa-solid fa-moon me-1"></i>Hưởng phụ cấp ca đêm +30%
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                <!-- KHỐI THAO TÁC CHECK-IN / CHECK-OUT -->
                <div class="col-lg-8 ps-lg-4">
                    <div class="d-flex flex-column justify-content-between h-100">
                        <div>
                            <div class="d-flex flex-wrap align-items-center justify-content-between mb-3 gap-2">
                                <div class="text-uppercase text-white-50 small fw-bold">
                                    Trạng Thái Hôm Nay (@DateTime.Today.ToString("dd/MM/yyyy")) • 
                                    <span class="text-info">@(selectedEmployee?.FullName ?? "Nhân viên")</span>
                                </div>
                                @if (todayTimesheet == null || (!todayTimesheet.CheckInTime.HasValue && !todayTimesheet.CheckOutTime.HasValue))
                                {
                                    <span class="badge bg-secondary-subtle text-secondary px-3 py-1 fs-6">
                                        <i class="fa-solid fa-circle-pause me-1"></i>Chưa Bắt Đầu Ca
                                    </span>
                                }
                                else if (todayTimesheet.CheckInTime.HasValue && !todayTimesheet.CheckOutTime.HasValue)
                                {
                                    <span class="badge bg-primary px-3 py-1 fs-6 shadow-sm">
                                        <i class="fa-solid fa-person-digging me-1"></i>Đang Trong Ca Làm Việc
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success px-3 py-1 fs-6 shadow-sm">
                                        <i class="fa-solid fa-circle-check me-1"></i>Đã Hoàn Thành Ca
                                    </span>
                                }
                            </div>

                            <!-- THẺ THÔNG TIN CHECK-IN / CHECK-OUT HÔM NAY -->
                            <div class="row g-3 mb-4">
                                <div class="col-sm-6">
                                    <div class="p-3 rounded bg-white bg-opacity-10 border border-white border-opacity-10">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="text-white-50 small fw-semibold">GIỜ VÀO (CHECK-IN)</span>
                                            @if (todayTimesheet?.CheckInTime.HasValue == true)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle small">Đã vào làm</span>
                                            }
                                        </div>
                                        <div class="fs-3 fw-bold text-success font-monospace mt-1">
                                            @(todayTimesheet?.CheckInTime?.ToString(@"hh\:mm\:ss") ?? "--:--:--")
                                        </div>
                                        <div class="small text-white-50 mt-1">
                                            @if (todayTimesheet?.CheckInTime.HasValue == true)
                                            {
                                                <span>Ca: @(todayTimesheet.ShiftName ?? "Ca Hành Chính")</span>
                                            }
                                            else
                                            {
                                                <span>Chưa ghi nhận giờ vào</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="col-sm-6">
                                    <div class="p-3 rounded bg-white bg-opacity-10 border border-white border-opacity-10">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <span class="text-white-50 small fw-semibold">GIỜ RA (CHECK-OUT)</span>
                                            @if (todayTimesheet?.CheckOutTime.HasValue == true)
                                            {
                                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle small">Đã tan ca</span>
                                            }
                                        </div>
                                        <div class="fs-3 fw-bold text-warning font-monospace mt-1">
                                            @(todayTimesheet?.CheckOutTime?.ToString(@"hh\:mm\:ss") ?? "--:--:--")
                                        </div>
                                        <div class="small text-white-50 mt-1">
                                            @(todayTimesheet?.CheckOutTime.HasValue == true ? $"Đạt {todayTimesheet.ActualHoursWorked}h ({todayTimesheet.WorkUnits} công)" : "Chưa ghi nhận giờ ra")
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- CÁC NÚT ĐIỂM DANH -->
                        <div class="d-flex flex-wrap gap-2 align-items-center">
                            <button class="btn btn-success btn-lg px-4 py-2 shadow fw-bold d-flex align-items-center" 
                                    @onclick="HandleCheckInAsync" disabled="@isCheckingIn">
                                @if (isCheckingIn)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    <span>Đang Check-In...</span>
                                }
                                else
                                {
                                    <i class="fa-solid fa-right-to-bracket fs-5 me-2"></i>
                                    <span>Check-In (Vào Ca)</span>
                                }
                            </button>

                            <button class="btn btn-warning text-dark btn-lg px-4 py-2 shadow fw-bold d-flex align-items-center" 
                                    @onclick="HandleCheckOutAsync" disabled="@isCheckingOut">
                                @if (isCheckingOut)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                    <span>Đang Check-Out...</span>
                                }
                                else
                                {
                                    <i class="fa-solid fa-right-from-bracket fs-5 me-2"></i>
                                    <span>Check-Out (Hết Ca)</span>
                                }
                            </button>

                            <button class="btn btn-outline-light px-3 py-2 fw-semibold" 
                                    @onclick="() => OpenManualPunchModal(todayTimesheet)">
                                <i class="fa-solid fa-pen-to-square me-1"></i>Chỉnh Giờ Thủ Công Hôm Nay
                            </button>

                            <div class="w-100 mt-2">
                                @if (todayTimesheet?.CheckInTime.HasValue == true && todayTimesheet?.CheckOutTime.HasValue == true)
                                {
                                    <div class="text-white-50 small">
                                        <i class="fa-solid fa-circle-check text-success me-1"></i>Hôm nay hoàn thành: 
                                        <strong class="text-white">@todayTimesheet.ActualHoursWorked giờ (@todayTimesheet.WorkUnits công)</strong> • @todayTimesheet.Note
                                    </div>
                                }
                                else if (todayTimesheet?.CheckInTime.HasValue == true)
                                {
                                    <div class="text-white-50 small">
                                        <i class="fa-solid fa-clock text-warning me-1"></i>Đã vào ca lúc @todayTimesheet.CheckInTime?.ToString(@"hh\:mm\:ss"). Bấm <strong>Check-Out</strong> khi tan ca.
                                    </div>
                                }
                                else
                                {
                                    <div class="text-white-50 small">
                                        <i class="fa-solid fa-info-circle text-info me-1"></i>Bấm <strong>Check-In</strong> để ghi nhận giờ bắt đầu làm, hoặc bấm <strong>Điểm Danh Thủ Công</strong> để chọn giờ tùy ý.
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- THỐNG KÊ NGÀY CÔNG TRONG THÁNG -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 border-start border-4 border-success bg-white">
                <div class="small text-muted fw-semibold text-uppercase">TỔNG NGÀY CÔNG TÍCH LŨY</div>
                <div class="fs-4 fw-bold text-success mt-1">@totalWorkUnits.ToString("0.##") công</div>
                <div class="small text-muted">Quy đổi hưởng lương tháng @currentMonth/@currentYear</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 border-start border-4 border-primary bg-white">
                <div class="small text-muted fw-semibold text-uppercase">CA ĐỦ CÔNG (1.0 CÔNG)</div>
                <div class="fs-4 fw-bold text-primary mt-1">@timesheets.Count(t => t.WorkUnits >= 1.0m) ca</div>
                <div class="small text-muted">Ca hoàn thành trọn vẹn</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 border-start border-4 border-info bg-white">
                <div class="small text-muted fw-semibold text-uppercase">CA NỬA NGÀY (0.5 CÔNG)</div>
                <div class="fs-4 fw-bold text-info mt-1">@timesheets.Count(t => t.WorkUnits > 0m && t.WorkUnits < 1.0m) ca</div>
                <div class="small text-muted">Ca sáng / chiều lẻ</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm p-3 border-start border-4 border-warning bg-white">
                <div class="small text-muted fw-semibold text-uppercase">ĐI MUỘN / VỀ SỚM</div>
                <div class="fs-4 fw-bold text-warning mt-1">
                    @timesheets.Count(t => t.WorkShiftStatus == WorkShiftStatus.LATE || t.WorkShiftStatus == WorkShiftStatus.EARLY_LEAVE) lần
                </div>
                <div class="small text-muted">Cần lưu ý tuân thủ giờ giấc</div>
            </div>
        </div>
    </div>

    <!-- BẢNG LỊCH SỬ CHẤM CÔNG CHI TIẾT -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <h5 class="card-title h6 mb-0 fw-bold">
                    <i class="fa-solid fa-clock-rotate-left text-primary me-2"></i>Nhật Ký Điểm Danh Chi Tiết Tháng @currentMonth/@currentYear
                </h5>
                <span class="text-muted small">
                    Nhân viên: <strong>@(selectedEmployee?.FullName ?? "N/A")</strong> (@(selectedEmployee?.EmployeeCode ?? "N/A"))
                </span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-secondary-subtle text-secondary px-2 py-1">
                    @timesheets.Count bản ghi
                </span>
                <button class="btn btn-sm btn-outline-primary fw-semibold" @onclick="() => OpenManualPunchModal(null)">
                    <i class="fa-solid fa-plus me-1"></i>Thêm Điểm Danh Mới
                </button>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted small text-uppercase">
                    <tr>
                        <th scope="col" style="width: 140px;">Ngày Làm Việc</th>
                        <th scope="col" style="width: 170px;">Ca Làm Việc</th>
                        <th scope="col" class="text-center" style="width: 120px;">Giờ Vào (In)</th>
                        <th scope="col" class="text-center" style="width: 120px;">Giờ Ra (Out)</th>
                        <th scope="col" class="text-center" style="width: 110px;">Số Giờ Làm</th>
                        <th scope="col" class="text-center" style="width: 100px;">Ngày Công</th>
                        <th scope="col" class="text-center" style="width: 140px;">Trạng Thái</th>
                        <th scope="col">Đánh Giá & Ghi Chú</th>
                        <th scope="col" class="text-center" style="width: 120px;">Thao Tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (timesheets.Count == 0)
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="fa-regular fa-calendar-xmark fs-2 d-block mb-2 text-secondary"></i>
                                Chưa có dữ liệu chấm công cho nhân viên này trong tháng @currentMonth/@currentYear.
                                <div class="mt-2">
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenManualPunchModal(null)">
                                        <i class="fa-solid fa-clock-rotate-left me-1"></i>Điểm danh ngay
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var t in timesheets)
                        {
                            var isToday = t.WorkDate.Date == DateTime.Today;
                            <tr class="@(isToday ? "table-primary table-opacity-10 fw-medium" : "")">
                                <td>
                                    <div class="fw-semibold @(isToday ? "text-primary" : "text-dark")">
                                        @t.WorkDate.ToString("dd/MM/yyyy")
                                        @if (isToday)
                                        {
                                            <span class="badge bg-primary ms-1" style="font-size: 0.65rem;">Hôm nay</span>
                                        }
                                    </div>
                                    <div class="text-muted small">@t.WorkDate.ToString("dddd", new System.Globalization.CultureInfo("vi-VN"))</div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(t.ShiftName))
                                    {
                                        <span class="badge bg-light text-dark border font-monospace px-2 py-1">
                                            @t.ShiftName
                                        </span>
                                    }
                                    else if (!string.IsNullOrEmpty(t.ShiftCode))
                                    {
                                        <span class="badge bg-light text-dark border font-monospace px-2 py-1">
                                            @t.ShiftCode
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border px-2 py-1">Ca Hành Chính</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (t.CheckInTime.HasValue)
                                    {
                                        <span class="font-monospace fw-bold text-success fs-6">
                                            <i class="fa-solid fa-arrow-right-to-bracket text-success me-1 small"></i>
                                            @t.CheckInTime.Value.ToString(@"hh\:mm\:ss")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted font-monospace">--:--:--</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (t.CheckOutTime.HasValue)
                                    {
                                        <span class="font-monospace fw-bold text-warning fs-6">
                                            <i class="fa-solid fa-arrow-right-from-bracket text-warning me-1 small"></i>
                                            @t.CheckOutTime.Value.ToString(@"hh\:mm\:ss")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted font-monospace">--:--:--</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="fw-semibold">@t.ActualHoursWorked.ToString("0.##")</span> giờ
                                </td>
                                <td class="text-center">
                                    <span class="badge @(t.WorkUnits >= 1.0m ? "bg-success" : (t.WorkUnits > 0 ? "bg-info" : "bg-secondary")) px-2 py-1">
                                        @t.WorkUnits.ToString("0.##") công
                                    </span>
                                </td>
                                <td class="text-center">
                                    @switch (t.WorkShiftStatus)
                                    {
                                        case WorkShiftStatus.PRESENT:
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                                <i class="fa-solid fa-circle-check me-1"></i>Đúng Giờ
                                            </span>
                                            break;
                                        case WorkShiftStatus.LATE:
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning px-2 py-1">
                                                <i class="fa-solid fa-clock me-1"></i>Đi Muộn
                                            </span>
                                            break;
                                        case WorkShiftStatus.EARLY_LEAVE:
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning px-2 py-1">
                                                <i class="fa-solid fa-person-walking-arrow-right me-1"></i>Về Sớm
                                            </span>
                                            break;
                                        case WorkShiftStatus.HALF_DAY:
                                            <span class="badge bg-info-subtle text-info border border-info px-2 py-1">
                                                <i class="fa-solid fa-hourglass-half me-1"></i>Nửa Ca
                                            </span>
                                            break;
                                        case WorkShiftStatus.ABSENT_WITH_PERMISSION:
                                            <span class="badge bg-info-subtle text-info border border-info px-2 py-1">
                                                <i class="fa-solid fa-calendar-xmark me-1"></i>Nghỉ Có Phép
                                            </span>
                                            break;
                                        case WorkShiftStatus.ABSENT_UNAUTHORIZED:
                                            <span class="badge bg-danger text-white px-2 py-1">
                                                <i class="fa-solid fa-xmark me-1"></i>Vắng Không Phép
                                            </span>
                                            break;
                                        case WorkShiftStatus.HOLIDAY:
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                                                <i class="fa-solid fa-flag me-1"></i>Nghỉ Lễ
                                            </span>
                                            break;
                                        default:
                                            <span class="badge bg-light text-secondary border px-2 py-1">@t.WorkShiftStatus</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    <span class="small @(t.WorkShiftStatus == WorkShiftStatus.LATE || t.WorkShiftStatus == WorkShiftStatus.EARLY_LEAVE || t.WorkShiftStatus == WorkShiftStatus.ABSENT_UNAUTHORIZED ? "text-danger fw-medium" : "text-muted")">
                                        @(string.IsNullOrWhiteSpace(t.Note) ? "-" : t.Note)
                                    </span>
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-outline-primary shadow-none py-1 px-2" 
                                            title="Chỉnh sửa giờ hoặc chấm công bổ sung cho ngày này"
                                            @onclick="() => OpenManualPunchModal(t)">
                                        <i class="fa-solid fa-pen-to-square me-1"></i>Sửa Giờ
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ========================================================================================= -->
<!-- MODAL ĐIỂM DANH THỦ CÔNG & CHỌN GIỜ VÀO / RA CỦA TỪNG NGƯỜI -->
<!-- ========================================================================================= -->
@if (showManualModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0, 0, 0, 0.65);" role="dialog">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content shadow-lg border-0 rounded-3">
                <div class="modal-header bg-dark text-white py-3">
                    <h5 class="modal-title h6 fw-bold">
                        <i class="fa-solid fa-clock-rotate-left me-2 text-warning"></i>
                        Điểm Danh Thủ Công & Tùy Chỉnh Giờ Chấm Công
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseManualModal"></button>
                </div>
                <div class="modal-body p-4">
                    @if (!string.IsNullOrEmpty(manualModalError))
                    {
                        <div class="alert alert-danger py-2 mb-3 small" role="alert">
                            <i class="fa-solid fa-triangle-exclamation me-2"></i>@manualModalError
                        </div>
                    }

                    <div class="row g-3">
                        <!-- Chọn nhân viên -->
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-dark mb-1">
                                Nhân Viên Được Điểm Danh <span class="text-danger">*</span>
                            </label>
                            <select class="form-select shadow-none" @bind="modalEmployeeId">
                                @foreach (var emp in allEmployees)
                                {
                                    <option value="@emp.Id">
                                        [@emp.EmployeeCode] @emp.FullName (@(emp.DepartmentName ?? "Nhân viên"))
                                    </option>
                                }
                            </select>
                            <div class="form-text" style="font-size: 0.75rem;">Chọn người cần ghi nhận giờ vào hoặc ra.</div>
                        </div>

                        <!-- Chọn ngày làm việc -->
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-dark mb-1">
                                Ngày Làm Việc <span class="text-danger">*</span>
                            </label>
                            <input type="date" class="form-control shadow-none" @bind="modalWorkDate" />
                            <div class="form-text" style="font-size: 0.75rem;">Mặc định ngày hôm nay hoặc ngày bạn muốn chỉnh sửa.</div>
                        </div>

                        <!-- Chọn ca làm việc -->
                        <div class="col-12">
                            <label class="form-label small fw-bold text-dark mb-1">
                                Ca Làm Việc Áp Dụng <span class="text-danger">*</span>
                            </label>
                            <select class="form-select shadow-none" @bind="modalShiftId">
                                @foreach (var shift in activeShifts)
                                {
                                    <option value="@shift.Id">
                                        @shift.ShiftName - [@shift.StartTime.ToString(@"hh\:mm") đến @shift.EndTime.ToString(@"hh\:mm")] (Mục tiêu: @shift.TargetHours h / @shift.WorkUnits công, Ân hạn: @shift.GracePeriodMinutes p)
                                    </option>
                                }
                            </select>
                        </div>

                        <!-- Giờ vào (Check-In) -->
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded border border-success-subtle">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <label class="form-label small fw-bold text-success mb-0">
                                        <i class="fa-solid fa-right-to-bracket me-1"></i>Giờ Vào (Check-In)
                                    </label>
                                    <div class="btn-group btn-group-sm">
                                        <button type="button" class="btn btn-outline-success btn-sm py-0 px-2" style="font-size: 0.7rem;" @onclick="SetNowCheckIn">
                                            Hiện tại
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" style="font-size: 0.7rem;" @onclick="SetShiftStartCheckIn">
                                            Chuẩn ca
                                        </button>
                                    </div>
                                </div>
                                <input type="time" class="form-control font-monospace fs-5 fw-bold text-success" @bind="modalCheckIn" />
                                <div class="form-text mt-1" style="font-size: 0.75rem;">
                                    Định dạng: Giờ:Phút (VD: 07:45, 08:00, 08:30). Để trống nếu chỉ muốn ghi giờ ra.
                                </div>
                            </div>
                        </div>

                        <!-- Giờ ra (Check-Out) -->
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded border border-warning-subtle">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <label class="form-label small fw-bold text-warning-emphasis mb-0">
                                        <i class="fa-solid fa-right-from-bracket me-1"></i>Giờ Ra (Check-Out)
                                    </label>
                                    <div class="btn-group btn-group-sm">
                                        <button type="button" class="btn btn-outline-warning btn-sm py-0 px-2 text-dark" style="font-size: 0.7rem;" @onclick="SetNowCheckOut">
                                            Hiện tại
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" style="font-size: 0.7rem;" @onclick="SetShiftEndCheckOut">
                                            Chuẩn ca
                                        </button>
                                        <button type="button" class="btn btn-outline-danger btn-sm py-0 px-2" style="font-size: 0.7rem;" @onclick="ClearCheckOut">
                                            Xóa
                                        </button>
                                    </div>
                                </div>
                                <input type="time" class="form-control font-monospace fs-5 fw-bold text-warning-emphasis" @bind="modalCheckOut" />
                                <div class="form-text mt-1" style="font-size: 0.75rem;">
                                    Định dạng: Giờ:Phút (VD: 17:30, 18:00). Để trống nếu nhân viên mới chỉ Check-In vào ca.
                                </div>
                            </div>
                        </div>

                        <!-- Ghi chú bổ sung -->
                        <div class="col-12">
                            <label class="form-label small fw-bold text-dark mb-1">
                                Ghi Chú / Lý Do Điểm Danh Thủ Công:
                            </label>
                            <input type="text" class="form-control shadow-none" 
                                   placeholder="VD: Quên bấm máy vân tay, Đi công tác về muộn, Điểm danh bổ sung..." 
                                   @bind="modalNote" />
                        </div>

                        <!-- HỘP DỰ TÍNH KẾT QUẢ ĐIỂM DANH -->
                        <div class="col-12">
                            <div class="p-3 rounded bg-primary bg-opacity-10 border border-primary-subtle small">
                                <div class="fw-bold text-primary mb-1">
                                    <i class="fa-solid fa-calculator me-1"></i>Đánh giá tự động khi lưu:
                                </div>
                                <ul class="mb-0 ps-3 text-secondary">
                                    <li>Nếu chỉ có <strong>Giờ Vào</strong>: Ghi nhận Check-In, tự động đối chiếu giờ ca và ghi chú nếu đi muộn.</li>
                                    <li>Nếu có cả <strong>Giờ Vào & Giờ Ra</strong>: Tự động trừ thời gian nghỉ trưa, tính tổng giờ làm việc thực tế và quy đổi hệ số công (1.0 hoặc 0.5 công).</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-light py-2 px-4 d-flex flex-wrap justify-content-between">
                    <button type="button" class="btn btn-secondary" @onclick="CloseManualModal" disabled="@isSubmittingModal">
                        Đóng
                    </button>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="button" class="btn btn-success fw-bold" @onclick="SaveManualCheckInOnlyAsync" disabled="@isSubmittingModal">
                            <i class="fa-solid fa-right-to-bracket me-1"></i>Chỉ Lưu Giờ Vào (Check-In)
                        </button>
                        <button type="button" class="btn btn-warning fw-bold text-dark" @onclick="SaveManualCheckOutOnlyAsync" disabled="@isSubmittingModal">
                            <i class="fa-solid fa-right-from-bracket me-1"></i>Chỉ Lưu Giờ Ra (Check-Out)
                        </button>
                        <button type="button" class="btn btn-primary fw-bold" @onclick="SaveManualFullShiftAsync" disabled="@isSubmittingModal">
                            <i class="fa-solid fa-floppy-disk me-1"></i>Lưu Toàn Bộ Ca (Vào & Ra)
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private long currentEmployeeId = 1;
    private int currentMonth = DateTime.Today.Month;
    private int currentYear = DateTime.Today.Year;

    private List<Employee> allEmployees = new();
    private List<Timesheet> timesheets = new();
    private List<WorkShift> activeShifts = new();
    private long selectedShiftId = 1;

    private Employee? selectedEmployee => allEmployees.FirstOrDefault(e => e.Id == currentEmployeeId);
    private Timesheet? todayTimesheet => timesheets.FirstOrDefault(t => t.WorkDate.Date == DateTime.Today);
    private WorkShift? currentShift => activeShifts.FirstOrDefault(s => s.Id == selectedShiftId) ?? activeShifts.FirstOrDefault();

    private decimal totalWorkUnits => timesheets.Sum(t => t.WorkUnits);

    private bool isLoading = false;
    private bool isCheckingIn = false;
    private bool isCheckingOut = false;
    private string statusMessage = string.Empty;
    private string statusType = "success";

    // Real-time clock timer
    private DateTime currentTime = DateTime.Now;
    private System.Threading.Timer? clockTimer;

    // Modal state
    private bool showManualModal = false;
    private bool isSubmittingModal = false;
    private string manualModalError = string.Empty;
    private long modalEmployeeId = 1;
    private DateTime modalWorkDate = DateTime.Today;
    private long modalShiftId = 1;
    private TimeOnly? modalCheckIn = new TimeOnly(8, 0);
    private TimeOnly? modalCheckOut = new TimeOnly(17, 30);
    private string modalNote = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        // Start real-time clock timer ticking every second
        clockTimer = new System.Threading.Timer(_ =>
        {
            currentTime = DateTime.Now;
            InvokeAsync(StateHasChanged);
        }, null, 0, 1000);

        if (AuthStateTask != null)
        {
            var authState = await AuthStateTask;
            var empIdClaim = authState.User.FindFirst("EmployeeId")?.Value;
            if (long.TryParse(empIdClaim, out var id) && id > 0)
            {
                currentEmployeeId = id;
            }
        }

        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        try
        {
            // 1. Load employees list
            var emps = await EmployeeRepo.GetEmployeesAsync();
            allEmployees = emps.OrderBy(e => e.EmployeeCode).ToList();

            if (allEmployees.Any() && !allEmployees.Any(e => e.Id == currentEmployeeId))
            {
                currentEmployeeId = allEmployees.First().Id;
            }

            // 2. Load active shifts
            var shiftResult = await GetWorkShiftsUseCase.ExecuteAsync(onlyActive: true);
            activeShifts = shiftResult.OrderBy(s => s.StartTime).ToList();

            if (activeShifts.Any())
            {
                var defaultShift = activeShifts.FirstOrDefault(s => s.ShiftCode == "CA_HANH_CHINH") ?? activeShifts.First();
                selectedShiftId = defaultShift.Id;
            }

            // 3. Load employee timesheets
            await LoadTimesheetsAsync();

            // 4. Pre-select shift from today's timesheet if already checked in
            if (todayTimesheet?.ShiftId.HasValue == true && todayTimesheet.ShiftId.Value > 0)
            {
                selectedShiftId = todayTimesheet.ShiftId.Value;
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Lỗi khi tải dữ liệu: {ex.Message}";
            statusType = "danger";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadTimesheetsAsync()
    {
        var result = await ViewTimesheetUseCase.ExecuteAsync(currentEmployeeId, currentMonth, currentYear);
        timesheets = result.OrderByDescending(t => t.WorkDate).ToList();
    }

    private async Task OnEmployeeChangedAsync(ChangeEventArgs e)
    {
        if (long.TryParse(e.Value?.ToString(), out var empId) && empId > 0)
        {
            currentEmployeeId = empId;
            await LoadTimesheetsAsync();
            if (todayTimesheet?.ShiftId.HasValue == true && todayTimesheet.ShiftId.Value > 0)
            {
                selectedShiftId = todayTimesheet.ShiftId.Value;
            }
        }
    }

    private async Task OnMonthChangedAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var m) && m >= 1 && m <= 12)
        {
            currentMonth = m;
            await LoadTimesheetsAsync();
        }
    }

    private async Task OnYearChangedAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var y) && y >= 2000 && y <= 2100)
        {
            currentYear = y;
            await LoadTimesheetsAsync();
        }
    }

    private async Task HandleCheckInAsync()
    {
        isCheckingIn = true;
        statusMessage = string.Empty;
        try
        {
            var t = await CheckInUseCase.ExecuteCheckInAsync(currentEmployeeId, selectedShiftId);
            var empName = selectedEmployee?.FullName ?? $"NV #{currentEmployeeId}";
            statusMessage = $"Check-In thành công cho {empName} lúc {DateTime.Now:HH:mm:ss} vào '{t.ShiftName ?? "Ca làm việc"}'! {t.Note}";
            statusType = "success";
            await LoadTimesheetsAsync();
        }
        catch (Exception ex)
        {
            statusMessage = $"Không thể Check-In: {ex.Message}";
            statusType = "danger";
        }
        finally
        {
            isCheckingIn = false;
        }
    }

    private async Task HandleCheckOutAsync()
    {
        isCheckingOut = true;
        statusMessage = string.Empty;
        try
        {
            var t = await CheckInUseCase.ExecuteCheckOutAsync(currentEmployeeId, selectedShiftId);
            var empName = selectedEmployee?.FullName ?? $"NV #{currentEmployeeId}";
            statusMessage = $"Check-Out thành công cho {empName} lúc {DateTime.Now:HH:mm:ss}! Tổng giờ làm: {t.ActualHoursWorked}h ({t.WorkUnits} công). Đánh giá: {t.Note}";
            statusType = "success";
            await LoadTimesheetsAsync();
        }
        catch (Exception ex)
        {
            statusMessage = $"Không thể Check-Out: {ex.Message}";
            statusType = "danger";
        }
        finally
        {
            isCheckingOut = false;
        }
    }

    // =========================================================================
    // MODAL DIALOG HANDLERS
    // =========================================================================

    private void OpenManualPunchModal(Timesheet? prefill)
    {
        manualModalError = string.Empty;
        modalEmployeeId = prefill?.EmployeeId ?? currentEmployeeId;
        modalWorkDate = prefill?.WorkDate ?? DateTime.Today;
        modalShiftId = prefill?.ShiftId ?? selectedShiftId;

        if (prefill?.CheckInTime.HasValue == true)
        {
            modalCheckIn = TimeOnly.FromTimeSpan(prefill.CheckInTime.Value);
        }
        else
        {
            var shift = activeShifts.FirstOrDefault(s => s.Id == modalShiftId) ?? currentShift;
            modalCheckIn = shift != null ? TimeOnly.FromTimeSpan(shift.StartTime) : new TimeOnly(8, 0);
        }

        if (prefill?.CheckOutTime.HasValue == true)
        {
            modalCheckOut = TimeOnly.FromTimeSpan(prefill.CheckOutTime.Value);
        }
        else
        {
            var shift = activeShifts.FirstOrDefault(s => s.Id == modalShiftId) ?? currentShift;
            modalCheckOut = shift != null ? TimeOnly.FromTimeSpan(shift.EndTime) : new TimeOnly(17, 30);
        }

        modalNote = prefill?.Note ?? string.Empty;
        showManualModal = true;
    }

    private void CloseManualModal()
    {
        showManualModal = false;
        manualModalError = string.Empty;
    }

    private void SetNowCheckIn()
    {
        modalCheckIn = TimeOnly.FromDateTime(DateTime.Now);
    }

    private void SetShiftStartCheckIn()
    {
        var shift = activeShifts.FirstOrDefault(s => s.Id == modalShiftId) ?? currentShift;
        modalCheckIn = shift != null ? TimeOnly.FromTimeSpan(shift.StartTime) : new TimeOnly(8, 0);
    }

    private void SetNowCheckOut()
    {
        modalCheckOut = TimeOnly.FromDateTime(DateTime.Now);
    }

    private void SetShiftEndCheckOut()
    {
        var shift = activeShifts.FirstOrDefault(s => s.Id == modalShiftId) ?? currentShift;
        modalCheckOut = shift != null ? TimeOnly.FromTimeSpan(shift.EndTime) : new TimeOnly(17, 30);
    }

    private void ClearCheckOut()
    {
        modalCheckOut = null;
    }

    private async Task SaveManualCheckInOnlyAsync()
    {
        manualModalError = string.Empty;
        if (!modalCheckIn.HasValue)
        {
            manualModalError = "Vui lòng nhập Giờ Vào hợp lệ.";
            return;
        }

        isSubmittingModal = true;
        try
        {
            var inTime = modalCheckIn.Value.ToTimeSpan();
            var result = await CheckInUseCase.ExecuteManualPunchAsync(
                employeeId: modalEmployeeId,
                shiftId: modalShiftId,
                workDate: modalWorkDate,
                checkInTime: inTime,
                checkOutTime: null,
                customNote: string.IsNullOrWhiteSpace(modalNote) ? "Điểm danh giờ vào thủ công" : modalNote
            );

            showManualModal = false;
            statusMessage = $"Đã ghi nhận Giờ Vào thành công cho nhân viên ngày {modalWorkDate:dd/MM/yyyy}: {result.CheckInTime?.ToString(@"hh\:mm")}. Trạng thái: {result.Note}";
            statusType = "success";

            // If we punched for another employee, switch to them so the user sees the record immediately
            if (currentEmployeeId != modalEmployeeId)
            {
                currentEmployeeId = modalEmployeeId;
            }
            await LoadTimesheetsAsync();
        }
        catch (Exception ex)
        {
            manualModalError = $"Lỗi: {ex.Message}";
        }
        finally
        {
            isSubmittingModal = false;
        }
    }

    private async Task SaveManualCheckOutOnlyAsync()
    {
        manualModalError = string.Empty;
        if (!modalCheckOut.HasValue)
        {
            manualModalError = "Vui lòng nhập Giờ Ra hợp lệ.";
            return;
        }

        isSubmittingModal = true;
        try
        {
            var outTime = modalCheckOut.Value.ToTimeSpan();
            var result = await CheckInUseCase.ExecuteManualPunchAsync(
                employeeId: modalEmployeeId,
                shiftId: modalShiftId,
                workDate: modalWorkDate,
                checkInTime: null,
                checkOutTime: outTime,
                customNote: string.IsNullOrWhiteSpace(modalNote) ? "Điểm danh giờ ra thủ công" : modalNote
            );

            showManualModal = false;
            statusMessage = $"Đã ghi nhận Giờ Ra thành công cho nhân viên ngày {modalWorkDate:dd/MM/yyyy}: {result.CheckOutTime?.ToString(@"hh\:mm")}. Tổng giờ làm: {result.ActualHoursWorked}h ({result.WorkUnits} công). Đánh giá: {result.Note}";
            statusType = "success";

            if (currentEmployeeId != modalEmployeeId)
            {
                currentEmployeeId = modalEmployeeId;
            }
            await LoadTimesheetsAsync();
        }
        catch (Exception ex)
        {
            manualModalError = $"Lỗi: {ex.Message}";
        }
        finally
        {
            isSubmittingModal = false;
        }
    }

    private async Task SaveManualFullShiftAsync()
    {
        manualModalError = string.Empty;
        if (!modalCheckIn.HasValue)
        {
            manualModalError = "Vui lòng nhập Giờ Vào hợp lệ.";
            return;
        }

        TimeSpan inTime = modalCheckIn.Value.ToTimeSpan();
        TimeSpan? outTime = modalCheckOut.HasValue ? modalCheckOut.Value.ToTimeSpan() : null;

        isSubmittingModal = true;
        try
        {
            var result = await CheckInUseCase.ExecuteManualPunchAsync(
                employeeId: modalEmployeeId,
                shiftId: modalShiftId,
                workDate: modalWorkDate,
                checkInTime: inTime,
                checkOutTime: outTime,
                customNote: string.IsNullOrWhiteSpace(modalNote) ? "Điểm danh toàn bộ ca thủ công" : modalNote
            );

            showManualModal = false;
            statusMessage = $"Lưu điểm danh thành công ngày {modalWorkDate:dd/MM/yyyy}! Giờ vào: {result.CheckInTime?.ToString(@"hh\:mm")}, Giờ ra: {(result.CheckOutTime.HasValue ? result.CheckOutTime.Value.ToString(@"hh\:mm") : "chưa có")}. Tổng giờ: {result.ActualHoursWorked}h ({result.WorkUnits} công). {result.Note}";
            statusType = "success";

            if (currentEmployeeId != modalEmployeeId)
            {
                currentEmployeeId = modalEmployeeId;
            }
            await LoadTimesheetsAsync();
        }
        catch (Exception ex)
        {
            manualModalError = $"Lỗi: {ex.Message}";
        }
        finally
        {
            isSubmittingModal = false;
        }
    }

    public void Dispose()
    {
        clockTimer?.Dispose();
    }
}
