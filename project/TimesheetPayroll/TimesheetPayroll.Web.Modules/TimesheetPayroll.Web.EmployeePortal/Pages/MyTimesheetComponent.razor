@page "/my-timesheet"
@implements IDisposable
@inject IViewMyTimesheetUseCase ViewTimesheetUseCase
@inject ICheckInCheckOutUseCase CheckInUseCase
@inject IGetWorkShiftsUseCase GetWorkShiftsUseCase
@inject IEmployeeRepository EmployeeRepo
@inject IViewTimesheetSummaryUseCase ViewTimesheetSummaryUseCase
@using TimesheetPayroll.UseCases.AdminPortal
@using TimesheetPayroll.UseCases.PluginInterfaces.DataStore
@using TimesheetPayroll.CoreBusiness.Models
@using TimesheetPayroll.Web.Common.Controls

<div class="container-fluid py-3">
    <!-- TIÊU ĐỀ TRANG & THANH ĐIỀU HƯỚNG NHANH -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 pb-2 border-bottom gap-2">
        <div>
            <h2 class="h4 mb-1 text-dark fw-bold">
                @if (isManager)
                {
                    <i class="fa-solid fa-calendar-check text-success me-2"></i><span>Quản Trị Bảng Chấm Công & Điểm Danh</span>
                }
                else
                {
                    <i class="fa-solid fa-fingerprint text-success me-2"></i><span>Bảng Chấm Công Cá Nhân & Điểm Danh</span>
                }
            </h2>
            <p class="text-muted small mb-0">
                @if (isManager)
                {
                    <span>Chế độ <strong>Kế toán / Quản trị viên</strong>: Điểm danh thủ công, chỉnh sửa giờ công, đối soát chi tiết và xem bảng tổng hợp toàn công ty.</span>
                }
                else
                {
                    <span>Chế độ <strong>Nhân viên</strong>: Ghi nhận Check-In / Check-Out thời gian thực theo ca và tra cứu dữ liệu ngày công cá nhân.</span>
                }
            </p>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2">
            @if (isManager)
            {
                <button class="btn btn-primary shadow-sm fw-semibold" @onclick="() => OpenManualPunchModal(null)">
                    <i class="fa-solid fa-clock-rotate-left me-1"></i>Điểm Danh Thủ Công (Nhập Giờ)
                </button>
            }
            <button class="btn btn-success shadow-sm fw-semibold" @onclick="HandleCheckInAsync" disabled="@isCheckingIn">
                <i class="fa-solid fa-right-to-bracket me-1"></i>Check-In (Vào Ca)
            </button>
            <button class="btn btn-warning shadow-sm fw-semibold text-dark" @onclick="HandleCheckOutAsync" disabled="@isCheckingOut">
                <i class="fa-solid fa-right-from-bracket me-1"></i>Check-Out (Hết Ca)
            </button>
            <button class="btn btn-outline-secondary" @onclick="LoadDataAsync" disabled="@isLoading" title="Tải lại dữ liệu">
                <i class="fa-solid fa-arrows-rotate @(isLoading ? "fa-spin" : "")"></i>
            </button>
        </div>
    </div>

    <!-- THÔNG BÁO HỆ THỐNG -->
    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert alert-@statusType alert-dismissible fade show shadow-sm" role="alert">
            <i class="fa-solid @(statusType == "success" ? "fa-circle-check" : (statusType == "warning" ? "fa-bell" : "fa-triangle-exclamation")) me-2"></i>
            @statusMessage
            <button type="button" class="btn-close" @onclick="() => statusMessage = string.Empty"></button>
        </div>
    }

    <!-- TAB ĐIỀU HƯỚNG DÀNH RIÊNG CHO KẾ TOÁN & ADMIN -->
    @if (isManager)
    {
        <ul class="nav nav-pills mb-3 p-1 bg-white rounded shadow-sm border gap-1">
            <li class="nav-item">
                <button type="button" class="nav-link fw-bold @(activeTimesheetTab == "individual" ? "active bg-primary text-white" : "text-dark")" 
                        @onclick='() => SetActiveTab("individual")'>
                    <i class="fa-solid fa-user me-2"></i>Bảng Công Chi Tiết (Từng Nhân Viên)
                </button>
            </li>
            <li class="nav-item">
                <button type="button" class="nav-link fw-bold @(activeTimesheetTab == "summary" ? "active bg-primary text-white" : "text-dark")" 
                        @onclick='() => SetActiveTab("summary")'>
                    <i class="fa-solid fa-table-list me-2"></i>Bảng Tổng Hợp Công Toàn Doanh Nghiệp (Tháng @currentMonth/@currentYear)
                    <span class="badge @(activeTimesheetTab == "summary" ? "bg-light text-dark" : "bg-primary text-white") ms-2">
                        @summaryItems.Count nhân sự
                    </span>
                </button>
            </li>
        </ul>
    }

    @if (activeTimesheetTab == "individual")
    {
        <!-- THANH LỌC: CHỌN NHÂN VIÊN & THÁNG NĂM -->
        <div class="card border-0 shadow-sm mb-4 bg-light">
            <div class="card-body p-3">
                <div class="row g-3 align-items-center">
                    <!-- Chọn nhân viên (Kế toán/Admin chọn được mọi người, Nhân viên chỉ hiển thị tên của chính mình) -->
                    <div class="col-lg-5 col-md-6">
                        @if (isManager)
                        {
                            <label class="form-label small fw-bold text-dark mb-1">
                                <i class="fa-solid fa-user-tie me-1 text-primary"></i>Chọn Nhân Viên Cần Kiểm Tra / Chấm Công:
                            </label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-muted">
                                    <i class="fa-solid fa-users"></i>
                                </span>
                                <select class="form-select border-start-0 shadow-none fw-semibold" 
                                        value="@currentEmployeeId" 
                                        @onchange="OnEmployeeChangedAsync">
                                    @foreach (var emp in allEmployees)
                                    {
                                        <option value="@emp.Id">
                                            [@emp.EmployeeCode] @emp.FullName - @(emp.DepartmentName ?? "Chưa phân phòng")
                                        </option>
                                    }
                                </select>
                            </div>
                        }
                        else
                        {
                            <label class="form-label small fw-bold text-dark mb-1">
                                <i class="fa-solid fa-id-badge me-1 text-primary"></i>Hồ Sơ Của Bạn (Bảo Mật Quyền Cá Nhân):
                            </label>
                            <div class="p-2 bg-white rounded border d-flex align-items-center">
                                <span class="badge bg-primary px-2 py-1 me-2 font-monospace">@selectedEmployee?.EmployeeCode</span>
                                <span class="fw-bold text-dark me-2">@selectedEmployee?.FullName</span>
                                <span class="text-muted small">• @(selectedEmployee?.DepartmentName ?? "Nhân viên")</span>
                                <span class="badge bg-success-subtle text-success ms-auto border border-success-subtle small">Chính chủ</span>
                            </div>
                        }
                    </div>

                    <!-- Chọn Tháng -->
                    <div class="col-lg-3 col-md-3 col-sm-6">
                        <label class="form-label small fw-bold text-dark mb-1">
                            <i class="fa-regular fa-calendar-days me-1 text-primary"></i>Tháng Chấm Công:
                        </label>
                        <select class="form-select shadow-none" value="@currentMonth" @onchange="OnMonthChangedAsync">
                            @for (int m = 1; m <= 12; m++)
                            {
                                <option value="@m">Tháng @m</option>
                            }
                        </select>
                    </div>

                    <!-- Chọn Năm -->
                    <div class="col-lg-2 col-md-3 col-sm-6">
                        <label class="form-label small fw-bold text-dark mb-1">
                            <i class="fa-solid fa-calendar me-1 text-primary"></i>Năm:
                        </label>
                        <select class="form-select shadow-none" value="@currentYear" @onchange="OnYearChangedAsync">
                            @for (int y = DateTime.Today.Year - 1; y <= DateTime.Today.Year + 1; y++)
                            {
                                <option value="@y">Năm @y</option>
                            }
                        </select>
                    </div>

                    <!-- Thông tin nhân sự đang xem -->
                    <div class="col-lg-2 col-md-12 text-lg-end text-start">
                        <div class="small text-muted">Đang xem dữ liệu của:</div>
                        <div class="fw-bold text-primary text-truncate">
                            @(selectedEmployee != null ? $"[{selectedEmployee.EmployeeCode}] {selectedEmployee.FullName}" : "Nhân viên")
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- TRẠM ĐIỂM DANH THỜI GIAN THỰC (PUNCH STATION) -->
        <div class="card border-0 shadow-sm mb-4 overflow-hidden" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);">
            <div class="card-body p-4 text-white">
                <div class="row g-4 align-items-center">
                    <!-- KHỐI ĐỒNG HỒ ĐIỆN TỬ & THÔNG TIN HÔM NAY -->
                    <div class="col-lg-4 border-end border-secondary-subtle pe-lg-4">
                        <div class="d-flex align-items-center mb-2">
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1 fw-bold me-2">
                                <i class="fa-solid fa-circle fa-fade me-1 text-danger"></i>LIVE
                            </span>
                            <span class="text-white-50 small text-uppercase fw-semibold letter-spacing-1">Đồng Hồ Hệ Thống</span>
                        </div>

                        <div class="display-5 fw-bold font-monospace text-white tracking-wider my-1" style="letter-spacing: 2px;">
                            @currentTime.ToString("HH:mm:ss")
                        </div>
                        <div class="text-info fw-medium small mb-3">
                            <i class="fa-regular fa-calendar-days me-1"></i>
                            @currentTime.ToString("dddd, dd/MM/yyyy", new System.Globalization.CultureInfo("vi-VN"))
                        </div>

                        <!-- DROPDOWN CHỌN & ĐIỀU CHỈNH CA LÀM VIỆC CỦA NHÂN VIÊN -->
                        <div class="mt-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="form-label small text-white-50 fw-semibold mb-0">
                                    <i class="fa-solid fa-business-time me-1 text-warning"></i>Ca Làm Việc Hôm Nay:
                                </label>
                                @if (currentShift?.ShiftCode == "CA_GAY")
                                {
                                    <span class="badge bg-warning text-dark fw-bold px-2 py-0" style="font-size: 0.72rem;">
                                        <i class="fa-solid fa-bolt me-1"></i>Ca Gãy (+50k/ca)
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-primary text-white fw-bold px-2 py-0" style="font-size: 0.72rem;">
                                        <i class="fa-solid fa-clock me-1"></i>Ca 8 Tiếng Chuẩn
                                    </span>
                                }
                            </div>
                            <select class="form-select form-select-sm bg-dark text-white border-secondary shadow-none fw-medium" 
                                    value="@selectedShiftId" 
                                    @onchange="OnPunchShiftChangedAsync"
                                    disabled="@(todayTimesheet?.IsLocked == true)">
                                @foreach (var shift in activeShifts)
                                {
                                    <option value="@shift.Id">
                                        @shift.ShiftName @(shift.ShiftCode == "CA_GAY" ? "⚡ [Ca Gãy • Hưởng phụ cấp 50k]" : "")
                                    </option>
                                }
                            </select>

                            @if (currentShift != null)
                            {
                                <div class="p-2 mt-2 rounded bg-black bg-opacity-25 border border-white border-opacity-10 small">
                                    <div class="d-flex justify-content-between text-white-50">
                                        <span>Phân loại ca:</span>
                                        <span class="fw-bold @(currentShift.ShiftCode == "CA_GAY" ? "text-warning" : "text-white")">
                                            @(currentShift.ShiftCode == "CA_GAY" ? "⚡ Ca Gãy (Phân lương & phụ cấp riêng)" : "☀️ Ca Tiêu Chuẩn 8 Tiếng")
                                        </span>
                                    </div>
                                    <div class="d-flex justify-content-between text-white-50 mt-1">
                                        <span>Khung giờ:</span>
                                        <span class="text-info font-monospace">@currentShift.StartTime.ToString(@"hh\:mm") - @currentShift.EndTime.ToString(@"hh\:mm")</span>
                                    </div>
                                    <div class="d-flex justify-content-between text-white-50 mt-1">
                                        <span>Mục tiêu / Quy đổi:</span>
                                        <span class="text-white">@currentShift.TargetHours giờ • @currentShift.WorkUnits công</span>
                                    </div>
                                    @if (currentShift.ShiftCode == "CA_GAY")
                                    {
                                        <div class="mt-2 pt-1 border-top border-white border-opacity-10 text-warning small fw-bold">
                                            <i class="fa-solid fa-gift me-1"></i>Hưởng phụ cấp ca gãy: +50.000 VNĐ / ngày công
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <!-- KHỐI THAO TÁC CHECK-IN / CHECK-OUT -->
                    <div class="col-lg-8 ps-lg-4">
                        <div class="d-flex flex-column justify-content-between h-100">
                            <div>
                                <div class="d-flex flex-wrap align-items-center justify-content-between mb-3 gap-2">
                                    <div class="text-uppercase text-white-50 small fw-bold">
                                        Trạng Thái Hôm Nay (@DateTime.Today.ToString("dd/MM/yyyy")) • 
                                        <span class="text-info">@(selectedEmployee?.FullName ?? "Nhân viên")</span>
                                    </div>
                                    @if (todayTimesheet == null || (!todayTimesheet.CheckInTime.HasValue && !todayTimesheet.CheckOutTime.HasValue))
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary px-3 py-1 fs-6">
                                            <i class="fa-solid fa-circle-pause me-1"></i>Chưa Bắt Đầu Ca
                                        </span>
                                    }
                                    else if (todayTimesheet.CheckInTime.HasValue && !todayTimesheet.CheckOutTime.HasValue)
                                    {
                                        <span class="badge bg-primary px-3 py-1 fs-6 shadow-sm">
                                            <i class="fa-solid fa-person-digging me-1"></i>Đang Trong Ca Làm Việc
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success px-3 py-1 fs-6 shadow-sm">
                                            <i class="fa-solid fa-circle-check me-1"></i>Đã Hoàn Thành Ca
                                        </span>
                                    }
                                </div>

                                <!-- THẺ THÔNG TIN CHECK-IN / CHECK-OUT HÔM NAY -->
                                <div class="row g-3 mb-4">
                                    <div class="col-sm-6">
                                        <div class="p-3 rounded bg-white bg-opacity-10 border border-white border-opacity-10">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <span class="text-white-50 small fw-semibold">GIỜ VÀO (CHECK-IN)</span>
                                                @if (todayTimesheet?.CheckInTime.HasValue == true)
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle small">Đã vào làm</span>
                                                }
                                            </div>
                                            <div class="fs-3 fw-bold text-success font-monospace mt-1">
                                                @(todayTimesheet?.CheckInTime?.ToString(@"hh\:mm\:ss") ?? "--:--:--")
                                            </div>
                                            <div class="small text-white-50 mt-1">
                                                @if (todayTimesheet?.CheckInTime.HasValue == true)
                                                {
                                                    <span>Ca: @(todayTimesheet.ShiftName ?? "Ca Hành Chính")</span>
                                                }
                                                else
                                                {
                                                    <span>Chưa ghi nhận giờ vào</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-sm-6">
                                        <div class="p-3 rounded bg-white bg-opacity-10 border border-white border-opacity-10">
                                            <div class="d-flex justify-content-between align-items-center">
                                                <span class="text-white-50 small fw-semibold">GIỜ RA (CHECK-OUT)</span>
                                                @if (todayTimesheet?.CheckOutTime.HasValue == true)
                                                {
                                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle small">Đã tan ca</span>
                                                }
                                            </div>
                                            <div class="fs-3 fw-bold text-warning font-monospace mt-1">
                                                @(todayTimesheet?.CheckOutTime?.ToString(@"hh\:mm\:ss") ?? "--:--:--")
                                            </div>
                                            <div class="small text-white-50 mt-1">
                                                @(todayTimesheet?.CheckOutTime.HasValue == true ? $"Đạt {todayTimesheet.ActualHoursWorked}h ({todayTimesheet.WorkUnits} công)" : "Chưa ghi nhận giờ ra")
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- CÁC NÚT ĐIỂM DANH THỰC TẾ -->
                            <div class="d-flex flex-wrap gap-2 align-items-center">
                                <button class="btn btn-success btn-lg px-4 py-2 shadow fw-bold d-flex align-items-center" 
                                        @onclick="HandleCheckInAsync" disabled="@isCheckingIn">
                                    @if (isCheckingIn)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                        <span>Đang Check-In...</span>
                                    }
                                    else
                                    {
                                        <i class="fa-solid fa-right-to-bracket fs-5 me-2"></i>
                                        <span>Check-In (Vào Ca)</span>
                                    }
                                </button>

                                <button class="btn btn-warning text-dark btn-lg px-4 py-2 shadow fw-bold d-flex align-items-center" 
                                        @onclick="HandleCheckOutAsync" disabled="@isCheckingOut">
                                    @if (isCheckingOut)
                                    {
                                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                        <span>Đang Check-Out...</span>
                                    }
                                    else
                                    {
                                        <i class="fa-solid fa-right-from-bracket fs-5 me-2"></i>
                                        <span>Check-Out (Hết Ca)</span>
                                    }
                                </button>

                                @if (isManager)
                                {
                                    <button class="btn btn-outline-light px-3 py-2 fw-semibold" 
                                            @onclick="() => OpenManualPunchModal(todayTimesheet)">
                                        <i class="fa-solid fa-pen-to-square me-1"></i>Chỉnh Giờ Thủ Công Hôm Nay
                                    </button>
                                }

                                <div class="w-100 mt-2">
                                    @if (todayTimesheet?.CheckInTime.HasValue == true && todayTimesheet?.CheckOutTime.HasValue == true)
                                    {
                                        <div class="text-white-50 small">
                                            <i class="fa-solid fa-circle-check text-success me-1"></i>Hôm nay hoàn thành: 
                                            <strong class="text-white">@todayTimesheet.ActualHoursWorked giờ (@todayTimesheet.WorkUnits công)</strong> • @todayTimesheet.Note
                                        </div>
                                    }
                                    else if (todayTimesheet?.CheckInTime.HasValue == true)
                                    {
                                        <div class="text-white-50 small">
                                            <i class="fa-solid fa-clock text-warning me-1"></i>Đã vào ca lúc @todayTimesheet.CheckInTime?.ToString(@"hh\:mm\:ss"). Bấm <strong>Check-Out</strong> khi tan ca.
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-white-50 small">
                                            <i class="fa-solid fa-info-circle text-info me-1"></i>Bấm <strong>Check-In</strong> để ghi nhận thời gian bắt đầu làm việc.
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- THỐNG KÊ NGÀY CÔNG & PHÂN BỔ CA TRONG THÁNG -->
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm p-3 border-start border-4 border-success bg-white">
                    <div class="small text-muted fw-semibold text-uppercase">TỔNG NGÀY CÔNG TÍCH LŨY</div>
                    <div class="fs-4 fw-bold text-success mt-1">@totalWorkUnits.ToString("0.##") công</div>
                    <div class="small text-muted">Quy đổi hưởng lương tháng @currentMonth/@currentYear</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm p-3 border-start border-4 border-primary bg-white">
                    <div class="small text-muted fw-semibold text-uppercase">CA 8 TIẾNG CHUẨN</div>
                    <div class="fs-4 fw-bold text-primary mt-1">@standard8hCount ca</div>
                    <div class="small text-muted">Lương tính theo ngày công chuẩn</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm p-3 border-start border-4 border-warning bg-white">
                    <div class="small text-muted fw-semibold text-uppercase">CA GÃY (SPLIT SHIFT)</div>
                    <div class="fs-4 fw-bold text-warning-emphasis mt-1">@splitShiftCount ca</div>
                    <div class="small text-success fw-semibold">
                        <i class="fa-solid fa-gift me-1"></i>Phụ cấp: +@((splitShiftCount * 50000m).ToString("N0")) đ
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm p-3 border-start border-4 border-secondary bg-white">
                    <div class="small text-muted fw-semibold text-uppercase">ĐI MUỘN / VỀ SỚM</div>
                    <div class="fs-4 fw-bold text-secondary mt-1">
                        @timesheets.Count(t => t.WorkShiftStatus == WorkShiftStatus.LATE || t.WorkShiftStatus == WorkShiftStatus.EARLY_LEAVE) lần
                    </div>
                    <div class="small text-muted">@timesheets.Count(t => t.WorkUnits > 0m && t.WorkUnits < 1.0m) ca nửa ngày</div>
                </div>
            </div>
        </div>

        <!-- BẢNG LỊCH SỬ CHẤM CÔNG CHI TIẾT -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <h5 class="card-title h6 mb-0 fw-bold">
                        <i class="fa-solid fa-clock-rotate-left text-primary me-2"></i>Nhật Ký Điểm Danh Chi Tiết Tháng @currentMonth/@currentYear
                    </h5>
                    <span class="text-muted small">
                        Nhân viên: <strong>@(selectedEmployee?.FullName ?? "N/A")</strong> (@(selectedEmployee?.EmployeeCode ?? "N/A"))
                    </span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-secondary-subtle text-secondary px-2 py-1">
                        @timesheets.Count bản ghi
                    </span>
                    @if (isManager)
                    {
                        <button class="btn btn-sm btn-outline-primary fw-semibold" @onclick="() => OpenManualPunchModal(null)">
                            <i class="fa-solid fa-plus me-1"></i>Thêm Điểm Danh Mới
                        </button>
                    }
                </div>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted small text-uppercase">
                        <tr>
                            <th scope="col" style="width: 140px;">Ngày Làm Việc</th>
                            <th scope="col" style="width: 190px;">Ca Làm Việc</th>
                            <th scope="col" class="text-center" style="width: 110px;">Giờ Vào (In)</th>
                            <th scope="col" class="text-center" style="width: 110px;">Giờ Ra (Out)</th>
                            <th scope="col" class="text-center" style="width: 100px;">Số Giờ Làm</th>
                            <th scope="col" class="text-center" style="width: 100px;">Ngày Công</th>
                            <th scope="col" class="text-center" style="width: 130px;">Trạng Thái</th>
                            <th scope="col">Đánh Giá & Phân Bổ</th>
                            <th scope="col" class="text-center" style="width: 130px;">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (timesheets.Count == 0)
                        {
                            <tr>
                                <td colspan="9" class="text-center py-5 text-muted">
                                    <i class="fa-regular fa-calendar-xmark fs-2 d-block mb-2 text-secondary"></i>
                                    Chưa có dữ liệu chấm công cho nhân viên này trong tháng @currentMonth/@currentYear.
                                    @if (isManager)
                                    {
                                        <div class="mt-2">
                                            <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenManualPunchModal(null)">
                                                <i class="fa-solid fa-clock-rotate-left me-1"></i>Điểm danh ngay
                                            </button>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var t in timesheets)
                            {
                                var isToday = t.WorkDate.Date == DateTime.Today;
                                <tr class="@(isToday ? "table-primary table-opacity-10 fw-medium" : "")">
                                    <td>
                                        <div class="fw-semibold @(isToday ? "text-primary" : "text-dark")">
                                            @t.WorkDate.ToString("dd/MM/yyyy")
                                            @if (isToday)
                                            {
                                                <span class="badge bg-primary ms-1" style="font-size: 0.65rem;">Hôm nay</span>
                                            }
                                        </div>
                                        <div class="text-muted small">@t.WorkDate.ToString("dddd", new System.Globalization.CultureInfo("vi-VN"))</div>
                                    </td>
                                    <td>
                                        @if (t.ShiftCode == "CA_GAY" || (t.ShiftName != null && t.ShiftName.Contains("Ca Gãy", StringComparison.OrdinalIgnoreCase)))
                                        {
                                            <span class="badge bg-warning text-dark border border-warning font-monospace px-2 py-1">
                                                <i class="fa-solid fa-bolt me-1 text-danger"></i>@(t.ShiftName ?? "Ca Gãy")
                                            </span>
                                            <div class="text-success small fw-semibold" style="font-size: 0.72rem;">+50k phụ cấp ca gãy</div>
                                        }
                                        else if (!string.IsNullOrEmpty(t.ShiftName))
                                        {
                                            <span class="badge bg-light text-dark border font-monospace px-2 py-1">
                                                <i class="fa-solid fa-clock me-1 text-primary"></i>@t.ShiftName
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border px-2 py-1">Ca 8 Tiếng Chuẩn</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (t.CheckInTime.HasValue)
                                        {
                                            <span class="font-monospace fw-bold text-success fs-6">
                                                <i class="fa-solid fa-arrow-right-to-bracket text-success me-1 small"></i>
                                                @t.CheckInTime.Value.ToString(@"hh\:mm\:ss")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted font-monospace">--:--:--</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (t.CheckOutTime.HasValue)
                                        {
                                            <span class="font-monospace fw-bold text-warning fs-6">
                                                <i class="fa-solid fa-arrow-right-from-bracket text-warning me-1 small"></i>
                                                @t.CheckOutTime.Value.ToString(@"hh\:mm\:ss")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted font-monospace">--:--:--</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="fw-semibold">@t.ActualHoursWorked.ToString("0.##")</span> giờ
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @(t.WorkUnits >= 1.0m ? "bg-success" : (t.WorkUnits > 0 ? "bg-info" : "bg-secondary")) px-2 py-1">
                                            @t.WorkUnits.ToString("0.##") công
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        @switch (t.WorkShiftStatus)
                                        {
                                            case WorkShiftStatus.PRESENT:
                                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                                    <i class="fa-solid fa-circle-check me-1"></i>Đúng Giờ
                                                </span>
                                                break;
                                            case WorkShiftStatus.LATE:
                                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning px-2 py-1">
                                                    <i class="fa-solid fa-clock me-1"></i>Đi Muộn
                                                </span>
                                                break;
                                            case WorkShiftStatus.EARLY_LEAVE:
                                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning px-2 py-1">
                                                    <i class="fa-solid fa-person-walking-arrow-right me-1"></i>Về Sớm
                                                </span>
                                                break;
                                            case WorkShiftStatus.HALF_DAY:
                                                <span class="badge bg-info-subtle text-info border border-info px-2 py-1">
                                                    <i class="fa-solid fa-hourglass-half me-1"></i>Nửa Ca
                                                </span>
                                                break;
                                            case WorkShiftStatus.ABSENT_WITH_PERMISSION:
                                                <span class="badge bg-info-subtle text-info border border-info px-2 py-1">
                                                    <i class="fa-solid fa-calendar-xmark me-1"></i>Nghỉ Có Phép
                                                </span>
                                                break;
                                            case WorkShiftStatus.ABSENT_UNAUTHORIZED:
                                                <span class="badge bg-danger text-white px-2 py-1">
                                                    <i class="fa-solid fa-xmark me-1"></i>Vắng Không Phép
                                                </span>
                                                break;
                                            case WorkShiftStatus.HOLIDAY:
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                                                    <i class="fa-solid fa-flag me-1"></i>Nghỉ Lễ
                                                </span>
                                                break;
                                            default:
                                                <span class="badge bg-light text-secondary border px-2 py-1">@t.WorkShiftStatus</span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        <span class="small @(t.WorkShiftStatus == WorkShiftStatus.LATE || t.WorkShiftStatus == WorkShiftStatus.EARLY_LEAVE || t.WorkShiftStatus == WorkShiftStatus.ABSENT_UNAUTHORIZED ? "text-danger fw-medium" : "text-muted")">
                                            @(string.IsNullOrWhiteSpace(t.Note) ? "-" : t.Note)
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm">
                                            @if (!t.IsLocked)
                                            {
                                                <button class="btn btn-outline-warning text-dark py-1 px-2 fw-semibold" 
                                                        title="Điều chỉnh ca làm việc của tôi (Đổi sang Ca 8h hoặc Ca Gãy...)" 
                                                        @onclick="() => OpenChangeShiftModal(t)">
                                                    <i class="fa-solid fa-arrows-rotate me-1 text-warning"></i>Đổi Ca
                                                </button>
                                            }
                                            @if (isManager)
                                            {
                                                <button class="btn btn-outline-primary py-1 px-2" 
                                                        title="Kế toán/Admin: Sửa giờ vào/ra thủ công" 
                                                        @onclick="() => OpenManualPunchModal(t)">
                                                    <i class="fa-solid fa-pen-to-square"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else if (isManager && activeTimesheetTab == "summary")
    {
        <!-- ================================================================================= -->
        <!-- CHẾ ĐỘ XEM TỔNG HỢP TOÀN DOANH NGHIỆP (DÀNH CHO KẾ TOÁN & QUẢN TRỊ VIÊN) -->
        <!-- ================================================================================= -->

        <!-- KPI TỔNG THỂ TOÀN DOANH NGHIỆP -->
        <div class="row g-3 mb-4">
            <div class="col-lg-3 col-md-6">
                <div class="card border-0 shadow-sm p-3 border-start border-4 border-primary bg-white h-100">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="small text-muted fw-semibold text-uppercase">TỔNG QUÂN SỐ CÔNG TY</div>
                            <div class="fs-3 fw-bold text-primary mt-1">@summaryItems.Count nhân sự</div>
                            <div class="small text-muted">Đang theo dõi công tháng @currentMonth/@currentYear</div>
                        </div>
                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-3 fs-3">
                            <i class="fa-solid fa-users"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="card border-0 shadow-sm p-3 border-start border-4 border-success bg-white h-100">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="small text-muted fw-semibold text-uppercase">TỔNG NGÀY CÔNG TOÀN CÔNG TY</div>
                            <div class="fs-3 fw-bold text-success mt-1">@summaryItems.Sum(s => s.TotalWorkUnits).ToString("0.##") công</div>
                            <div class="small text-muted">Trung bình: @(summaryItems.Count > 0 ? (summaryItems.Sum(s => s.TotalWorkUnits) / summaryItems.Count).ToString("0.1") : "0") công/người</div>
                        </div>
                        <div class="bg-success bg-opacity-10 text-success rounded-circle p-3 fs-3">
                            <i class="fa-solid fa-calculator"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="card border-0 shadow-sm p-3 border-start border-4 border-info bg-white h-100">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="small text-muted fw-semibold text-uppercase">TỔNG CA ĐỦ CÔNG (1.0)</div>
                            <div class="fs-3 fw-bold text-info mt-1">@summaryItems.Sum(s => s.FullShiftCount) ca</div>
                            <div class="small text-muted">Hoàn thành đủ chuẩn ca làm việc</div>
                        </div>
                        <div class="bg-info bg-opacity-10 text-info rounded-circle p-3 fs-3">
                            <i class="fa-solid fa-circle-check"></i>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="card border-0 shadow-sm p-3 border-start border-4 border-warning bg-white h-100">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="small text-muted fw-semibold text-uppercase">TỔNG LẦN ĐI MUỘN / VỀ SỚM</div>
                            <div class="fs-3 fw-bold text-warning-emphasis mt-1">@summaryItems.Sum(s => s.LateOrEarlyCount) lượt</div>
                            <div class="small text-muted">Cần kế toán đối soát trước tính lương</div>
                        </div>
                        <div class="bg-warning bg-opacity-10 text-warning-emphasis rounded-circle p-3 fs-3">
                            <i class="fa-solid fa-clock"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- BẢNG TỔNG HỢP CÔNG THEO TỪNG NHÂN SỰ -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <h5 class="card-title h6 mb-0 fw-bold">
                        <i class="fa-solid fa-table-list text-primary me-2"></i>Bảng Tổng Hợp Công Toàn Công Ty Tháng @currentMonth/@currentYear
                    </h5>
                    <span class="text-muted small">
                        Hiển thị danh sách tất cả nhân viên kèm thống kê ngày công, ca đủ, ca nửa và vi phạm giờ giấc.
                    </span>
                </div>
                <!-- BỘ LỌC TÌM KIẾM NHANH -->
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <div class="input-group input-group-sm" style="width: 240px;">
                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
                        <input type="text" class="form-control border-start-0" placeholder="Tìm theo tên hoặc mã NV..." @bind="summarySearchKeyword" @bind:event="oninput" />
                    </div>

                    <select class="form-select form-select-sm" style="width: 180px;" @bind="selectedDepartmentFilter">
                        <option value="">Tất cả phòng ban</option>
                        @foreach (var dept in availableDepartments)
                        {
                            <option value="@dept">@dept</option>
                        }
                    </select>

                    <button class="btn btn-sm btn-outline-secondary" @onclick="LoadAllSummaryAsync" title="Làm mới bảng tổng">
                        <i class="fa-solid fa-arrows-rotate"></i>
                    </button>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-muted small text-uppercase">
                        <tr>
                            <th scope="col" style="width: 50px;" class="text-center">STT</th>
                            <th scope="col" style="width: 110px;">Mã NV</th>
                            <th scope="col">Họ và Tên Nhân Viên</th>
                            <th scope="col">Phòng Ban</th>
                            <th scope="col" class="text-center" style="width: 130px;">Tổng Ngày Công</th>
                            <th scope="col" class="text-center" style="width: 110px;">Ca 8H Chuẩn</th>
                            <th scope="col" class="text-center" style="width: 150px;">Ca Gãy (Phụ Cấp)</th>
                            <th scope="col" class="text-center" style="width: 90px;">Ca Nửa</th>
                            <th scope="col" class="text-center" style="width: 120px;">Đi Muộn / Sớm</th>
                            <th scope="col" class="text-center" style="width: 160px;">Thao Tác Kế Toán</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int stt = 1; }
                        @foreach (var item in FilteredSummaryItems)
                        {
                            <tr>
                                <td class="text-center text-muted small fw-semibold">@(stt++)</td>
                                <td>
                                    <span class="badge bg-light text-primary border font-monospace px-2 py-1">
                                        @item.EmployeeCode
                                    </span>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@item.FullName</div>
                                    <div class="small text-muted">
                                        @(item.LastWorkDate.HasValue ? $"Có mặt gần nhất: {item.LastWorkDate.Value:dd/MM/yyyy}" : "Chưa có lượt điểm danh")
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-secondary px-2 py-1">
                                        @(item.DepartmentName ?? "Chưa phân phòng")
                                    </span>
                                </td>
                                <td class="text-center">
                                    <span class="badge @(item.TotalWorkUnits >= 20.0m ? "bg-success" : (item.TotalWorkUnits > 0 ? "bg-primary" : "bg-secondary")) fs-6 px-3 py-1 shadow-sm">
                                        @item.TotalWorkUnits.ToString("0.##") công
                                    </span>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                                        @item.Standard8hCount ca
                                    </span>
                                </td>
                                <td class="text-center">
                                    @if (item.SplitShiftCount > 0)
                                    {
                                        <span class="badge bg-warning text-dark border border-warning px-2 py-1">
                                            <i class="fa-solid fa-bolt me-1 text-danger"></i>@item.SplitShiftCount ca
                                        </span>
                                        <div class="text-success small fw-semibold" style="font-size: 0.72rem;">+@((item.SplitShiftCount * 50000m).ToString("N0")) đ</div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">0 ca</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1">
                                        @item.HalfShiftCount ca
                                    </span>
                                </td>
                                <td class="text-center">
                                    @if (item.LateOrEarlyCount > 0)
                                    {
                                        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning px-2 py-1 fw-bold">
                                            <i class="fa-solid fa-clock me-1"></i>@item.LateOrEarlyCount lần
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border px-2 py-1">0 lần</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-primary" 
                                                title="Mở nhật ký chấm công chi tiết của nhân viên này"
                                                @onclick="() => SwitchToIndividualViewAsync(item.EmployeeId)">
                                            <i class="fa-solid fa-eye me-1"></i>Chi Tiết
                                        </button>
                                        <button class="btn btn-outline-success" 
                                                title="Thêm giờ hoặc điểm danh thủ công cho nhân viên này"
                                                @onclick="() => OpenManualPunchModalForEmployee(item.EmployeeId)">
                                            <i class="fa-solid fa-plus"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- ========================================================================================= -->
<!-- MODAL ĐIỂM DANH THỦ CÔNG & CHỌN GIỜ VÀO / RA (CHỈ DÀNH CHO KẾ TOÁN HOẶC ADMIN) -->
<!-- ========================================================================================= -->
@if (showManualModal && isManager)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0, 0, 0, 0.65);" role="dialog">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content shadow-lg border-0 rounded-3">
                <div class="modal-header bg-dark text-white py-3">
                    <h5 class="modal-title h6 fw-bold">
                        <i class="fa-solid fa-clock-rotate-left me-2 text-warning"></i>
                        Điểm Danh Thủ Công & Tùy Chỉnh Giờ Chấm Công (Kế Toán / Admin)
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseManualModal"></button>
                </div>
                <div class="modal-body p-4">
                    @if (!string.IsNullOrEmpty(manualModalError))
                    {
                        <div class="alert alert-danger py-2 mb-3 small" role="alert">
                            <i class="fa-solid fa-triangle-exclamation me-2"></i>@manualModalError
                        </div>
                    }

                    <div class="row g-3">
                        <!-- Chọn nhân viên -->
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-dark mb-1">
                                Nhân Viên Được Điểm Danh <span class="text-danger">*</span>
                            </label>
                            <select class="form-select shadow-none" @bind="modalEmployeeId">
                                @foreach (var emp in allEmployees)
                                {
                                    <option value="@emp.Id">
                                        [@emp.EmployeeCode] @emp.FullName (@(emp.DepartmentName ?? "Nhân viên"))
                                    </option>
                                }
                            </select>
                            <div class="form-text" style="font-size: 0.75rem;">Chọn người cần ghi nhận giờ vào hoặc ra.</div>
                        </div>

                        <!-- Chọn ngày làm việc -->
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-dark mb-1">
                                Ngày Làm Việc <span class="text-danger">*</span>
                            </label>
                            <input type="date" class="form-control shadow-none" @bind="modalWorkDate" />
                            <div class="form-text" style="font-size: 0.75rem;">Mặc định ngày hôm nay hoặc ngày bạn muốn chỉnh sửa.</div>
                        </div>

                        <!-- Chọn ca làm việc -->
                        <div class="col-12">
                            <label class="form-label small fw-bold text-dark mb-1">
                                Ca Làm Việc Áp Dụng <span class="text-danger">*</span>
                            </label>
                            <select class="form-select shadow-none" @bind="modalShiftId">
                                @foreach (var shift in activeShifts)
                                {
                                    <option value="@shift.Id">
                                        @shift.ShiftName - [@shift.StartTime.ToString(@"hh\:mm") đến @shift.EndTime.ToString(@"hh\:mm")] (Mục tiêu: @shift.TargetHours h / @shift.WorkUnits công, Ân hạn: @shift.GracePeriodMinutes p)
                                    </option>
                                }
                            </select>
                        </div>

                        <!-- Giờ vào (Check-In) -->
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded border border-success-subtle">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <label class="form-label small fw-bold text-success mb-0">
                                        <i class="fa-solid fa-right-to-bracket me-1"></i>Giờ Vào (Check-In)
                                    </label>
                                    <div class="btn-group btn-group-sm">
                                        <button type="button" class="btn btn-outline-success btn-sm py-0 px-2" style="font-size: 0.7rem;" @onclick="SetNowCheckIn">
                                            Hiện tại
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" style="font-size: 0.7rem;" @onclick="SetShiftStartCheckIn">
                                            Chuẩn ca
                                        </button>
                                    </div>
                                </div>
                                <input type="time" class="form-control font-monospace fs-5 fw-bold text-success" @bind="modalCheckIn" />
                                <div class="form-text mt-1" style="font-size: 0.75rem;">
                                    Định dạng: Giờ:Phút (VD: 07:45, 08:00, 08:30). Để trống nếu chỉ muốn ghi giờ ra.
                                </div>
                            </div>
                        </div>

                        <!-- Giờ ra (Check-Out) -->
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded border border-warning-subtle">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <label class="form-label small fw-bold text-warning-emphasis mb-0">
                                        <i class="fa-solid fa-right-from-bracket me-1"></i>Giờ Ra (Check-Out)
                                    </label>
                                    <div class="btn-group btn-group-sm">
                                        <button type="button" class="btn btn-outline-warning btn-sm py-0 px-2 text-dark" style="font-size: 0.7rem;" @onclick="SetNowCheckOut">
                                            Hiện tại
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm py-0 px-2" style="font-size: 0.7rem;" @onclick="SetShiftEndCheckOut">
                                            Chuẩn ca
                                        </button>
                                        <button type="button" class="btn btn-outline-danger btn-sm py-0 px-2" style="font-size: 0.7rem;" @onclick="ClearCheckOut">
                                            Xóa
                                        </button>
                                    </div>
                                </div>
                                <input type="time" class="form-control font-monospace fs-5 fw-bold text-warning-emphasis" @bind="modalCheckOut" />
                                <div class="form-text mt-1" style="font-size: 0.75rem;">
                                    Định dạng: Giờ:Phút (VD: 17:30, 18:00). Để trống nếu nhân viên mới chỉ Check-In vào ca.
                                </div>
                            </div>
                        </div>

                        <!-- Ghi chú bổ sung -->
                        <div class="col-12">
                            <label class="form-label small fw-bold text-dark mb-1">
                                Ghi Chú / Lý Do Điểm Danh Thủ Công:
                            </label>
                            <input type="text" class="form-control shadow-none" 
                                   placeholder="VD: Quên bấm máy vân tay, Đi công tác về muộn, Điểm danh bổ sung..." 
                                   @bind="modalNote" />
                        </div>

                        <!-- HỘP DỰ TÍNH KẾT QUẢ ĐIỂM DANH -->
                        <div class="col-12">
                            <div class="p-3 rounded bg-primary bg-opacity-10 border border-primary-subtle small">
                                <div class="fw-bold text-primary mb-1">
                                    <i class="fa-solid fa-calculator me-1"></i>Quy chế phân bổ công tự động:
                                </div>
                                <ul class="mb-0 ps-3 text-secondary">
                                    <li>Nếu chỉ có <strong>Giờ Vào</strong>: Ghi nhận Check-In, tự động đối chiếu giờ ca và ghi chú nếu đi muộn.</li>
                                    <li>Nếu có cả <strong>Giờ Vào & Giờ Ra</strong>: Tự động trừ thời gian nghỉ trưa, tính tổng giờ làm việc thực tế và quy đổi hệ số công (1.0 hoặc 0.5 công).</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-light py-2 px-4 d-flex flex-wrap justify-content-between">
                    <button type="button" class="btn btn-secondary" @onclick="CloseManualModal" disabled="@isSubmittingModal">
                        Đóng
                    </button>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="button" class="btn btn-success fw-bold" @onclick="SaveManualCheckInOnlyAsync" disabled="@isSubmittingModal">
                            <i class="fa-solid fa-right-to-bracket me-1"></i>Chỉ Lưu Giờ Vào (Check-In)
                        </button>
                        <button type="button" class="btn btn-warning fw-bold text-dark" @onclick="SaveManualCheckOutOnlyAsync" disabled="@isSubmittingModal">
                            <i class="fa-solid fa-right-from-bracket me-1"></i>Chỉ Lưu Giờ Ra (Check-Out)
                        </button>
                        <button type="button" class="btn btn-primary fw-bold" @onclick="SaveManualFullShiftAsync" disabled="@isSubmittingModal">
                            <i class="fa-solid fa-floppy-disk me-1"></i>Lưu Toàn Bộ Ca (Vào & Ra)
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- ========================================================================================= -->
<!-- MODAL ĐIỀU CHỈNH CA LÀM VIỆC (DÀNH CHO NHÂN VIÊN & QUẢN LÝ) -->
<!-- ========================================================================================= -->
@if (showChangeShiftModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.65); z-index: 1060;" role="dialog">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg border-0 rounded-3">
                <div class="modal-header bg-warning text-dark py-3 px-4">
                    <h5 class="modal-title h6 fw-bold mb-0">
                        <i class="fa-solid fa-arrows-rotate me-2"></i>Điều Chỉnh Ca Làm Việc Của Tôi
                    </h5>
                    <button type="button" class="btn-close" @onclick="() => showChangeShiftModal = false"></button>
                </div>
                <div class="modal-body p-4">
                    @if (!string.IsNullOrEmpty(changeShiftError))
                    {
                        <div class="alert alert-danger small py-2 px-3 mb-3">
                            <i class="fa-solid fa-triangle-exclamation me-1"></i>@changeShiftError
                        </div>
                    }

                    <div class="p-3 bg-light rounded border mb-3">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted small">Ngày làm việc:</span>
                            <span class="fw-bold text-primary font-monospace">@changeShiftTargetDate.ToString("dddd, dd/MM/yyyy", new System.Globalization.CultureInfo("vi-VN"))</span>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span class="text-muted small">Nhân sự:</span>
                            <span class="fw-bold text-dark">@(selectedEmployee?.FullName ?? "Nhân viên")</span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span class="text-muted small">Ca hiện tại:</span>
                            <span class="badge bg-secondary-subtle text-secondary border">@(selectedChangeShiftTimesheet?.ShiftName ?? "Chưa phân ca")</span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-dark mb-1">
                            <i class="fa-solid fa-business-time text-primary me-1"></i>Chọn Ca Làm Việc Mới Mong Muốn:
                        </label>
                        <select class="form-select shadow-none fw-semibold" @bind="changeShiftSelectedId">
                            @foreach (var shift in activeShifts)
                            {
                                <option value="@shift.Id">
                                    @shift.ShiftName @(shift.ShiftCode == "CA_GAY" ? "⚡ [Ca Gãy • Hưởng phụ cấp 50k]" : "")
                                </option>
                            }
                        </select>
                    </div>

                    @{
                        var modalShift = activeShifts.FirstOrDefault(s => s.Id == changeShiftSelectedId);
                    }
                    @if (modalShift != null)
                    {
                        <div class="p-3 rounded border @(modalShift.ShiftCode == "CA_GAY" ? "border-warning bg-warning bg-opacity-10" : "border-primary bg-primary bg-opacity-10") small">
                            <div class="fw-bold @(modalShift.ShiftCode == "CA_GAY" ? "text-warning-emphasis" : "text-primary") mb-1">
                                <i class="fa-solid fa-circle-info me-1"></i>Thông tin chi tiết ca được chọn:
                            </div>
                            <ul class="mb-0 ps-3 text-secondary">
                                <li>Khung giờ quy định: <strong>@modalShift.StartTime.ToString(@"hh\:mm") - @modalShift.EndTime.ToString(@"hh\:mm")</strong></li>
                                <li>Mục tiêu chuẩn: <strong>@modalShift.TargetHours giờ/ca</strong> • Quy đổi: <strong>@modalShift.WorkUnits công</strong></li>
                                @if (modalShift.ShiftCode == "CA_GAY")
                                {
                                    <li class="text-success fw-bold">Chính sách ca gãy: Hưởng phụ cấp ca gãy 50.000 VNĐ / ngày công.</li>
                                }
                                else
                                {
                                    <li>Lương tính theo tỷ lệ ngày công ca 8 tiếng tiêu chuẩn.</li>
                                }
                                <li>Giờ vào / ra thực tế (nếu đã điểm danh) được giữ nguyên, hệ thống tự động đánh giá lại trạng thái ca.</li>
                            </ul>
                        </div>
                    }
                </div>
                <div class="modal-footer bg-light py-2 px-4 d-flex justify-content-between">
                    <button type="button" class="btn btn-secondary btn-sm" @onclick="() => showChangeShiftModal = false" disabled="@isSubmittingChangeShift">
                        Đóng
                    </button>
                    <button type="button" class="btn btn-warning fw-bold text-dark btn-sm px-3 shadow-sm" @onclick="SaveChangeShiftAsync" disabled="@isSubmittingChangeShift">
                        @if (isSubmittingChangeShift)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            <span>Đang lưu...</span>
                        }
                        else
                        {
                            <i class="fa-solid fa-check me-1"></i>
                            <span>Xác Nhận Đổi Ca</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    // Phân quyền vai trò
    private string currentUserRole = "";
    private long myEmployeeId = 1;
    private bool isManager = false; // true nếu ROLE_ADMIN hoặc ROLE_HR_ACCOUNTANT

    // Quản lý Tab hiển thị
    private string activeTimesheetTab = "individual"; // "individual" hoặc "summary"

    // Thống kê phân bổ ca 8 tiếng vs ca gãy cho cá nhân
    private int splitShiftCount => timesheets.Count(t => t.ShiftCode == "CA_GAY" || (t.ShiftName != null && t.ShiftName.Contains("Ca Gãy", StringComparison.OrdinalIgnoreCase)));
    private int standard8hCount => timesheets.Count(t => (t.ShiftCode != "CA_GAY" && !(t.ShiftName != null && t.ShiftName.Contains("Ca Gãy", StringComparison.OrdinalIgnoreCase))) && t.WorkUnits >= 1.0m);

    // Modal Điều chỉnh ca làm việc
    private bool showChangeShiftModal = false;
    private bool isSubmittingChangeShift = false;
    private string changeShiftError = string.Empty;
    private Timesheet? selectedChangeShiftTimesheet;
    private DateTime changeShiftTargetDate = DateTime.Today;
    private long changeShiftSelectedId = 1;

    private long currentEmployeeId = 1;
    private int currentMonth = DateTime.Today.Month;
    private int currentYear = DateTime.Today.Year;

    private List<Employee> allEmployees = new();
    private List<Timesheet> timesheets = new();
    private List<WorkShift> activeShifts = new();
    private long selectedShiftId = 1;

    // Danh sách dữ liệu bảng tổng hợp toàn công ty
    private List<EmployeeTimesheetSummaryItem> summaryItems = new();
    private string summarySearchKeyword = "";
    private string selectedDepartmentFilter = "";
    private List<string> availableDepartments => allEmployees.Select(e => e.DepartmentName ?? "Chưa phân phòng").Distinct().OrderBy(d => d).ToList();

    private IEnumerable<EmployeeTimesheetSummaryItem> FilteredSummaryItems =>
        summaryItems.Where(item =>
            (string.IsNullOrWhiteSpace(summarySearchKeyword) ||
             item.FullName.Contains(summarySearchKeyword, StringComparison.OrdinalIgnoreCase) ||
             item.EmployeeCode.Contains(summarySearchKeyword, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrWhiteSpace(selectedDepartmentFilter) ||
             item.DepartmentName == selectedDepartmentFilter)
        );

    private Employee? selectedEmployee => allEmployees.FirstOrDefault(e => e.Id == currentEmployeeId);
    private Timesheet? todayTimesheet => timesheets.FirstOrDefault(t => t.WorkDate.Date == DateTime.Today);
    private WorkShift? currentShift => activeShifts.FirstOrDefault(s => s.Id == selectedShiftId) ?? activeShifts.FirstOrDefault();

    private decimal totalWorkUnits => timesheets.Sum(t => t.WorkUnits);

    private bool isLoading = false;
    private bool isCheckingIn = false;
    private bool isCheckingOut = false;
    private string statusMessage = string.Empty;
    private string statusType = "success";

    // Đồng hồ thời gian thực
    private DateTime currentTime = DateTime.Now;
    private System.Threading.Timer? clockTimer;

    // Modal state
    private bool showManualModal = false;
    private bool isSubmittingModal = false;
    private string manualModalError = string.Empty;
    private long modalEmployeeId = 1;
    private DateTime modalWorkDate = DateTime.Today;
    private long modalShiftId = 1;
    private TimeOnly? modalCheckIn = new TimeOnly(8, 0);
    private TimeOnly? modalCheckOut = new TimeOnly(17, 30);
    private string modalNote = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        // Khởi động đồng hồ thời gian thực
        clockTimer = new System.Threading.Timer(_ =>
        {
            currentTime = DateTime.Now;
            InvokeAsync(StateHasChanged);
        }, null, 0, 1000);

        if (AuthStateTask != null)
        {
            var authState = await AuthStateTask;
            var user = authState.User;
            currentUserRole = user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
            isManager = currentUserRole == "ROLE_ADMIN" || currentUserRole == "ROLE_HR_ACCOUNTANT";

            var empIdClaim = user.FindFirst("EmployeeId")?.Value;
            if (long.TryParse(empIdClaim, out var id) && id > 0)
            {
                myEmployeeId = id;
            }
        }

        // Nhân viên bắt buộc chỉ xem và điểm danh của chính mình
        if (!isManager)
        {
            currentEmployeeId = myEmployeeId;
            activeTimesheetTab = "individual";
        }

        await LoadDataAsync();
    }

    private void SetActiveTab(string tab)
    {
        if (!isManager && tab == "summary")
        {
            activeTimesheetTab = "individual";
            return;
        }
        activeTimesheetTab = tab;
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        try
        {
            // 1. Tải danh sách nhân sự
            var emps = await EmployeeRepo.GetEmployeesAsync();
            allEmployees = emps.OrderBy(e => e.EmployeeCode).ToList();

            if (!isManager)
            {
                currentEmployeeId = myEmployeeId;
            }
            else if (allEmployees.Any() && !allEmployees.Any(e => e.Id == currentEmployeeId))
            {
                currentEmployeeId = allEmployees.First().Id;
            }

            // 2. Tải danh mục ca làm việc
            var shiftResult = await GetWorkShiftsUseCase.ExecuteAsync(onlyActive: true);
            activeShifts = shiftResult.OrderBy(s => s.StartTime).ToList();

            if (activeShifts.Any() && selectedShiftId <= 0)
            {
                var defaultShift = activeShifts.FirstOrDefault(s => s.ShiftCode == "CA_HANH_CHINH") ?? activeShifts.First();
                selectedShiftId = defaultShift.Id;
            }

            // 3. Tải bảng công cá nhân của nhân sự đang chọn
            await LoadTimesheetsAsync();

            // 4. Nếu là Kế toán hoặc Admin, tải bảng tổng hợp công toàn công ty
            if (isManager)
            {
                await LoadAllSummaryAsync();
            }

            // 5. Cập nhật ca làm việc của ngày hôm nay nếu đã Check-In
            if (todayTimesheet?.ShiftId.HasValue == true && todayTimesheet.ShiftId.Value > 0)
            {
                selectedShiftId = todayTimesheet.ShiftId.Value;
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Lỗi khi tải dữ liệu: {ex.Message}";
            statusType = "danger";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadTimesheetsAsync()
    {
        if (!isManager)
        {
            currentEmployeeId = myEmployeeId;
        }
        var result = await ViewTimesheetUseCase.ExecuteAsync(currentEmployeeId, currentMonth, currentYear);
        timesheets = result.OrderByDescending(t => t.WorkDate).ToList();
    }

    private async Task LoadAllSummaryAsync()
    {
        if (!isManager) return;
        try
        {
            var allMonthTimesheets = (await ViewTimesheetSummaryUseCase.ExecuteByMonthAsync(currentMonth, currentYear)).ToList();
            var list = new List<EmployeeTimesheetSummaryItem>();

            foreach (var emp in allEmployees)
            {
                var empTs = allMonthTimesheets.Where(t => t.EmployeeId == emp.Id).ToList();
                int splitCount = empTs.Count(t => t.ShiftCode == "CA_GAY" || (t.ShiftName != null && t.ShiftName.Contains("Ca Gãy", StringComparison.OrdinalIgnoreCase)));
                int std8hCount = empTs.Count(t => (t.ShiftCode != "CA_GAY" && !(t.ShiftName != null && t.ShiftName.Contains("Ca Gãy", StringComparison.OrdinalIgnoreCase))) && t.WorkUnits >= 1.0m);

                list.Add(new EmployeeTimesheetSummaryItem
                {
                    EmployeeId = emp.Id,
                    EmployeeCode = emp.EmployeeCode,
                    FullName = emp.FullName,
                    DepartmentName = emp.DepartmentName,
                    TotalWorkUnits = empTs.Sum(t => t.WorkUnits),
                    TotalHours = empTs.Sum(t => t.ActualHoursWorked),
                    Standard8hCount = std8hCount,
                    SplitShiftCount = splitCount,
                    FullShiftCount = empTs.Count(t => t.WorkUnits >= 1.0m),
                    HalfShiftCount = empTs.Count(t => t.WorkUnits > 0m && t.WorkUnits < 1.0m),
                    LateOrEarlyCount = empTs.Count(t => t.WorkShiftStatus == WorkShiftStatus.LATE || t.WorkShiftStatus == WorkShiftStatus.EARLY_LEAVE),
                    AbsentCount = empTs.Count(t => t.WorkShiftStatus == WorkShiftStatus.ABSENT_UNAUTHORIZED),
                    LastWorkDate = empTs.OrderByDescending(t => t.WorkDate).FirstOrDefault()?.WorkDate
                });
            }
            summaryItems = list.OrderBy(s => s.EmployeeCode).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading timesheet summary: {ex.Message}");
        }
    }

    private async Task OnEmployeeChangedAsync(ChangeEventArgs e)
    {
        if (!isManager)
        {
            currentEmployeeId = myEmployeeId;
            return;
        }

        if (long.TryParse(e.Value?.ToString(), out var empId) && empId > 0)
        {
            currentEmployeeId = empId;
            await LoadTimesheetsAsync();
            if (todayTimesheet?.ShiftId.HasValue == true && todayTimesheet.ShiftId.Value > 0)
            {
                selectedShiftId = todayTimesheet.ShiftId.Value;
            }
        }
    }

    private async Task OnMonthChangedAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var m) && m >= 1 && m <= 12)
        {
            currentMonth = m;
            await LoadTimesheetsAsync();
            if (isManager)
            {
                await LoadAllSummaryAsync();
            }
        }
    }

    private async Task OnYearChangedAsync(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var y) && y >= 2000 && y <= 2100)
        {
            currentYear = y;
            await LoadTimesheetsAsync();
            if (isManager)
            {
                await LoadAllSummaryAsync();
            }
        }
    }

    private async Task SwitchToIndividualViewAsync(long employeeId)
    {
        currentEmployeeId = employeeId;
        activeTimesheetTab = "individual";
        await LoadTimesheetsAsync();
    }

    private void OpenManualPunchModalForEmployee(long employeeId)
    {
        if (!isManager) return;
        currentEmployeeId = employeeId;
        OpenManualPunchModal(null);
    }

    private async Task HandleCheckInAsync()
    {
        isCheckingIn = true;
        statusMessage = string.Empty;
        try
        {
            // Nhân viên chỉ được Check-In cho chính mình
            long punchEmpId = isManager ? currentEmployeeId : myEmployeeId;
            var t = await CheckInUseCase.ExecuteCheckInAsync(punchEmpId, selectedShiftId);
            var empName = allEmployees.FirstOrDefault(e => e.Id == punchEmpId)?.FullName ?? $"NV #{punchEmpId}";
            statusMessage = $"Check-In thành công cho {empName} lúc {DateTime.Now:HH:mm:ss} vào '{t.ShiftName ?? "Ca làm việc"}'! {t.Note}";
            statusType = "success";
            await LoadTimesheetsAsync();
            if (isManager) await LoadAllSummaryAsync();
        }
        catch (Exception ex)
        {
            statusMessage = $"Không thể Check-In: {ex.Message}";
            statusType = "danger";
        }
        finally
        {
            isCheckingIn = false;
        }
    }

    private async Task HandleCheckOutAsync()
    {
        isCheckingOut = true;
        statusMessage = string.Empty;
        try
        {
            // Nhân viên chỉ được Check-Out cho chính mình
            long punchEmpId = isManager ? currentEmployeeId : myEmployeeId;
            var t = await CheckInUseCase.ExecuteCheckOutAsync(punchEmpId, selectedShiftId);
            var empName = allEmployees.FirstOrDefault(e => e.Id == punchEmpId)?.FullName ?? $"NV #{punchEmpId}";
            statusMessage = $"Check-Out thành công cho {empName} lúc {DateTime.Now:HH:mm:ss}! Tổng giờ làm: {t.ActualHoursWorked}h ({t.WorkUnits} công). Đánh giá: {t.Note}";
            statusType = "success";
            await LoadTimesheetsAsync();
            if (isManager) await LoadAllSummaryAsync();
        }
        catch (Exception ex)
        {
            statusMessage = $"Không thể Check-Out: {ex.Message}";
            statusType = "danger";
        }
        finally
        {
            isCheckingOut = false;
        }
    }

    // =========================================================================
    // ĐIỀU CHỈNH CA LÀM VIỆC (DÀNH CHO CẢ NHÂN VIÊN VÀ QUẢN LÝ)
    // =========================================================================

    private async Task OnPunchShiftChangedAsync(ChangeEventArgs e)
    {
        if (long.TryParse(e.Value?.ToString(), out var newShiftId) && newShiftId > 0)
        {
            selectedShiftId = newShiftId;
            try
            {
                long empId = isManager ? currentEmployeeId : myEmployeeId;
                var updated = await CheckInUseCase.ChangeShiftAsync(empId, newShiftId, DateTime.Today);
                var shiftName = activeShifts.FirstOrDefault(s => s.Id == newShiftId)?.ShiftName ?? "Ca mới";
                statusMessage = $"Đã cập nhật ca làm việc hôm nay sang: '{shiftName}'! Hệ số công: {updated.WorkUnits} công.";
                statusType = "success";
                await LoadTimesheetsAsync();
                if (isManager) await LoadAllSummaryAsync();
            }
            catch (Exception ex)
            {
                statusMessage = $"Thông báo ca hôm nay: {ex.Message}";
                statusType = "info";
            }
        }
    }

    private void OpenChangeShiftModal(Timesheet t)
    {
        selectedChangeShiftTimesheet = t;
        changeShiftTargetDate = t.WorkDate;
        changeShiftSelectedId = t.ShiftId ?? activeShifts.FirstOrDefault(s => s.ShiftCode == "CA_HANH_CHINH")?.Id ?? activeShifts.FirstOrDefault()?.Id ?? 1;
        changeShiftError = string.Empty;
        showChangeShiftModal = true;
    }

    private async Task SaveChangeShiftAsync()
    {
        isSubmittingChangeShift = true;
        changeShiftError = string.Empty;
        try
        {
            long empId = isManager ? currentEmployeeId : myEmployeeId;
            var updated = await CheckInUseCase.ChangeShiftAsync(empId, changeShiftSelectedId, changeShiftTargetDate);
            showChangeShiftModal = false;
            var shiftName = activeShifts.FirstOrDefault(s => s.Id == changeShiftSelectedId)?.ShiftName ?? "Ca mới";
            statusMessage = $"Đã điều chỉnh ca làm việc ngày {changeShiftTargetDate:dd/MM/yyyy} thành '{shiftName}' thành công! Trạng thái: {updated.WorkShiftStatus}. Ghi chú: {updated.Note}";
            statusType = "success";
            await LoadTimesheetsAsync();
            if (isManager) await LoadAllSummaryAsync();
        }
        catch (Exception ex)
        {
            changeShiftError = $"Không thể đổi ca: {ex.Message}";
        }
        finally
        {
            isSubmittingChangeShift = false;
        }
    }

    // =========================================================================
    // MODAL DIALOG HANDLERS (CHỈ KẾ TOÁN HOẶC ADMIN MỚI ĐƯỢC PHÉP GỌI)
    // =========================================================================

    private void OpenManualPunchModal(Timesheet? prefill)
    {
        if (!isManager)
        {
            statusMessage = "Quyền hạn từ chối: Chỉ Kế toán hoặc Admin mới có quyền thêm/sửa chấm công thủ công!";
            statusType = "warning";
            return;
        }

        manualModalError = string.Empty;
        modalEmployeeId = prefill?.EmployeeId ?? currentEmployeeId;
        modalWorkDate = prefill?.WorkDate ?? DateTime.Today;
        modalShiftId = prefill?.ShiftId ?? selectedShiftId;

        if (prefill?.CheckInTime.HasValue == true)
        {
            modalCheckIn = TimeOnly.FromTimeSpan(prefill.CheckInTime.Value);
        }
        else
        {
            var shift = activeShifts.FirstOrDefault(s => s.Id == modalShiftId) ?? currentShift;
            modalCheckIn = shift != null ? TimeOnly.FromTimeSpan(shift.StartTime) : new TimeOnly(8, 0);
        }

        if (prefill?.CheckOutTime.HasValue == true)
        {
            modalCheckOut = TimeOnly.FromTimeSpan(prefill.CheckOutTime.Value);
        }
        else
        {
            var shift = activeShifts.FirstOrDefault(s => s.Id == modalShiftId) ?? currentShift;
            modalCheckOut = shift != null ? TimeOnly.FromTimeSpan(shift.EndTime) : new TimeOnly(17, 30);
        }

        modalNote = prefill?.Note ?? string.Empty;
        showManualModal = true;
    }

    private void CloseManualModal()
    {
        showManualModal = false;
        manualModalError = string.Empty;
    }

    private void SetNowCheckIn()
    {
        modalCheckIn = TimeOnly.FromDateTime(DateTime.Now);
    }

    private void SetShiftStartCheckIn()
    {
        var shift = activeShifts.FirstOrDefault(s => s.Id == modalShiftId) ?? currentShift;
        modalCheckIn = shift != null ? TimeOnly.FromTimeSpan(shift.StartTime) : new TimeOnly(8, 0);
    }

    private void SetNowCheckOut()
    {
        modalCheckOut = TimeOnly.FromDateTime(DateTime.Now);
    }

    private void SetShiftEndCheckOut()
    {
        var shift = activeShifts.FirstOrDefault(s => s.Id == modalShiftId) ?? currentShift;
        modalCheckOut = shift != null ? TimeOnly.FromTimeSpan(shift.EndTime) : new TimeOnly(17, 30);
    }

    private void ClearCheckOut()
    {
        modalCheckOut = null;
    }

    private async Task SaveManualCheckInOnlyAsync()
    {
        if (!isManager)
        {
            manualModalError = "Từ chối truy cập: Bạn không có quyền phân bổ hoặc sửa đổi giờ công!";
            return;
        }

        manualModalError = string.Empty;
        if (!modalCheckIn.HasValue)
        {
            manualModalError = "Vui lòng nhập Giờ Vào hợp lệ.";
            return;
        }

        isSubmittingModal = true;
        try
        {
            var inTime = modalCheckIn.Value.ToTimeSpan();
            var result = await CheckInUseCase.ExecuteManualPunchAsync(
                employeeId: modalEmployeeId,
                shiftId: modalShiftId,
                workDate: modalWorkDate,
                checkInTime: inTime,
                checkOutTime: null,
                customNote: string.IsNullOrWhiteSpace(modalNote) ? "Điểm danh giờ vào thủ công" : modalNote
            );

            showManualModal = false;
            statusMessage = $"Đã ghi nhận Giờ Vào thành công cho nhân viên ngày {modalWorkDate:dd/MM/yyyy}: {result.CheckInTime?.ToString(@"hh\:mm")}. Trạng thái: {result.Note}";
            statusType = "success";

            currentEmployeeId = modalEmployeeId;
            await LoadTimesheetsAsync();
            await LoadAllSummaryAsync();
        }
        catch (Exception ex)
        {
            manualModalError = $"Lỗi: {ex.Message}";
        }
        finally
        {
            isSubmittingModal = false;
        }
    }

