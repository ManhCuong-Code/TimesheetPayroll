@code {
    private string currentTab = "calendar";
    private string calendarViewMode = "MONTH"; // MONTH hoặc WEEK
    private bool isLoading = false;
    private string statusMessage = string.Empty;
    private string statusType = "success";

    // Trạng thái modal chấm công xác minh ảnh tự động
    private bool showPhotoPunchModal = false;
    private string punchActionType = "CHECK_IN";
    private string punchStatus = "Đang khởi tạo camera";
    private string punchStatusSubtitle = "Đang kết nối camera và kiểm tra quyền truy cập...";
    private string punchErrorMessage = "";
    private string? capturedPhotoPreview = null;
    private bool isPunchCameraActive = false;
    private bool isPunchSubmitting = false;

    private int currentMonth = DateTime.Today.Month;
    private int currentYear = DateTime.Today.Year;
    private DateTime selectedDate = DateTime.Today;

    private string statusFilter = "ALL";
    private string departmentFilter = "ALL";
    private long selectedEmployeeId = 0; // 0 = Tất cả nhân viên (Lưới tổng)

    private List<Timesheet> allLoadedTimesheets = new();
    private List<EmployeeTimesheetSummaryItem> summaryList = new();
    private List<TimesheetAuditLog> auditLogs = new();
    private List<Employee> allEmployees = new();
    private List<string> allDepartments = new();
    private Employee? selectedEmployee;

    private List<DateTime> monthCalendarDays = new();
    private List<DateTime> weekDays = new();

    // Modal state
    private Timesheet? selectedTimesheet;
    private DateTime? modalInTime;
    private DateTime? modalOutTime;
    private WorkShiftStatus modalStatus = WorkShiftStatus.PRESENT;
    private decimal modalWorkUnits = 1.0m;
    private string modalAdjustReason = string.Empty;
    private bool isSubmittingModal = false;
    private bool showPrintPreviewModal = false;

    private bool isAdmin => UserSession.CurrentUser?.Role == "ROLE_ADMIN";
    private bool isManager => UserSession.CurrentUser?.Role == "ROLE_MANAGER";
    private bool isAccountant => UserSession.CurrentUser?.Role == "ROLE_HR_ACCOUNTANT";
    private bool canManage => isAdmin || isManager || isAccountant;

    protected override async Task OnInitializedAsync()
    {
        await LoadMetadataAsync();
        await LoadDataAsync();
    }

    private async Task LoadMetadataAsync()
    {
        try
        {
            allEmployees = (await EmployeeRepo.GetEmployeesAsync()).ToList();
            allDepartments = allEmployees
                .Select(e => e.DepartmentName)
                .Where(d => !string.IsNullOrEmpty(d))
                .Distinct()
                .Cast<string>()
                .ToList();

            var currentUserId = UserSession.CurrentUser?.EmployeeId ?? 1;
            selectedEmployee = allEmployees.FirstOrDefault(e => e.Id == currentUserId) ?? allEmployees.FirstOrDefault();

            if (!canManage)
            {
                selectedEmployeeId = selectedEmployee?.Id ?? 1;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Lỗi tải metadata: {ex.Message}");
        }
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        try
        {
            CalculateCalendarDays();

            if (canManage)
            {
                // Tải dữ liệu thật theo thẩm quyền (Admin/Kế toán: toàn công ty; Quản lý: bộ phận phụ trách)
                var emps = allEmployees.Where(e => e.IsActiveEmployee());
                if (isManager && !string.IsNullOrEmpty(UserSession.CurrentUser?.DepartmentName))
                {
                    emps = emps.Where(e => string.Equals(e.DepartmentName, UserSession.CurrentUser.DepartmentName, StringComparison.OrdinalIgnoreCase));
                }
                var allowedEmps = emps.ToList();
                var empIds = allowedEmps.Select(e => e.Id).ToHashSet();

                var allTs = (await ViewTimesheetSummaryUseCase.ExecuteByMonthAsync(currentMonth, currentYear)).ToList();
                allLoadedTimesheets = allTs.Where(t => empIds.Contains(t.EmployeeId)).ToList();
                summaryList = BuildSummaryItems(allowedEmps, allLoadedTimesheets);
                auditLogs = (await ManageTimesheetUseCase.GetAuditLogsAsync(null, UserSession.CurrentUser?.Role)).ToList();
            }
            else
            {
                // Nhân viên thông thường: CHỈ xem dữ liệu cá nhân của mình, tuyệt đối không lộ dữ liệu nhân viên khác
                currentTab = "calendar";
                long myEmpId = UserSession.CurrentUser?.EmployeeId ?? 1;
                allLoadedTimesheets = (await ViewTimesheetUseCase.ExecuteAsync(myEmpId, currentMonth, currentYear)).ToList();
                summaryList.Clear();
                auditLogs.Clear();
            }
        }
        catch (Exception ex)
        {
            statusMessage = $"Lỗi khi tải dữ liệu chấm công: {ex.Message}";
            statusType = "danger";
        }
        finally
        {
            isLoading = false;
        }
    }

    private List<EmployeeTimesheetSummaryItem> BuildSummaryItems(List<Employee> emps, List<Timesheet> timesheets)
    {
        var result = new List<EmployeeTimesheetSummaryItem>();
        int order = 1;
        foreach (var emp in emps.Where(e => e.IsActiveEmployee()))
        {
            var empTs = timesheets.Where(t => t.EmployeeId == emp.Id).ToList();
            var item = new EmployeeTimesheetSummaryItem
            {
                OrderNumber = order++,
                EmployeeId = emp.Id,
                EmployeeCode = emp.EmployeeCode,
                FullName = emp.FullName,
                DepartmentName = emp.Department ?? "Khối Vận Hành",
                PositionName = emp.Position ?? "Nhân viên",
                Standard8hCount = empTs.Count(t => t.WorkUnits == 1.0m && t.WorkShiftStatus == WorkShiftStatus.PRESENT),
                SplitShiftCount = empTs.Count(t => t.ShiftCode != null && t.ShiftCode.Contains("GAY")),
                HalfShiftCount = empTs.Count(t => t.WorkUnits == 0.5m || t.WorkShiftStatus == WorkShiftStatus.HALF_DAY),
                FullShiftCount = empTs.Count(t => t.WorkUnits >= 1.0m),
                LateOrEarlyCount = empTs.Count(t => t.IsLate || t.IsEarlyLeave),
                PaidLeaveCount = empTs.Count(t => t.WorkShiftStatus == WorkShiftStatus.ABSENT_WITH_PERMISSION || t.WorkShiftStatus == WorkShiftStatus.HOLIDAY),
                AbsentCount = empTs.Count(t => t.WorkShiftStatus == WorkShiftStatus.ABSENT_UNAUTHORIZED),
                TotalHours = empTs.Sum(t => t.ActualHoursWorked),
                OvertimeHours = empTs.Sum(t => t.OvertimeHours),
                TotalWorkUnits = empTs.Sum(t => t.WorkUnits),
                ConfirmationStatus = empTs.Any() && empTs.All(t => t.IsLocked) ? "Đã Khóa" : "Chờ Duyệt"
            };
            result.Add(item);
        }
        return result;
    }

    private void CalculateCalendarDays()
    {
        // 1. Tính toán lưới 7 cột cho tháng
        monthCalendarDays.Clear();
        var firstDayOfMonth = new DateTime(currentYear, currentMonth, 1);
        int dayOfWeek = (int)firstDayOfMonth.DayOfWeek; // 0 = Sunday, 1 = Monday
        int offset = dayOfWeek == 0 ? 6 : dayOfWeek - 1; // Tuần bắt đầu từ Thứ Hai

        var startDate = firstDayOfMonth.AddDays(-offset);
        for (int i = 0; i < 42; i++) // 6 tuần x 7 ngày
        {
            monthCalendarDays.Add(startDate.AddDays(i));
        }

        // 2. Tính toán các ngày trong tuần đang chọn
        weekDays.Clear();
        int selectedDayOfWeek = (int)selectedDate.DayOfWeek;
        int weekOffset = selectedDayOfWeek == 0 ? 6 : selectedDayOfWeek - 1;
        var weekStart = selectedDate.AddDays(-weekOffset);
        for (int i = 0; i < 7; i++)
        {
            weekDays.Add(weekStart.AddDays(i));
        }
    }

    private List<Timesheet> GetTimesheetsForDay(DateTime date)
    {
        var query = allLoadedTimesheets.Where(t => t.WorkDate.Date == date.Date);

        if (selectedEmployeeId > 0)
        {
            query = query.Where(t => t.EmployeeId == selectedEmployeeId);
        }

        if (departmentFilter != "ALL")
        {
            var empIdsInDept = allEmployees.Where(e => e.DepartmentName == departmentFilter).Select(e => e.Id).ToHashSet();
            query = query.Where(t => empIdsInDept.Contains(t.EmployeeId));
        }

        if (statusFilter != "ALL")
        {
            if (statusFilter == "LATE_EARLY")
                query = query.Where(t => t.WorkShiftStatus == WorkShiftStatus.LATE || t.WorkShiftStatus == WorkShiftStatus.EARLY_LEAVE);
            else if (Enum.TryParse<WorkShiftStatus>(statusFilter, out var st))
                query = query.Where(t => t.WorkShiftStatus == st);
        }

        return query.ToList();
    }

    private string GetEventChipClass(WorkShiftStatus status) => status switch
    {
        WorkShiftStatus.PRESENT => "event-chip-present",
        WorkShiftStatus.LATE => "event-chip-warning",
        WorkShiftStatus.EARLY_LEAVE => "event-chip-warning",
        WorkShiftStatus.HALF_DAY => "event-chip-warning",
        WorkShiftStatus.ABSENT_WITH_PERMISSION => "event-chip-info",
        WorkShiftStatus.ABSENT_UNAUTHORIZED => "event-chip-danger",
        _ => "event-chip-gray"
    };

    private void SetViewMode(string mode)
    {
        calendarViewMode = mode;
        CalculateCalendarDays();
    }

    private async Task PrevMonth()
    {
        if (currentMonth == 1)
        {
            currentMonth = 12;
            currentYear--;
        }
        else
        {
            currentMonth--;
        }
        selectedDate = new DateTime(currentYear, currentMonth, 1);
        await LoadDataAsync();
    }

    private async Task NextMonth()
    {
        if (currentMonth == 12)
        {
            currentMonth = 1;
            currentYear++;
        }
        else
        {
            currentMonth++;
        }
        selectedDate = new DateTime(currentYear, currentMonth, 1);
        await LoadDataAsync();
    }

    private async Task GoToToday()
    {
        currentMonth = DateTime.Today.Month;
        currentYear = DateTime.Today.Year;
        selectedDate = DateTime.Today;
        await LoadDataAsync();
    }

    private void OnDayCellClicked(DateTime date)
    {
        selectedDate = date;
        var dayRecords = GetTimesheetsForDay(date);
        if (dayRecords.Any())
        {
            OpenDetailModal(dayRecords.First());
        }
        else if (canManage && selectedEmployeeId > 0)
        {
            // Tạo bản ghi mới cho ngày được bấm
            var emp = allEmployees.FirstOrDefault(e => e.Id == selectedEmployeeId);
            OpenDetailModal(new Timesheet
            {
                EmployeeId = selectedEmployeeId,
                EmployeeName = emp?.FullName,
                EmployeeCode = emp?.EmployeeCode,
                WorkDate = date,
                WorkShiftStatus = WorkShiftStatus.PRESENT,
                WorkUnits = 1.0m,
                ActualHoursWorked = 8.0m,
                ShiftName = "Ca Hành Chính (08:00 - 17:30)"
            });
        }
    }

    private void OpenDetailModal(Timesheet timesheet)
    {
        selectedTimesheet = timesheet;
        modalInTime = timesheet.CheckInTime.HasValue ? DateTime.Today.Add(timesheet.CheckInTime.Value) : DateTime.Today.AddHours(8);
        modalOutTime = timesheet.CheckOutTime.HasValue ? DateTime.Today.Add(timesheet.CheckOutTime.Value) : DateTime.Today.AddHours(17).AddMinutes(30);
        modalStatus = timesheet.WorkShiftStatus;
        modalWorkUnits = timesheet.WorkUnits;
        modalAdjustReason = string.Empty;
    }

    private void CloseDetailModal()
    {
        selectedTimesheet = null;
    }

    private async Task HandleSaveAdjustmentAsync()
    {
        if (selectedTimesheet == null || isSubmittingModal) return;

        if (string.IsNullOrWhiteSpace(modalAdjustReason))
        {
            statusMessage = "Bắt buộc phải nhập lý do điều chỉnh bản ghi chấm công để lưu nhật ký kiểm toán.";
            statusType = "warning";
            return;
        }

        isSubmittingModal = true;
        try
        {
            selectedTimesheet.CheckInTime = modalInTime?.TimeOfDay;
            selectedTimesheet.CheckOutTime = modalOutTime?.TimeOfDay;
            selectedTimesheet.WorkShiftStatus = modalStatus;
            selectedTimesheet.WorkUnits = modalWorkUnits;
            selectedTimesheet.Note = modalAdjustReason;

            if (selectedTimesheet.CheckInTime.HasValue && selectedTimesheet.CheckOutTime.HasValue)
            {
                decimal lunchBreak = (selectedTimesheet.ShiftCode == "CA_SANG" || selectedTimesheet.ShiftCode == "CA_CHIEU" || selectedTimesheet.ShiftCode == "CA_TOI") ? 0.0m : 1.5m;
                selectedTimesheet.CalculateHoursWorked(lunchBreak);
            }

            var user = UserSession.CurrentUser;
            await ManageTimesheetUseCase.AdjustTimesheetAsync(
                selectedTimesheet, 
                modalAdjustReason, 
                user?.Username ?? "admin", 
                user?.Role);

            statusMessage = $"Đã điều chỉnh thành công chấm công ngày {selectedTimesheet.WorkDate:dd/MM/yyyy} và ghi log kiểm toán.";
            statusType = "success";

            CloseDetailModal();
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            statusMessage = $"Lỗi khi lưu điều chỉnh: {ex.Message}";
            statusType = "danger";
        }
        finally
        {
            isSubmittingModal = false;
        }
    }

    private async Task HandleCheckInAsync()
    {
        await OpenPhotoPunchModalAsync("CHECK_IN");
    }

    private async Task HandleCheckOutAsync()
    {
        await OpenPhotoPunchModalAsync("CHECK_OUT");
    }

    private async Task OpenPhotoPunchModalAsync(string actionType)
    {
        punchActionType = actionType;
        showPhotoPunchModal = true;
        capturedPhotoPreview = null;
        punchErrorMessage = "";
        punchStatus = "Đang khởi tạo camera";
        punchStatusSubtitle = "Đang kết nối camera và kiểm tra quyền truy cập...";
        StateHasChanged();

        await Task.Delay(250);

        try
        {
            var initRes = await JSRuntime.InvokeAsync<CameraInitResult>("FaceRecognitionHelper.startCamera", "punchCaptureVideo", "punchCaptureCanvas");
            if (initRes != null && initRes.Success)
            {
                isPunchCameraActive = true;
                StateHasChanged();

                // Đợi 1.5 giây để camera cân bằng ánh sáng và nhận diện khuôn mặt
                await Task.Delay(1500);

                if (!showPhotoPunchModal) return;

                // Tự động chụp ảnh xác minh (không yêu cầu nhấn nút thủ công)
                punchStatus = "Đang chụp ảnh";
                punchStatusSubtitle = "Tự động ghi nhận khung hình xác minh khuôn mặt...";
                StateHasChanged();

                await Task.Delay(300);
                var photoBase64 = await JSRuntime.InvokeAsync<string>("FaceRecognitionHelper.capturePhotoBase64", "punchCaptureVideo", 0.85);

                if (string.IsNullOrWhiteSpace(photoBase64))
                {
                    throw new Exception("Chưa chụp được ảnh từ camera. Vui lòng giữ thẳng khuôn mặt và thử lại.");
                }

                capturedPhotoPreview = photoBase64;
                await JSRuntime.InvokeVoidAsync("FaceRecognitionHelper.playChime", "scan");

                // Dừng camera ngay lập tức sau khi chụp ảnh
                await StopPunchCameraAsync();
                StateHasChanged();

                // Hiển thị ảnh vừa chụp để người dùng kiểm tra trước khi gửi dữ liệu
                await Task.Delay(900);

                // Gửi dữ liệu tới backend
                punchStatus = "Đang gửi dữ liệu";
                punchStatusSubtitle = "Backend đang kiểm tra ca làm và lưu bản ghi kèm ảnh xác minh...";
                isPunchSubmitting = true;
                StateHasChanged();

                var empId = selectedEmployee?.Id ?? UserSession.CurrentUser?.EmployeeId ?? 1;
                Timesheet result;
                if (punchActionType == "CHECK_OUT")
                {
                    result = await CheckInUseCase.ExecuteCheckOutAsync(empId, null, null, DateTime.Today, photoBase64);
                }
                else
                {
                    result = await CheckInUseCase.ExecuteCheckInAsync(empId, null, null, DateTime.Today, photoBase64);
                }

                punchStatus = "Chấm công thành công";
                punchStatusSubtitle = $"Đã ghi nhận lượt {(punchActionType == "CHECK_IN" ? "Vào" : "Ra")} ca lúc {DateTime.Now:HH:mm:ss} vào CSDL SQL Server.";
                await JSRuntime.InvokeVoidAsync("FaceRecognitionHelper.playChime", "success");
                await LoadDataAsync();
            }
            else
            {
                punchStatus = "Không thể chấm công";
                punchErrorMessage = initRes?.Error ?? "Không thể kết nối camera. Vui lòng kiểm tra quyền camera hoặc thiết bị rồi thử lại.";
                punchStatusSubtitle = punchErrorMessage;
            }
        }
        catch (Exception ex)
        {
            await StopPunchCameraAsync();
            if (ex.Message.Contains("Bạn đã hoàn thành lượt vào và ra"))
            {
                punchStatus = "Chấm công thành công";
                punchStatusSubtitle = "Bạn đã hoàn thành lượt vào và ra cho tất cả các ca được phân công trong ngày.";
                punchErrorMessage = "";
                await JSRuntime.InvokeVoidAsync("FaceRecognitionHelper.playChime", "success");
            }
            else
            {
                punchStatus = "Không thể chấm công";
                punchErrorMessage = ex.Message;
                punchStatusSubtitle = ex.Message;
            }
        }
        finally
        {
            isPunchSubmitting = false;
            StateHasChanged();
        }
    }

    private async Task ClosePhotoPunchModalAsync()
    {
        if (isPunchSubmitting) return;
        await StopPunchCameraAsync();
        showPhotoPunchModal = false;
        StateHasChanged();
    }

    private async Task StopPunchCameraAsync()
    {
        if (isPunchCameraActive)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync("FaceRecognitionHelper.stopCamera", "punchCaptureVideo");
            }
            catch { }
            isPunchCameraActive = false;
        }
    }

    private async Task OnEmployeeSelectChangedAsync(ChangeEventArgs e)
    {
        if (long.TryParse(e.Value?.ToString(), out var empId))
        {
            selectedEmployeeId = empId;
            selectedEmployee = allEmployees.FirstOrDefault(x => x.Id == empId);
            await LoadDataAsync();
        }
    }

    private void FilterByEmployee(long empId)
    {
        selectedEmployeeId = empId;
        selectedEmployee = allEmployees.FirstOrDefault(x => x.Id == empId);
        currentTab = "calendar";
    }

    private void OpenPrintPreviewModal()
    {
        showPrintPreviewModal = true;
