                    <!-- TAB 1: CẤU HÌNH LLM PROVIDER -->
                    @if (modalActiveTab == "config")
                    {
                        <div class="card border-0 shadow-sm rounded-3 p-3 bg-white mb-3">
                            <h6 class="fw-bold text-dark small mb-3">
                                <i class="fa-solid fa-microchip text-primary me-2"></i>Chọn Động Cơ Trí Tuệ Nhân Tạo (AI Engine)
