                                            <option value="gpt-4o">gpt-4o (Mạnh mẽ toàn diện)</option>
                                        </select>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-info border-0 py-2 small mb-0">
                                    <i class="fa-solid fa-circle-info me-2"></i>Chế độ <strong>Động Cơ Nội Bộ (Local Engine)</strong> sử dụng các thuật toán đối soát toán học tất định (Deterministic Engine) và bộ quy tắc luật lao động 2024 tích hợp sẵn mà không cần kết nối mạng bên ngoài.
                                </div>
                            }
                        </div>
                    }

                    <!-- TAB 2: TÀI LIỆU TRI THỨC (KNOWLEDGE BASE) -->
                    @if (modalActiveTab == "docs")
                    {
                        <div class="mb-3">
                            <h6 class="fw-bold text-dark small mb-2 d-flex align-items-center justify-content-between">
                                <span><i class="fa-solid fa-book-open text-primary me-2"></i>Tài Liệu Tri Thức Pháp Luật Đã Tích Hợp</span>
                                <span class="badge bg-primary">@allKnowledgeDocs.Count tài liệu</span>
                            </h6>
                            <div class="accordion accordion-flush rounded-3 border overflow-hidden" id="accordionKnowledge">
                                @for (int i = 0; i < allKnowledgeDocs.Count; i++)
                                {
                                    var doc = allKnowledgeDocs[i];
                                    int docIdx = i;
                                    <div class="accordion-item">
                                        <h2 class="accordion-header" id="@($"heading_{docIdx}")">
                                            <button class="accordion-button collapsed py-2 px-3 small fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="@($"#collapse_{docIdx}")">
                                                <span class="badge bg-secondary-subtle text-secondary me-2" style="font-size: 0.68rem;">@doc.Category</span>
                                                @doc.Title
                                            </button>
                                        </h2>
                                        <div id="@($"collapse_{docIdx}")" class="accordion-collapse collapse" data-bs-parent="#accordionKnowledge">
                                            <div class="accordion-body small bg-light bg-opacity-50 text-muted py-2 px-3" style="font-size: 0.8rem; line-height: 1.5;">
                                                <div class="fw-semibold text-dark mb-1"><i class="fa-solid fa-scale-balanced me-1 text-primary"></i>Nguồn: @doc.Source</div>
                                                <div>@doc.Content</div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
                            <h6 class="fw-bold text-dark small mb-2">
                                <i class="fa-solid fa-pen-to-square text-success me-2"></i>Nạp Thêm Quy Chế / Chính Sách Riêng Của Doanh Nghiệp
                            </h6>
                            <p class="text-muted small mb-2" style="font-size: 0.75rem;">
                                Bạn có thể gõ thêm các chính sách phụ cấp, chế độ thưởng nội bộ của công ty. AI sẽ ghi nhớ và kết hợp trả lời cho người lao động:
                            </p>
                            <textarea class="form-control mb-2" rows="3" 
                                      placeholder="Ví dụ: Công ty hỗ trợ thêm 300.000 VNĐ thưởng chuyên cần nếu nhân viên đi làm đủ 100% ngày công..." 
                                      @bind="customNotesInput"></textarea>
                        </div>
                    }

                    <!-- TAB 3: NGỮ CẢNH DỮ LIỆU THỰC TẾ (GROUNDING CONTEXT) -->
                    @if (modalActiveTab == "grounding")
                    {
                        <div class="card border-0 shadow-sm rounded-3 p-3 bg-white">
                            <h6 class="fw-bold text-dark small mb-2">
                                <i class="fa-solid fa-shield-halved text-success me-2"></i>Bản Xem Trước Ngữ Cảnh Dữ Liệu Nhân Sự Nạp Vào AI
                            </h6>
                            <p class="text-muted small mb-3" style="font-size: 0.75rem;">
                                Khi nhân viên gửi câu hỏi, hệ thống tự động tiêm (inject) các thông tin sau vào System Instruction để AI trả lời chuẩn xác 100%:
                            </p>

                            <div class="p-3 bg-light rounded-3 border" style="font-family: monospace; font-size: 0.75rem; white-space: pre-wrap; max-height: 280px; overflow-y: auto;">
                                @GetActiveGroundingPreview()
                            </div>
                        </div>
                    }
                </div>

                <div class="modal-footer bg-light border-top py-2 px-4 d-flex justify-content-between">
                    <span class="text-muted small" style="font-size: 0.75rem;">
                        <i class="fa-solid fa-lock text-success me-1"></i>Bảo mật dữ liệu theo nguyên tắc Anti-IDOR & Zero-Hallucination
                    </span>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3" @onclick="CloseKnowledgeModal">Đóng</button>
                        <button type="button" class="btn btn-primary btn-sm rounded-pill px-4 fw-semibold" @onclick="SaveAiConfig">
                            <i class="fa-solid fa-floppy-disk me-1"></i>Lưu & Cập Nhật Tri Thức
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private long currentEmployeeId = 1;
    private Employee? currentEmployee;
    private List<Payslip> payslips = new();
    private Payslip? selectedPayslip;

    private string activeTab = "chat";
    private bool isLoading = true;

    // Chat Tab State
    private long selectedPeriodId = 10;
    private string inputQuestion = string.Empty;
    private bool isThinking = false;
    private List<AiChatMessage> chatMessages = new();

    // Compare Tab State
    private long comparePeriodA = 10;
    private long comparePeriodB = 9;
    private SalaryComparisonDiff? comparisonDiff;
    private bool isComparing = false;

    // Simulator Tab State
    private SalarySimulationRequest simRequest = new();
    private SalarySimulationResult? simResult;

    // AI Configuration & Knowledge Base State
    private bool showKnowledgeModal = false;
    private string modalActiveTab = "config";
    private AiConfiguration aiConfig = new();
    private string customNotesInput = string.Empty;
    private bool showApiKeyText = false;
    private string configSuccessMsg = string.Empty;
    private List<KnowledgeDocument> allKnowledgeDocs = new();

    private readonly CultureInfo vnCulture = new("vi-VN");

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            if (AuthStateTask != null)
            {
                var authState = await AuthStateTask;
                var empIdClaim = authState.User.FindFirst("EmployeeId")?.Value;
                if (long.TryParse(empIdClaim, out var id) && id > 0)
                {
                    currentEmployeeId = id;
                }
            }

            // Tải thông tin nhân viên
            currentEmployee = await ProfileUseCase.ExecuteAsync(currentEmployeeId);

            // Tải lịch sử phiếu lương (Chống IDOR: chỉ tải của chính nhân viên)
            var history = await HistoryUseCase.ExecuteAsync(currentEmployeeId);
            payslips = history.ToList();

            if (payslips.Any())
            {
                selectedPeriodId = payslips.First().PeriodId;
                selectedPayslip = payslips.First();

                comparePeriodA = payslips.First().PeriodId;
                comparePeriodB = payslips.Count > 1 ? payslips[1].PeriodId : comparePeriodA;
            }

            // Khởi tạo form mô phỏng với mức lương hợp đồng thực tế
            if (currentEmployee != null)
            {
                simRequest.BaseSalary = currentEmployee.BaseSalary > 0 ? currentEmployee.BaseSalary : 10000000m;
                simRequest.MealAllowance = currentEmployee.MealAllowance;
                simRequest.FuelAllowance = currentEmployee.FuelAllowance;
            }
            simResult = await SimulateUseCase.ExecuteAsync(currentEmployeeId, simRequest);

            // Tin nhắn mở đầu của Trợ lý AI
            InitGreetingMessage();

            // Tự động chạy so sánh ban đầu nếu có 2 kỳ
            if (comparePeriodA != comparePeriodB)
            {
                comparisonDiff = await CompareUseCase.ExecuteAsync(currentEmployeeId, comparePeriodA, comparePeriodB);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[AiSalaryAssistant] Init error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void InitGreetingMessage()
    {
        string name = currentEmployee?.FullName ?? "bạn";
        chatMessages.Add(new AiChatMessage
        {
            IsUser = false,
            Timestamp = DateTime.Now,
            Text = $"Dạ chào anh/chị **{name}**! Em là **Trợ lý Lương AI** thông minh.\nEm đã liên kết với phiếu lương của bạn tại hệ thống doanh nghiệp. Anh/chị có thể hỏi bất kỳ câu hỏi nào về các khoản lương, lý do biến động lương hoặc bấm chọn các câu hỏi gợi ý bên dưới nhé!",
            FollowUpSuggestions = new List<string>
            {
                "Sao lương tháng 10 ít hơn tháng 9?",
                "Chi tiết phiếu lương tháng này của tôi",
                "Giải thích các khoản trừ bảo hiểm (10.5%)",
                "Cách tính thuế thu nhập cá nhân (TNCN)"
            }
        });
    }

    private void SwitchTab(string tab)
    {
        activeTab = tab;
    }

    private async Task HandleSendMessageAsync()
    {
        if (string.IsNullOrWhiteSpace(inputQuestion) || isThinking) return;

        string question = inputQuestion.Trim();
        inputQuestion = string.Empty;
        await AskQuestionAsync(question);
    }

    private async Task AskQuestionAsync(string question)
    {
        // 1. Thêm tin nhắn của User
        chatMessages.Add(new AiChatMessage
        {
            IsUser = true,
            Text = question,
            Timestamp = DateTime.Now
        });

        isThinking = true;
        StateHasChanged();

        try
        {
            // Trì hoãn nhẹ 400ms để tạo cảm giác suy nghĩ tự nhiên mượt mà
            await Task.Delay(400);

            // Xác định kỳ so sánh nếu có
            long? compId = null;
            if (payslips.Count > 1)
            {
                var other = payslips.FirstOrDefault(p => p.PeriodId != selectedPeriodId);
                compId = other?.PeriodId;
            }

            var aiAnswer = await AskAiUseCase.ExecuteAsync(currentEmployeeId, question, selectedPeriodId, compId);
            chatMessages.Add(aiAnswer);
        }
        catch (Exception ex)
        {
            chatMessages.Add(new AiChatMessage
            {
                IsUser = false,
                Text = $"Đã xảy ra sự cố trong quá trình đối soát: {ex.Message}",
                Timestamp = DateTime.Now
            });
        }
        finally
        {
            isThinking = false;
            StateHasChanged();
        }
    }

    private void ClearChat()
    {
        chatMessages.Clear();
        InitGreetingMessage();
    }

    private async Task RunComparisonAsync()
    {
        if (comparePeriodA == comparePeriodB) return;

        isComparing = true;
        try
        {
            comparisonDiff = await CompareUseCase.ExecuteAsync(currentEmployeeId, comparePeriodA, comparePeriodB);
        }
        finally
        {
            isComparing = false;
        }
    }

    private async Task RunSimulationAsync()
    {
        simResult = await SimulateUseCase.ExecuteAsync(currentEmployeeId, simRequest);
    }

    private string FormatPeriod(Payslip p)
    {
        if (p.PeriodMonth > 0)
            return $"Tháng {p.PeriodMonth}/{p.PeriodYear}";
        if (!string.IsNullOrEmpty(p.PeriodCode))
            return p.PeriodCode;
        return $"Kỳ #{p.PeriodId}";
    }

    private string FormatMarkdownText(string text)
    {
        if (string.IsNullOrEmpty(text)) return string.Empty;
        
        // Escape HTML
        var safe = System.Net.WebUtility.HtmlEncode(text);

        // Bold: **text** -> <strong>text</strong>
        safe = System.Text.RegularExpressions.Regex.Replace(safe, @"\*\*(.+?)\*\*", "<strong>$1</strong>");

        // Italic: *text* -> <em>text</em>
        safe = System.Text.RegularExpressions.Regex.Replace(safe, @"\*(.+?)\*", "<em>$1</em>");

        return safe;
    }

    private void OpenKnowledgeModal()
    {
        aiConfig = LlmClient.GetConfiguration();
        customNotesInput = KnowledgeBaseService.GetCustomNotes();
        allKnowledgeDocs = KnowledgeBaseService.GetAllDocuments();
        configSuccessMsg = string.Empty;
        showKnowledgeModal = true;
    }

    private void CloseKnowledgeModal()
    {
        showKnowledgeModal = false;
        configSuccessMsg = string.Empty;
    }

    private void SaveAiConfig()
    {
        LlmClient.UpdateConfiguration(aiConfig);
        KnowledgeBaseService.SetCustomNotes(customNotesInput);
        allKnowledgeDocs = KnowledgeBaseService.GetAllDocuments();
        configSuccessMsg = "Đã lưu và cập nhật tri thức cho AI thành công!";
        StateHasChanged();
    }

    private string GetActiveGroundingPreview()
    {
        Payslip? prev = null;
        if (payslips.Count > 1)
        {
            prev = payslips.FirstOrDefault(p => p.PeriodId != selectedPeriodId);
        }
        return KnowledgeBaseService.BuildFullSystemPrompt(currentEmployee, selectedPayslip, prev, comparisonDiff);
    }
}
