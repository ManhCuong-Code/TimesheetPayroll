                                         style="cursor: pointer;" 
                                         @onclick="() => aiConfig.Provider = AiProviderType.OpenAi">
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <input class="form-check-input mt-0" type="radio" name="aiProvider" id="provOpenAi" 
                                                   checked="@(aiConfig.Provider == AiProviderType.OpenAi)" />
                                            <label class="form-check-label fw-bold text-dark small" for="provOpenAi">
                                                OpenAI (ChatGPT)
                                            </label>
                                        </div>
                                        <div class="text-muted" style="font-size: 0.72rem;">Sử dụng mô hình gpt-4o-mini hoặc gpt-4o qua OpenAI API.</div>
                                    </div>
                                </div>

                                <div class="col-md-4">
                                    <div class="p-3 border rounded-3 h-100 @(aiConfig.Provider == AiProviderType.LocalEngine ? "border-primary bg-primary bg-opacity-10" : "bg-light")" 
                                         style="cursor: pointer;" 
                                         @onclick="() => aiConfig.Provider = AiProviderType.LocalEngine">
                                        <div class="d-flex align-items-center gap-2 mb-1">
                                            <input class="form-check-input mt-0" type="radio" name="aiProvider" id="provLocal" 
                                                   checked="@(aiConfig.Provider == AiProviderType.LocalEngine)" />
