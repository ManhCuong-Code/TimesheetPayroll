@using TimesheetPayroll.CoreBusiness.Models
@using TimesheetPayroll.Web.Common.Controls

@if (Payslips == null || !Payslips.Any())
{
    <div class="alert alert-info d-flex align-items-center m-3" role="alert">
        <i class="fa-solid fa-circle-info me-2 fs-5"></i>
        <div>Chưa có dữ liệu tính lương cho kỳ này. Vui lòng nhấn nút <strong>"Chạy Tính Lương Tự Động"</strong> để bắt đầu.</div>
    </div>
}
else
{
    <!-- THANH TÌM KIẾM REUSABLE COMPONENT (K3.1) -->
    <div class="p-3 bg-light border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div style="min-width: 280px; max-width: 450px;" class="flex-grow-1">
            <SearchBarComponent Placeholder="Tìm kiếm theo mã NV, họ tên hoặc phòng ban..." OnSearch="HandleSearch" />
        </div>
        <div class="small text-muted">
            Hiển thị <strong>@DisplayPayslips.Count()</strong> / @Payslips.Count() nhân sự
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle border mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col">Mã NV</th>
                    <th scope="col">Họ và Tên</th>
                    <th scope="col">Phòng Ban</th>
                    <th scope="col" class="text-center">Ngày Công</th>
                    <th scope="col" class="text-center">Trạng Thái</th>
                    <th scope="col" class="text-end">Thu Nhập Gộp</th>
                    <th scope="col" class="text-end">Tổng Khấu Trừ</th>
                    <th scope="col" class="text-end">Thực Lĩnh (Net)</th>
                    <th scope="col">Tài Khoản Chi Trả</th>
                    <th scope="col" class="text-center">Hành Động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in DisplayPayslips)
                {
                    <tr>
                        <td class="fw-bold text-primary">@p.EmployeeCode</td>
                        <td>@p.EmployeeName</td>
                        <td><span class="badge bg-light text-dark border">@(p.DepartmentName ?? "Văn phòng")</span></td>
                        <td class="text-center fw-semibold">
                            @p.ActualWorkDays
                            @if (p.Lines.Any(l => l.LineType == PayslipLineType.SPLIT_SHIFT_ALLOWANCE))
                            {
                                <div class="mt-1">
                                    <StatusBadgeComponent Status="HALF_DAY" Label="Có ca gãy" />
                                </div>
                            }
                        </td>
                        <td class="text-center">
                            <StatusBadgeComponent Status="CALCULATED" Label="Đã tính" />
                        </td>
                        <td class="text-end">@p.GrossSalary.ToString("N0") đ</td>
                        <td class="text-end text-danger">-@p.TotalDeductions.ToString("N0") đ</td>
                        <td class="text-end fw-bold text-success fs-6">@p.NetSalary.ToString("N0") đ</td>
                        <td class="small text-muted">
                            <div>@p.BankAccountNumber</div>
                            <div class="text-uppercase fw-semibold">@p.BankName</div>
                        </td>
                        <td class="text-center">
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => OnSelectPayslip.InvokeAsync(p)" title="Xem chi tiết phiếu lương">
                                <i class="fa-solid fa-eye me-1"></i>Chi tiết
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot class="table-group-divider table-light fw-bold">
                <tr>
                    <td colspan="5" class="text-end">TỔNG CỘNG:</td>
                    <td class="text-end text-primary">@DisplayPayslips.Sum(p => p.GrossSalary).ToString("N0") đ</td>
                    <td class="text-end text-danger">-@DisplayPayslips.Sum(p => p.TotalDeductions).ToString("N0") đ</td>
                    <td class="text-end text-success fs-5">@DisplayPayslips.Sum(p => p.NetSalary).ToString("N0") đ</td>
                    <td colspan="2"></td>
                </tr>
            </tfoot>
        </table>
    </div>
}

@code {
    [Parameter] public IEnumerable<Payslip>? Payslips { get; set; }
    [Parameter] public EventCallback<Payslip> OnSelectPayslip { get; set; }

    private string searchTerm = string.Empty;

    private IEnumerable<Payslip> DisplayPayslips
    {
        get
        {
            if (Payslips == null) return Enumerable.Empty<Payslip>();
            if (string.IsNullOrWhiteSpace(searchTerm)) return Payslips;

            return Payslips.Where(p =>
                (p.EmployeeCode?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (p.EmployeeName?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (p.DepartmentName?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ?? false));
        }
    }

    private void HandleSearch(string term)
    {
        searchTerm = term;
    }
}
