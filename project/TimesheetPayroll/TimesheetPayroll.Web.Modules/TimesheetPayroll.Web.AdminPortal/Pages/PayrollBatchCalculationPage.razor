@page "/admin/payroll-calculation"
@attribute [Authorize(Roles = "ROLE_HR_ACCOUNTANT, ROLE_ADMIN")]
@inject ICalculatePayrollBatchUseCase CalculateUseCase
@inject IViewPayrollSummaryUseCase ViewSummaryUseCase
@inject ILockPayrollPeriodUseCase LockUseCase
@inject IUnlockPayrollPeriodUseCase UnlockUseCase
@inject IExportPayrollExcelUseCase ExportExcelUseCase
@inject IJSRuntime JSRuntime
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using TimesheetPayroll.Web.AdminPortal.Controls

<AuthorizeView Roles="ROLE_HR_ACCOUNTANT, ROLE_ADMIN">
    <Authorized>
<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="h4 mb-1 text-dark fw-bold">
                <i class="fa-solid fa-calculator text-primary me-2"></i>Tính Toán Bảng Lương Hàng Loạt (Batch Calculation)
            </h2>
            <p class="text-muted small mb-0">Tự động hóa tính lương toàn bộ nhân sự theo ngày công thực tế, phụ cấp và khấu trừ bảo hiểm luật định.</p>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-primary" @onclick="LoadDataAsync" disabled="@isLoading">
                <i class="fa-solid fa-arrows-rotate me-1"></i>Làm mới
            </button>
            <button class="btn btn-primary shadow-sm" @onclick="HandleCalculateBatchAsync" disabled="@isLoading" title="@(isLocked ? "Bấm vào để demo chặn vi phạm tính lại kỳ đã khóa" : "Chạy tính lương tự động")">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                    <span>Đang tính toán...</span>
                }
                else
                {
                    <i class="fa-solid fa-bolt me-1"></i>
                    <span>Chạy Tính Lương Tự Động</span>
                }
            </button>
            <button class="btn btn-outline-primary shadow-sm" @onclick="() => showPrintModal = true" disabled="@(!payslips.Any())" title="Xem trước và in bảng thanh toán tiền lương Mẫu 02-LĐTL">
                <i class="fa-solid fa-print me-1"></i>In Bảng Lương (Mẫu 02)
            </button>
            @if (payslips.Any())
            {
                <div class="btn-group shadow-sm">
                    <button class="btn btn-success" @onclick="HandleExportExcelAsync" disabled="@isLoading" title="Tải xuống bảng tính Excel chi tiết">
                        <i class="fa-solid fa-file-excel me-1"></i>
                        <span>Xuất Excel Bảng Lương</span>
                    </button>
                    <button type="button" class="btn btn-success dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false" disabled="@isLoading" title="Tùy chọn xuất file">
                        <span class="visually-hidden">Tùy chọn xuất file</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                        <li>
                            <button class="dropdown-item py-2" @onclick="HandleExportExcelAsync">
                                <i class="fa-solid fa-file-excel text-success me-2"></i>Bảng thanh toán lương chi tiết (.xls)
                            </button>
                        </li>
                        <li>
                            <button class="dropdown-item py-2" @onclick="HandleExportCsvAsync">
                                <i class="fa-solid fa-file-csv text-primary me-2"></i>Dữ liệu chuyển khoản ngân hàng (.csv)
                            </button>
                        </li>
                    </ul>
                </div>
            }
            @if (payslips.Any() && !isLocked)
            {
                <button class="btn btn-danger shadow-sm" @onclick="HandleLockPeriodAsync" disabled="@isLoading">
                    <i class="fa-solid fa-lock me-1"></i>Chốt Kỳ Lương (Khóa Sổ)
                </button>
            }
            @if (isLocked)
            {
                <button class="btn btn-warning shadow-sm" @onclick="HandleUnlockPeriodAsync" disabled="@isLoading">
                    <i class="fa-solid fa-lock-open me-1"></i>Mở Khóa Bảng Lương
                </button>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(alertMessage))
    {
        <div class="alert alert-@alertType alert-dismissible fade show shadow-sm" role="alert">
            <i class="fa-solid fa-circle-check me-2"></i>@alertMessage
            <button type="button" class="btn-close" @onclick="() => alertMessage = string.Empty"></button>
        </div>
    }

    <!-- THÔNG TIN KỲ LƯƠNG HIỆN TẠI -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-white p-3 border-start border-4 border-primary">
                <div class="text-muted small fw-semibold">KỲ LƯƠNG ÁP DỤNG</div>
                <div class="fs-4 fw-bold text-dark mt-1">@(period?.PeriodCode ?? "PR-2026-10")</div>
                <div class="small text-muted">Tháng @(period?.PeriodMonth ?? 10)/@(period?.PeriodYear ?? 2026) (Chuẩn: @(period?.StandardWorkDays ?? 22) công)</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-white p-3 border-start border-4 border-info">
                <div class="text-muted small fw-semibold">TRẠNG THÁI KỲ</div>
                <div class="fs-4 fw-bold mt-1">
                    <StatusBadgeComponent Status="@(isLocked ? "LOCKED" : (period?.Status.ToString() ?? "CALCULATED"))" 
                                          Label="@(isLocked ? "ĐÃ KHÓA SỔ (READ-ONLY)" : (period?.Status.ToString() ?? "SẴN SÀNG TÍNH"))" />
                </div>
                <div class="small text-muted">@(isLocked ? "Không thể chỉnh sửa" : "Cho phép đối soát & tính lại")</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-white p-3 border-start border-4 border-warning">
                <div class="text-muted small fw-semibold">TỔNG QUỸ LƯƠNG GỘP (GROSS)</div>
                <div class="fs-4 fw-bold text-dark mt-1">@totalGross.ToString("N0") đ</div>
                <div class="small text-muted">Bao gồm lương ngày công & phụ cấp</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-white p-3 border-start border-4 border-success">
                <div class="text-muted small fw-semibold">TỔNG THỰC LĨNH CHI TRẢ (NET)</div>
                <div class="fs-4 fw-bold text-success mt-1">@totalNet.ToString("N0") đ</div>
                <div class="small text-muted">Tổng số tiền chi chuyển khoản</div>
            </div>
        </div>
    </div>

    <!-- BẢNG ĐỐI SOÁT TỔNG HỢP CHI TIẾT -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h5 class="card-title h6 mb-0 fw-bold">
                <i class="fa-solid fa-list-check me-2 text-primary"></i>Danh Sách Phiếu Lương Đối Soát Chi Tiết
            </h5>
            <div class="d-flex align-items-center gap-2">
                @if (payslips.Any())
                {
                    <button class="btn btn-sm btn-outline-primary fw-semibold shadow-sm" @onclick="() => showPrintModal = true" title="In bảng lương mẫu 02-LĐTL">
                        <i class="fa-solid fa-print me-1"></i>In Mẫu 02
                    </button>
                    <button class="btn btn-sm btn-outline-success fw-semibold shadow-sm" @onclick="HandleExportExcelAsync" disabled="@isLoading" title="Xuất nhanh bảng lương Excel">
                        <i class="fa-solid fa-file-excel me-1"></i>Xuất Excel
                    </button>
                }
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2">
                    Tổng nhân sự: @payslips.Count người
                </span>
            </div>
        </div>
        <div class="card-body p-0">
            <PayrollSummaryComponent Payslips="@payslips" OnSelectPayslip="HandleSelectPayslip" />
        </div>
    </div>

    @if (selectedPayslip != null)
    {
        <div class="mt-4">
            <PayslipDetailCard Payslip="@selectedPayslip" OnClose="() => selectedPayslip = null" />
        </div>
    }

    <!-- MODAL XEM TRƯỚC VÀ IN BẢNG LƯƠNG TỔNG HỢP (MẪU 02-LĐTL) -->
    @if (showPrintModal && period != null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.65); z-index: 1060;">
            <div class="modal-dialog modal-fullscreen-lg-down modal-xl modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content shadow-lg border-0">
                    <div class="modal-header bg-dark text-white py-3 d-print-none">
                        <h5 class="modal-title h6 fw-bold">
                            <i class="fa-solid fa-print me-2 text-primary"></i>In Bảng Thanh Toán Lương (Mẫu Số 02-LĐTL) - KimLongEcoStay
                        </h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="() => showPrintModal = false"></button>
                    </div>
                    <div class="modal-body p-4 bg-white" id="payrollPrintArea">
                        <div class="p-3 border rounded bg-white">
                            <!-- HEADER DOANH NGHIỆP -->
                            <div class="d-flex justify-content-between align-items-start border-bottom pb-3 mb-3">
                                <div>
                                    <div class="fw-bold fs-6 text-uppercase text-primary">KIM LONG ECOSTAY - CÔNG TY TNHH MTV</div>
                                    <div class="small text-muted">Khu du lịch sinh thái nghỉ dưỡng Kim Long EcoStay</div>
                                    <div class="small text-muted">Bộ phận: Phòng Kế Toán - Tiền Lương</div>
                                </div>
                                <div class="text-end">
                                    <div class="fw-bold small">Mẫu số 02-LĐTL</div>
                                    <div class="small text-muted fst-italic">(Ban hành theo TT 200/2014/TT-BTC)</div>
                                    <div class="small text-muted">Mã kỳ: <strong>@period.PeriodCode</strong></div>
                                    <div class="small text-muted">Ngày xuất: @DateTime.Today.ToString("dd/MM/yyyy")</div>
                                </div>
                            </div>

                            <div class="text-center my-3">
                                <h4 class="fw-bold text-uppercase text-dark mb-1">BẢNG THANH TOÁN TIỀN LƯƠNG VÀ CÁC KHOẢN PHỤ CẤP</h4>
                                <div class="fst-italic text-muted small">
                                    Kỳ lương: <strong>Tháng @period.PeriodMonth/@period.PeriodYear</strong> | 
                                    Số công chuẩn: <strong>@period.StandardWorkDays</strong> ngày | 
                                    Tổng nhân sự: <strong>@payslips.Count</strong> người
                                </div>
                            </div>

                            <!-- BẢNG DỮ LIỆU ĐỐI SOÁT -->
                            <div class="table-responsive">
                                <table class="table table-bordered table-sm align-middle small mb-3">
                                    <thead class="table-light text-center align-middle">
                                        <tr>
                                            <th rowspan="2" style="width: 35px;">STT</th>
                                            <th rowspan="2" style="width: 85px;">Mã NV</th>
                                            <th rowspan="2">Họ và Tên</th>
                                            <th rowspan="2">Phòng Ban</th>
                                            <th rowspan="2" style="width: 60px;">Công Thực</th>
                                            <th colspan="3">CÁC KHOẢN THU NHẬP (VNĐ)</th>
                                            <th rowspan="2" style="width: 105px;" class="table-primary">TỔNG GROSS</th>
                                            <th colspan="4">CÁC KHOẢN KHẤU TRỪ (VNĐ)</th>
                                            <th rowspan="2" style="width: 100px;" class="table-danger">TỔNG TRỪ</th>
                                            <th rowspan="2" style="width: 110px;" class="table-success">THỰC LĨNH</th>
                                            <th rowspan="2" style="width: 75px;">Ký Nhận</th>
                                        </tr>
                                        <tr>
                                            <th style="width: 95px;">Lương Chuẩn</th>
                                            <th style="width: 85px;">Phụ Cấp</th>
                                            <th style="width: 85px;">Làm Thêm</th>
                                            <th style="width: 75px;">BHXH</th>
                                            <th style="width: 70px;">BHYT</th>
                                            <th style="width: 70px;">BHTN</th>
                                            <th style="width: 75px;">Thuế</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{ int pIdx = 1; }
                                        @foreach (var p in payslips)
                                        {
                                            decimal basePay = p.Lines.Where(l => l.LineType == PayslipLineType.BASE_SALARY_PRORATED).Sum(l => l.Amount);
                                            decimal allow = p.Lines.Where(l => !l.IsDeduction && l.LineType != PayslipLineType.BASE_SALARY_PRORATED && l.LineType != PayslipLineType.OVERTIME_PAY).Sum(l => l.Amount);
                                            decimal ot = p.Lines.Where(l => l.LineType == PayslipLineType.OVERTIME_PAY).Sum(l => l.Amount);
                                            decimal bhxh = p.Lines.Where(l => l.LineType == PayslipLineType.DEDUCTION_BHXH).Sum(l => l.Amount);
                                            decimal bhyt = p.Lines.Where(l => l.LineType == PayslipLineType.DEDUCTION_BHYT).Sum(l => l.Amount);
                                            decimal bhtn = p.Lines.Where(l => l.LineType == PayslipLineType.DEDUCTION_BHTN).Sum(l => l.Amount);
                                            decimal tax = p.Lines.Where(l => l.LineType == PayslipLineType.PERSONAL_INCOME_TAX).Sum(l => l.Amount);
                                            <tr>
                                                <td class="text-center">@(pIdx++)</td>
                                                <td class="text-center fw-bold text-primary font-monospace">@p.EmployeeCode</td>
                                                <td class="fw-semibold">@p.EmployeeName</td>
                                                <td>@(p.DepartmentName ?? "Văn phòng")</td>
                                                <td class="text-center fw-bold">@p.ActualWorkDays</td>
                                                <td class="text-end">@basePay.ToString("N0")</td>
                                                <td class="text-end">@allow.ToString("N0")</td>
                                                <td class="text-end">@ot.ToString("N0")</td>
                                                <td class="text-end fw-bold text-primary table-primary">@p.GrossSalary.ToString("N0")</td>
                                                <td class="text-end">@bhxh.ToString("N0")</td>
                                                <td class="text-end">@bhyt.ToString("N0")</td>
                                                <td class="text-end">@bhtn.ToString("N0")</td>
                                                <td class="text-end">@tax.ToString("N0")</td>
                                                <td class="text-end fw-semibold text-danger table-danger">@p.TotalDeductions.ToString("N0")</td>
                                                <td class="text-end fw-bold text-success table-success">@p.NetSalary.ToString("N0")</td>
                                                <td class="text-center text-muted fst-italic" style="font-size: 0.75rem;">(Đã CK)</td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot class="table-light fw-bold">
                                        <tr class="table-active">
                                            <td colspan="4" class="text-end text-uppercase">TỔNG CỘNG:</td>
                                            <td class="text-center">@payslips.Sum(p => p.ActualWorkDays)</td>
                                            <td colspan="3"></td>
                                            <td class="text-end text-primary fs-6">@totalGross.ToString("N0") đ</td>
                                            <td colspan="4"></td>
                                            <td class="text-end text-danger fs-6">-@payslips.Sum(p => p.TotalDeductions).ToString("N0") đ</td>
                                            <td class="text-end text-success fs-6">@totalNet.ToString("N0") đ</td>
                                            <td></td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>

                            <!-- 3 CHỮ KÝ TRÁCH NHIỆM -->
                            <div class="row text-center mt-4 pt-3 small">
                                <div class="col-4">
                                    <div class="fw-bold mb-1 text-uppercase">NGƯỜI LẬP BIỂU</div>
                                    <div class="text-muted fst-italic mb-5">(Ký và ghi rõ họ tên)</div>
                                    <div class="fw-semibold">Lê Thị Thanh Thảo</div>
                                    <div class="text-muted small">Chuyên viên Nhân sự - Tiền lương</div>
                                </div>
                                <div class="col-4">
                                    <div class="fw-bold mb-1 text-uppercase">KẾ TOÁN TRƯỞNG</div>
                                    <div class="text-muted fst-italic mb-5">(Ký và ghi rõ họ tên)</div>
                                    <div class="fw-semibold">Phòng Kế Toán Tài Chính</div>
                                    <div class="text-muted small">Đã kiểm soát số liệu</div>
                                </div>
                                <div class="col-4">
                                    <div class="fw-bold mb-1 text-uppercase">GIÁM ĐỐC ĐIỀU HÀNH</div>
                                    <div class="text-muted fst-italic mb-5">(Ký, đóng dấu duyệt)</div>
                                    <div class="fw-semibold">Ban Giám Đốc KimLongEcoStay</div>
                                    <div class="text-muted small">Phê duyệt chi trả lương</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer bg-light py-2 d-print-none">
                        <button type="button" class="btn btn-secondary btn-sm" @onclick="() => showPrintModal = false">
                            <i class="fa-solid fa-xmark me-1"></i>Đóng
                        </button>
                        <button type="button" class="btn btn-success btn-sm" @onclick="HandleExportExcelAsync">
                            <i class="fa-solid fa-file-excel me-1"></i>Tải Excel
                        </button>
                        <button type="button" class="btn btn-primary btn-sm px-3 shadow-sm" @onclick="TriggerBrowserPrintAsync">
                            <i class="fa-solid fa-print me-1"></i>In Ngay (Print)
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
    </Authorized>
    <NotAuthorized>
        <div class="container p-5 text-center">
            <div class="card border-0 shadow-sm mx-auto" style="max-width: 600px;">
                <div class="card-body p-5">
                    <div class="text-danger mb-3">
                        <i class="fa-solid fa-shield-halved fa-4x"></i>
                    </div>
                    <h3 class="fw-bold text-danger mb-2">Truy Cập Bị Từ Chối (403)</h3>
                    <p class="text-muted mb-4">
                        Tài khoản hiện tại không có quyền truy cập vào phân hệ tính lương quản trị. 
                        Vui lòng đăng nhập với tài khoản Quản trị viên (ROLE_ADMIN) hoặc Kế toán (ROLE_HR_ACCOUNTANT).
                    </p>
                    <div class="d-flex justify-content-center gap-2">
                        <a href="/login" class="btn btn-primary px-4">
                            <i class="fa-solid fa-right-to-bracket me-2"></i>Đăng Nhập Tài Khoản Khác
                        </a>
                        <a href="/" class="btn btn-outline-secondary px-4">
                            <i class="fa-solid fa-house me-2"></i>Về Trang Chủ
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private const long DefaultPeriodId = 10;
    private PayrollPeriod? period;
    private List<Payslip> payslips = new();
    private Payslip? selectedPayslip;
    private bool isLoading = false;
    private bool isLocked = false;
    private bool showPrintModal = false;
    private string alertMessage = string.Empty;
    private string alertType = "success";

    private async Task TriggerBrowserPrintAsync()
    {
        await JSRuntime.InvokeVoidAsync("window.print");
    }

    private decimal totalGross => payslips.Sum(p => p.GrossSalary);
    private decimal totalNet => payslips.Sum(p => p.NetSalary);

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        try
        {
            var summary = await ViewSummaryUseCase.ExecuteAsync(DefaultPeriodId);
            period = summary.Period;
            payslips = summary.Payslips.ToList();
            isLocked = period?.Status == PeriodStatus.LOCKED;
        }
        catch (Exception ex)
        {
            alertMessage = $"Lỗi khi tải dữ liệu: {ex.Message}";
            alertType = "danger";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void HandleSelectPayslip(Payslip p)
    {
        selectedPayslip = p;
    }

    private async Task HandleCalculateBatchAsync()
    {
        isLoading = true;
        try
        {
            var results = await CalculateUseCase.ExecuteAsync(DefaultPeriodId);
            payslips = results.ToList();
            var summary = await ViewSummaryUseCase.ExecuteAsync(DefaultPeriodId);
            period = summary.Period;
            isLocked = period?.Status == PeriodStatus.LOCKED;
            alertMessage = $"Đã tính toán thành công toàn bộ {payslips.Count} nhân viên với tổng thực lĩnh {totalNet:N0} đ!";
            alertType = "success";
        }
        catch (InvalidOperationException ex)
        {
            // Bắt lỗi vi phạm quy tắc nghiệp vụ K3.3 (Luật 2: Kỳ đã chốt không được tính lại)
            alertMessage = $"[CHẶN VI PHẠM LUẬT NGHIỆP VỤ] {ex.Message}";
            alertType = "danger";
        }
        catch (Exception ex)
        {
            alertMessage = $"Lỗi khi chạy tính lương: {ex.Message}";
            alertType = "danger";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleLockPeriodAsync()
    {
        isLoading = true;
        try
        {
            string lockedBy = "ketoan.thao";
            if (AuthStateTask != null)
            {
                var authState = await AuthStateTask;
                var currentUsername = authState.User.Identity?.Name;
                if (!string.IsNullOrEmpty(currentUsername))
                {
                    lockedBy = currentUsername;
                }
            }

            bool success = await LockUseCase.ExecuteAsync(DefaultPeriodId, lockedBy);
            if (success)
            {
                isLocked = true;
                if (period != null) period.Status = PeriodStatus.LOCKED;
                alertMessage = $"Kỳ lương đã được CHỐT KHÓA SỔ thành công bởi {lockedBy}! Toàn bộ bảng công và phiếu lương chuyển sang chế độ Chỉ đọc (Read-Only).";
                alertType = "warning";
            }
        }
        catch (Exception ex)
        {
            alertMessage = $"Lỗi khi chốt kỳ lương: {ex.Message}";
            alertType = "danger";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleUnlockPeriodAsync()
    {
        isLoading = true;
        try
        {
            bool success = await UnlockUseCase.ExecuteAsync(DefaultPeriodId);
            if (success)
            {
                isLocked = false;
                if (period != null) period.Status = PeriodStatus.CALCULATED;
                alertMessage = "Đã MỞ KHÓA BẢNG LƯƠNG thành công! Toàn bộ bảng công của kỳ đã được mở khóa, bạn có thể chỉnh sửa điểm danh và tính lại lương tự động.";
                alertType = "success";
            }
        }
        catch (Exception ex)
        {
            alertMessage = $"Lỗi khi mở khóa kỳ lương: {ex.Message}";
            alertType = "danger";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleExportExcelAsync()
    {
        if (period == null || !payslips.Any())
        {
            alertMessage = "Chưa có dữ liệu phiếu lương để xuất Excel. Vui lòng bấm 'Chạy Tính Lương Tự Động' trước.";
            alertType = "warning";
            return;
        }

        isLoading = true;
        try
        {
            byte[] excelBytes = ExportExcelUseCase.ExportToExcelHtml(period, payslips);
            string base64Data = Convert.ToBase64String(excelBytes);
            string fileName = $"Bang_Luong_{period.PeriodCode}_{DateTime.Now:yyyyMMdd_HHmmss}.xls";

            await JSRuntime.InvokeVoidAsync("downloadFileFromBase64", fileName, "application/vnd.ms-excel;charset=utf-8", base64Data);
            alertMessage = $"Đã xuất thành công bảng tính Excel lương kỳ {period.PeriodCode} ({payslips.Count} nhân viên)!";
            alertType = "success";
        }
        catch (Exception ex)
        {
            alertMessage = $"Lỗi khi xuất bảng Excel: {ex.Message}";
            alertType = "danger";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleExportCsvAsync()
    {
        if (period == null || !payslips.Any())
