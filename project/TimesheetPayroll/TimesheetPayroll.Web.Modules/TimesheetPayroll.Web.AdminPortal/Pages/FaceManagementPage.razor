@page "/admin/face-management"
@attribute [Authorize(Roles = "ROLE_ADMIN")]
@implements IAsyncDisposable
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using TimesheetPayroll.CoreBusiness.Models
@using TimesheetPayroll.UseCases.AdminPortal
@using TimesheetPayroll.UseCases.Authentication
@using TimesheetPayroll.UseCases.PluginInterfaces.DataStore
@inject IFaceManagementUseCases FaceManagementUseCases
@inject IEmployeeRepository EmployeeRepo
@inject IUserSessionService UserSession
@inject IJSRuntime JSRuntime

<PageTitle>Quản Lý Khuôn Mặt - HỆ THỐNG QUẢN LÝ NHÂN SỰ – CHẤM CÔNG – TÍNH LƯƠNG</PageTitle>

<AuthorizeView Roles="ROLE_ADMIN">
    <Authorized>
        <div class="container-fluid py-3 pb-5 mb-4">
            <!-- TIÊU ĐỀ TRANG & PHÂN QUYỀN ADMIN -->
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 pb-2 border-bottom gap-2">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="badge bg-danger text-white px-2 py-1 fw-bold">
                            <i class="fa-solid fa-shield-halved me-1"></i>PHÂN HỆ BẢO MẬT ADMIN
                        </span>
                        <span class="badge bg-white text-dark border px-2 py-1">
                            <i class="fa-solid fa-lock me-1"></i>Quyền Hạn: ROLE_ADMIN Tối Cao
                        </span>
                    </div>
                    <h2 class="h4 mb-0 text-dark fw-bold">
                        <i class="fa-solid fa-fingerprint text-danger me-2"></i>Quản Lý Đăng Ký Khuôn Mặt Nhân Viên
                    </h2>
                    <p class="text-muted small mb-0 mt-1">
                        Chỉ tài khoản Quản trị viên (Admin) mới có quyền khởi tạo, cập nhật, tạm khóa và thu hồi dữ liệu sinh trắc học khuôn mặt theo quy định bảo mật.
                    </p>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-primary shadow-sm fw-semibold" @onclick="() => OpenEnrollModal(null)">
                        <i class="fa-solid fa-camera me-1"></i>Đăng Ký Khuôn Mặt Mới
                    </button>
                    <button class="btn btn-outline-secondary" @onclick="LoadDataAsync" disabled="@isLoading" title="Tải lại dữ liệu">
                        <i class="fa-solid fa-arrows-rotate @(isLoading ? "fa-spin" : "")"></i>
                    </button>
                </div>
            </div>

            <!-- THÔNG BÁO HỆ THỐNG -->
            @if (!string.IsNullOrEmpty(statusMessage))
            {
                <div class="alert alert-@statusType alert-dismissible fade show shadow-sm" role="alert">
                    <i class="fa-solid @(statusType == "success" ? "fa-circle-check" : "fa-triangle-exclamation") me-2"></i>
                    @statusMessage
                    <button type="button" class="btn-close" @onclick="() => statusMessage = string.Empty"></button>
                </div>
            }

            @if (!string.IsNullOrEmpty(loadingError))
            {
                <div class="alert alert-danger shadow-sm d-flex justify-content-between align-items-center mb-3" role="alert">
                    <div>
                        <i class="fa-solid fa-circle-exclamation me-2 fs-5"></i>
                        <strong>Lỗi truy xuất dữ liệu:</strong> @loadingError
                    </div>
                    <button class="btn btn-outline-danger btn-sm fw-semibold" @onclick="LoadDataAsync">
                        <i class="fa-solid fa-arrows-rotate me-1"></i>Thử Lại
                    </button>
                </div>
            }

            <!-- TAB ĐIỀU HƯỚNG: DANH SÁCH & AUDIT LOG -->
            <ul class="nav nav-pills mb-3 p-1 bg-white rounded shadow-sm border gap-1">
                <li class="nav-item">
                    <button type="button" class="nav-link fw-bold @(activeTab == "list" ? "active bg-primary text-white" : "text-dark")" 
                            @onclick='() => activeTab = "list"'>
                        <i class="fa-solid fa-users me-2"></i>Danh Sách Đăng Ký Khuôn Mặt (@faceProfiles.Count nhân sự)
                    </button>
                </li>
                <li class="nav-item">
                    <button type="button" class="nav-link fw-bold @(activeTab == "audit" ? "active bg-primary text-white" : "text-dark")" 
                            @onclick='() => activeTab = "audit"'>
                        <i class="fa-solid fa-list-check me-2"></i>Nhật Ký Kiểm Toán Sinh Trắc Học (Audit Trail)
                        <span class="badge @(activeTab == "audit" ? "bg-light text-dark" : "bg-primary text-white") ms-2">
                            @auditLogs.Count bản ghi
                        </span>
                    </button>
                </li>
            </ul>

            @if (activeTab == "list")
            {
                <!-- THANH TÌM KIẾM & LỌC -->
                <div class="card border-0 shadow-sm mb-4 bg-light">
                    <div class="card-body p-3">
                        <div class="row g-3 align-items-center">
                            <div class="col-md-5">
                                <div class="input-group">
                                    <span class="input-group-text bg-white border-end-0 text-muted">
                                        <i class="fa-solid fa-magnifying-glass"></i>
                                    </span>
                                    <input type="text" class="form-control border-start-0 shadow-none" 
                                           placeholder="Tìm theo mã NV, họ tên hoặc phòng ban..." 
                                           value="@_rawSearchTerm" @oninput="OnSearchInputChanged" />
                                    @if (!string.IsNullOrEmpty(_rawSearchTerm))
                                    {
                                        <button class="btn btn-outline-secondary border-start-0 bg-white" type="button" @onclick="ClearSearch">
                                            <i class="fa-solid fa-xmark text-muted"></i>
                                        </button>
                                    }
                                </div>
                            </div>
                            <div class="col-md-4">
                                <select class="form-select shadow-none" @bind="statusFilter">
                                    <option value="ALL">Tất cả trạng thái đăng ký</option>
                                    <option value="REGISTERED">Đã đăng ký (Hoạt động)</option>
                                    <option value="NOT_REGISTERED">Chưa đăng ký</option>
                                    <option value="LOCKED">Đang tạm khóa</option>
                                </select>
                            </div>
                            <div class="col-md-3 text-md-end text-start">
                                <span class="small text-muted">
                                    Hiển thị: <strong>@StartItemIndex–@EndItemIndex</strong> trên <strong>@TotalFilteredCount</strong> nhân viên phù hợp @(TotalFilteredCount != faceProfiles.Count ? $"(Tổng: {faceProfiles.Count})" : "")
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- BẢNG HỒ SƠ KHUÔN MẶT NHÂN SỰ -->
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-3">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light text-muted small text-uppercase">
                                <tr>
                                    <th style="width: 100px;">Mã NV</th>
                                    <th style="min-width: 170px;">Họ và Tên</th>
                                    <th style="min-width: 160px;">Phòng Ban</th>
                                    <th class="text-center" style="width: 160px;">Trạng Thái Sinh Trắc</th>
                                    <th style="min-width: 120px;">Người Đăng Ký</th>
                                    <th style="min-width: 130px;">Ngày Đăng Ký</th>
                                    <th style="min-width: 200px; max-width: 300px;">Ghi Chú</th>
                                    <th class="text-center" style="min-width: 210px; width: 230px;">THAO TÁC</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (isLoading)
                                {
                                    <tr>
                                        <td colspan="8" class="text-center py-5 text-muted">
                                            <span class="spinner-border spinner-border-sm me-2 text-primary" role="status"></span>
                                            Đang tải dữ liệu hồ sơ sinh trắc học nhân sự...
                                        </td>
                                    </tr>
                                }
                                else if (!FilteredProfiles.Any())
                                {
                                    <tr>
                                        <td colspan="8" class="text-center py-5 text-muted">
                                            <i class="fa-solid fa-user-xmark fs-2 d-block mb-2 text-secondary"></i>
                                            Không tìm thấy nhân viên nào phù hợp với bộ lọc hiện tại.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var p in PagedProfiles)
                                    {
                                        bool isEnrolled = !string.IsNullOrEmpty(p.FaceDescriptorJson) && p.FaceDescriptorJson != "[]";
                                        <tr>
                                            <td class="fw-bold text-primary">@p.EmployeeCode</td>
                                            <td>
                                                <div class="fw-semibold text-dark">@p.FullName</div>
                                            </td>
                                            <td>
                                                <span class="badge bg-light text-dark border">@(p.DepartmentName ?? "Chưa phân phòng")</span>
                                            </td>
                                            <td class="text-center">
                                                @if (!isEnrolled)
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">
                                                        <i class="fa-solid fa-circle-xmark me-1"></i>Chưa Đăng Ký
                                                    </span>
                                                }
                                                else if (p.IsActive)
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                                        <i class="fa-solid fa-circle-check me-1"></i>Đã Đăng Ký (Active)
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                                        <i class="fa-solid fa-lock me-1"></i>Đang Tạm Khóa
                                                    </span>
                                                }
                                            </td>
                                            <td class="small text-muted">
                                                @(string.IsNullOrEmpty(p.RegisteredBy) ? "-" : p.RegisteredBy)
                                            </td>
                                            <td class="small text-muted">
                                                @(p.RegisteredAt.Year > 2005 ? p.RegisteredAt.ToString("dd/MM/yyyy HH:mm") : "-")
                                            </td>
                                            <td style="min-width: 200px; max-width: 300px;">
                                                @if (string.IsNullOrWhiteSpace(p.Notes))
                                                {
                                                    <span class="text-muted fst-italic small">Không có ghi chú</span>
                                                }
                                                else
                                                {
                                                    <div class="small text-dark" style="word-break: break-word; line-height: 1.4;" title="@p.Notes">
                                                        @p.Notes
                                                    </div>
                                                }
                                            </td>
                                            <td class="text-center">
                                                <div class="btn-group btn-group-sm" role="group" aria-label="Thao tác quản lý khuôn mặt">
                                                    <!-- XEM CHI TIẾT -->
                                                    <button type="button" class="btn btn-outline-info" @onclick="() => OpenDetailModal(p)" title="Xem chi tiết hồ sơ">
                                                        <i class="fa-solid fa-eye"></i>
                                                    </button>

                                                    @if (isEnrolled)
                                                    {
                                                        <!-- CHỈNH SỬA GHI CHÚ / THAM SỐ -->
                                                        <button type="button" class="btn btn-outline-primary" @onclick="() => OpenEditModal(p)" title="Chỉnh sửa ghi chú & tham số">
                                                            <i class="fa-solid fa-pen-to-square"></i>
                                                        </button>

                                                        <!-- QUÉT LẠI MẪU KHUÔN MẶT -->
                                                        <button type="button" class="btn btn-outline-secondary" @onclick="() => OpenEnrollModal(p)" title="Quét / Chụp lại mẫu mới">
                                                            <i class="fa-solid fa-camera-rotate"></i>
                                                        </button>

                                                        <!-- TẠM KHÓA / MỞ KHÓA -->
                                                        @if (p.IsActive)
                                                        {
                                                            <button type="button" class="btn btn-outline-warning text-dark" @onclick="() => PromptToggleLock(p, false)" title="Tạm khóa khuôn mặt">
                                                                <i class="fa-solid fa-lock"></i>
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <button type="button" class="btn btn-outline-success" @onclick="() => PromptToggleLock(p, true)" title="Mở khóa khuôn mặt">
                                                                <i class="fa-solid fa-lock-open"></i>
                                                            </button>
                                                        }

                                                        <!-- THU HỒI / XÓA DỮ LIỆU -->
                                                        <button type="button" class="btn btn-outline-danger" @onclick="() => PromptRevoke(p)" title="Thu hồi dữ liệu sinh trắc học">
                                                            <i class="fa-solid fa-trash-can"></i>
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <!-- ĐĂNG KÝ MỚI -->
                                                        <button type="button" class="btn btn-primary" @onclick="() => OpenEnrollModal(p)" title="Đăng ký khuôn mặt">
                                                            <i class="fa-solid fa-camera me-1"></i>Đăng Ký
                                                        </button>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- THANH PHÂN TRANG CHUYÊN NGHIỆP -->
                    <div class="card-footer bg-white border-top py-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
                        <div class="d-flex align-items-center gap-2 small text-muted">
                            <span>Hiển thị</span>
                            <select class="form-select form-select-sm d-inline-block w-auto shadow-none" 
                                    value="@pageSize" @onchange="OnPageSizeChanged">
                                <option value="5">5 dòng/trang</option>
                                <option value="10">10 dòng/trang</option>
                                <option value="20">20 dòng/trang</option>
                                <option value="50">50 dòng/trang</option>
                            </select>
                            <span>
                                <strong>@StartItemIndex–@EndItemIndex</strong> trên tổng số <strong>@TotalFilteredCount</strong> bản ghi
                            </span>
                        </div>

                        @if (TotalPages > 1)
                        {
                            <nav aria-label="Phân trang bảng khuôn mặt">
                                <ul class="pagination pagination-sm mb-0">
                                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                        <button type="button" class="page-link shadow-none" @onclick="() => ChangePage(currentPage - 1)">
                                            <i class="fa-solid fa-chevron-left me-1"></i>Trước
                                        </button>
                                    </li>
                                    @for (int i = 1; i <= TotalPages; i++)
                                    {
                                        int pageNum = i;
                                        <li class="page-item @(currentPage == pageNum ? "active fw-bold" : "")">
                                            <button type="button" class="page-link shadow-none" @onclick="() => ChangePage(pageNum)">
                                                @pageNum
                                            </button>
                                        </li>
                                    }
                                    <li class="page-item @(currentPage >= TotalPages ? "disabled" : "")">
                                        <button type="button" class="page-link shadow-none" @onclick="() => ChangePage(currentPage + 1)">
                                            Sau<i class="fa-solid fa-chevron-right ms-1"></i>
                                        </button>
                                    </li>
                                </ul>
                            </nav>
                        }
                    </div>
                </div>
            }
            else
            {
                <!-- BẢNG NHẬT KÝ KIỂM TOÁN SINH TRẮC HỌC (AUDIT TRAIL) -->
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-3">
                    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                        <h6 class="fw-bold mb-0 text-dark">
                            <i class="fa-solid fa-clock-rotate-left text-danger me-2"></i>Nhật Ký Quản Trị & Điểm Danh Sinh Trắc Học (Tối đa 100 giao dịch mới nhất)
                        </h6>
                        <span class="badge bg-secondary-subtle text-secondary px-2 py-1">
                            Lưu vết tự động chống chối bỏ
                        </span>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 small">
                            <thead class="table-light text-uppercase">
                                <tr>
                                    <th>Thời Điểm</th>
                                    <th>Nhân Viên</th>
                                    <th>Loại Hành Động</th>
                                    <th>Người Thực Hiện</th>
                                    <th>Thiết Bị / Điểm Cuối</th>
                                    <th class="text-center">Kết Quả</th>
                                    <th>Chi Tiết / Lý Do Thất Bại</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!auditLogs.Any())
                                {
                                    <tr>
                                        <td colspan="7" class="text-center py-4 text-muted">
                                            Chưa có bản ghi nhật ký kiểm toán sinh trắc học nào.
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    @foreach (var log in auditLogs)
                                    {
                                        <tr>
                                            <td class="font-monospace text-muted">@log.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                            <td class="fw-semibold">
                                                @if (!string.IsNullOrEmpty(log.EmployeeCode))
                                                {
                                                    <span>[@log.EmployeeCode] @log.FullName</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Không xác định (Chưa khớp)</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge @GetActionBadgeClass(log.ActionType)">@log.ActionType</span>
                                            </td>
                                            <td><code>@log.PerformedBy</code></td>
                                            <td class="text-muted">@(log.DeviceInfo ?? "Terminal")</td>
                                            <td class="text-center">
                                                @if (log.IsSuccess)
                                                {
                                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                        <i class="fa-solid fa-check me-1"></i>Thành Công
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">
                                                        <i class="fa-solid fa-xmark me-1"></i>Từ Chối
                                                    </span>
                                                }
                                            </td>
                                            <td class="text-muted">
                                                @(log.FailureReason ?? (log.SimilarityScore.HasValue ? $"Độ tin cậy: {log.SimilarityScore:0.##}" : "-"))
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>

        <!-- MODAL 1: XEM CHI TIẾT HỒ SƠ SINH TRẮC HỌC -->
        @if (showDetailModal && selectedProfileForDetail != null)
        {
            <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.6);" aria-modal="true" role="dialog">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                        <div class="modal-header bg-dark text-white p-3">
                            <h5 class="modal-title h6 fw-bold">
                                <i class="fa-solid fa-id-card text-info me-2"></i>Chi Tiết Dữ Liệu Sinh Trắc Học Khuôn Mặt
                            </h5>
                            <button type="button" class="btn-close btn-close-white" @onclick="() => showDetailModal = false"></button>
                        </div>
                        <div class="modal-body p-4">
                            <div class="d-flex align-items-center gap-3 mb-3 pb-3 border-bottom">
                                <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold fs-4" style="width: 54px; height: 54px;">
                                    @(selectedProfileForDetail.FullName?.FirstOrDefault() ?? 'U')
                                </div>
                                <div>
                                    <h5 class="fw-bold mb-0 text-dark">@selectedProfileForDetail.FullName</h5>
                                    <div class="text-muted small">Mã NV: <strong class="text-primary">@selectedProfileForDetail.EmployeeCode</strong> • @(selectedProfileForDetail.DepartmentName ?? "Chưa phân phòng")</div>
                                </div>
                            </div>

                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <span class="text-muted small d-block">Trạng thái đăng ký:</span>
                                    @if (string.IsNullOrEmpty(selectedProfileForDetail.FaceDescriptorJson) || selectedProfileForDetail.FaceDescriptorJson == "[]")
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border">Chưa Đăng Ký</span>
                                    }
                                    else if (selectedProfileForDetail.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success border">Đang Hoạt Động (Active)</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger-subtle text-danger border">Đang Tạm Khóa</span>
                                    }
                                </div>
                                <div class="col-6">
                                    <span class="text-muted small d-block">Ngưỡng Liveness:</span>
                                    <span class="badge bg-light text-dark border fw-bold">@selectedProfileForDetail.LivenessThreshold.ToString("0.00")</span>
                                </div>
                                <div class="col-6">
                                    <span class="text-muted small d-block">Người đăng ký:</span>
                                    <span class="fw-semibold text-dark">@(string.IsNullOrEmpty(selectedProfileForDetail.RegisteredBy) ? "-" : selectedProfileForDetail.RegisteredBy)</span>
                                </div>
                                <div class="col-6">
                                    <span class="text-muted small d-block">Ngày đăng ký:</span>
                                    <span class="text-dark">@(selectedProfileForDetail.RegisteredAt.Year > 2005 ? selectedProfileForDetail.RegisteredAt.ToString("dd/MM/yyyy HH:mm") : "-")</span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-bold text-dark mb-1">Ghi chú lưu trữ (Đầy đủ):</label>
                                <div class="p-3 bg-light rounded-3 border small text-dark" style="white-space: pre-wrap; max-height: 140px; overflow-y: auto;">
                                    @(string.IsNullOrWhiteSpace(selectedProfileForDetail.Notes) ? "Không có ghi chú nào." : selectedProfileForDetail.Notes)
                                </div>
                            </div>

                            <div class="alert alert-secondary py-2 px-3 small mb-0 rounded-3">
                                <i class="fa-solid fa-shield-halved text-success me-1"></i>
                                <strong>Bảo mật sinh trắc học:</strong> Dữ liệu khuôn mặt được lưu trữ dưới dạng vector đặc trưng toán học 128 chiều bảo mật. Không lưu trữ ảnh khuôn mặt thô nhằm tuân thủ quy định quyền riêng tư cá nhân.
                            </div>
                        </div>
                        <div class="modal-footer bg-light p-3">
                            <button type="button" class="btn btn-secondary btn-sm" @onclick="() => showDetailModal = false">Đóng</button>
                            <button type="button" class="btn btn-primary btn-sm" @onclick="() => { showDetailModal = false; OpenEditModal(selectedProfileForDetail); }">
                                <i class="fa-solid fa-pen-to-square me-1"></i>Chỉnh Sửa
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- MODAL 2: CHỈNH SỬA THÔNG TIN GHI CHÚ & THAM SỐ SINH TRẮC -->
        @if (showEditModal && selectedProfileForEdit != null)
        {
            <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.6);" aria-modal="true" role="dialog">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                        <div class="modal-header bg-primary text-white p-3">
                            <h5 class="modal-title h6 fw-bold">
                                <i class="fa-solid fa-pen-to-square me-2"></i>Chỉnh Sửa Dữ Liệu Sinh Trắc Học
                            </h5>
                            <button type="button" class="btn-close btn-close-white" @onclick="() => showEditModal = false"></button>
                        </div>
                        <div class="modal-body p-4">
                            <div class="mb-3 pb-2 border-bottom">
                                <span class="text-muted small">Nhân viên:</span>
                                <div class="fw-bold text-dark fs-6">[@selectedProfileForEdit.EmployeeCode] @selectedProfileForEdit.FullName</div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-bold text-dark">Ghi chú quản lý:</label>
                                <textarea class="form-control" rows="3" placeholder="Nhập ghi chú hoặc lý do điều chỉnh..." @bind="editModalNotes"></textarea>
                            </div>

                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <label class="form-label small fw-bold text-dark mb-0">Ngưỡng Liveness (Độ nhạy chống giả mạo):</label>
                                    <span class="badge bg-primary">@editModalThreshold.ToString("0.00")</span>
                                </div>
                                <select class="form-select form-select-sm" @bind="editModalThreshold">
                                    <option value="0.60">0.60 (Tiêu chuẩn lỏng - Dễ nhận diện)</option>
                                    <option value="0.70">0.70 (Khuyến nghị chuẩn hệ thống)</option>
                                    <option value="0.75">0.75 (Nâng cao)</option>
                                    <option value="0.80">0.80 (Bảo mật cao)</option>
                                    <option value="0.85">0.85 (Rất nghiêm ngặt)</option>
                                </select>
                                <span class="text-muted" style="font-size: 0.72rem;">Mặc định 0.70 là mức tối ưu cân bằng giữa độ chính xác và tính tiện dụng.</span>
                            </div>
                        </div>
                        <div class="modal-footer bg-light p-3">
                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => showEditModal = false" disabled="@isBusyAction">Hủy</button>
                            <button type="button" class="btn btn-primary btn-sm fw-semibold px-3" @onclick="SaveEditMetadataAsync" disabled="@isBusyAction">
                                @if (isBusyAction)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                    <span>Đang lưu...</span>
                                }
                                else
                                {
                                    <i class="fa-solid fa-floppy-disk me-1"></i>
                                    <span>Lưu Cập Nhật</span>
                                }
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- MODAL 3: XÁC NHẬN HÀNH ĐỘNG (CONFIRM MODAL - KHÓA/MỞ KHÓA/THU HỒI) -->
        @if (showConfirmModal && selectedProfileForAction != null)
        {
            <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.65);" aria-modal="true" role="dialog">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                        <div class="modal-header @(confirmActionType == "REVOKE" ? "bg-danger" : "bg-warning") text-white p-3">
                            <h5 class="modal-title h6 fw-bold">
                                <i class="fa-solid @(confirmActionType == "REVOKE" ? "fa-triangle-exclamation" : "fa-shield-halved") me-2"></i>
                                @confirmModalTitle
                            </h5>
                            <button type="button" class="btn-close btn-close-white" @onclick="() => showConfirmModal = false"></button>
                        </div>
                        <div class="modal-body p-4">
                            <div class="mb-3">
                                <span class="text-muted small">Đối tượng thao tác:</span>
                                <div class="fw-bold text-dark fs-6">[@selectedProfileForAction.EmployeeCode] @selectedProfileForAction.FullName</div>
                                <div class="text-muted small">@(selectedProfileForAction.DepartmentName ?? "Chưa phân phòng")</div>
                            </div>

                            <p class="text-dark small mb-3">
                                @confirmModalMessage
                            </p>

                            @if (confirmActionType == "REVOKE")
                            {
                                <div class="alert alert-danger py-2 px-3 small mb-0 rounded-3">
                                    <i class="fa-solid fa-radiation me-1"></i>
                                    <strong>Cảnh báo bảo mật:</strong> Hành động thu hồi sẽ xóa hoàn toàn vector đặc trưng khuôn mặt của nhân viên khỏi cơ sở dữ liệu và lưu vết vào Nhật ký kiểm toán.
                                </div>
                            }
                        </div>
                        <div class="modal-footer bg-light p-3">
                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => showConfirmModal = false" disabled="@isBusyAction">Hủy Bỏ</button>
                            <button type="button" class="btn @(confirmActionType == "REVOKE" ? "btn-danger" : (confirmActionType == "LOCK" ? "btn-warning text-dark" : "btn-success")) btn-sm fw-bold px-3" 
                                    @onclick="ExecuteConfirmedActionAsync" disabled="@isBusyAction">
                                @if (isBusyAction)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                    <span>Đang xử lý...</span>
                                }
                                else
                                {
                                    <i class="fa-solid fa-check me-1"></i>
                                    <span>Xác Nhận Thực Hiện</span>
                                }
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- MODAL 4: QUY TRÌNH ĐĂNG KÝ KHUÔN MẶT 5 BƯỚC (WIZARD CHUYÊN NGHIỆP) -->
        @if (showEnrollModal)
        {
            <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(15, 23, 42, 0.75);" aria-modal="true" role="dialog">
                <div class="modal-dialog modal-dialog-centered enroll-modal-dialog">
                    <div class="modal-content enroll-modal-content">
                        <!-- HEADER -->
                        <div class="enroll-modal-header d-flex justify-content-between align-items-center">
                            <div>
                                <h5 class="modal-title h6 fw-bold mb-0 text-white">
                                    <i class="fa-solid fa-fingerprint text-primary me-2"></i>Quy Trình Đăng Ký Khuôn Mặt Sinh Trắc Học
                                </h5>
                                <div class="text-white-50 small" style="font-size: 0.75rem;">
                                    Chuẩn hóa đặc trưng toán học 128 chiều • Bảo mật cơ sở dữ liệu SQL Server
                                </div>
                            </div>
                            <button type="button" class="btn-close btn-close-white" @onclick="CloseEnrollModal"></button>
                        </div>

                        <!-- BODY -->
                        <div class="enroll-modal-body">
                            <!-- 5-STEP STEPPER TIMELINE -->
                            <div class="stepper-nav mb-3">
                                <div class="step-item @(wizardStep == 1 ? "active" : (wizardStep > 1 ? "completed" : ""))">
                                    <div class="step-circle">
                                        @if (wizardStep > 1) { <i class="fa-solid fa-check"></i> } else { <span>1</span> }
                                    </div>
                                    <span class="step-title">1. Chọn Nhân Sự</span>
                                </div>
                                <div class="step-item @(wizardStep == 2 ? "active" : (wizardStep > 2 ? "completed" : ""))">
                                    <div class="step-circle">
                                        @if (wizardStep > 2) { <i class="fa-solid fa-check"></i> } else { <span>2</span> }
                                    </div>
                                    <span class="step-title">2. Căn Chỉnh Mặt</span>
                                </div>
                                <div class="step-item @(wizardStep == 3 ? "active" : (wizardStep > 3 ? "completed" : ""))">
                                    <div class="step-circle">
                                        @if (wizardStep > 3) { <i class="fa-solid fa-check"></i> } else if (wizardStep == 3) { <span class="spinner-border spinner-border-sm"></span> } else { <span>3</span> }
                                    </div>
                                    <span class="step-title">3. Trích Xuất 128-D</span>
                                </div>
                                <div class="step-item @(wizardStep == 4 ? "active" : (wizardStep > 4 ? "completed" : ""))">
                                    <div class="step-circle">
                                        @if (wizardStep > 4) { <i class="fa-solid fa-check"></i> } else if (wizardStep == 4) { <span class="spinner-border spinner-border-sm"></span> } else { <span>4</span> }
                                    </div>
                                    <span class="step-title">4. Lưu CSDL</span>
                                </div>
                                <div class="step-item @(wizardStep == 5 ? "active completed" : "")">
                                    <div class="step-circle">
                                        @if (wizardStep == 5) { <i class="fa-solid fa-check"></i> } else { <span>5</span> }
                                    </div>
                                    <span class="step-title">5. Hoàn Tất</span>
                                </div>
                            </div>

                            <!-- BƯỚC 1: CHỌN NHÂN VIÊN CẦN ĐĂNG KÝ -->
                            @if (wizardStep < 5)
                            {
                                <div class="mb-3 p-3 bg-white rounded-3 border shadow-sm">
                                    <label class="form-label small fw-bold text-dark d-flex justify-content-between align-items-center mb-1">
                                        <span><i class="fa-solid fa-user-check me-1 text-primary"></i>Nhân viên tiếp nhận đăng ký sinh trắc:</span>
                                        @if (SelectedEnrollProfile != null)
                                        {
                                            <span class="badge @(SelectedEnrollProfile.HasFaceEnrolled ? "bg-info-subtle text-info border border-info-subtle" : "bg-secondary-subtle text-secondary border")">
                                                @(SelectedEnrollProfile.HasFaceEnrolled ? "Cập Nhật Lại Mẫu" : "Đăng Ký Mới Lần Đầu")
                                            </span>
                                        }
                                    </label>
                                    <select class="form-select fw-semibold" @bind="modalSelectedEmployeeId" disabled="@isBusyModal">
                                        @foreach (var emp in allEmployees)
                                        {
                                            var profile = faceProfiles.FirstOrDefault(p => p.EmployeeId == emp.Id);
                                            bool hasFace = profile?.HasFaceEnrolled ?? false;
                                            <option value="@emp.Id">
                                                [@emp.EmployeeCode] @emp.FullName — @(emp.DepartmentName ?? "Chưa phân phòng") @(hasFace ? "✓ (Đã có mẫu)" : "○ (Chưa đăng ký)")
                                            </option>
                                        }
                                    </select>
                                </div>
                            }

                            <!-- BƯỚC 2: CAMERA VIEWPORT & HUD CĂN CHỈNH (Giữ phần tử DOM không bị hủy ở bước 5 để tái sử dụng luồng phần cứng tức thì) -->
                            <div class="enroll-camera-box mb-3" style="display: @(wizardStep < 5 ? "flex" : "none");">
                                <video id="adminEnrollVideo" autoplay playsinline muted 
                                       style="display: @(isModalCameraActive ? "block" : "none");"></video>
                                <canvas id="adminEnrollCanvas" 
                                        style="display: @(isModalCameraActive ? "block" : "none");"></canvas>

                                @if (!isModalCameraActive)
                                {
                                    <div class="text-center p-4">
                                        <i class="fa-solid fa-camera fs-1 text-secondary mb-2 d-block"></i>
                                        <div class="text-white fw-semibold mb-1">Camera chưa kích hoạt</div>
                                        <div class="text-white-50 small mb-3">Nhấn nút bên dưới để mở camera thu thập vector đặc trưng 128-D.</div>
                                        <button type="button" class="btn btn-primary btn-sm px-4 shadow" @onclick="StartAdminCameraAsync" disabled="@isBusyModal">
                                            <i class="fa-solid fa-video me-1"></i>Kích Hoạt Camera
                                        </button>
                                    </div>
                                }
                            </div>

                            @if (wizardStep < 5)
                            {
                                @if (!string.IsNullOrEmpty(modalError))
                                {
                                    <div class="alert alert-danger py-2 px-3 small mb-3 rounded-3 shadow-sm">
                                        <i class="fa-solid fa-triangle-exclamation me-1"></i>@modalError
                                    </div>
                                }

                                <!-- GIAI ĐOẠN ĐANG XỬ LÝ (PROGRESS INDICATOR) -->
                                @if (isBusyModal)
                                {
                                    <div class="stage-indicator-card mb-3">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="spinner-border text-primary" role="status"></div>
                                            <div>
                                                <div class="fw-bold text-dark">
                                                    @(wizardStep == 3 ? "Giai đoạn 3/5: Đang trích xuất vector đặc trưng 128-D..." : "Giai đoạn 4/5: Đang ghi nhận vào cơ sở dữ liệu SQL Server...")
                                                </div>
                                                <div class="text-muted small">
                                                    @(wizardStep == 3 ? "Kiểm tra chất lượng ảnh, căn chỉnh tâm khuôn mặt, trích xuất đa ô 4x4 và L2-Normalization." : "Lưu trữ vector 128-D và ghi vết kiểm toán trong 1 giao dịch SQL Server duy nhất.")
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }

                                <!-- GHI CHÚ ĐĂNG KÝ -->
                                <div class="mb-3">
                                    <label class="form-label small fw-bold text-dark mb-1">Ghi chú đăng ký (Lý do / Phê duyệt của Admin):</label>
                                    <input type="text" class="form-control" placeholder="vd: Đăng ký lần đầu cho nhân sự mới; Cập nhật lại ảnh do thay đổi ngoại hình..." 
                                           @bind="modalEnrollNote" disabled="@isBusyModal" />
                                </div>

                                <!-- HƯỚNG DẪN THAO TÁC CHO ADMIN -->
                                <div class="p-2 px-3 bg-white rounded border small text-muted">
                                    <i class="fa-solid fa-circle-info text-primary me-1"></i>
                                    <strong>Hướng dẫn Admin:</strong> Hướng dẫn nhân viên ngồi thẳng, bỏ kính râm/khẩu trang, nhìn thẳng vào camera sao cho khuôn mặt nằm trong khung oval định vị. 
                                    Nhấn <strong>"Chụp & Đăng Ký Mẫu 128-D"</strong> để lưu vector đặc trưng mã hóa vào cơ sở dữ liệu.
                                </div>
                            }
                            else
                            {
                                <!-- BƯỚC 5: XÁC NHẬN KẾT QUẢ THÀNH CÔNG & TELEMETRY TỪNG GIAI ĐOẠN -->
                                <div class="text-center py-2">
                                    <div class="bg-success-subtle text-success rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style="width: 64px; height: 64px;">
                                        <i class="fa-solid fa-circle-check fs-2"></i>
                                    </div>
                                    <h4 class="fw-bold text-success mb-1">ĐĂNG KÝ SINH TRẮC HỌC THÀNH CÔNG!</h4>
                                    <p class="text-muted small mb-3">
                                        Hồ sơ khuôn mặt của nhân viên đã được chuẩn hóa 128-D và lưu trữ nguyên tử trong SQL Server.
                                    </p>

                                    <!-- THÔNG TIN TÓM TẮT & ĐO LƯỜNG HIỆU NĂNG -->
                                    <div class="card border-0 bg-white shadow-sm rounded-3 p-3 text-start mb-2 mx-auto" style="max-width: 560px;">
                                        <div class="d-flex align-items-center gap-3 pb-3 border-bottom mb-3">
                                            @if (!string.IsNullOrEmpty(enrolledPhotoBase64))
                                            {
                                                <img src="@enrolledPhotoBase64" class="rounded-3 border shadow-sm" style="width: 72px; height: 72px; object-fit: cover;" alt="Khuôn mặt" />
                                            }
                                            else
                                            {
                                                <div class="bg-primary text-white rounded-3 d-flex align-items-center justify-content-center fw-bold fs-3" style="width: 72px; height: 72px;">
                                                    @(enrolledEmployeeName?.FirstOrDefault() ?? 'U')
                                                </div>
                                            }
                                            <div>
                                                <h5 class="fw-bold text-dark mb-0">@enrolledEmployeeName</h5>
                                                <div class="small text-muted">Mã NV: <strong class="text-primary">@enrolledEmployeeCode</strong></div>
                                                <div class="small text-muted">Phòng ban: <strong class="text-dark">@(enrolledDepartmentName ?? "Chưa phân phòng")</strong></div>
                                            </div>
                                        </div>

                                        <div class="row g-2 small mb-2 pb-2 border-bottom">
                                            <div class="col-6">
                                                <span class="text-muted d-block">Trạng thái hồ sơ:</span>
                                                <span class="badge bg-success-subtle text-success border border-success-subtle">
                                                    <i class="fa-solid fa-check me-1"></i>Hoạt Động (Active)
                                                </span>
                                            </div>
                                            <div class="col-6">
                                                <span class="text-muted d-block">Chuẩn hóa đặc trưng:</span>
                                                <span class="badge bg-light text-dark border fw-bold">128-D Unit Sphere (||V|| = 1.0)</span>
                                            </div>
                                        </div>

                                        @if (lastTelemetry != null)
                                        {
                                            <div class="small">
                                                <div class="fw-bold text-dark mb-2 d-flex justify-content-between align-items-center">
                                                    <span><i class="fa-solid fa-gauge-high text-primary me-1"></i>Thời Gian Xử Lý Thực Tế Theo Giai Đoạn:</span>
                                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                                        Tổng: @lastTelemetry.TotalEnrollmentMs.ToString("0.##") ms
                                                    </span>
                                                </div>
                                                <div class="row g-1 text-muted" style="font-size: 0.78rem;">
                                                    <div class="col-6 d-flex justify-content-between pe-2">
                                                        <span>1. Camera Init @(lastTelemetry.ReusedCameraStream ? "(Tái sử dụng)" : ""):</span>
                                                        <strong class="text-dark font-monospace">@lastTelemetry.CameraInitMs.ToString("0.##") ms</strong>
                                                    </div>
                                                    <div class="col-6 d-flex justify-content-between ps-2">
                                                        <span>2. Phát hiện & Chất lượng:</span>
                                                        <strong class="text-dark font-monospace">@lastTelemetry.FaceDetectionMs.ToString("0.##") ms</strong>
                                                    </div>
                                                    <div class="col-6 d-flex justify-content-between pe-2">
                                                        <span>3. Căn chỉnh mặt (Alignment):</span>
                                                        <strong class="text-dark font-monospace">@lastTelemetry.FaceAlignmentMs.ToString("0.##") ms</strong>
                                                    </div>
                                                    <div class="col-6 d-flex justify-content-between ps-2">
                                                        <span>4. Tiền xử lý (160×160):</span>
                                                        <strong class="text-dark font-monospace">@lastTelemetry.PreprocessingMs.ToString("0.##") ms</strong>
                                                    </div>
                                                    <div class="col-6 d-flex justify-content-between pe-2">
                                                        <span>5. Trích xuất 128-D:</span>
                                                        <strong class="text-primary font-monospace">@lastTelemetry.EmbeddingInferenceMs.ToString("0.##") ms</strong>
                                                    </div>
                                                    <div class="col-6 d-flex justify-content-between ps-2">
                                                        <span>6. Kiểm tra chuẩn hóa L2:</span>
                                                        <strong class="text-dark font-monospace">@lastTelemetry.EmbeddingValidationMs.ToString("0.##") ms</strong>
                                                    </div>
                                                    <div class="col-6 d-flex justify-content-between pe-2">
                                                        <span>7. Truy vấn SQL Server:</span>
                                                        <strong class="text-dark font-monospace">@lastTelemetry.SqlQueryMs.ToString("0.##") ms</strong>
                                                    </div>
                                                    <div class="col-6 d-flex justify-content-between ps-2">
                                                        <span>8. Ghi CSDL & Audit Log:</span>
                                                        <strong class="text-success font-monospace">@lastTelemetry.DbWriteMs.ToString("0.##") ms</strong>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- FOOTER -->
                        <div class="enroll-modal-footer d-flex justify-content-between align-items-center">
                            @if (wizardStep < 5)
                            {
                                <button type="button" class="btn btn-outline-secondary" @onclick="CloseEnrollModal">
                                    <i class="fa-solid fa-xmark me-1"></i>Hủy Bỏ
                                </button>
                                <div>
                                    @if (isModalCameraActive)
                                    {
                                        <button type="button" class="btn btn-success fw-bold px-4 shadow" @onclick="CaptureAndEnrollAsync" disabled="@isBusyModal">
                                            @if (isBusyModal)
                                            {
                                                <span class="spinner-border spinner-border-sm me-2"></span>
                                                <span>@(wizardStep == 3 ? "Đang trích xuất 128-D..." : "Đang lưu CSDL...")</span>
                                            }
                                            else
                                            {
                                                <i class="fa-solid fa-camera me-2"></i>
                                                <span>Chụp & Đăng Ký Mẫu 128-D</span>
                                            }
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-primary" @onclick="StartAdminCameraAsync" disabled="@isBusyModal">
                                            <i class="fa-solid fa-video me-1"></i>Kích Hoạt Camera
                                        </button>
                                    }
                                </div>
                            }
                            else
                            {
                                <button type="button" class="btn btn-outline-primary" @onclick="ResetWizardForNextEmployee">
                                    <i class="fa-solid fa-user-plus me-1"></i>Đăng Ký Nhân Viên Khác
                                </button>
                                <button type="button" class="btn btn-success fw-semibold px-4" @onclick="CloseEnrollModal">
                                    <i class="fa-solid fa-check me-1"></i>Hoàn Tất & Đóng
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <!-- BẢO VỆ CHỐNG BYPASS: HIỂN THỊ LỖI 403 KHI KHÔNG ĐỦ QUYỀN ADMIN -->
        <div class="container py-5 text-center">
            <div class="card border-danger shadow-sm p-5 mx-auto rounded-4" style="max-width: 600px;">
                <div class="text-danger mb-3">
                    <i class="fa-solid fa-shield-virus display-3"></i>
                </div>
                <h3 class="fw-bold text-danger mb-2">403 FORBIDDEN - TRUY CẬP BỊ TỪ CHỐI</h3>
                <p class="text-muted mb-4">
                    Trang quản trị dữ liệu sinh trắc học khuôn mặt nhân viên chỉ dành riêng cho tài khoản có vai trò <strong>Quản Trị Viên (ROLE_ADMIN)</strong>.
                    Nhân viên thường, Quản lý và Kế toán không được phép truy cập hoặc thay đổi dữ liệu này.
                </p>
                <div>
                    <a href="/" class="btn btn-primary px-4 fw-semibold">
                        <i class="fa-solid fa-arrow-left me-1"></i>Quay Về Trang Chủ
                    </a>
                </div>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private string activeTab = "list";
    private bool isLoading = false;
    private string loadingError = string.Empty;
    private string statusMessage = string.Empty;
    private string statusType = "success";

    // TÌM KIẾM CÓ DEBOUNCE (CHỐNG LẶP RENDER VÀ GIẢM TẢI SIGNALR)
    private string _rawSearchTerm = string.Empty;
    private string _debouncedSearchTerm = string.Empty;
    private System.Threading.CancellationTokenSource? _searchCts;

    private async Task OnSearchInputChanged(ChangeEventArgs e)
    {
        _rawSearchTerm = e.Value?.ToString() ?? string.Empty;
        _searchCts?.Cancel();
        _searchCts = new System.Threading.CancellationTokenSource();
        var token = _searchCts.Token;

        try
        {
            await Task.Delay(250, token); // 250ms debounce
            if (!token.IsCancellationRequested)
            {
                _debouncedSearchTerm = _rawSearchTerm.Trim();
                currentPage = 1;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (TaskCanceledException) { }
    }

    private void ClearSearch()
    {
        _rawSearchTerm = string.Empty;
        _debouncedSearchTerm = string.Empty;
        currentPage = 1;
    }

    private string _statusFilter = "ALL";
    private string statusFilter
    {
        get => _statusFilter;
        set
        {
            if (_statusFilter != value)
            {
                _statusFilter = value;
                currentPage = 1;
            }
        }
    }

    private List<EmployeeFaceProfile> faceProfiles = new();
    private List<FaceAuditLog> auditLogs = new();
    private List<Employee> allEmployees = new();

    // PHÂN TRANG (PAGINATION)
    private int currentPage = 1;
    private int pageSize = 10;
    private int TotalFilteredCount => FilteredProfiles.Count();
    private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)TotalFilteredCount / pageSize));
    private int StartItemIndex => TotalFilteredCount == 0 ? 0 : (currentPage - 1) * pageSize + 1;
    private int EndItemIndex => Math.Min(currentPage * pageSize, TotalFilteredCount);

    private IEnumerable<EmployeeFaceProfile> PagedProfiles =>
        FilteredProfiles.Skip((currentPage - 1) * pageSize).Take(pageSize);

    private void ChangePage(int page)
    {
        if (page >= 1 && page <= TotalPages)
        {
            currentPage = page;
        }
    }

    private void OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int size) && size > 0)
        {
            pageSize = size;
            currentPage = 1;
        }
    }

    // Modal Xem Chi Tiết
    private bool showDetailModal = false;
    private EmployeeFaceProfile? selectedProfileForDetail;

    private void OpenDetailModal(EmployeeFaceProfile profile)
    {
        selectedProfileForDetail = profile;
        showDetailModal = true;
    }

    // Modal Chỉnh Sửa Metadata
    private bool showEditModal = false;
    private EmployeeFaceProfile? selectedProfileForEdit;
    private string editModalNotes = string.Empty;
    private decimal editModalThreshold = 0.70m;
    private bool isBusyAction = false;

    private void OpenEditModal(EmployeeFaceProfile profile)
    {
        selectedProfileForEdit = profile;
        editModalNotes = profile.Notes ?? string.Empty;
        editModalThreshold = profile.LivenessThreshold > 0 ? profile.LivenessThreshold : 0.70m;
        showEditModal = true;
    }

    private async Task SaveEditMetadataAsync()
    {
        if (selectedProfileForEdit == null) return;
        isBusyAction = true;
        try
        {
            var user = UserSession.CurrentUser;
            await FaceManagementUseCases.UpdateProfileMetadataAsync(
                selectedProfileForEdit.EmployeeId, 
                editModalNotes, 
                editModalThreshold, 
                user?.Username ?? "admin", 
                user?.Role);

            selectedProfileForEdit.Notes = editModalNotes;
            selectedProfileForEdit.LivenessThreshold = editModalThreshold;
            selectedProfileForEdit.UpdatedAt = DateTime.Now;

            auditLogs.Insert(0, new FaceAuditLog
            {
                EmployeeId = selectedProfileForEdit.EmployeeId,
                EmployeeCode = selectedProfileForEdit.EmployeeCode,
                FullName = selectedProfileForEdit.FullName,
                ActionType = "UPDATE_METADATA",
                PerformedBy = user?.Username ?? "admin",
                DeviceInfo = "Admin Portal Biometric Update",
                IsSuccess = true,
                CreatedAt = DateTime.Now
            });

            statusMessage = $"Đã cập nhật thành công thông tin sinh trắc cho nhân viên [{selectedProfileForEdit.EmployeeCode}] {selectedProfileForEdit.FullName}.";
            statusType = "success";
            showEditModal = false;
        }
        catch (Exception ex)
        {
            statusMessage = $"Lỗi cập nhật: {ex.Message}";
            statusType = "danger";
        }
        finally
        {
            isBusyAction = false;
        }
    }

    // Modal Xác Nhận Hành Động (Confirm Modal)
    private bool showConfirmModal = false;
    private EmployeeFaceProfile? selectedProfileForAction;
    private string confirmActionType = string.Empty; // "LOCK", "UNLOCK", "REVOKE"
    private string confirmModalTitle = string.Empty;
    private string confirmModalMessage = string.Empty;

    private void PromptToggleLock(EmployeeFaceProfile profile, bool lockState)
    {
        selectedProfileForAction = profile;
        confirmActionType = lockState ? "UNLOCK" : "LOCK";
        confirmModalTitle = lockState ? "Xác Nhận Mở Khóa Dữ Liệu Khuôn Mặt" : "Xác Nhận Tạm Khóa Dữ Liệu Khuôn Mặt";
        confirmModalMessage = lockState
            ? $"Bạn có chắc chắn muốn MỞ KHÓA nhận diện khuôn mặt cho nhân viên [{profile.EmployeeCode}] {profile.FullName}? Sau khi mở khóa, nhân viên có thể tiếp tục chấm công bình thường."
            : $"Bạn có chắc chắn muốn TẠM KHÓA nhận diện khuôn mặt của nhân viên [{profile.EmployeeCode}] {profile.FullName}? Trong thời gian tạm khóa, nhân viên sẽ không thể check-in bằng camera.";
        showConfirmModal = true;
    }

    private void PromptRevoke(EmployeeFaceProfile profile)
    {
        selectedProfileForAction = profile;
        confirmActionType = "REVOKE";
        confirmModalTitle = "Xác Nhận Thu Hồi Dữ Liệu Sinh Trắc Học";
        confirmModalMessage = $"Bạn có chắc chắn muốn THU HỒI và XÓA dữ liệu mẫu khuôn mặt của nhân viên [{profile.EmployeeCode}] {profile.FullName}?";
        showConfirmModal = true;
    }

    private async Task ExecuteConfirmedActionAsync()
    {
        if (selectedProfileForAction == null) return;
        isBusyAction = true;

        try
        {
            var user = UserSession.CurrentUser;
            if (confirmActionType == "LOCK")
            {
                await FaceManagementUseCases.ToggleFaceProfileLockAsync(selectedProfileForAction.EmployeeId, false, user?.Username ?? "admin", user?.Role);
                selectedProfileForAction.IsActive = false;
                statusMessage = $"Đã tạm khóa nhận diện khuôn mặt của nhân viên [{selectedProfileForAction.EmployeeCode}] {selectedProfileForAction.FullName}.";
                statusType = "warning";
                auditLogs.Insert(0, new FaceAuditLog
                {
                    EmployeeId = selectedProfileForAction.EmployeeId,
                    EmployeeCode = selectedProfileForAction.EmployeeCode,
                    FullName = selectedProfileForAction.FullName,
                    ActionType = "LOCK",
                    PerformedBy = user?.Username ?? "admin",
                    DeviceInfo = "Admin Portal",
                    IsSuccess = true,
                    CreatedAt = DateTime.Now
                });
            }
            else if (confirmActionType == "UNLOCK")
            {
                await FaceManagementUseCases.ToggleFaceProfileLockAsync(selectedProfileForAction.EmployeeId, true, user?.Username ?? "admin", user?.Role);
                selectedProfileForAction.IsActive = true;
                statusMessage = $"Đã mở khóa nhận diện khuôn mặt cho nhân viên [{selectedProfileForAction.EmployeeCode}] {selectedProfileForAction.FullName}.";
                statusType = "success";
                auditLogs.Insert(0, new FaceAuditLog
                {
                    EmployeeId = selectedProfileForAction.EmployeeId,
                    EmployeeCode = selectedProfileForAction.EmployeeCode,
                    FullName = selectedProfileForAction.FullName,
                    ActionType = "UNLOCK",
                    PerformedBy = user?.Username ?? "admin",
                    DeviceInfo = "Admin Portal",
                    IsSuccess = true,
                    CreatedAt = DateTime.Now
                });
            }
            else if (confirmActionType == "REVOKE")
            {
                await FaceManagementUseCases.RevokeFaceProfileAsync(selectedProfileForAction.EmployeeId, user?.Username ?? "admin", user?.Role);
                selectedProfileForAction.FaceDescriptorJson = string.Empty;
                selectedProfileForAction.IsActive = false;
                statusMessage = $"Đã thu hồi thành công dữ liệu khuôn mặt của nhân viên [{selectedProfileForAction.EmployeeCode}] {selectedProfileForAction.FullName}.";
                statusType = "info";
                auditLogs.Insert(0, new FaceAuditLog
                {
                    EmployeeId = selectedProfileForAction.EmployeeId,
                    EmployeeCode = selectedProfileForAction.EmployeeCode,
                    FullName = selectedProfileForAction.FullName,
                    ActionType = "REVOKE",
                    PerformedBy = user?.Username ?? "admin",
                    DeviceInfo = "Admin Portal Biometric Revocation",
                    IsSuccess = true,
                    CreatedAt = DateTime.Now
                });
            }

            showConfirmModal = false;
        }
        catch (Exception ex)
        {
            statusMessage = $"Lỗi thực hiện: {ex.Message}";
            statusType = "danger";
        }
        finally
        {
            isBusyAction = false;
        }
    }

    // Camera Enrollment Modal & Wizard State
    private bool showEnrollModal = false;
    private bool isModalCameraActive = false;
    private bool isBusyModal = false;
    private bool _isUserClosingModal = false;
    private bool _isDisposed = false;
    private System.Threading.CancellationTokenSource? _enrollCts;
    private int wizardStep = 1; // 1: Chọn NV, 2: Căn chỉnh, 3: Trích xuất, 4: Ghi CSDL, 5: Hoàn tất
    private long modalSelectedEmployeeId = 1;
    private string modalEnrollNote = string.Empty;
    private string modalError = string.Empty;

    private double lastCameraInitMs = 0;
    private bool lastCameraReused = false;
    private FaceEnrollmentTelemetryDto? lastTelemetry = null;
    private string? enrolledPhotoBase64 = null;
    private string? enrolledEmployeeName = null;
    private string? enrolledEmployeeCode = null;
    private string? enrolledDepartmentName = null;

    private EmployeeFaceProfile? SelectedEnrollProfile =>
        faceProfiles.FirstOrDefault(p => p.EmployeeId == modalSelectedEmployeeId);

    private IEnumerable<EmployeeFaceProfile> FilteredProfiles
    {
        get
        {
            var query = faceProfiles.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_debouncedSearchTerm))
            {
                query = query.Where(p =>
                    (p.EmployeeCode?.Contains(_debouncedSearchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (p.FullName?.Contains(_debouncedSearchTerm, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (p.DepartmentName?.Contains(_debouncedSearchTerm, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            if (statusFilter == "REGISTERED")
            {
                query = query.Where(p => p.HasFaceEnrolled && p.IsActive);
            }
            else if (statusFilter == "NOT_REGISTERED")
            {
                query = query.Where(p => !p.HasFaceEnrolled);
            }
            else if (statusFilter == "LOCKED")
            {
                query = query.Where(p => p.HasFaceEnrolled && !p.IsActive);
            }

            return query;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    // TỐI ƯU TRUY VẤN: Chạy song song Task.WhenAll, không query trùng lặp bảng employees
    private async Task LoadDataAsync()
    {
        isLoading = true;
        loadingError = string.Empty;
        try
        {
            var user = UserSession.CurrentUser;
            string? role = user?.Role;

            if (role == "ROLE_ADMIN")
            {
                var profilesTask = FaceManagementUseCases.GetAllProfilesAsync(role);
                var auditLogsTask = FaceManagementUseCases.GetAuditLogsAsync(role, 100);

                await Task.WhenAll(profilesTask, auditLogsTask);

                faceProfiles = (await profilesTask).ToList();
                auditLogs = (await auditLogsTask).ToList();

                allEmployees = faceProfiles.Select(p => new Employee
                {
                    Id = p.EmployeeId,
                    EmployeeCode = p.EmployeeCode ?? string.Empty,
                    FullName = p.FullName ?? string.Empty,
                    DepartmentName = p.DepartmentName
                }).ToList();
            }
        }
        catch (Exception ex)
        {
            loadingError = ex.Message;
            statusMessage = $"Lỗi khi tải dữ liệu sinh trắc học: {ex.Message}";
            statusType = "danger";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OpenEnrollModal(EmployeeFaceProfile? profile)
    {
        _isUserClosingModal = false;
        modalError = string.Empty;
        wizardStep = 1;
        lastTelemetry = null;
        enrolledPhotoBase64 = null;

        if (profile != null)
        {
            modalSelectedEmployeeId = profile.EmployeeId;
            modalEnrollNote = profile.HasFaceEnrolled
                ? $"Cập nhật lại mẫu sinh trắc học nhân viên [{profile.EmployeeCode}] {profile.FullName}"
                : $"Đăng ký khuôn mặt mới cho nhân viên [{profile.EmployeeCode}] {profile.FullName}";
        }
        else if (allEmployees.Any())
        {
            modalSelectedEmployeeId = allEmployees.First().Id;
            modalEnrollNote = "Đăng ký khuôn mặt mới";
        }

        showEnrollModal = true;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
        await StartAdminCameraAsync();
    }

    private async Task CloseEnrollModal()
    {
        _isUserClosingModal = true;
        try { _enrollCts?.Cancel(); } catch { }

        try
        {
            using var stopCts = new System.Threading.CancellationTokenSource(TimeSpan.FromSeconds(2));
            await JSRuntime.InvokeVoidAsync("FaceRecognitionHelper.stopCamera", stopCts.Token, "adminEnrollVideo");
        }
        catch { }

        isModalCameraActive = false;
        isBusyModal = false;
        showEnrollModal = false;
        wizardStep = 1;
        modalError = string.Empty;
    }

    private async Task ResetWizardForNextEmployee()
    {
        _isUserClosingModal = false;
        wizardStep = 2;
        lastTelemetry = null;
        enrolledPhotoBase64 = null;
        modalError = string.Empty;

        var nextUnenrolled = faceProfiles.FirstOrDefault(p => !p.HasFaceEnrolled);
        if (nextUnenrolled != null)
        {
            modalSelectedEmployeeId = nextUnenrolled.EmployeeId;
            modalEnrollNote = $"Đăng ký khuôn mặt mới cho nhân viên [{nextUnenrolled.EmployeeCode}] {nextUnenrolled.FullName}";
        }

        await InvokeAsync(StateHasChanged);
        await StartAdminCameraAsync();
    }

    private async Task StartAdminCameraAsync()
    {
        if (_isUserClosingModal || _isDisposed) return;

        isBusyModal = true;
        modalError = string.Empty;
        try
        {
            using var camCts = new System.Threading.CancellationTokenSource(TimeSpan.FromSeconds(10));
            var res = await JSRuntime.InvokeAsync<FaceCameraInitResult>(
                "FaceRecognitionHelper.startCamera",
                camCts.Token,
                "adminEnrollVideo",
                "adminEnrollCanvas",
                null);

            if (_isUserClosingModal || _isDisposed) return;

            if (res.Success)
            {
                isModalCameraActive = true;
                lastCameraInitMs = res.CameraInitMs;
                lastCameraReused = res.ReusedStream;
                wizardStep = 2; // Đã sẵn sàng căn chỉnh
            }
            else
            {
                isModalCameraActive = false;
                modalError = res.Error ?? "Không thể kết nối camera.";
            }
        }
        catch (OperationCanceledException)
        {
            if (!_isUserClosingModal && !_isDisposed)
            {
                isModalCameraActive = false;
                modalError = "Quá thời gian khởi tạo camera. Vui lòng kiểm tra thiết bị webcam và thử lại.";
            }
        }
        catch (Microsoft.JSInterop.JSDisconnectedException)
        {
            isModalCameraActive = false;
        }
        catch (Exception ex)
        {
            if (!_isUserClosingModal && !_isDisposed)
            {
                isModalCameraActive = false;
                modalError = $"Lỗi khởi tạo camera: {ex.Message}";
            }
        }
        finally
        {
            isBusyModal = false;
        }
    }

    // QUY TRÌNH 5 GIAI ĐOẠN ĐĂNG KÝ KHUÔN MẶT CHỐNG DOUBLE-SUBMIT, CHỐNG LỖI TASK CANCELED & ĐỒNG BỘ TRẠNG THÁI SAU COMMIT
    private async Task CaptureAndEnrollAsync()
    {
        if (isBusyModal || !isModalCameraActive || _isUserClosingModal || _isDisposed) return;

        isBusyModal = true;
        _isUserClosingModal = false;
        modalError = string.Empty;
        wizardStep = 3; // Giai đoạn 3: Trích xuất đặc trưng 128-D
        await InvokeAsync(StateHasChanged);

        _enrollCts?.Cancel();
        _enrollCts?.Dispose();
        _enrollCts = new System.Threading.CancellationTokenSource(TimeSpan.FromSeconds(15));
        var token = _enrollCts.Token;

        bool dbCommitted = false;
        var enrollStartTime = DateTime.Now;
        var user = UserSession.CurrentUser;

        try
        {
            // BƯỚC 3: Chụp & Trích xuất vector 128-D từ Webcam qua JSInterop
            FaceCaptureResult captureRes;
            try
            {
                captureRes = await JSRuntime.InvokeAsync<FaceCaptureResult>(
                    "FaceRecognitionHelper.captureFaceDescriptor",
                    token,
                    "adminEnrollVideo",
                    new { mode = "enroll" });
            }
            catch (OperationCanceledException)
            {
                if (_isUserClosingModal || _isDisposed) return;
                modalError = "Quá trình trích xuất khuôn mặt từ camera đã bị gián đoạn hoặc quá thời gian chờ. Vui lòng giữ khuôn mặt ổn định và nhấn chụp lại.";
                wizardStep = 2;
                return;
            }

            if (_isUserClosingModal || _isDisposed) return;

            if (!captureRes.Success || captureRes.Descriptor == null || captureRes.Descriptor.Length == 0)
            {
                modalError = captureRes.Error ?? "Chưa phát hiện được khuôn mặt hợp lệ trong khung quét. Vui lòng căn chỉnh lại.";
                wizardStep = 2; // Quay lại bước căn chỉnh
                try { await JSRuntime.InvokeVoidAsync("FaceRecognitionHelper.playChime", "error"); } catch { }
                return;
            }

            enrolledPhotoBase64 = captureRes.PhotoBase64;

            // BƯỚC 4: Ghi CSDL SQL Server trong 1 giao dịch nguyên tử (UPSERT + Audit Log)
            wizardStep = 4;
            await InvokeAsync(StateHasChanged);

            var clientTelemetry = new FaceEnrollmentTelemetryDto
            {
                CameraInitMs = lastCameraInitMs,
                ReusedCameraStream = lastCameraReused,
                FaceDetectionMs = captureRes.FaceDetectionMs,
                FaceAlignmentMs = captureRes.FaceAlignmentMs,
                PreprocessingMs = captureRes.PreprocessingMs,
                EmbeddingInferenceMs = captureRes.EmbeddingInferenceMs
            };

            lastTelemetry = await FaceManagementUseCases.RegisterFaceProfileWithMetricsAsync(
                modalSelectedEmployeeId,
                captureRes.Descriptor,
                modalEnrollNote,
                user?.Username ?? "admin",
                user?.Role,
                clientTelemetry,
                token);

            // Đánh dấu CSDL đã commit thành công để bất kỳ lỗi JSInterop nào sau đó cũng không bao giờ đẩy lùi UI về bước 2
            dbCommitted = true;

            ApplyCommittedEnrollmentToUiState(user?.Username ?? "admin");

            // Các tác vụ giao diện phụ (pauseHud, playChime) được bọc cô lập hoàn toàn sau khi DB đã commit
            if (!_isUserClosingModal && !_isDisposed)
            {
                try
                {
                    using var postCommitCts = new System.Threading.CancellationTokenSource(TimeSpan.FromSeconds(2));
                    await JSRuntime.InvokeVoidAsync("FaceRecognitionHelper.pauseHud", postCommitCts.Token, "adminEnrollVideo");
                    await JSRuntime.InvokeVoidAsync("FaceRecognitionHelper.playChime", postCommitCts.Token, "success");
                }
                catch
                {
                    // Bỏ qua lỗi JSInterop sau khi dữ liệu đã lưu thành công vào SQL Server
                }
            }
        }
        catch (OperationCanceledException)
        {
            if (dbCommitted)
            {
                // Dữ liệu đã được lưu vào SQL Server trước khi hủy — giữ nguyên trạng thái hoàn tất bước 5
                return;
            }

            if (_isUserClosingModal || _isDisposed)
            {
                // Người dùng chủ động đóng modal hoặc chuyển trang — kết thúc êm, không báo lỗi giả
                return;
            }

            // Kiểm tra xem giao dịch SQL Server đã kịp commit ngay trước thời điểm tín hiệu hủy đến hay chưa
            bool recoveredFromDb = await TryRecoverCommittedEnrollmentAsync(enrollStartTime, user?.Username ?? "admin", user?.Role);
            if (!recoveredFromDb)
            {
                modalError = "Tác vụ xử lý bị ngắt kết nối hoặc quá thời gian phản hồi. Vui lòng nhấn 'Chụp & Đăng Ký Mẫu 128-D' để thử lại.";
                wizardStep = 2;
            }
        }
        catch (Microsoft.JSInterop.JSDisconnectedException)
        {
            // Kết nối SignalR đã đóng do chuyển trang — không xử lý tiếp
        }
        catch (ArgumentException argEx)
        {
            if (!dbCommitted && !_isUserClosingModal && !_isDisposed)
            {
                modalError = argEx.Message;
                wizardStep = 2;
                try { await JSRuntime.InvokeVoidAsync("FaceRecognitionHelper.playChime", "error"); } catch { }
            }
        }
        catch (Exception ex)
        {
            if (dbCommitted || _isUserClosingModal || _isDisposed)
            {
                return;
            }

            bool recoveredFromDb = await TryRecoverCommittedEnrollmentAsync(enrollStartTime, user?.Username ?? "admin", user?.Role);
            if (!recoveredFromDb)
            {
                modalError = ex.Message.Contains("A task was canceled", StringComparison.OrdinalIgnoreCase)
                    ? "Kết nối xử lý tạm thời bị gián đoạn. Vui lòng nhấn 'Chụp & Đăng Ký Mẫu 128-D' để thử lại."
                    : $"Lỗi khi lưu dữ liệu đăng ký: {ex.Message}";
                wizardStep = 2;
                try { await JSRuntime.InvokeVoidAsync("FaceRecognitionHelper.playChime", "error"); } catch { }
            }
        }
        finally
        {
            isBusyModal = false;
            if (!_isDisposed)
            {
                try { await InvokeAsync(StateHasChanged); } catch { }
            }
        }
    }

    private void ApplyCommittedEnrollmentToUiState(string performedBy)
    {
        var targetEmp = faceProfiles.FirstOrDefault(p => p.EmployeeId == modalSelectedEmployeeId);
        if (targetEmp != null)
        {
            targetEmp.FaceDescriptorJson = "[ENROLLED]";
            targetEmp.IsActive = true;
            targetEmp.Notes = string.IsNullOrWhiteSpace(modalEnrollNote)
                ? $"Đăng ký bởi Quản trị viên {performedBy} ngày {DateTime.Now:dd/MM/yyyy HH:mm}"
                : modalEnrollNote;
            targetEmp.RegisteredAt = DateTime.Now;
            targetEmp.RegisteredBy = performedBy;
            targetEmp.UpdatedAt = DateTime.Now;

            enrolledEmployeeName = targetEmp.FullName;
            enrolledEmployeeCode = targetEmp.EmployeeCode;
            enrolledDepartmentName = targetEmp.DepartmentName;
        }

        if (!(lastTelemetry?.SkippedIdenticalWrite ?? false))
        {
            auditLogs.Insert(0, new FaceAuditLog
            {
                EmployeeId = modalSelectedEmployeeId,
                EmployeeCode = enrolledEmployeeCode,
                FullName = enrolledEmployeeName,
                ActionType = "REGISTER",
                PerformedBy = performedBy,
                DeviceInfo = "Admin Portal Biometric Enrollment",
                IsSuccess = true,
                CreatedAt = DateTime.Now
            });
        }

        wizardStep = 5; // Giai đoạn 5: Hoàn tất & xác nhận kết quả
        double totalMs = lastTelemetry?.TotalEnrollmentMs ?? 0;
        statusMessage = totalMs > 0
            ? $"Đăng ký khuôn mặt thành công cho nhân viên [{enrolledEmployeeCode}] {enrolledEmployeeName} (Tổng thời gian xử lý: {totalMs:0.##} ms)."
            : $"Đăng ký khuôn mặt thành công cho nhân viên [{enrolledEmployeeCode}] {enrolledEmployeeName}.";
        statusType = "success";
    }

    private async Task<bool> TryRecoverCommittedEnrollmentAsync(DateTime enrollStartTime, string performedBy, string? callerRole)
    {
        try
        {
            var latestProfile = await FaceManagementUseCases.GetProfileByEmployeeIdAsync(modalSelectedEmployeeId, callerRole);
            if (latestProfile != null &&
                latestProfile.IsActive &&
                !string.IsNullOrWhiteSpace(latestProfile.FaceDescriptorJson) &&
                latestProfile.FaceDescriptorJson != "[]" &&
                latestProfile.UpdatedAt >= enrollStartTime.AddSeconds(-3))
            {
                ApplyCommittedEnrollmentToUiState(performedBy);
                return true;
            }
        }
        catch
        {
            // Nếu truy vấn kiểm tra trạng thái cũng lỗi thì trả về false để hiển thị thông báo thử lại
        }
        return false;
    }

    private string GetActionBadgeClass(string action) => action switch
    {
        "REGISTER" => "bg-primary text-white",
        "RE_ENROLL" => "bg-info text-dark",
        "REVOKE" => "bg-danger text-white",
        "LOCK" => "bg-warning text-dark",
        "UNLOCK" => "bg-success text-white",
        "UPDATE_METADATA" => "bg-primary text-white",
        "PUNCH_CHECK_IN" => "bg-success text-white",
        "PUNCH_CHECK_OUT" => "bg-warning text-dark",
        "VERIFY_FAIL" => "bg-danger text-white",
        _ => "bg-secondary text-white"
    };

    public async ValueTask DisposeAsync()
    {
        _isDisposed = true;
        _isUserClosingModal = true;

        try { _searchCts?.Cancel(); _searchCts?.Dispose(); } catch { }
        try { _enrollCts?.Cancel(); _enrollCts?.Dispose(); } catch { }

        if (isModalCameraActive || showEnrollModal)
        {
            try
            {
                using var disposeCts = new System.Threading.CancellationTokenSource(TimeSpan.FromSeconds(1));
                await JSRuntime.InvokeVoidAsync("FaceRecognitionHelper.stopCamera", disposeCts.Token, "adminEnrollVideo");
            }
            catch { }
        }
    }
}
