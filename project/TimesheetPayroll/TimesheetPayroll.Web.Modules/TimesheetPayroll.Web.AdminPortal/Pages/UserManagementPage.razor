@page "/admin/user-management"
@attribute [Authorize(Roles = "ROLE_ADMIN")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using TimesheetPayroll.CoreBusiness.Exceptions
@using TimesheetPayroll.CoreBusiness.Models
@using TimesheetPayroll.UseCases.AdminPortal
@using TimesheetPayroll.UseCases.Authentication
@using TimesheetPayroll.UseCases.PluginInterfaces.DataStore
@inject IGetUserAccountsUseCase GetUsersUseCase
@inject ICreateUserAccountUseCase CreateUserUseCase
@inject IUpdateUserAccountUseCase UpdateUserUseCase
@inject IGetEmployeesWithoutAccountUseCase GetUnassignedEmpsUseCase
@inject IToggleUserStatusUseCase ToggleStatusUseCase
@inject IEmployeeRepository EmployeeRepo

<PageTitle>Quản Trị Người Dùng & Phân Quyền - HỆ THỐNG QUẢN LÝ NHÂN SỰ – CHẤM CÔNG – TÍNH LƯƠNG</PageTitle>

<AuthorizeView Roles="ROLE_ADMIN">
    <Authorized>
        <div class="container-fluid py-3">
            <!-- PAGE HEADER -->
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom gap-2">
                <div>
                    <h2 class="h4 mb-1 text-dark fw-bold">
                        <i class="fa-solid fa-users-gear text-primary me-2"></i>Quản Trị Tài Khoản & Phân Quyền (RBAC)
                    </h2>
                    <p class="text-muted small mb-0">Cấp tài khoản mới cho nhân viên, chỉnh sửa thông tin, đặt lại mật khẩu và phân quyền vai trò bảo mật.</p>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-primary" @onclick="LoadDataAsync" disabled="@isLoading">
                        <i class="fa-solid fa-arrows-rotate me-1"></i>Làm mới
                    </button>
                    <button class="btn btn-primary shadow-sm" @onclick="OpenCreateModal">
                        <i class="fa-solid fa-user-plus me-1"></i>Cấp Tài Khoản Mới
                    </button>
                </div>
            </div>

            <!-- ALERT NOTIFICATIONS -->
            @if (!string.IsNullOrEmpty(alertMessage))
            {
                <div class="alert alert-@alertType alert-dismissible fade show shadow-sm" role="alert">
                    <i class="fa-solid @(alertType == "success" ? "fa-circle-check" : "fa-triangle-exclamation") me-2"></i>
                    @alertMessage
                    <button type="button" class="btn-close" @onclick="() => alertMessage = string.Empty"></button>
                </div>
            }

            <!-- STATISTIC CARDS -->
            <div class="row g-3 mb-4">
                <div class="col-md-3 col-sm-6">
                    <div class="card border-0 shadow-sm bg-white p-3 border-start border-4 border-primary">
                        <div class="text-muted small fw-semibold">TỔNG TÀI KHOẢN</div>
                        <div class="fs-4 fw-bold text-dark mt-1">@users.Count</div>
                        <div class="small text-muted">@users.Count(u => u.IsActive) đang hoạt động</div>
                    </div>
                </div>
                <div class="col-md-3 col-sm-6">
                    <div class="card border-0 shadow-sm bg-white p-3 border-start border-4 border-danger">
                        <div class="text-muted small fw-semibold">QUẢN TRỊ VIÊN (ADMIN)</div>
                        <div class="fs-4 fw-bold text-danger mt-1">@users.Count(u => u.Role == "ROLE_ADMIN")</div>
                        <div class="small text-muted">Toàn quyền hệ thống</div>
                    </div>
                </div>
                <div class="col-md-3 col-sm-6">
                    <div class="card border-0 shadow-sm bg-white p-3 border-start border-4 border-warning">
                        <div class="text-muted small fw-semibold">KẾ TOÁN / HR</div>
                        <div class="fs-4 fw-bold text-warning mt-1">@users.Count(u => u.Role == "ROLE_HR_ACCOUNTANT")</div>
                        <div class="small text-muted">Quản trị công & lương</div>
                    </div>
                </div>
                <div class="col-md-3 col-sm-6">
                    <div class="card border-0 shadow-sm bg-white p-3 border-start border-4 border-success">
                        <div class="text-muted small fw-semibold">NHÂN VIÊN (PORTAL)</div>
                        <div class="fs-4 fw-bold text-success mt-1">@users.Count(u => u.Role == "ROLE_EMPLOYEE")</div>
                        <div class="small text-muted">Tài khoản cá nhân</div>
                    </div>
                </div>
            </div>

            <!-- SEARCH & FILTER TOOLBAR -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-3">
                    <div class="row g-2 align-items-center">
                        <div class="col-md-5">
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-muted">
                                    <i class="fa-solid fa-magnifying-glass"></i>
                                </span>
                                <input type="text" class="form-control border-start-0" 
                                       placeholder="Tìm kiếm theo Tên đăng nhập, Họ tên, Mã nhân viên..." 
                                       @bind="searchTerm" @bind:event="oninput" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <select class="form-select" @bind="selectedRoleFilter">
                                <option value="">-- Tất cả vai trò --</option>
                                <option value="ROLE_ADMIN">Quản trị viên (ROLE_ADMIN)</option>
                                <option value="ROLE_HR_ACCOUNTANT">Kế toán / HR (ROLE_HR_ACCOUNTANT)</option>
                                <option value="ROLE_EMPLOYEE">Nhân viên (ROLE_EMPLOYEE)</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <select class="form-select" @bind="selectedStatusFilter">
                                <option value="">-- Tất cả trạng thái --</option>
                                <option value="active">Đang hoạt động</option>
                                <option value="locked">Đã khóa</option>
                            </select>
                        </div>
                        <div class="col-md-2 text-md-end">
                            <span class="text-muted small">Hiển thị <strong>@FilteredUsers.Count()</strong> / @users.Count</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- USER ACCOUNTS TABLE -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="card-title h6 mb-0 fw-bold text-dark">
                        <i class="fa-solid fa-list-check me-2 text-primary"></i>Danh Sách Tài Khoản Người Dùng
                    </h5>
                    <span class="badge bg-light text-muted border">Cập nhật thời gian thực</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-secondary small">
                            <tr>
                                <th class="text-center" style="width: 50px;">#</th>
                                <th>Nhân Viên Sở Hữu</th>
                                <th>Tên Đăng Nhập</th>
                                <th>Phòng Ban</th>
                                <th>Vai Trò Phân Quyền</th>
                                <th class="text-center">Trạng Thái</th>
                                <th>Đăng Nhập Cuối</th>
                                <th class="text-center" style="width: 140px;">Thao Tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (isLoading)
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-5">
                                        <div class="spinner-border text-primary" role="status"></div>
                                        <div class="mt-2 text-muted small">Đang tải danh sách tài khoản...</div>
                                    </td>
                                </tr>
                            }
                            else if (!FilteredUsers.Any())
                            {
                                <tr>
                                    <td colspan="8" class="text-center py-5 text-muted">
                                        <i class="fa-solid fa-user-slash fa-2x mb-2 text-secondary opacity-50"></i>
                                        <div>Không tìm thấy tài khoản phù hợp với điều kiện tìm kiếm.</div>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                var index = 1;
                                foreach (var u in FilteredUsers)
                                {
                                    <tr>
                                        <td class="text-center text-muted small">@(index++)</td>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <div class="bg-primary-subtle text-primary fw-bold rounded-circle p-2 me-2 d-flex align-items-center justify-content-center" 
                                                     style="width: 38px; height: 38px; font-size: 0.85rem;">
                                                    @GetAvatarLetter(u.FullName)
                                                </div>
                                                <div>
                                                    <div class="fw-bold text-dark">@(u.FullName ?? "Chưa liên kết")</div>
                                                    <div class="text-muted small">
                                                        <span class="badge bg-light text-secondary border">@(u.EmployeeCode ?? "EMP")</span>
                                                        @if (!string.IsNullOrEmpty(u.Email))
                                                        {
                                                            <span class="ms-1">• @u.Email</span>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="fw-semibold text-dark">
                                                <i class="fa-solid fa-at text-muted me-1"></i>@u.Username
                                            </div>
                                        </td>
                                        <td>
                                            <span class="text-secondary small">@(u.DepartmentName ?? "Chưa phân bổ")</span>
                                        </td>
                                        <td>
                                            <span class="badge @GetRoleBadgeClass(u.Role) px-2 py-1">
                                                <i class="fa-solid @GetRoleIcon(u.Role) me-1"></i>@GetRoleDisplayName(u.Role)
                                            </span>
                                        </td>
                                        <td class="text-center">
                                            @if (u.IsActive)
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                                    <i class="fa-solid fa-circle-check me-1"></i>Hoạt động
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                                                    <i class="fa-solid fa-ban me-1"></i>Đã khóa
                                                </span>
                                            }
                                        </td>
                                        <td class="small text-muted">
                                            @(u.LastLoginAt.HasValue ? u.LastLoginAt.Value.ToString("dd/MM/yyyy HH:mm") : "Chưa đăng nhập")
                                        </td>
                                        <td class="text-center">
                                            <div class="btn-group btn-group-sm">
                                                <button class="btn btn-outline-primary" title="Chỉnh sửa tài khoản" @onclick="() => OpenEditModal(u)">
                                                    <i class="fa-solid fa-pen-to-square"></i>
                                                </button>
                                                <button class="btn @(u.IsActive ? "btn-outline-danger" : "btn-outline-success")" 
                                                        title="@(u.IsActive ? "Khóa tài khoản" : "Mở khóa tài khoản")" 
                                                        @onclick="() => HandleToggleStatusAsync(u.Id)">
                                                    <i class="fa-solid @(u.IsActive ? "fa-lock" : "fa-lock-open")"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- MODAL CẤP TÀI KHOẢN MỚI -->
        @if (showCreateModal)
        {
            <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content border-0 shadow-lg rounded-4">
                        <div class="modal-header bg-primary text-white border-0 py-3 rounded-top-4">
                            <h5 class="modal-title fw-bold">
                                <i class="fa-solid fa-user-plus me-2"></i>Cấp Tài Khoản Cho Nhân Viên
                            </h5>
                            <button type="button" class="btn-close btn-close-white" @onclick="CloseCreateModal"></button>
                        </div>
                        <div class="modal-body p-4">
                            @if (!string.IsNullOrEmpty(modalError))
                            {
                                <div class="alert alert-danger py-2 small mb-3">
                                    <i class="fa-solid fa-triangle-exclamation me-1"></i>@modalError
                                </div>
                            }

                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Chọn Nhân Viên Được Cấp <span class="text-danger">*</span></label>
                                <select class="form-select" @bind="newAccount.EmployeeId" @bind:after="OnEmployeeSelected">
                                    <option value="0">-- Chọn nhân sự từ danh sách --</option>
                                    @foreach (var emp in unassignedEmployees)
                                    {
                                        <option value="@emp.Id">[@emp.EmployeeCode] @emp.FullName (@(emp.DepartmentName ?? "Chưa phân phòng"))</option>
                                    }
                                </select>
                                @if (!unassignedEmployees.Any())
                                {
                                    <div class="form-text text-warning">
                                        <i class="fa-solid fa-circle-info me-1"></i>Tất cả nhân sự trong hệ thống hiện tại đều đã được cấp tài khoản.
                                    </div>
                                }
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Tên Đăng Nhập (Username) <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="fa-solid fa-user text-muted"></i></span>
                                    <input type="text" class="form-control" placeholder="vd: nhanvien.b, ketoan.an..." @bind="newAccount.Username" />
                                </div>
                                <div class="form-text">Viết liền không dấu, chữ thường (ví dụ: nguyenvana).</div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Mật Khẩu Khởi Tạo <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="fa-solid fa-key text-muted"></i></span>
                                    <input type="@(showNewPassword ? "text" : "password")" class="form-control" placeholder="Tối thiểu 6 ký tự..." @bind="newPassword" />
                                    <button class="btn btn-outline-secondary" type="button" @onclick="() => showNewPassword = !showNewPassword">
                                        <i class="fa-solid @(showNewPassword ? "fa-eye-slash" : "fa-eye")"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Phân Quyền Vai Trò (Role) <span class="text-danger">*</span></label>
                                <select class="form-select" @bind="newAccount.Role">
                                    <option value="ROLE_EMPLOYEE">ROLE_EMPLOYEE - Nhân viên (Xem công & lương cá nhân)</option>
                                    <option value="ROLE_HR_ACCOUNTANT">ROLE_HR_ACCOUNTANT - Kế toán / HR (Quản trị bảng lương, duyệt phép)</option>
                                    <option value="ROLE_ADMIN">ROLE_ADMIN - Quản trị viên (Toàn quyền hệ thống)</option>
                                </select>
                            </div>

                            <div class="form-check form-switch mb-2">
                                <input class="form-check-input" type="checkbox" id="chkActiveNew" @bind="newAccount.IsActive">
                                <label class="form-check-label small fw-semibold" for="chkActiveNew">Kích hoạt tài khoản ngay lập tức</label>
                            </div>
                        </div>
                        <div class="modal-footer border-0 p-3 pt-0">
                            <button type="button" class="btn btn-secondary px-3" @onclick="CloseCreateModal">Hủy Bỏ</button>
                            <button type="button" class="btn btn-primary px-4 fw-bold" @onclick="HandleCreateAccountAsync" disabled="@isSubmitting">
                                @if (isSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                    <span>Đang tạo...</span>
                                }
                                else
                                {
                                    <i class="fa-solid fa-check me-1"></i>
                                    <span>Cấp Tài Khoản</span>
                                }
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- MODAL CHỈNH SỬA TÀI KHOẢN & PHÂN QUYỀN -->
        @if (showEditModal && editingAccount != null)
        {
            <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content border-0 shadow-lg rounded-4">
                        <div class="modal-header bg-dark text-white border-0 py-3 rounded-top-4">
                            <h5 class="modal-title fw-bold">
                                <i class="fa-solid fa-user-pen me-2 text-warning"></i>Chỉnh Sửa Tài Khoản & Phân Quyền
                            </h5>
                            <button type="button" class="btn-close btn-close-white" @onclick="CloseEditModal"></button>
                        </div>
                        <div class="modal-body p-4">
                            @if (!string.IsNullOrEmpty(modalError))
                            {
                                <div class="alert alert-danger py-2 small mb-3">
                                    <i class="fa-solid fa-triangle-exclamation me-1"></i>@modalError
                                </div>
                            }

                            <!-- THÔNG TIN NHÂN VIÊN GỐC (READ-ONLY) -->
                            <div class="p-3 bg-light rounded-3 mb-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="fw-bold text-dark">@(editingAccount.FullName ?? "Nhân viên")</div>
                                        <div class="text-muted small">
                                            Mã NV: <strong>@(editingAccount.EmployeeCode ?? "N/A")</strong> • Phòng: @(editingAccount.DepartmentName ?? "Chưa phân phòng")
                                        </div>
                                    </div>
                                    <span class="badge bg-primary px-2 py-1">ID=@editingAccount.EmployeeId</span>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Tên Đăng Nhập (Username) <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light"><i class="fa-solid fa-user text-muted"></i></span>
                                    <input type="text" class="form-control" @bind="editingAccount.Username" />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-semibold">Vai Trò Phân Quyền (Role) <span class="text-danger">*</span></label>
                                <select class="form-select" @bind="editingAccount.Role">
                                    <option value="ROLE_EMPLOYEE">ROLE_EMPLOYEE - Nhân viên (Xem công & lương cá nhân)</option>
                                    <option value="ROLE_HR_ACCOUNTANT">ROLE_HR_ACCOUNTANT - Kế toán / HR (Quản trị bảng lương, duyệt phép)</option>
                                    <option value="ROLE_ADMIN">ROLE_ADMIN - Quản trị viên (Toàn quyền hệ thống)</option>
                                </select>
                            </div>

                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" id="chkActiveEdit" @bind="editingAccount.IsActive">
                                <label class="form-check-label small fw-semibold" for="chkActiveEdit">Trạng thái kích hoạt (Hoạt động / Khóa)</label>
                            </div>

                            <!-- ĐỔI MẬT KHẨU MỚI -->
                            <div class="card border border-warning-subtle bg-warning-subtle bg-opacity-25 p-3 rounded-3 mb-2">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" id="chkChangePass" @bind="changePasswordOption">
                                    <label class="form-check-label fw-bold small text-dark" for="chkChangePass">
                                        <i class="fa-solid fa-key me-1 text-warning"></i>Đặt lại mật khẩu mới cho tài khoản
                                    </label>
                                </div>
                                @if (changePasswordOption)
                                {
                                    <div class="input-group">
                                        <input type="@(showEditPassword ? "text" : "password")" class="form-control" placeholder="Nhập mật khẩu mới (tối thiểu 6 ký tự)..." @bind="editNewPassword" />
                                        <button class="btn btn-outline-secondary" type="button" @onclick="() => showEditPassword = !showEditPassword">
                                            <i class="fa-solid @(showEditPassword ? "fa-eye-slash" : "fa-eye")"></i>
                                        </button>
                                    </div>
                                    <div class="form-text small">Nếu không thay đổi, mật khẩu cũ vẫn được giữ nguyên.</div>
                                }
                            </div>
                        </div>
                        <div class="modal-footer border-0 p-3 pt-0">
                            <button type="button" class="btn btn-secondary px-3" @onclick="CloseEditModal">Hủy Bỏ</button>
                            <button type="button" class="btn btn-primary px-4 fw-bold" @onclick="HandleUpdateAccountAsync" disabled="@isSubmitting">
                                @if (isSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                    <span>Đang lưu...</span>
                                }
                                else
                                {
                                    <i class="fa-solid fa-floppy-disk me-1"></i>
                                    <span>Lưu Thay Đổi</span>
                                }
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <div class="container py-5 text-center">
            <div class="card border-0 shadow-sm mx-auto p-5" style="max-width: 600px;">
                <div class="text-danger mb-3">
                    <i class="fa-solid fa-shield-halved fa-4x"></i>
                </div>
                <h3 class="fw-bold text-danger mb-2">Quyền Quản Trị Viên (403)</h3>
                <p class="text-muted mb-4">
                    Chức năng Cấp & Chỉnh sửa tài khoản người dùng chỉ dành riêng cho Quản trị viên hệ thống (ROLE_ADMIN).
                </p>
                <a href="/login" class="btn btn-primary px-4">
                    <i class="fa-solid fa-right-to-bracket me-2"></i>Đăng Nhập Với Tài Khoản Admin
                </a>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private List<UserAccount> users = new();
    private List<Employee> unassignedEmployees = new();
    private bool isLoading = true;
    private bool isSubmitting = false;
    private string alertMessage = string.Empty;
    private string alertType = "success";
    private string modalError = string.Empty;

    // Filters & Search
    private string searchTerm = string.Empty;
    private string selectedRoleFilter = string.Empty;
    private string selectedStatusFilter = string.Empty;

    // Modals
    private bool showCreateModal = false;
    private bool showEditModal = false;
    private bool showNewPassword = false;
    private bool showEditPassword = false;
    private bool changePasswordOption = false;

    private UserAccount newAccount = new();
    private string newPassword = string.Empty;

    private UserAccount? editingAccount;
    private string editNewPassword = string.Empty;

    private IEnumerable<UserAccount> FilteredUsers
    {
        get
        {
            var query = users.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var term = searchTerm.Trim().ToLowerInvariant();
                query = query.Where(u =>
                    (!string.IsNullOrEmpty(u.Username) && u.Username.ToLowerInvariant().Contains(term)) ||
                    (!string.IsNullOrEmpty(u.FullName) && u.FullName.ToLowerInvariant().Contains(term)) ||
                    (!string.IsNullOrEmpty(u.EmployeeCode) && u.EmployeeCode.ToLowerInvariant().Contains(term)) ||
                    (!string.IsNullOrEmpty(u.DepartmentName) && u.DepartmentName.ToLowerInvariant().Contains(term)));
            }

            if (!string.IsNullOrWhiteSpace(selectedRoleFilter))
            {
                query = query.Where(u => u.Role == selectedRoleFilter);
            }

            if (!string.IsNullOrWhiteSpace(selectedStatusFilter))
            {
                if (selectedStatusFilter == "active") query = query.Where(u => u.IsActive);
                else if (selectedStatusFilter == "locked") query = query.Where(u => !u.IsActive);
            }

            return query;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        alertMessage = string.Empty;
        try
        {
            users = (await GetUsersUseCase.ExecuteAsync()).ToList();
            unassignedEmployees = (await GetUnassignedEmpsUseCase.ExecuteAsync()).ToList();
        }
        catch (Exception ex)
        {
            alertType = "danger";
            alertMessage = $"Lỗi tải danh sách tài khoản: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenCreateModal()
    {
        modalError = string.Empty;
        newPassword = "Password123@";
        showNewPassword = false;
        newAccount = new UserAccount
        {
            EmployeeId = unassignedEmployees.FirstOrDefault()?.Id ?? 0,
            Role = "ROLE_EMPLOYEE",
            IsActive = true
        };

        if (newAccount.EmployeeId > 0)
        {
            OnEmployeeSelected();
        }

        showCreateModal = true;
    }

    private void CloseCreateModal()
    {
        showCreateModal = false;
        modalError = string.Empty;
    }

    private void OnEmployeeSelected()
    {
        var emp = unassignedEmployees.FirstOrDefault(e => e.Id == newAccount.EmployeeId);
        if (emp != null && string.IsNullOrWhiteSpace(newAccount.Username))
        {
            // Tự động tạo gợi ý tên đăng nhập dựa trên mã nhân viên
            newAccount.Username = emp.EmployeeCode.ToLowerInvariant();
        }
    }

    private async Task HandleCreateAccountAsync()
    {
        modalError = string.Empty;
        isSubmitting = true;
        try
        {
            await CreateUserUseCase.ExecuteAsync(newAccount, newPassword);
            showCreateModal = false;
            alertType = "success";
            alertMessage = $"Cấp tài khoản '{newAccount.Username}' cho nhân viên thành công!";
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            modalError = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private void OpenEditModal(UserAccount user)
    {
        modalError = string.Empty;
        changePasswordOption = false;
        editNewPassword = string.Empty;
        showEditPassword = false;

        editingAccount = new UserAccount
        {
            Id = user.Id,
            EmployeeId = user.EmployeeId,
            Username = user.Username,
            Role = user.Role,
            IsActive = user.IsActive,
            FullName = user.FullName,
            EmployeeCode = user.EmployeeCode,
            DepartmentName = user.DepartmentName,
            Email = user.Email
        };

        showEditModal = true;
    }

    private void CloseEditModal()
    {
        showEditModal = false;
        editingAccount = null;
        modalError = string.Empty;
    }

    private async Task HandleUpdateAccountAsync()
    {
        if (editingAccount == null) return;

        modalError = string.Empty;
        isSubmitting = true;
        try
        {
            string? pwdToUpdate = changePasswordOption ? editNewPassword : null;
            await UpdateUserUseCase.ExecuteAsync(editingAccount, pwdToUpdate);
            showEditModal = false;
            alertType = "success";
            alertMessage = $"Cập nhật tài khoản '{editingAccount.Username}' thành công!";
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            modalError = ex.Message;
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task HandleToggleStatusAsync(long userId)
    {
        try
        {
            await ToggleStatusUseCase.ExecuteAsync(userId);
            alertType = "info";
            alertMessage = "Thay đổi trạng thái kích hoạt tài khoản thành công!";
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            alertType = "danger";
            alertMessage = $"Không thể cập nhật trạng thái: {ex.Message}";
        }
    }

    private string GetAvatarLetter(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "U";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts[^1][0].ToString().ToUpperInvariant();
    }

    private string GetRoleBadgeClass(string? role) => role switch
    {
        "ROLE_ADMIN" => "bg-danger text-white",
        "ROLE_HR_ACCOUNTANT" => "bg-warning text-dark",
        _ => "bg-success text-white"
    };

    private string GetRoleIcon(string? role) => role switch
    {
        "ROLE_ADMIN" => "fa-user-shield",
        "ROLE_HR_ACCOUNTANT" => "fa-calculator",
        _ => "fa-user"
    };

    private string GetRoleDisplayName(string? role) => role switch
    {
        "ROLE_ADMIN" => "Quản trị viên (Admin)",
        "ROLE_HR_ACCOUNTANT" => "Kế toán / HR",
        _ => "Nhân viên"
    };
}
